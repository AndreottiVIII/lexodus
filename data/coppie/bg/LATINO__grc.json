ena":[{"codice":"la","nome":"Latin","termine":"emblēma","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἔμβλημα","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Ultimately from Latin emblēma, via some Western language. In turn from Ancient Greek ἔμβλημα (émblēma, “insertion, ornament”).","origine_varieta":"la"},{"parola":"камила","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"camel","termine_origine":"camēlus","catena":[{"codice":"la","nome":"Latin","termine":"camēlus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κάμηλος","categoria":"non_precisato"},{"codice":"sem","nome":"Semitic","termine":"","categoria":"non_precisato"},{"codice":"sem-wes-pro","nome":"Proto-West Semitic","termine":"*gamal-","categoria":"non_precisato"}],"lontana":"sem-wes-pro","ambiti":["scienza"],"via":"","testo":"From Latin camēlus, from Ancient Greek κάμηλος (kámēlos), from a Semitic source, ultimately from Proto-West Semitic *gamal-.","origine_varieta":"la"},{"parola":"конус","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"cone","termine_origine":"cōnus","catena":[{"codice":"la","nome":"Latin","termine":"cōnus","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"κῶνος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"Mathematical term from Latin cōnus, a transliteration of Ancient Greek κῶνος (kônos, “pine cone”).","origine_varieta":"la"},{"parola":"лампа","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lamp","termine_origine":"lampas","catena":[{"codice":"la","nome":"Latin","termine":"lampas","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"λαμπάς","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Internationalism, ultimately from Latin lampas, from Ancient Gr