{"arrivo":"bg","origine":"fr","origine_nome":"French","livello2":"grc","livello2_nome":"Ancient Greek","n":7,"parole":[{"parola":"абак","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abacus","termine_origine":"abaque","catena":[{"codice":"fr","nome":"French","termine":"abaque","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἄβαξ","categoria":"non_precisato"}],"lontana":"grc","ambiti":["arte"],"via":"","testo":"Borrowed from French abaque, in turn from Ancient Greek ἄβαξ (ábax, “board”)."},{"parola":"аероплан","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"airplane","termine_origine":"aéroplane","catena":[{"codice":"fr","nome":"French","termine":"aéroplane","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾱ̓ερόπλᾰνος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from French aéroplane."},{"parola":"апсида","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"apse, apsis (a recess or projection, with a dome or vault, at the east end of a church)","termine_origine":"abside","catena":[{"codice":"fr","nome":"French","termine":"abside","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἁψίς","categoria":"prestito"}],"lontana":"grc","ambiti":["scienza","arte"],"via":"","testo":"Borrowed from French abside, ultimately from the oblique stem of Ancient Greek ἁψίς (hapsís, “vault, arch”) (gen. ἁψῖδος (hapsîdos)). Doublet of абси́да (absída)."},{"parola":"емфатичен","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"emphatic","termine_origine":"emphatique","catena":[{"codice":"fr","nome":"French","termine":"emphatique","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἐμφατικός","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from French emphatique, from Ancient Greek ἐμφατικό