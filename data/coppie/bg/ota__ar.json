ola":"халва","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"halva","termine_origine":"حلوا","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حلوا","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حَلْوَى","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish حلوا (halva, helva), from Arabic حَلْوَى (ḥalwā)."},{"parola":"халка","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ring, hoop","termine_origine":"حلقه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حلقه","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حَلْقَة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish حلقه (halka), from Arabic حَلْقَة (ḥalqa)."},{"parola":"хап","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pill, pellet","termine_origine":"حب","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حب","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"","categoria":"non_precisato"}],"lontana":"ar","ambiti":["scienza"],"via":"","testo":"Borrowed from Ottoman Turkish حب (“grain”) (whence Turkish hap, Greek χάπι (chápi)), of Arabic origin."},{"parola":"харамия","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bandit, ruffian, scoundrel, rebel, thief, robber","termine_origine":"حرامی","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حرامی","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"حَرَامِيّ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Cognate with Macedonian арамија (aramija), Serbo-Croatian haramija, хара̀мија, Hungarian haramia. Via Ottoman Turkish حرامی, all ultimately from Arabic حَرَامِيّ (ḥarāmiyy)."},{"parola":"харем","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"harem, seraglio","termine_origine":"حرم","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حرم","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حَرَم","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish حرم (harem), from Arabic حَرَم (ḥaram)."},{"parola":"харч","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"expenditure, expense, outlay (cost incurred for something)","termine_origine":"خرج","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"خرج","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"خَرْج","categoria":"prestito"}],"lontana":"ar","ambiti":["finanza"],"via":"","testo":"Borrowed from Ottoman Turkish خرج (harç), ultimately from Arabic خَرْج (ḵarj). It has been speculated that кръ́чма (krắčma, “tavern”) may be derived from an earlier loanword from the same Arabic source."},{"parola":"хисар","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fortified structure, citadel (usually built at hospitable location)","termine_origine":"حصار","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حصار","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حِصَار","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish حصار (hisar) ultimately from Arabic حِصَار (ḥiṣār, “restriction”)."},{"parola":"хъс","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"zeal, passion, drive, ambition, gumption, spunk, enthusiasm","termine_origine":"حرص","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حرص","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حِرْص","categoria":"prestito"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish حرص (hırs), borrowed from Arabic حِرْص (ḥirṣ)."},{"parola":"шериат","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shari'a","termine_origine":"شریعت","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"شریعت","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"شَرِيعَة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish شریعت (şeri'at), from Arabic شَرِيعَة (šarīʕa)."}]}