{"arrivo":"bg","origine":"el","origine_nome":"Greek","livello2":"ine-pro","livello2_nome":"Proto-Indo-European","n":3,"parole":[{"parola":"кефал","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"grey mullet, flathead mullet (Mugil cephalus)","termine_origine":"κέφαλος","catena":[{"codice":"el","nome":"Greek","termine":"κέφαλος","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gʰébʰōl","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Greek κέφαλος (kéfalos, “mullet; gray mullet”), from Ancient Greek κέφᾰλος (képhălos, “grey mullet”), ultimately from Proto-Indo-European *gʰébʰōl (“head”). Cognates include Turkish kefal, Russian кефа́ль (kefálʹ), Albanian qefull and Romanian chefal."},{"parola":"спатия","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"♣, the suit of clubs","termine_origine":"σπαθί","catena":[{"codice":"el","nome":"Greek","termine":"σπαθί","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["sport"],"via":"","testo":"Borrowed from Greek σπαθί (spathí). Via its Proto-Indo-European reconstruction, cognate with English spade."},{"parola":"хор","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"choir","termine_origine":"χορός","catena":[{"codice":"el","nome":"Greek","termine":"χορός","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ǵʰer-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["cucina"],"via":"","testo":"Borrowed from Greek χορός (chorós)."}]}