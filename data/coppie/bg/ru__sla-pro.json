":[],"via":"","testo":"Probably borrowed from Russian трус (trus), from Proto-Slavic *trǫsъ."},{"parola":"тяга","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pull, traction, draft (a pulling force or the force by which something is drawn, hauled, or moved)","termine_origine":"тя́га","catena":[{"codice":"ru","nome":"Russian","termine":"тя́га","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*tęga","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian тя́га (tjága), from Proto-Slavic *tęga or *tęgъ."},{"parola":"угроза","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"threat, imminence, menace","termine_origine":"угро́за","catena":[{"codice":"ru","nome":"Russian","termine":"угро́за","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*groza","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian угро́за (ugróza). By surface analysis, deverbal from угрозя́ (ugrozjá), ultimately from Proto-Slavic *groza."},{"parola":"упова","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to refer, to rely","termine_origine":"упова́ть","catena":[{"codice":"ru","nome":"Russian","termine":"упова́ть","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*upъvati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian упова́ть (upovátʹ), from Proto-Slavic *upъvati."},{"parola":"урожай","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"harvest, yield (usually rich, abundant)","termine_origine":"урожа́й","catena":[{"codice":"ru","nome":"Russian","termine":"урожа́й","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*uroďajь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["agricoltura"],"via":"","testo":"Borrowed from Russian урожа́й (urožáj), from Proto-Slavic *uroďajь. Morphologically equivalent to Bulgarian уро́дя (uródja, “to give birth”) (dialectal) + -яй (-jaj). Identical with outdated native Bulgarian урожда́й (uroždáj, “brood”)."},{"parola":"утроба","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"womb, uterus","termine_origine":"утро́ба","catena":[{"codice":"ru","nome":"Russian","termine":"утро́ба","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ǫtroba","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian утро́ба (utróba), from Proto-Slavic *ǫtroba. Synchronically analyzable as въ́тре (vắtre, “inside”) + -оба (-oba)."},{"parola":"хребет","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"crest (of a wave or hill)","termine_origine":"хребе́т","catena":[{"codice":"ru","nome":"Russian","termine":"хребе́т","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*xrьbьtъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian хребе́т (xrebét). Doublet of хръбе́т (hrăbét), obsolete form of Proto-Slavic *xrьbьtъ (“back”)."},{"parola":"част","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"part, piece, portion (of a whole)","termine_origine":"часть","catena":[{"codice":"ru","nome":"Russian","termine":"часть","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*čęstь","categoria":"non_precisato"},{"codice":"ine-bsl-pro","nome":"Proto-Balto-Slavic","termine":"*kanˀstei","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kanˀd-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from Russian часть (častʹ), from Proto-Slavic *čęstь. Partially displaced native дял (djal)."},{"parola":"чорт","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"devil, demon, fiend (an evil supernatural being; the Devil)","termine_origine":"чёрт","catena":[{"codice":"ru","nome":"Russian","termine":"чёрт","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*čьrtъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian чёрт (čort), from Proto-Slavic *čьrtъ."},{"parola":"чучело","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"effigy, dummy (a figure of a person made of straw, rags, or similar material)","termine_origine":"чу́чело","catena":[{"codice":"ru","nome":"Russian","termine":"чу́чело","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*čučelo","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian чу́чело (čúčelo), from Proto-Slavic *čučelo."},{"parola":"ядро","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kernel of a nut, pith of a stem","termine_origine":"ядро́","catena":[{"codice":"ru","nome":"Russian","termine":"ядро́","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ędro","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["militare","scienza","informatica"],"via":"","testo":"Borrowed from Russian ядро́ (jadró), from Proto-Slavic *ędro."}]}