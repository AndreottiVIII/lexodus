e":"sla-pro","nome":"Proto-Slavic","termine":"*listva","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian лиственница (listvennica). Formally derived from Proto-Slavic *listva (“leafage”) + -еница (-enica)."},{"parola":"ловък","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"agile, brisky","termine_origine":"ло́вкий","catena":[{"codice":"ru","nome":"Russian","termine":"ло́вкий","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*lovъkъ","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"According to BER, likely borrowed from Russian ло́вкий (lóvkij). Analyzable as лов (lov, “hunt”) + -ък (-ăk), from Proto-Slavic *lovъkъ."},{"parola":"лодка","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"boat (naval vessel)","termine_origine":"ло́дка","catena":[{"codice":"ru","nome":"Russian","termine":"ло́дка","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*oldī","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["mare"],"via":"","testo":"Borrowed from Russian ло́дка (lódka), itself derived from Proto-Slavic *aldьji + -ка (-ka). Doublet of лади́я (ladíja)."},{"parola":"лос","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"moose (male individual of genus Alces)","termine_origine":"лось","catena":[{"codice":"ru","nome":"Russian","termine":"лось","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*olsь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian лось (losʹ), from Proto-Slavic *olsь."},{"parola":"мерзък","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"vile, devilish, low","termine_origine":"ме́рзкий","catena":[{"codice":"ru","nome":"Russian","termine":"ме́рзкий","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*mьrzъkъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian ме́рзкий (mérzkij), formally reflecting Proto-Slavic *mьrzъkъ (“frosty, cold”) (probably originally meaning cold hearted). Related to Bulgarian мръ́зна (mrắzna, “to feel cold”) + -ък (-ăk)."},{"parola":"надменен","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"haughty, lofty, supercilious, overbearing","termine_origine":"надме́нный","catena":[{"codice":"ru","nome":"Russian","termine":"надме́нный","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*nadъmenъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian надме́нный (nadménnyj), itself derived from Proto-Slavic *nadъmenъ (“blown up”) + -ен (-en)."},{"parola":"негодяй","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"scoundrel, knave","termine_origine":"негодя́й","catena":[{"codice":"ru","nome":"Russian","termine":"негодя́й","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*negodějь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian негодя́й (negodjáj), from Proto-Slavic *negodějь. Morphologically equivalent to негоду́вам (negodúvam, “to resent; to rebel, revolt”) + -яй (-jaj). Akin to Czech Nehodiv (shortened from an earlier *Nehodejevo) - a village in Bohemia."},{"parola":"обиход","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"use, usage, circulation (practical use or general currency in speech, life, or society)","termine_origine":"обихо́д","catena":[{"codice":"ru","nome":"Russian","termine":"обихо́д","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*obixodъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian обихо́д (obixód), from Proto-Slavic *obixodъ."},{"parola":"обоз","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"baggage train, wagon train","termine_origine":"обо́з","catena":[{"codice":"ru","nome":"Russian","termine":"обо́з","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*obozъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from Russian обо́з (obóz), from Proto-Slavic *obozъ. Cognate with Czech oboz and Polish obóz."},{"parola":"опекун","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"guardian, custodian, trustee","termine_origine":"опеку́н","catena":[{"codice":"ru","nome":"Russian","termine":"опеку́н","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*opekunъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian опеку́н (opekún), from Proto-Slavic *opekunъ. By surface analysis, опе́ка (opéka) + -ун (-un)."},{"parola":"отбой","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"retreat signal (a military signal ordering troops to stop an action, withdraw, or cease an alarm or attack)","termine_origine":"отбо́й","catena":[{"codice":"ru","nome":"Russian","termine":"отбо́й","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*otъbojь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from Russian отбо́й (otbój), from Proto-Slavic *otъbojь."},{"parola":"отчет","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"report, account, statement","termine_origine":"отчёт","catena":[{"codice":"ru","nome":"Russian","termine":"отчёт","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*otъčьtъ","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian отчёт (otčót), from Proto-Slavic *otъčьtъ."},{"parola":"охота","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"desire, wish, inclination, willingness (inner readiness or desire to do something)","termine_origine":"охо́та","catena":[{"codice":"ru","nome":"Russian","termine":"охо́та","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*oxota","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian охо́та (oxóta), from Proto-Slavic *oxota."},{"parola":"площад","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"square, plaza","termine_origine":"пло́щадь","catena":[{"codice":"ru","nome":"Russian","termine":"пло́щадь","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ploščadь","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Russian пло́щадь (plóščadʹ). Morphologically formed as пло́сък (plósăk) + -яд (-jad)."},{"parola":"подъл","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"low, wicked, dishonest, vile, sneaky","termine_origine":"по́длый","catena":[{"codice":"ru","nome":"Russian","termine":"по́длый","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*podьlъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Probably borrowed from Russian по́длый (pódlyj), ultimately from Proto-Slavic *podьlъ."},{"parola":"портя","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to spoil, to ruin (to destroy the value of something)","termine_origine":"по́ртить","catena":[{"codice":"ru","nome":"Russian","termine":"по́ртить","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pъrtiti","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian по́ртить (pórtitʹ), ultimately from Proto-Slavic *pъrtiti."},{"parola":"порядък","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"order, cohesion","termine_origine":"поря́док","catena":[{"codice":"ru","nome":"Russian","termine":"поря́док","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*porędъkъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Russian поря́док (porjádok), from Proto-Slavic *porędъkъ. Formally a resultant of поре́ждам (poréždam, “to arrange”) + -ък (-ăk)."},{"parola":"посуда","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tableware, dishes, crockery, dishware, utensils (vessels and utensils used for eating, drinking, serving, or preparing…","termine_origine":"посу́да","catena":[{"codice":"ru","nome":"Russian","termine":"посу́да","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*posǫda","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian посу́да (posúda), from Proto-Slavic *posǫda."},{"parola":"потомък","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"descendant, offspring, issue (biological descendent of a person)","termine_origine":"пото́мок","catena":[{"codice":"ru","nome":"Russian","termine":"пото́мок","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*potomъkъ","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Russian пото́мок (potómok)."},{"parola":"прелест","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"allure, attractiveness, seductiveness","termine_origine":"пре́лесть","catena":[{"codice":"ru","nome":"Russian","termine":"пре́лесть","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*perlьstь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian пре́лесть (prélestʹ) (Church Slavonic loanword), ultimately from Proto-Slavic *perlьstь (“allure”). Compare Old Church Slavonic прѣльсть (prělĭstĭ, “trickery, deceit, allure”)."},{"parola":"приют","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shelter, refuge, haven (a place where someone finds protection, safety, or rest)","termine_origine":"прию́т","catena":[{"codice":"ru","nome":"Russian","termine":"прию́т","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*prijǫtъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian прию́т (prijút), from Proto-Slavic *prijǫtъ."},{"parola":"пружина","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"spring, coil spring (an elastic mechanical part that can be compressed, stretched, or bent and then return to its origi…","termine_origine":"пружи́на","catena":[{"codice":"ru","nome":"Russian","termine":"пружи́на","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*prǫžina","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian пружи́на (pružína), from Proto-Slavic *prǫžina."},{"parola":"ругая","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to scold, to rebuke, to malign, to curse","termine_origine":"руга́ть","catena":[{"codice":"ru","nome":"Russian","termine":"руга́ть","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*rǫgati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian руга́ть (rugátʹ), which is a doublet of ръга́я (răgája) (inherited), ultimately from Proto-Slavic *rǫgati. Superficially also resembles Bulgarian ръ́гам (rắgam, “to prod”), however, their semantics don't match exactly."},{"parola":"сажен","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"unit of length, equal to 7 feet","termine_origine":"са́жень","catena":[{"codice":"ru","nome":"Russian","termine":"са́жень","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sęženь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian са́жень (sáženʹ), from Proto-Slavic *sęženь (n-stem)."},{"parola":"самец","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"male animal","termine_origine":"саме́ц","catena":[{"codice":"ru","nome":"Russian","termine":"саме́ц","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*samьcь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian саме́ц (saméc), ultimately from Proto-Slavic *samьcь."},{"parola":"свиреп","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ferocious, savage","termine_origine":"свире́пый","catena":[{"codice":"ru","nome":"Russian","termine":"свире́пый","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sverěpъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian свире́пый (svirépyj), from Proto-Slavic *sverěpъ"},{"parola":"сволоч","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gang, riffraff, rabble of people","termine_origine":"сво́лочь","catena":[{"codice":"ru","nome":"Russian","termine":"сво́лочь","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sъvolčь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian сво́лочь (svóločʹ), from Proto-Slavic *sъvolčь."},{"parola":"смугъл","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"swarthy, dusky (having a darker or brownish complexion)","termine_origine":"сму́глый","catena":[{"codice":"ru","nome":"Russian","termine":"сму́глый","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*smǫglъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian сму́глый (smúglyj), from Proto-Slavic *smǫglъ."},{"parola":"спад","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"decline, drop, fall, decrease, reduction (a lowering or decrease in amount, level, value, intensity, or quantity)","termine_origine":"спад","catena":[{"codice":"ru","nome":"Russian","termine":"спад","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sъpadъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian спад (spad), from Proto-Slavic *sъpadъ. By surface analysis, с- (s-) + па́д (pád)"},{"parola":"способен","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"able, capable","termine_origine":"спосо́бный","catena":[{"codice":"ru","nome":"Russian","termine":"спосо́бный","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sъposobьnъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian спосо́бный (sposóbnyj), from Proto-Slavic *sъposobьnъ. By surface analysis, спо́соб (spósob, “manner, skill”) + -ен (-en)."},{"parola":"ставка","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"setup, standup","termine_origine":"ста́вка","catena":[{"codice":"ru","nome":"Russian","termine":"ста́вка","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*stàviti","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["sport"],"via":"","testo":"Borrowed from Russian ста́вка (stávka, “stake, bet; rate, tariff, wage rate”), from Russian ста́вить (stávitʹ, “to set, to place”), ultimately from Proto-Slavic *stàviti. Compare also the older spellings ставкъ, стафка noted in Bulgarian dictionaries."},{"parola":"стрепет","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"little bustard (Otis tetrax)","termine_origine":"стре́пет","catena":[{"codice":"ru","nome":"Russian","termine":"стре́пет","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sterpьtiti","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian стре́пет (strépet), probably related to Proto-Slavic *sterpьtiti (“to move suddenly, to trample”)."},{"parola":"считам","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to consider, to deem, to regard","termine_origine":"счи́тать","catena":[{"codice":"ru","nome":"Russian","termine":"счи́тать","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sъčitati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian счи́тать (sčítatʹ), from Proto-Slavic *sъčitati (“to regard, to consider”). By surface analysis, с- (s-) + читам (čitam)."},{"parola":"терзая","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to torment, to torture","termine_origine":"терза́ть","catena":[{"codice":"ru","nome":"Russian","termine":"терза́ть","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*tьrzati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian терза́ть (terzátʹ), from Proto-Slavic *tьrzati (“to pluck, to tear”). A doublet of natively inherited тъ́рзам (tắrzam)."},{"parola":"тлен","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"decay, rot, dust, ashes","termine_origine":"тлен","catena":[{"codice":"ru","nome":"Russian","termine":"тлен","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*tъlěnъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian тлен (t