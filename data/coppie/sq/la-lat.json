{"arrivo":"sq","origine":"la-lat","origine_nome":"Late Latin","n":27,"parole":[{"parola":"-eshë","pos":"suffix","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"forms female equivalents to male nouns. -ess","termine_origine":"-issa","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"-issa","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin -issa. Compare Romanian -easă, Italian -essa."},{"parola":"abis","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"abyss, deep","termine_origine":"abyssus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"abyssus","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin abyssus."},{"parola":"armë","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"weapon","termine_origine":"arma","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"arma","categoria":"latinismo_dotto"},{"codice":"it","nome":"Italian","termine":"arma","categoria":"prestito"}],"lontana":"it","ambiti":["militare"],"via":"","testo":"Borrowed from Late Latin arma (“weapon”). A later loan from Italian arma (“weapon”) is also plausible."},{"parola":"artist","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"artist (all senses)","termine_origine":"artista","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"artista","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"artiste","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ars","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Learned borrowing from Late Latin artista or French artiste, ultimately from Latin ars."},{"parola":"buf","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"Probably","significato":"owl","termine_origine":"būfus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"būfus","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Late Latin būfus (“owl”), probably of onomatopoeic origin; see also Ancient Greek βοῦφος (boûphos). Compare archaic Romanian buf, Spanish búho."},{"parola":"cikël","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"cycle","termine_origine":"cyclus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cyclus","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin cyclus."},{"parola":"drejtë","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"direct","termine_origine":"drictus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"drictus","categoria":"non_precisato"},{"codice":"dlm","nome":"Dalmatian","termine":"","categoria":"prestito"}],"lontana":"dlm","ambiti":[],"via":"","testo":"From Late Latin drictus, from Latin dīrēctus, through Dalmatian *draita, variant of drat."},{"parola":"fishkëllej","pos":"verb","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"to whistle","termine_origine":"fistulare","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"fistulare","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin fistulare (fiscla (“whistle”), Italian fischiare (“whistle”))."},{"parola":"gotë","pos":"noun","n_etimologia":2,"categoria":"latinismo_dotto","incerta":"no","significato":"Goths (Germanic tribe)","termine_origine":"Gothī","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"Gothī","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Learned borrowing from Late Latin Gothī."},{"parola":"gërshërë","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"scissors","termine_origine":"cīsōria","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cīsōria","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"With epenthetic -r- from variant gësherë, from Late Latin cīsōria, plural of cīsōrium (“shear, scissor”). Compare Italian cesoie (“shears”), French cisoires (“bench shears”)."},{"parola":"kalorës","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"knight","termine_origine":"caballāricius","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"caballāricius","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":["militare"],"via":"","testo":"From Late Latin or Vulgar Latin caballāricius, from Latin caballus (“horse”), whence Albanian kalë. Compare Aromanian cãlãrets, Romanian călăreț."},{"parola":"kukur","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"quiver (for arrows)","termine_origine":"cucurum","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cucurum","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"κούκουρον","categoria":"prestito"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Late Latin cucurum or Byzantine Greek κούκουρον (koúkouron). See Proto-Mongolic *kökexür for more."},{"parola":"kultër","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"pillow; cushion","termine_origine":"culcitra","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"culcitra","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin culcitra (“mattress, pillow”), itself a form of Latin culcita."},{"parola":"kutëndoj","pos":"verb","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"to thank","termine_origine":"contentāre","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"contentāre","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin contentāre."},{"parola":"kuçedër","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"hydra, seven-headed serpent","termine_origine":"celsydri","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"celsydri","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From kulshedër, from Late Latin celsydri, blend of Ancient Greek χέλυδρος (khéludros, “poisonous”) + χέρσυδρος (khérsudros, “amphibious snake”)."},{"parola":"murgeshë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"nun","termine_origine":"monāchus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"monāchus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"μοναχός","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"From murg + -eshë, and Tosk variant of Gheg mûng, from Late Latin monāchus, from Ancient Greek μοναχός (monakhós)."},{"parola":"oazë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"oasis","termine_origine":"Oasis","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"Oasis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"Ὄασις","categoria":"non_precisato"},{"codice":"egx-dem","nome":"Demotic Egyptian","termine":"wḥj","categoria":"non_precisato"},{"codice":"egy","nome":"Egyptian","termine":"wḥꜣt","categoria":"non_precisato"}],"lontana":"egy","ambiti":[],"via":"","testo":"Ultimately from Late Latin Oasis, from Ancient Greek Ὄασις (Óasis), from Demotic Egyptian wḥj, from Egyptian wḥꜣt (“oasis, cauldron”)."},{"parola":"ode","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ode: lyric poem or solemn song","termine_origine":"oda","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"oda","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾠδή","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Ultimately from Late Latin oda, from Ancient Greek ᾠδή (ōidḗ, “song”)."},{"parola":"parlament","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"parliament","termine_origine":"parlamentum","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"parlamentum","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Late Latin parlamentum."},{"parola":"pranverë","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"spring (season)","termine_origine":"prīma vēra","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"prīma vēra","categoria":"calco"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"A phonosemantic calque of Late Latin prīma vēra (“early spring”), using pranë (“near, close”) + verë (“summer”), the latter derived from Vulgar Latin *vēra (“spring”)."},{"parola":"pyll","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"forest, wood","termine_origine":"padulis","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"padulis","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"φύλλον","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"folium","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From an earlier *pëdyll, borrowed from Late Latin padūlem (“swamp”), from a metathesis of Latin palūdem. Compare Romanian pădure, which shows the same change in meaning. Compare also Italian padule, which keeps the Latin sense. Otherwise cognate or derived from Ancient Greek φύλλον (phúllon, “leaf”)"},{"parola":"quar","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"basement, cellar, stable (where animals are kept)","termine_origine":"cellārium","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cellārium","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Late Latin cellārium (“cellar, pantry”). For the ending compare hamshor, fruer, etc. Doublet of qilar. Discarded theories Meyer (1891) separately misidentifies Bardhi's chiuer a typographical mistake for qiler and hesitatingly compares qur with ahur. Jokl (1923) connects the word to de"},{"parola":"shparg","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"asparagus","termine_origine":"sparagus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"sparagus","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀσπάρᾰγος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Late Latin sparagus, from classical asparagus, from Ancient Greek ἀσπάραγος (aspáragos), a variant of ἀσφάραγος (aspháragos)."},{"parola":"shpretkë","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"spleen","termine_origine":"splēnēticus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"splēnēticus","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":["scienza"],"via":"","testo":"From Old Albanian shpënetkë, borrowed from Late Latin splēnēticus, from Latin splēn."},{"parola":"shqa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a Bulgarian (or generally any person of South Slavic ethnicity)","termine_origine":"sclavus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"sclavus","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"σκλάβος","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"From Late Latin sclavus or Sclavus, from Byzantine Greek σκλάβος (sklábos, “Slav”) or Σκλάβος (Sklábos). Compare Romanian șcheau (“Bulgarian, (South) Slav”), șchiau, Aromanian shcljau. Doublet of skllav (“slave”), a later borrowing."},{"parola":"vorfën","pos":"adj","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"poor (having little money)","termine_origine":"orfanus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"orfanus","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"ὀρφανός","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Late Latin orfanus, orphanus, from Ancient Greek ὀρφανός (orphanós). Compare Aromanian oarfãn, archaic Romanian oarfăn."},{"parola":"voshtër","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"privet","termine_origine":"óleaster","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"óleaster","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":["scienza"],"via":"","testo":"From Late Latin óleaster."}]}