nificato":"kitten","termine_origine":"ко́тел","catena":[{"codice":"bg","nome":"Bulgarian","termine":"ко́тел","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian ко́тел (kótel, “tomcat”), derivative of archaic кот (kot, “tomcat”)."},{"parola":"krekë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"field maple (Acer campestre)","termine_origine":"крека","catena":[{"codice":"bg","nome":"Bulgarian","termine":"крека","categoria":"prestito"}],"lontana":"bg","ambiti":["scienza"],"via":"","testo":"From dialectal Bulgarian крека (kreka)."},{"parola":"krinë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"swarm (of bees)","termine_origine":"кри́на","catena":[{"codice":"bg","nome":"Bulgarian","termine":"кри́на","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian кри́на (krína, “bushel”), compare Aromanian crinã (“bushel; beehive”), dialectal Greek κρίνα (krína, “beehive”)."},{"parola":"këllk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hip","termine_origine":"кълк","catena":[{"codice":"bg","nome":"Bulgarian","termine":"кълк","categoria":"prestito"},{"codice":"mk","nome":"Macedonian","termine":"колк","categoria":"prestito"}],"lontana":"mk","ambiti":["scienza"],"via":"","testo":"Borrowed from Bulgarian кълк (kălk) оr Macedonian колк (kolk) (\"hip\")."},{"parola":"lisën","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"wild thyme (Thymus serpyllum)","termine_origine":"лиса","catena":[{"codice":"bg","nome":"Bulgarian","termine":"лиса","categoria":"prestito"}],"lontana":"bg","ambiti":["scienza"],"via":"","testo":"Probably from Bulgarian лиса (lisa)."},{"parola":"sëpatë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; modello unc/uncertain","significato":"axe","termine_origine":"сапът","catena":[{"codice":"bg","nome":"Bulgarian","termine":"сапът","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sappata","categoria":"latinismo_dotto"},{"codice":"it","nome":"Italian","termine":"spada","categoria":"prestito"}],"lontana":"it","ambiti":[],"via":"","testo":"Uncertain. Orel suggests a borrowing from Bulgarian сапът (sapăt, “axe-handle”), which does not account for its prevalence in both dialects. Meyer suggest an indirect borrowing from Vulgar Latin *sappata from Latin sappa (“mattock”), comparing it with Romance descendants Italian zappa (“hoe”), Frenc"},{"parola":"vazhdë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; either","significato":"track made by feet or wheels","termine_origine":"*важдам","catena":[{"codice":"bg","nome":"Bulgarian","termine":"*важдам","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"From a South Slavic language, possibly from an Old Bulgarian *важдам (*važdam) (изваждам (izvaždam)), compare Old Church Slavonic важдати (važdati), either way an internal formation from Slavic vocabulary."},{"parola":"zhellvë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tortoise","termine_origine":"же́лва","catena":[{"codice":"bg","nome":"Bulgarian","termine":"же́лва","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian же́лва (žélva)."}]}