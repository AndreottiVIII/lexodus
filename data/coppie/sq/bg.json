{"arrivo":"sq","origine":"bg","origine_nome":"Bulgarian","n":23,"parole":[{"parola":"april","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"April","termine_origine":"апри́л","catena":[{"codice":"bg","nome":"Bulgarian","termine":"апри́л","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"aprile","categoria":"prestito"}],"lontana":"it","ambiti":[],"via":"","testo":"In Mandrica borrowed from Bulgarian апри́л (apríl) or Greek Απρίλιος (Aprílios). In Greci borrowed from Italian aprile. Doublet of prill."},{"parola":"belbicë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Ohrid trout","termine_origine":"белвица","catena":[{"codice":"bg","nome":"Bulgarian","termine":"белвица","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian белвица (belvica)."},{"parola":"bullkë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wife","termine_origine":"бу́лка","catena":[{"codice":"bg","nome":"Bulgarian","termine":"бу́лка","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian бу́лка (búlka)."},{"parola":"civik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"whey","termine_origine":"цвик","catena":[{"codice":"bg","nome":"Bulgarian","termine":"цвик","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian цвик (cvik). Doublet of cik."},{"parola":"cule","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Short, single- or double-barreled double-reed instrument with eight fingerholes. aulos, tibia","termine_origine":"","catena":[{"codice":"bg","nome":"Bulgarian","termine":"","categoria":"non_precisato"}],"lontana":"bg","ambiti":["musica"],"via":"","testo":"From Bulgarian [script needed] (surla), from Ottoman Turkish زورنا (zurna), ultimately from Persian زرنا (zornâ). Similar path with Romanian surla. A direct borrowing from Turkish is excluded due to u:y shift in some of the variants, and because the Turkish word has gone into Albanian as zurnë. An i"},{"parola":"djado","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"grandfather, grandpa","termine_origine":"дя́до","catena":[{"codice":"bg","nome":"Bulgarian","termine":"дя́до","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian дя́до (djádo)."},{"parola":"dune","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"quince","termine_origine":"дю́ля","catena":[{"codice":"bg","nome":"Bulgarian","termine":"дю́ля","categoria":"prestito"}],"lontana":"bg","ambiti":["cucina"],"via":"","testo":"Borrowed from Bulgarian дю́ля (djúlja), dialectal ду́ня (dúnja), compare Macedonian дуња (dunja)."},{"parola":"gatankë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"riddle","termine_origine":"га́танка","catena":[{"codice":"bg","nome":"Bulgarian","termine":"га́танка","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Bulgarian га́танка (gátanka), compare Macedonian гатанка (gatanka)."},{"parola":"gozhdë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"nail","termine_origine":"гвоздей","catena":[{"codice":"bg","nome":"Bulgarian","termine":"гвоздей","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*gvozdь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from a Slavic language, compare Serbo-Croatian gvozd (“nail”) and gvožđe (“iron”), Bulgarian гвоздей (gvozdej). Ultimately from Proto-Slavic *gvozdь (“nail”)."},{"parola":"hojnë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"juniper","termine_origine":"хво́йна","catena":[{"codice":"bg","nome":"Bulgarian","termine":"хво́йна","categoria":"prestito"}],