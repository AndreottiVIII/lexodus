{"arrivo":"sq","origine":"vec","origine_nome":"Venetan","n":36,"n_alternative":2,"parole":[{"parola":"ançua","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"anchovy (Engraulis encrasicholus)","termine_origine":"inciò","catena":[{"codice":"vec","nome":"Venetan","termine":"inciò","categoria":"prestito"},{"codice":"lij","nome":"Ligurian","termine":"anciôa","categoria":"non_precisato"}],"lontana":"lij","ambiti":[],"via":"","testo":"Borrowed from Venetan inciò, anciò, from Ligurian anciôa. Doublet of açugë and inçun."},{"parola":"badifokë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"skin pouch carrying flint and tinder (to light a fire), or tobacco","termine_origine":"batifogo","catena":[{"codice":"vec","nome":"Venetan","termine":"batifogo","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan batifogo (“firestriker”), with a semantic shift from the firestriker to the pouch containing it."},{"parola":"bagolinë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"birdsfoot trefoil (Lotus corniculatus)","termine_origine":"bagolina","catena":[{"codice":"vec","nome":"Venetan","termine":"bagolina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"baculum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Venetan bagolina, from Latin baculum (“staff”)."},{"parola":"bandill","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"handsome young boy","termine_origine":"bandido","catena":[{"codice":"vec","nome":"Venetan","termine":"bandido","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan bandido."},{"parola":"baticë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"high tide","termine_origine":"bataizza","catena":[{"codice":"vec","nome":"Venetan","termine":"bataizza","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan bataizza (“id.”)."},{"parola":"brushtull","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"heavily beaten sweet pastry made with wheat flour and butter","termine_origine":"brustola","catena":[{"codice":"vec","nome":"Venetan","termine":"brustola","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan brustola; cf. Greek μπρούστουλα (broústoula)."},{"parola":"bunacë","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lull, dead calm, calm sea","termine_origine":"bonazza","catena":[{"codice":"vec","nome":"Venetan","termine":"bonazza","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan bonazza. The meaning “darkness” comes from contamination of natë (“night”)."},{"parola":"cakull","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"little sack","termine_origine":"sacheta","catena":[{"codice":"vec","nome":"Venetan","termine":"sacheta","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"σάκκος","traslitterazione":"sákkos","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"A variant of canguletë, together with cangull, borrowed from Venetan sacheta. As a meaning, close to cakë and its derivates which come from Ancient Greek σάκκος (sákkos, “sack, bag; sackcloth”)."},{"parola":"canguletë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"small knapsack","termine_origine":"sacheta","catena":[{"codice":"vec","nome":"Venetan","termine":"sacheta","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan sacheta, with a colloquial epenthesis, similar to barakë -> barangë and some influence from kuletë."},{"parola":"cangull","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"little bag","termine_origine":"sacheta","catena":[{"codice":"vec","nome":"Venetan","termine":"sacheta","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"A variant of canguletë, together with cakull, borrowed from Venetan sacheta. Regional to Kastrati area in Northwest Albania."},{"parola":"copë","pos":"noun|adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"piece, part","termine_origine":"zopa","catena":[{"codice":"vec","nome":"Venetan","termine":"zopa","categoria":"prestito"}],"lontana":"vec","ambiti":["scienza"],"via":"","testo":"Borrowed from Venetan zopa (“clod”)."},{"parola":"fanellë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"undershirt","termine_origine":"fanela","catena":[{"codice":"vec","nome":"Venetan","termine":"fanela","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan fanela."},{"parola":"fugë","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"flame","termine_origine":"fogo","catena":[{"codice":"vec","nome":"Venetan","termine":"fogo","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan fogo (“fire”)."},{"parola":"fëdigë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"work","termine_origine":"fatigo","catena":[{"codice":"vec","nome":"Venetan","termine":"fatigo","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan fatigo."},{"parola":"garbi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"southwest wind, libeccio","termine_origine":"garbin","catena":[{"codice":"vec","nome":"Venetan","termine":"garbin","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"garbino","categoria":"prestito"}],"lontana":"it","ambiti":[],"via":"","testo":"Borrowed from Venetan garbin ~ Italian garbino. Less likely from Ottoman Turkish غربی (ğarbi, “western”), which lacks the nautical nuance."},{"parola":"gardalinë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"European goldfinch (Carduelis carduelis)","termine_origine":"gardełìn","catena":[{"codice":"vec","nome":"Venetan","termine":"gardełìn","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"cardellino","categoria":"prestito"}],"lontana":"it","ambiti":["scienza"],"via":"","testo":"From Venetan gardełìn or Italian cardellino."},{"parola":"gotë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"glass (for drinking)","termine_origine":"goto","catena":[{"codice":"vec","nome":"Venetan","termine":"goto","categoria":"prestito"}],"lontana":"vec","ambiti":["scienza"],"via":"","testo":"Borrowed from Venetan goto."},{"parola":"kajnacë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bolt for a door, window, drawer","termine_origine":"caenazzo","catena":[{"codice":"vec","nome":"Venetan","termine":"caenazzo","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan caenazzo; compare Italian catenaccio, from catena (“chain”)."},{"parola":"kanavacë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"canvas (cloth)","termine_origine":"canevazza","catena":[{"codice":"vec","nome":"Venetan","termine":"canevazza","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan canevazza (compare Italian canovaccio), related to canapa (“hemp”)."},{"parola":"kanavetë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"small chest for valuables","termine_origine":"canaveta","catena":[{"codice":"vec","nome":"Venetan","termine":"canaveta","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan canaveta."},{"parola":"kargatis","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to draw, stretch (string, cloth)","termine_origine":"cargar","catena":[{"codice":"vec","nome":"Venetan","termine":"cargar","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan cargar (“load”)."},{"parola":"karrige","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chair","termine_origine":"carega","catena":[{"codice":"vec","nome":"Venetan","termine":"carega","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cathedra","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"καθέδρα","traslitterazione":"kathédra","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Venetan carega, from Latin cathedra, from Ancient Greek καθέδρα (kathédra, “chair of a teacher, throne”)."},{"parola":"kornizë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"frame","termine_origine":"cornise","catena":[{"codice":"vec","nome":"Venetan","termine":"cornise","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan cornise."},{"parola":"kuzhinë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kitchen","termine_origine":"cusina","catena":[{"codice":"vec","nome":"Venetan","termine":"cusina","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"cocīna","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Venetan cusina, from Late Latin cocīna, from earlier coquīna."},{"parola":"lexoj","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to read","termine_origine":"lezer","catena":[{"codice":"vec","nome":"Venetan","termine":"lezer","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan lezer, compare Italian leggere."},{"parola":"noz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"large nut thrown in children games","termine_origine":"noxa","catena":[{"codice":"vec","nome":"Venetan","termine":"noxa","categoria":"prestito"}],"lontana":"vec","ambiti":["cucina"],"via":"","testo":"Borrowed from Venetan noxa (“walnut”)."},{"parola":"plëndës","pos":"noun|adv","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"stomach of animals, (in particular) rumen, paunch","termine_origine":"spienza","catena":[{"codice":"vec","nome":"Venetan","termine":"spienza","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan spienza (“milt”), through its earlier form splenza (14th c.), with contamination of pança (“belly”). The /d͡z/ ~ /t͡s/ was later, within Albanian, reanalysed as the -ës agent suffix on a dental stem, as perhaps may have been the case for rrëndës as well. For a parallel, compare"},{"parola":"porteg","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"porch, portico","termine_origine":"pòrtego","catena":[{"codice":"vec","nome":"Venetan","termine":"pòrtego","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan pòrtego ~ Italian portico. From Buzuku's orthography it is ambiguous whether the attested form represents portegj or porteq."},{"parola":"pupël","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pinfeather","termine_origine":"pùpoƚa","catena":[{"codice":"vec","nome":"Venetan","termine":"pùpoƚa","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan pùpoƚa; compare Greek πούπουλο (poúpoulo)."},{"parola":"rrugë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"road, street","termine_origine":"ruga","catena":[{"codice":"vec","nome":"Venetan","termine":"ruga","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rūga","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Venetan ruga (“furrow, path, street”), ultimately from Latin rūga (“wrinkle”)."},{"parola":"spirancë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"anchor","termine_origine":"speranza, speransa","catena":[{"codice":"vec","nome":"Venetan","termine":"speranza, speransa","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"Borrowed from Venetan speranza, speransa (“hope”) by the metaphor of the anchor being the last hope to a vessel; ultimately derived from Latin spīrantia."},{"parola":"trink","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"brand new","termine_origine":"novo de trinca","catena":[{"codice":"vec","nome":"Venetan","termine":"novo de trinca","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"nuovo di trinca","categoria":"non_precisato"}],"lontana":"it","ambiti":[],"via":"","testo":"Clipping of i ri trink, a semi-calque of Venetan novo de trinca, Italian nuovo di trinca. A derivative of trim + -kë is also possible."},{"parola":"velludhe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"velvet","termine_origine":"vełudo","catena":[{"codice":"vec","nome":"Venetan","termine":"vełudo","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan vełudo."},{"parola":"zbaticë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"low tide","termine_origine":"sbataizza","catena":[{"codice":"vec","nome":"Venetan","termine":"sbataizza","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan sbataizza (“id.”)."},{"parola":"capë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"alternatively; either","significato":"claw mattock","termine_origine":"zapa","catena":[{"codice":"vec","nome":"Venetan","termine":"zapa","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","alternative":[{"codice":"vec","nome":"Venetan","termine":"zapa","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"zappa","categoria":"prestito"}],"testo":"Either from Venetan zapa (“id.”) or Italian zappa (“id.”), from a late Latin sappa, from Illyrian, or alternatively from cap (“he-goat”), considering the resemblance of blades to the he-goat's horns. The presence of other meanings related to soil indicates a pre-Roman origin, thus resulting in the h"},{"parola":"fustan","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"alternatively","significato":"dress (item of clothing)","termine_origine":"fustagno","catena":[{"codice":"vec","nome":"Venetan","termine":"fustagno","categoria":"non_precisato"}],"lontana":"vec","ambiti":["moda"],"via":"","alternative":[{"codice":"gkm","nome":"Byzantine Greek","termine":"φουστάνιν","traslitterazione":"phoustánin","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"fustagno","categoria":"non_precisato"},{"codice":"vec","nome":"Venetan","termine":"fustagno","categoria":"non_precisato"}],"testo":"Borrowed from Byzantine Greek φουστάνιν (phoustánin). Alternatively, from Italian fustagno or Venetan fustagno (“fustian”)."}]}