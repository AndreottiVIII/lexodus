{"arrivo":"sq","origine":"grc","origine_nome":"Ancient Greek","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":6,"parole":[{"parola":"ardian","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Ardiaei","termine_origine":"Ἀρδιαῖοι","catena":[{"codice":"grc","nome":"Ancient Greek","termine":"Ἀρδιαῖοι","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Ardiaei","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Learned borrowing from Ancient Greek Ἀρδιαῖοι (Ardiaîoi) ~ Latin Ardiaei.","livello2_varieta":"la"},{"parola":"gamë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"range","termine_origine":"γάμμα","catena":[{"codice":"grc","nome":"Ancient Greek","termine":"γάμμα","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"gamma","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Ultimately from Ancient Greek γάμμα (gámma). Possibly through Medieval Latin gamma or through one of its descendants.","livello2_varieta":"la-med"},{"parola":"hutë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"vulture","termine_origine":"ὦτος","catena":[{"codice":"grc","nome":"Ancient Greek","termine":"ὦτος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"ōtus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Ancient Greek ὦτος (ôtos) or its descendant Latin ōtus.","livello2_varieta":"la"},{"parola":"javë","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"week","termine_origine":"ἑβδομάς","catena":[{"codice":"grc","nome":"Ancient Greek","termine":"ἑβδομάς","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"hebdomas","categoria":"non_precisato"},{"codice":"sqj-pro","nome":"Proto-Albanian","termine":"*avā","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂óyu","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Sometimes thought of as a loan from Ancient Greek ἑβδομάς (hebdomás), via Latin hebdomas, although this remains debated due to the unexplained loss of the syllable containing -má-. More likely from Proto-Albanian *avā, from Proto-Indo-European *h₂eyu- (“vital force”). Close to Latin aevum, Sanskrit ","livello2_varieta":"la"},{"parola":"lëpjetë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; perhaps","significato":"orach, dock (Rumex L.)","termine_origine":"λάπαθον","catena":[{"codice":"grc","nome":"Ancient Greek","termine":"λάπαθον","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"lapathum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Possibly borrowed from Ancient Greek λάπαθον (lápathon), perhaps via Latin lapathum, or derived from the same source as it.","livello2_varieta":"la"},{"parola":"psalënj","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to publish","termine_origine":"ψαλμός","catena":[{"codice":"grc","nome":"Ancient Greek","termine":"ψαλμός","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"psalmus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"From psaloj (“sing psalms”), ultimately from Ancient Greek ψαλμός (psalmós), via Latin psalmus.","livello2_varieta":"la"}]}