{"arrivo":"sq","origine":"mk","origine_nome":"Macedonian","n":18,"n_alternative":6,"parole":[{"parola":"ballgun","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Italian oak (Quercus frainetto)","termine_origine":"благун","termine_origine_traslitterazione":"blagun","catena":[{"codice":"mk","nome":"Macedonian","termine":"благун","traslitterazione":"blagun","categoria":"prestito"}],"lontana":"mk","ambiti":["scienza"],"via":"","testo":"From Macedonian благун (blagun), from благ (blag, “soft”)."},{"parola":"belot","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Italian buckthorn (Rhamnus alaternus)","termine_origine":"белотија","termine_origine_traslitterazione":"belotija","catena":[{"codice":"mk","nome":"Macedonian","termine":"белотија","traslitterazione":"belotija","categoria":"prestito"}],"lontana":"mk","ambiti":["scienza"],"via":"","testo":"From Macedonian белотија (belotija)."},{"parola":"borzilok","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"basil (Ocimum basilicum)","termine_origine":"босилок","termine_origine_traslitterazione":"bosilok","catena":[{"codice":"mk","nome":"Macedonian","termine":"босилок","traslitterazione":"bosilok","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"βασιλικόν","traslitterazione":"basilikón","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"From Macedonian босилок (bosilok), ultimately from Ancient Greek βασιλικόν (basilikón, “royal”)."},{"parola":"bërcel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"einkorn wheat (Triticum monococcum)","termine_origine":"пченица","termine_origine_traslitterazione":"pčenica","catena":[{"codice":"mk","nome":"Macedonian","termine":"пченица","traslitterazione":"pčenica","categoria":"prestito"}],"lontana":"mk","ambiti":["scienza"],"via":"","testo":"Possibly a suffixed formation