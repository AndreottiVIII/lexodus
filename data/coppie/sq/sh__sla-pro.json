{"arrivo":"sq","origine":"sh","origine_nome":"Serbo-Croatian","livello2":"sla-pro","livello2_nome":"Proto-Slavic","n":8,"parole":[{"parola":"boronicë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"blueberry (Vaccinium myrtillus)","termine_origine":"borovnica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"borovnica","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*borovъka","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Serbo-Croatian borovnica, with the regular -vn- > -n- change. Ultimately from Proto-Slavic *borovъka, a derivative of *borъ (“pine tree”), see Serbo-Croatian bor (“pine”). Compare Macedonian боровница (borovnica, “blueberry”) and боровинка (borovinka), as well as Polish borówka (“blueb"},{"parola":"buças","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"I let out a loud noise, thud, roar","termine_origine":"bučati","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"bučati","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*bučati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian bučati (“to make a loud noise, roar”), ultimately derived from Proto-Slavic *bučati (“to roar, thud”)."},{"parola":"bërllog","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trash, garbage (chiefly Kosovo Albanian)","termine_origine":"brlog","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"brlog","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*bьrlogъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian brlog (“dregs; lair”), from Proto-Slavic *bьrlogъ (“den, cave”). Compare Bulgarian бърлога (bărloga), Romanian bârlog (“den”), Hungarian barlang (“cave, den”)."},{"parola":"dremit","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to sleep, drowse","termine_origine":"drémati","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"drémati","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*drěmati","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian drémati, from Proto-Slavic *drěmati, from Proto-Indo-European *drēm-ye-ti, from *drem- (“to sleep”)."},{"parola":"drugë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"spindle, distaff","termine_origine":"drȕga//дру̏га","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"drȕga//дру̏га","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*drǫgъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian drȕga /дру̏га, drȗg /дру̑г, from Proto-Slavic *drǫgъ (“bar, pole”)."},{"parola":"fllad","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"breeze","termine_origine":"hlad","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"hlad","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*xoldъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from a South Slavic language, likely Serbo-Croatian hlad (“shade”); ultimately from Proto-Slavic *xoldъ (“cold”)."},{"parola":"ubël","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"well in the mountains, especially for livestock","termine_origine":"ȕbao//у̏бао","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"ȕbao//у̏бао","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ǫbьlъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian ȕbao /у̏бао, genitive ȗbla /у̑бла, from Proto-Slavic *ǫbьlъ (“well”)."},{"parola":"zhapi","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lizard","termine_origine":"žȁbica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"žȁbica","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*žaba","categoria":"prestito"}],"lontana":"sla-pro","ambiti":["scienza"],"via":"","testo":"From variant zhapik, from Serbo-Croatian žȁbica (“small frog or toad”), diminutive from Proto-Slavic *žaba (“toad, frog”)."}]}