{"arrivo":"sq","origine":"it","origine_nome":"Italian","livello2":"la","livello2_nome":"Latin","n":12,"parole":[{"parola":"autore","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"author","termine_origine":"autore","catena":[{"codice":"it","nome":"Italian","termine":"autore","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"auctor","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian autore."},{"parola":"evident","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"evident","termine_origine":"evidente","catena":[{"codice":"it","nome":"Italian","termine":"evidente","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ēvidentem","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian evidente, from earlier Latin ēvidentem."},{"parola":"fabrikë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"factory, part of a combine","termine_origine":"fabbrica","catena":[{"codice":"it","nome":"Italian","termine":"fabbrica","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fabrica","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed through Italian fabbrica from Latin fabrica. Compare the earlier borrowing farkë (“forge”), with regular loss of word-internal /b/ before /r/."},{"parola":"frutë","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"fruit","termine_origine":"frutta","catena":[{"codice":"it","nome":"Italian","termine":"frutta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fructus","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Probably borrowed from Italian frutta, from Latin fructus. Doublet of fryt, an earlier borrowing through Vulgar Latin."},{"parola":"Gjermani","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the german (male person) (definite form of gjerman (“german”))","termine_origine":"Germania","catena":[{"codice":"it","nome":"Italian","termine":"Germania","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Germānia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian Germania."},{"parola":"letër","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"paper","termine_origine":"lettera","catena":[{"codice":"it","nome":"Italian","termine":"lettera","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"littera","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian lettera, ultimately from Latin littera."},{"parola":"mjeshtër","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"master, professional","termine_origine":"maestro","catena":[{"codice":"it","nome":"Italian","termine":"maestro","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"magister","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Albanian mjeshtrë (Buzuku, Matrënga), an early borrowing from Italian maestro (“teacher, master”) (*mai̯estro > *mëjés'trë > mjéshtrë), from Latin magister (“teacher, master”)."},{"parola":"nepotizëm","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"favouritism that the pope would show towards his family and friends with church funds","termine_origine":"nepotismo","catena":[{"codice":"it","nome":"Italian","termine":"nepotismo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nepōs","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian nepotismo, from earlier Latin nepōs."},{"parola":"qartë","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"clear","termine_origine":"chiaro","catena":[{"codice":"it","nome":"Italian","