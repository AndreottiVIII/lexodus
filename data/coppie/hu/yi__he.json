{"arrivo":"hu","origine":"yi","origine_nome":"Yiddish","livello2":"he","livello2_nome":"Hebrew","n":14,"parole":[{"parola":"córesz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tsuris, problem, trouble","termine_origine":"צרות","catena":[{"codice":"yi","nome":"Yiddish","termine":"צרות","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"צרה","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish צרות (tsores), plural of צרה (tsore, “trouble”), from Hebrew צרה (tsará, “narrow”)."},{"parola":"gój","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"goy (a non-Jew)","termine_origine":"גוי","catena":[{"codice":"yi","nome":"Yiddish","termine":"גוי","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"גּוֹי","categoria":"non_precisato"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"From Yiddish גוי (goy, “gentile”), from Hebrew גּוֹי (goi, “nation”)."},{"parola":"haver","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pal, buddy, dude","termine_origine":"חבֿר","catena":[{"codice":"yi","nome":"Yiddish","termine":"חבֿר","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"חבר","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish חבֿר (khaver), from Hebrew חבר (khaver, “friend”)."},{"parola":"herót","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"disgust (with/by someone or something: -tól/-től)","termine_origine":"חרטה","catena":[{"codice":"yi","nome":"Yiddish","termine":"חרטה","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"חֲרָטָה","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"From earlier heróte, from Yiddish חרטה (kharote, “regret”), from Hebrew חֲרָטָה (kharatá)."},{"parola":"jesiva","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"yeshiva","termine_origine":"ישיבה","catena":[{"codice":"yi","nome":"Yiddish","termine":"ישיבה","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"יְשִׁיבָה","categoria":"non_precisato"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"From Yiddish ישיבה (yeshive), from Hebrew יְשִׁיבָה (y'shivá, “sitting”)."},{"parola":"kóser","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kosher","termine_origine":"כּשר","catena":[{"codice":"yi","nome":"Yiddish","termine":"כּשר","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"כשר","categoria":"non_precisato"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"Borrowed from Yiddish כּשר (kosher), from Hebrew כשר (kasher, “fit, proper, lawful”)."},{"parola":"majré","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"fright","termine_origine":"מורא","catena":[{"codice":"yi","nome":"Yiddish","termine":"מורא","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"מורא","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"From Yiddish מורא (moyre), from Hebrew מורא (mora', “fear”)."},{"parola":"meló","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"work","termine_origine":"מלאָכה","catena":[{"codice":"yi","nome":"Yiddish","termine":"מלאָכה","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"מלאכה","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"de","testo":"From Yiddish מלאָכה (melokhe, “work”), from Hebrew מלאכה (melakah, “work”). Perhaps via German Maloche. First attested in 1877."},{"parola":"mázli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fluke (a lucky or improbable occurrence, with the implication that the occurrence could not be repeated)","termine_origine":"מזל","catena":[{"codice":"yi","nome":"Yiddish","termine":"מזל","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"מַזָּל","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish מזל (mazl, “luck”), from Hebrew מַזָּל (mazál). Suffixed with -i to resolve the word-final consonant cluster, compare cetli from Bavarian zettl or German Zettel (/⁠ˈt͡sɛtl̩⁠/) etc."},{"parola":"mísz","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bored, moody, unwelcoming","termine_origine":"מיאוס","catena":[{"codice":"yi","nome":"Yiddish","termine":"מיאוס","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"מִאוּס","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish מיאוס (mies), from Hebrew מִאוּס."},{"parola":"pajesz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"earlock (of orthodox Jews)","termine_origine":"פּאות","catena":[{"codice":"yi","nome":"Yiddish","termine":"פּאות","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"פאה","categoria":"non_precisato"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"Borrowed from Yiddish פּאות (peyes), from Hebrew פֵּאָה (pe'á, “corner”)."},{"parola":"samesz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a synagogue servant; a shammes","termine_origine":"שמשׂ","catena":[{"codice":"yi","nome":"Yiddish","termine":"שמשׂ","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"שַׁמָּשׁ","categoria":"non_precisato"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"Borrowed from Yiddish שמשׂ (shames, “servant of the synagogue”), from Hebrew שַׁמָּשׁ (shamásh, “servant”)."},{"parola":"srác","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"boy","termine_origine":"schraz","catena":[{"codice":"yi","nome":"Yiddish","termine":"schraz","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"שֶׁרֶץ","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"From Yiddish schraz, from Hebrew שֶׁרֶץ (“creeping thing”). First attested in 1888."},{"parola":"sóher","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"poor (with little or no money)","termine_origine":"שחור","catena":[{"codice":"yi","nome":"Yiddish","termine":"שחור","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"שחור//שָׁחֹר","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"schocher","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Yiddish שחור (shokher, “black”), from Hebrew שחור /שָׁחֹר (shakhór, “black”), possibly through German schocher (used in argot), having the same semantic shift of “black” → “poor” as occurred with schwarz."}]}