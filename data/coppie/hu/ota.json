":"imam","termine_origine":"امام","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"امام","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"إِمَام","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish امام (imam), from Arabic إِمَام (ʔimām, “leader, imam”)."},{"parola":"iszlám","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Islamic","termine_origine":"اسلام","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"اسلام","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"إِسْلَام","categoria":"non_precisato"}],"lontana":"ar","ambiti":["religione"],"via":"","testo":"From Ottoman Turkish اسلام (islâm), from Arabic إِسْلَام (ʔislām, “submission”)."},{"parola":"janicsár","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"janissary (soldier in an elite Turkish guard)","termine_origine":"یڭیچری","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"یڭیچری","categoria":"prestito"},{"codice":"sh","nome":"Serbo-Croatian","termine":"janjičar","categoria":"non_precisato"}],"lontana":"sh","ambiti":["militare"],"via":"","testo":"Borrowed from Ottoman Turkish یڭیچری (yeñiçeri, “new troops”), perhaps via Serbo-Croatian janjičar."},{"parola":"jasmak","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yashmak","termine_origine":"یاشمق","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"یاشمق","categoria":"prestito"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"From Ottoman Turkish یاشمق (yaşmak, “veil”, literally “to hide”). Modern Turkish spelling is yaşmak."},{"parola":"jatagán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yataghan","termine_origine":"یتاغان","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"یتاغان","categoria":"prestito"},{"codice":"trk-pro","nome":"P