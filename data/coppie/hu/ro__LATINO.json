{"arrivo":"hu","origine":"ro","origine_nome":"Romanian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":12,"parole":[{"parola":"berbécs","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ram (a male sheep), wether (a castrated ram)","termine_origine":"berbec","catena":[{"codice":"ro","nome":"Romanian","termine":"berbec","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"vervex","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Romanian berbec (“ram”), ultimately from Vulgar Latin vervex (“wether, ram”). First attested in 1423.","livello2_varieta":"la-vul"},{"parola":"ficsúr","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dandy, fop, dude","termine_origine":"fecior","catena":[{"codice":"ro","nome":"Romanian","termine":"fecior","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fetiolus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Romanian fecior, dialectal ficior (“boy, lad”), from Vulgar Latin *fetiolus (“child, boy”), from Latin fētus (“bringing forth, offspring”). Spelling influenced by úr.","livello2_varieta":"la-vul"},{"parola":"fáta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Romanian girl","termine_origine":"fată","catena":[{"codice":"ro","nome":"Romanian","termine":"fată","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fēta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Romanian fată (“girl, daughter”), from Latin fēta, feminine of fētus (“bringing forth, offspring”).","livello2_varieta":"la"},{"parola":"lej","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"leu (currency of Romania)","termine_origine":"lei","catena":[{"codice":"ro","nome":"Romanian","termine":"lei","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"leō","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"Borrowed from Romanian lei, plural of leu (“leu”) (literally, \"lion\"), from Latin leō (“lion”).","livello2_varieta":"la"},{"parola":"lestyán","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"lovage (Levisticum officinale)","termine_origine":"leuștean","catena":[{"codice":"ro","nome":"Romanian","termine":"leuștean","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"levisticum","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Romanian leuștean, probably a borrowing of Hungarian lesten, variant of obsolete levestikom, from Late Latin levisticum (“lovage”), probably an alteration of Latin ligusticum (“Ligurian”).","livello2_varieta":"la-lat"},{"parola":"pakulár","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shepherd","termine_origine":"păcurar","catena":[{"codice":"ro","nome":"Romanian","termine":"păcurar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pecorarius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Romanian păcurar (“shepherd”), itself from Latin Latin pecorarius (“shepherd”). First attested in 1568.","livello2_varieta":"la"},{"parola":"pakura","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"mazut, crude oil, fuel oil","termine_origine":"păcură","catena":[{"codice":"ro","nome":"Romanian","termine":"păcură","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"picula","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Romanian păcură (“oil, tar”), from Late Latin picula, diminutive of Latin pix (“pitch, tar”).","livello2_varieta":"la-lat"},{"parola":"palacsinta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pancake, crêpe (thin batter cake)","termine_origine":"plăcintă","catena":[{"codice":"ro","nome":"Romanian","termine":"plăcintă","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"placenta","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"πλακόεντα","categoria":"prestito"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"Borrowed from Romanian plăcintă, from Latin placenta (“cake”).","livello2_varieta":"la"},{"parola":"poronty","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"kid, brat","termine_origine":"prunc","catena":[{"codice":"ro","nome":"Romanian","termine":"prunc","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Romanian prunc (“infant, baby”), from Late Latin *puerunculus (\"small child\"), from Latin puer (“boy”).","livello2_varieta":"la-lat"},{"parola":"pulya","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; perhaps; modello unc/uncertain","significato":"faint, chicken-hearted, cowardly","termine_origine":"pui","catena":[{"codice":"ro","nome":"Romanian","termine":"pui","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pullus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Uncertain, perhaps from Romanian pui (“chicken, young of an animal, a child”), from Latin pullus (“young of an animal”).","livello2_varieta":"la"},{"parola":"román","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Romanian (of, from, or relating to Romania, its people or language)","termine_origine":"român","catena":[{"codice":"ro","nome":"Romanian","termine":"român","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Rōmānus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Romanian român (“Romanian”), from Latin Rōmānus (“Roman”).","livello2_varieta":"la"},{"parola":"tokány","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Strips of meat stewed on fried onion, black pepper and marjoram. A kind of \"pörkölt\" that does not contain paprika and…","termine_origine":"tocană","catena":[{"codice":"ro","nome":"Romanian","termine":"tocană","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["cucina"],"via":"","testo":"From Romanian tocană (“meat stew, goulash”), from toca (“to chop, mince”), from Vulgar Latin *toccare (“to knock, strike”).","livello2_varieta":"la-vul"}]}