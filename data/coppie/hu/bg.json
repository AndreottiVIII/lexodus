{"arrivo":"hu","origine":"bg","origine_nome":"Bulgarian","n":11,"n_alternative":3,"parole":[{"parola":"diák","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"student","termine_origine":"","catena":[{"codice":"bg","nome":"Bulgarian","termine":"","categoria":"non_precisato"},{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"διάκος","traslitterazione":"diákos","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Bulgarian or Serbo-Croatian loanword, compare Bulgarian dialectal дяк (djak, “pupil, deacon”), Serbo-Croatian đak (“pupil”), archaic dijak (“scribe”), from Byzantine Greek διάκος (diákos, “deacon”). Doublet of deák."},{"parola":"ladik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"punt, boat (a flat-bottomed boat used mainly in rivers or lakes)","termine_origine":"ла́дийка","termine_origine_traslitterazione":"ládijka","catena":[{"codice":"bg","nome":"Bulgarian","termine":"ла́дийка","traslitterazione":"ládijka","categoria":"prestito"}],"lontana":"bg","ambiti":["mare"],"via":"","testo":"Borrowed from dialectal Bulgarian ла́дийка (ládijka), diminutive of ла́дия (ládija, “boat”)."},{"parola":"mostoha","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"step- (parent, child, or sibling)","termine_origine":"ма́щеха","termine_origine_traslitterazione":"mášteha","catena":[{"codice":"bg","nome":"Bulgarian","termine":"ма́щеха","traslitterazione":"mášteha","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*maťexa","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Bulgarian ма́щеха (mášteha, “stepmother”), from Proto-Slavic *maťexa."},{"parola":"padlizsán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aubergine, eggplant","termine_origine":"патладжан","t