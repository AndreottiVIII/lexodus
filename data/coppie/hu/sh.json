{"arrivo":"hu","origine":"sh","origine_nome":"Serbo-Croatian","n":60,"n_alternative":10,"parole":[{"parola":"apát","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abbot (the superior or head of an abbey or monastery)","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"opat","categoria":"prestito"},{"codice":"goh","nome":"Old High German","termine":"abbat","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"abbas","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀββᾶς","traslitterazione":"abbâs","categoria":"non_precisato"},{"codice":"arc","nome":"Aramaic","termine":"אבא","traslitterazione":"’abbā","categoria":"non_precisato"}],"lontana":"arc","ambiti":["religione"],"via":"","testo":"A loanword of debated origin: # Borrowed from Serbo-Croatian or Slovene opat (“abbot”). # Borrowed from Old High German abbat (“abbot”), from Latin abbas (“father”), from Ancient Greek ἀββᾶς (abbâs) In both cases, ultimately from Aramaic אבא (’abbā, “father”)."},{"parola":"baj","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trouble, matter, problem","termine_origine":"boj","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"boj","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian boj (“battle”)."},{"parola":"bajnok","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"champion (an ongoing winner in a game or contest)","termine_origine":"bȏjnīk","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"bȏjnīk","categoria":"non_precisato"}],"lontana":"sh","ambiti":["sport"],"via":"","testo":"From Serbo-Croatian bȏjnīk (“duelist”)."},{"parola":"betyár","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"highwayman, outlaw","termine_origine":"bećar","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"bećar","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"بكار","traslitterazione":"bekâr","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"بِكْر","traslitterazione":"bikr","categoria":"prestito"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowing from Serbo-Croatian bećar, from Ottoman Turkish بیكار (bekâr, “bachelor”), from Classical Persian بیکَار (bēkār, “unemployed, idle, vagabond”)."},{"parola":"boroszlán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"daphne (any plant of the genus Daphne)","termine_origine":"brstan//bršljan","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"brstan//bršljan","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian brstan /bršljan. Compare zászló and poroszló for the sound change /st/ > /sl/. First attested in 1783."},{"parola":"bosnyák","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Bosnian (of, or relating to Bosnia, its people or language)","termine_origine":"Bošnjak","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"Bošnjak","categoria":"non_precisato"}],"lontana":"sh","ambiti":[],"via":"","testo":"From Serbo-Croatian Bošnjak (“Bosniak”)."},{"parola":"burnót","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"snuff (finely ground or pulverized tobacco)","termine_origine":"burnut","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"burnut","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"بورون اوتی","traslitterazione":"burun otu","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"From Serbo-Croatian burnut, from Ottoman Turkish بورون اوتی (burun otu, “snuff”), from بورون (burun, “nose”) + اوت (ot, “grass”)."},{"parola":"csata","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"battle","termine_origine":"četa","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"četa","categoria":"prestito"}],"lontana":"sh","ambiti":["militare"],"via":"","testo":"Borrowed from Serbo-Croatian četa (“troop, squad”). First attested in 1532."},{"parola":"csatorna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"canal","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian. Compare čatrnja (“cistern”)."},{"parola":"csizma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"boot","termine_origine":"čizma","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"čizma","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"چزمه","traslitterazione":"çizme","categoria":"non_precisato"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"Borrowed from Serbo-Croatian čizma, from Ottoman Turkish چزمه (çizme, “boot”)."},{"parola":"csizmadia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bootmaker","termine_origine":"čizmedžija","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"čizmedžija","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"چیزمهجی","traslitterazione":"çizmeci","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian čizmedžija, from Ottoman Turkish چیزمهجی (çizmeci, “bootmaker”), from چیزمه (çizme, “boot”) + ـجی (-ci, suffix denoting a profession or occupation)."},{"parola":"dalia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hero, valiant knight","termine_origine":"delija","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"delija","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"دلی","traslitterazione":"deli","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian delija (“brave man; hero, soldier; Turkish bodyguard”), from Ottoman Turkish دلی (deli, “mad, insane; the grand vizier's Bosnian or Albanian bodyguard”). Modern Turkish spelling is deli. Doublet of deli."},{"parola":"duttyán","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"food stall","termine_origine":"dućan","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"dućan","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"دكان","traslitterazione":"dükkân","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"دُكَّان","traslitterazione":"dukkān","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Serbo-Croatian dućan, from Ottoman Turkish دكان (dükkân), from Arabic دُكَّان (dukkān, “shop”)."},{"parola":"gatya","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"baggy peasant knickerbockers","termine_origine":"gaće","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"gaće","categoria":"prestito"}],"lontana":"sh","ambiti":["moda"],"via":"","testo":"Borrowed from Serbo-Croatian gaće (“drawers”)."},{"parola":"golyva","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"goitre (enlargement of the front and sides of the neck caused by inflammation of the thyroid gland)","termine_origine":"gljiva","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"gljiva","categoria":"prestito"}],"lontana":"sh","ambiti":["scienza"],"via":"","testo":"First attested in 1228. Borrowed from Serbo-Croatian gljiva."},{"parola":"grabanc","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; perhaps; modello unc/uncertain","significato":"collar","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"non_precisato"}],"lontana":"sh","ambiti":["moda"],"via":"","testo":"Uncertain. Perhaps from Serbo-Croatian, compare grabac (“plumber”), from grabiti (“to grab, seize”)."},{"parola":"guzlica","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gusle (single-stringed musical instrument)","termine_origine":"guslice","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"guslice","categoria":"prestito"}],"lontana":"sh","ambiti":["musica"],"via":"","testo":"Borrowed from Serbo-Croatian guslice pl (“gusle”), from gȕsle /гу̏сле pl (“gusle”). First attested in 1836. Doublet of guszla."},{"parola":"hajdina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buckwheat (an Asian plant, of the species Fagopyrum esculentum)","termine_origine":"hajdina","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"hajdina","categoria":"prestito"},{"codice":"bar","nome":"Bavarian","termine":"haidn","categoria":"non_precisato"}],"lontana":"bar","ambiti":[],"via":"","testo":"First attested in 1495. Borrowed from Serbo-Croatian hajdina, from Bavarian haidn."},{"parola":"haramia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bandit, highwayman, ruffian, reaver, robber","termine_origine":"haramija","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"haramija","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"حرامی","traslitterazione":"harâmi","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"حَرَامِيّ","traslitterazione":"ḥarāmiyy","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Serbo-Croatian haramija (“bandit, thief, robber”), from Ottoman Turkish حرامی (harâmi), from Arabic حَرَامِيّ (ḥarāmiyy)."},{"parola":"huszár","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hussar","termine_origine":"gusar","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"gusar","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"corsaro","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"cursārius","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ker-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["militare","sport"],"via":"","testo":"From Serbo-Croatian gusar (“corsair”), from Italian corsaro (“corsair”), from Medieval Latin cursārius (“pirate”), from Latin cursus (“running”), from currō (“run”), from Proto-Indo-European *ker- (“to run”)."},{"parola":"jugoszláv","pos":"adj|noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"Yugoslavian, Yugoslav (of or relating to Yugoslavia)","termine_origine":"Jugoslaven","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"Jugoslaven","categoria":"calco"}],"lontana":"sh","ambiti":[],"via":"","testo":"Partial calque of Serbo-Croatian Jugoslaven, jug (“south”) + Slaven (“Slav”)."},{"parola":"kamat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"interest (the price of credit)","termine_origine":"kamata","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kamata","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"κάματος","traslitterazione":"kámatos","categoria":"non_precisato"}],"lontana":"grc","ambiti":["finanza"],"via":"","testo":"Borrowed from Serbo-Croatian kamata, from Ancient Greek κάματος (kámatos)."},{"parola":"kukac","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"maggot (soft, legless larva of a fly or other dipterous insect)","termine_origine":"kúkac","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kúkac","categoria":"prestito"}],"lontana":"sh","ambiti":["informatica"],"via":"","testo":"From Kajkavian Serbo-Croatian kúkac (“insect”)."},{"parola":"kukorica","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"maize, corn (a type of grain of the species Zea mays)","termine_origine":"kukuruz","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kukuruz","categoria":"non_precisato"},{"codice":"ro","nome":"Romanian","termine":"cucuruz","categoria":"non_precisato"}],"lontana":"ro","ambiti":["cucina"],"via":"","testo":"Via Serbo-Croatian kukuruz or Romanian cucuruz, perhaps in the form kukuriz + -ka. First attested in 1691."},{"parola":"kunyhó","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; perhaps; modello unc/uncertain","significato":"hut, cottage, hovel, cabin, shack (a roughly built, simple dwelling)","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"Uncertain. Perhaps borrowed from Serbo-Croatian."},{"parola":"kupac","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"small heap, pile","termine_origine":"kúpac","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kúpac","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian kúpac (“small pile (dialectal)”), from Serbo-Croatian kup (“heap”)."},{"parola":"kupica","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a stemless shot glass, usually smaller than 50 ml","termine_origine":"купица//kupica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"купица//kupica","categoria":"prestito"}],"lontana":"sh","ambiti":["cucina"],"via":"","testo":"Borrowed from Serbo-Croatian купица /kupica (“noggin, small cup”), from ку̏па /kȕpa (“cup, goblet”). See also Slovene kupica (“drinking glass”). Doublet of kupa. First attested in 1725–1764."},{"parola":"kúp","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cone","termine_origine":"kup","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kup","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"kup","categoria":"prestito"}],"lontana":"sl","ambiti":["scienza"],"via":"","testo":"Borrowed from Serbo-Croatian kup and Slovene kup. First attested in 1713."},{"parola":"lucfenyő","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"spruce (tree from the genus Picea)","termine_origine":"luč","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"luč","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"luc + fenyő (fir), from earlier (currently obsolete) and dialectal lucs, lúcs, probably from Serbo-Croatian luč (“torch; fir”), referring to the fact that this fir was used to make torches. The current spelling is a result of misreading, since cz in lucz was also used in the 16–17th centuries to den"},{"parola":"mangalica","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Mangalica (domestic lard pig of a Hungarian breed, which grows a thick, curly coat of hair)","termine_origine":"mangulica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"mangulica","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"First attested in 1791. Borrowed from Serbo-Croatian mangulica (“a type of lard pig”)."},{"parola":"martalóc","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"marauder, freebooter","termine_origine":"martòloz","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"martòloz","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"مارتولوز","traslitterazione":"martoloz","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"αμαρτωλός","traslitterazione":"amartolós","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"From Serbo-Croatian martòloz, from Ottoman Turkish مارتولوز (martoloz, “Christian soldier in the Ottoman army”)(compare Turkish martolos), from Greek αμαρτωλός (amartolós, “sinner”)."},{"parola":"muhar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Any of a group of various types of grass of genus Setaria","termine_origine":"muhar","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"muhar","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"From Serbo-Croatian muhar, derivative of muha (“fly”)."},{"parola":"olasz","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Italian (of, from, or relating to Italy, its people or language)","termine_origine":"Vlah","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"Vlah","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*volxъ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*walhaz","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"Volcae","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian Vlah (“Romanian”, dialectally “Italian, Latin”), Vlasi pl, from Proto-Slavic *volxъ, ultimately from Proto-Germanic *walhaz (“foreigner”), from Latin Volcae (the name of a Celtic tribe). See also the doublet oláh and Polish Włochy, with a similar origin."},{"parola":"orgovány","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lilac shrub","termine_origine":"jorgovan","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"jorgovan","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"ارغوان","traslitterazione":"ergavân, erguvân","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"ارغوان","traslitterazione":"arġavân, arġuvân","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"From Serbo-Croatian jorgovan (“lilac”), from Ottoman Turkish ارغوان (ergavân, erguvân), from Persian ارغوان (arġavân, arġuvân, “purple; Judas tree”)."},{"parola":"paprika","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"paprika (spice)","termine_origine":"pàprika","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"pàprika","categoria":"prestito"}],"lontana":"sh","ambiti":["cucina"],"via":"","testo":"Borrowed from Serbo-Croatian pàprika."},{"parola":"paszuly","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"synonym of bab, haricot, common bean, bean (the plant and its crop)","termine_origine":"pasulj","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"pasulj","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"φασόλι","traslitterazione":"fasóli","categoria":"non_precisato"}],"lontana":"el","ambiti":["cucina"],"via":"","testo":"From Serbo-Croatian pasulj, from Greek φασόλι (fasóli, “bean”), from Ancient Greek φάσηλος (phásēlos, “kidney bean”)."},{"parola":"pazarol","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to squander, waste (to spend or use something carelessly; on something: -ra/-re)","termine_origine":"pazariti","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"pazariti","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"پازار","traslitterazione":"pazar","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"بازار","traslitterazione":"bâzâr","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"From Serbo-Croatian pazariti (“to shop”) + -ol (verb-forming suffix); from pazar (“bazaar, market”), from Ottoman Turkish پازار (pazar), from Persian بازار (bâzâr, “bazaar, market”). Its stem is a doublet of bazár and vásár."},{"parola":"pokol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hell","termine_origine":"pakao","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"pakao","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"pekel","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pьkъlъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["religione"],"via":"","testo":"From Serbo-Croatian pakao or Slovene pekel. From Proto-Slavic *pьkъlъ."},{"parola":"pribék","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"henchman","termine_origine":"prebjeg","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"prebjeg","categoria":"non_precisato"}],"lontana":"sh","ambiti":[],"via":"","testo":"From Serbo-Croatian prebjeg (“deserter”), from pre- prefix + bijeg (“escape”)."},{"parola":"rekettye","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"broom (any plant of the genus Genista)","termine_origine":"rakitje","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"rakitje","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"rakitje","categoria":"prestito"}],"lontana":"sl","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian rakitje or Slovene rakitje. First attested in 1181."},{"parola":"rusnya","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ugly","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"First attested in c. 1468. Borrowed from Serbo-Croatian."},{"parola":"sapka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"beanie","termine_origine":"šapka","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"šapka","categoria":"prestito"}],"lontana":"sh","ambiti":["moda"],"via":"","testo":"Borrowed from Serbo-Croatian šapka (“hat”)."},{"parola":"strázsa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"sentinel, sentry, guard","termine_origine":"straža","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"straža","categoria":"non_precisato"}],"lontana":"sh","ambiti":["militare"],"via":"","testo":"From Serbo-Croatian straža (“guard”)."},{"parola":"szekerce","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hatchet, axe, ax","termine_origine":"sekirica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"sekirica","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sěkyra","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"securis","categoria":"non_precisato"}],"lontana":"la","ambiti":["militare"],"via":"","testo":"From Serbo-Croatian sekirica (“hatchet”) (literally, \"small axe\"), diminutive of sekira (“axe”), from Proto-Slavic *sěkyra, itself from Latin securis."},{"parola":"tambura","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tambura (a long-necked lute-like stringed instrument)","termine_origine":"tambura","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"tambura","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"طنبوره","traslitterazione":"tanbura","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"تنبور","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"طُنْبُور","traslitterazione":"ṭunbūr","categoria":"non_precisato"}],"lontana":"ar","ambiti":["musica"],"via":"","testo":"From Serbo-Croatian tambura, from Ottoman Turkish طنبوره (tanbura), from Persian تنبور. Compare Arabic طُنْبُور (ṭunbūr)."},{"parola":"tunya","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Of uncertain origin; perhaps; modello unc/uncertain","significato":"lazy, sluggish","termine_origine":"stúnja","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"stúnja","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","testo":"First attested in 1381. Of uncertain origin. Perhaps borrowed from Serbo-Croatian stúnja."},{"parola":"tákol","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to knock up (to put together hastily or without effective equipment)","termine_origine":"tȁk","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"tȁk","categoria":"non_precisato"},{"codice":"sl","nome":"Slovene","termine":"","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"tacco","categoria":"non_precisato"}],"lontana":"it","ambiti":[],"via":"","testo":"From Serbo-Croatian tȁk/та̏к (“shoe heel”) or Slovene, itself from Italian tacco + -ol (“verb-forming suffix”)."},{"parola":"verbuvál","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to recruit (to supply with new men, as an army)","termine_origine":"verbovati","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"verbovati","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"werben","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Serbo-Croatian verbovati, from German werben (“to recruit”). With the verb-forming suffix -ál."},{"parola":"zsizsik","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"weevil","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"non_precisato"},{"codice":"sl","nome":"Slovene","termine":"","categoria":"non_precisato"}],"lontana":"sl","ambiti":[],"via":"","testo":"Borrowed Serbo-Croatian or Slovene, compare Serbo-Croatian žížak, dialectal žižek, Slovene žižek (“weevil”)."},{"parola":"zászló","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"flag, standard, banner, ensign (piece of cloth, often decorated with an emblem, used as a visual signal or symbol)","termine_origine":"zastava","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"zastava","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"zastava","categoria":"prestito"}],"lontana":"sl","ambiti":["scienza"],"via":"","testo":"Probably borrowed from Serbo-Croatian zastava or Slovene zastava. For the sound change /st/ > /sl/, compare poroszló and boroszlán. Compare Slovak zástava. First attested in 1086."},{"parola":"apáca","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from; either","significato":"nun (member of a nunnery)","termine_origine":"opàtica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"opàtica","categoria":"non_precisato"}],"lontana":"sh","ambiti":["religione"],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"opàtica","categoria":"non_precisato"},{"codice":"sl","nome":"Slovene","termine":"opatica","categoria":"non_precisato"},{"codice":"goh","nome":"Old High German","termine":"appātissā","categoria":"non_precisato"}],"testo":"Either from a South Slavic language, either Serbo-Croatian opàtica or Slovene opatica, or from Old High German appātissā. First attested in 1256."},{"parola":"bula","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Of uncertain origin; Possibly; alternatively; modello unc/uncertain","significato":"(woman's) ass, buttocks or vulva","termine_origine":"бу̏ла//bȕla","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"бу̏ла//bȕla","categoria":"non_precisato"}],"lontana":"sh","ambiti":[],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"бу̏ла//bȕla","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"بولا","traslitterazione":"bola, bula","categoria":"non_precisato"},{"codice":"rom","nome":"Romani","termine":"bulǎ","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"बुलि","traslitterazione":"buli","categoria":"non_precisato"}],"testo":"Of uncertain origin. Possibly related to the archaic bulya (“Turkish woman; concubine”), from Serbo-Croatian бу̏ла /bȕla (“a Muslim woman in harem pants or covered with a headscarf; a married woman”), from Ottoman Turkish بولا (bola, bula, “wife of one’s paternal uncle; lady, miss”). Alternatively, "},{"parola":"bérmál","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"either","significato":"to confirm (to administer the sacrament of confirmation on someone)","termine_origine":"","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"prestito"}],"lontana":"sh","ambiti":["religione"],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"","categoria":"prestito"}],"testo":"From either Serbo-Croatian [Term?] or Slovene [Term?]. Compare Czech biřmovat and Polish bierzmować. First attested in 1519. With the verb-forming suffix -ál."},{"parola":"cirok","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"either","significato":"sorghum (Sorghum, especially Sorghum bicolor)","termine_origine":"sirak","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"sirak","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"sirak","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"sirek","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"sorgo","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(granum) syricum","categoria":"non_precisato"}],"testo":"Borrowed from either Serbo-Croatian sirak or Slovene sirek, from Italian sorgo, from Latin (granum) syricum (“Syrian grain”). The word-initial consonant became affricated from sz to c. First attested in 1465."},{"parola":"kabóca","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from; either","significato":"cicada","termine_origine":"kobilica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kobilica","categoria":"non_precisato"}],"lontana":"sh","ambiti":[],"via":"","alternative":[{"codice":"sl","nome":"Slovene","termine":"kobilica","categoria":"non_precisato"},{"codice":"sh","nome":"Serbo-Croatian","termine":"kobilica","categoria":"non_precisato"}],"testo":"Either from Slovene kobilica (“locust”), from kobila (“mare”) or from Serbo-Croatian kobilica (“mare”)."},{"parola":"kár","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"damage, loss, detriment","termine_origine":"kvar","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kvar","categoria":"non_precisato"}],"lontana":"sh","ambiti":[],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kvar","categoria":"non_precisato"},{"codice":"sl","nome":"Slovene","termine":"kvar","categoria":"non_precisato"}],"testo":"Borrowed from either a Serbo-Croatian kvar or Slovene kvar."},{"parola":"megye","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"county, shire (administrative region of a country)","termine_origine":"međa","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"međa","categoria":"non_precisato"}],"lontana":"sh","ambiti":[],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"međa","categoria":"non_precisato"},{"codice":"sl","nome":"Slovene","termine":"meja","categoria":"non_precisato"}],"testo":"Either from Serbo-Croatian međa (“border, boundary”) or Slovene meja (“border, boundary”). First attested in 1055."},{"parola":"palást","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"cloak, mantle, robe, pall, cope (a long outer garment worn over the shoulders covering the back)","termine_origine":"plašt","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"plašt","categoria":"prestito"}],"lontana":"sh","ambiti":["scienza","moda"],"via":"","alternative":[{"codice":"bg","nome":"Bulgarian","termine":"плащ","traslitterazione":"plašt","categoria":"prestito"},{"codice":"sh","nome":"Serbo-Croatian","termine":"plašt","categoria":"prestito"}],"testo":"Borrowed from Bulgarian плащ (plašt) or from Serbo-Croatian plašt."},{"parola":"parittya","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"either","significato":"sling (an instrument for throwing stones or other missiles)","termine_origine":"praća","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"praća","categoria":"prestito"}],"lontana":"sh","ambiti":["militare","scienza","diritto_politica"],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"praća","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"práča","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*porťa","categoria":"non_precisato"}],"testo":"Borrowed from either Serbo-Croatian praća or Slovene práča, from Proto-Slavic *porťa (“sling”)."},{"parola":"viasz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"either","significato":"wax (a substance of animal or vegetable origin, consisting of fatty acids and alcohol, with a greasy sheen and feel, ma…","termine_origine":"vosak","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"vosak","categoria":"prestito"}],"lontana":"sh","ambiti":[],"via":"","alternative":[{"codice":"sh","nome":"Serbo-Croatian","termine":"vosak","categoria":"prestito"},{"codice":"sl","nome":"Slovene","termine":"vosek","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*voskъ","categoria":"non_precisato"}],"testo":"Either from Serbo-Croatian vosak (“wax”) or Slovene vosek (“wax”). Ultimately from Proto-Slavic *voskъ."}]}