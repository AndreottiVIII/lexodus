{"arrivo":"hu","origine":"sh","origine_nome":"Serbo-Croatian","livello2":"ota","livello2_nome":"Ottoman Turkish","n":11,"parole":[{"parola":"betyár","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"highwayman, outlaw","termine_origine":"bećar","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"bećar","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"بكار","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"بِكْر","categoria":"prestito"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowing from Serbo-Croatian bećar, from Ottoman Turkish بیكار (bekâr, “bachelor”), from Classical Persian بیکَار (bēkār, “unemployed, idle, vagabond”)."},{"parola":"burnót","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"snuff (finely ground or pulverized tobacco)","termine_origine":"burnut","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"burnut","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"بورون اوتی","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"From Serbo-Croatian burnut, from Ottoman Turkish بورون اوتی (burun otu, “snuff”), from بورون (burun, “nose”) + اوت (ot, “grass”)."},{"parola":"csizma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"boot","termine_origine":"čizma","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"čizma","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"چزمه","categoria":"non_precisato"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"Borrowed from Serbo-Croatian čizma, from Ottoman Turkish چزمه (çizme, “boot”)."},{"parola":"csizmadia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bootmaker","termine_origine":"čizmedžija","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"čizmedžija","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"چیزمهجی","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian čizmedžija, from Ottoman Turkish چیزمهجی (çizmeci, “bootmaker”), from چیزمه (çizme, “boot”) + ـجی (-ci, suffix denoting a profession or occupation)."},{"parola":"dalia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hero, valiant knight","termine_origine":"delija","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"delija","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"دلی","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian delija (“brave man; hero, soldier; Turkish bodyguard”), from Ottoman Turkish دلی (deli, “mad, insane; the grand vizier's Bosnian or Albanian bodyguard”). Modern Turkish spelling is deli. Doublet of deli."},{"parola":"duttyán","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"food stall","termine_origine":"dućan","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"dućan","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"دكان","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"دُكَّان","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Serbo-Croatian dućan, from Ottoman Turkish دكان (dükkân), from Arabic دُكَّان (dukkān, “shop”)."},{"parola":"haramia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bandit, highwayman, ruffian, reaver, robber","termine_origine":"haramija","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"haramija","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"حرامی","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"حَرَامِيّ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Serbo-Croatian haramija (“bandit, thief, robber”), from Ottoman Turkish حرامی (harâmi), from Arabic حَرَامِيّ (ḥarāmiyy)."},{"parola":"martalóc","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"marauder, freebooter","termine_origine":"martòloz","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"martòloz","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"مارتولوز","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"αμαρτωλός","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"From Serbo-Croatian martòloz, from Ottoman Turkish مارتولوز (martoloz, “Christian soldier in the Ottoman army”)(compare Turkish martolos), from Greek αμαρτωλός (amartolós, “sinner”)."},{"parola":"orgovány","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lilac shrub","termine_origine":"jorgovan","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"jorgovan","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"ارغوان","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"ارغوان","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"From Serbo-Croatian jorgovan (“lilac”), from Ottoman Turkish ارغوان (ergavân, erguvân), from Persian ارغوان (arġavân, arġuvân, “purple; Judas tree”)."},{"parola":"pazarol","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to squander, waste (to spend or use something carelessly; on something: -ra/-re)","termine_origine":"pazariti","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"pazariti","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"پازار","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"بازار","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"From Serbo-Croatian pazariti (“to shop”) + -ol (verb-forming suffix); from pazar (“bazaar, market”), from Ottoman Turkish پازار (pazar), from Persian بازار (bâzâr, “bazaar, market”). Its stem is a doublet of bazár and vásár."},{"parola":"tambura","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tambura (a long-necked lute-like stringed instrument)","termine_origine":"tambura","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"tambura","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"طنبوره","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"تنبور","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"طُنْبُور","categoria":"non_precisato"}],"lontana":"ar","ambiti":["musica"],"via":"","testo":"From Serbo-Croatian tambura, from Ottoman Turkish طنبوره (tanbura), from Persian تنبور. Compare Arabic طُنْبُور (ṭunbūr)."}]}