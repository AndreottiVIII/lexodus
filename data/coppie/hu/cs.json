{"arrivo":"hu","origine":"cs","origine_nome":"Czech","n":11,"parole":[{"parola":"birka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sheep","termine_origine":"","catena":[{"codice":"cs","nome":"Czech","termine":"","categoria":"prestito"}],"lontana":"cs","ambiti":[],"via":"","testo":"First attested in 1347. Of debated origin: * A native word. * Borrowed from Czech."},{"parola":"cseh","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Czech (of or pertaining to the Czech Republic, its people or language)","termine_origine":"Čech","catena":[{"codice":"cs","nome":"Czech","termine":"Čech","categoria":"prestito"}],"lontana":"cs","ambiti":[],"via":"","testo":"Borrowing from Czech Čech (“Czech”)."},{"parola":"csésze","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cup (a concave vessel for drinking from)","termine_origine":"číše","catena":[{"codice":"cs","nome":"Czech","termine":"číše","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*čaša","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech číše (“cup”), from Proto-Slavic *čaša."},{"parola":"komorna","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lady's maid, abigail","termine_origine":"","catena":[{"codice":"cs","nome":"Czech","termine":"","categoria":"non_precisato"},{"codice":"sk","nome":"Slovak","termine":"komorná","categoria":"non_precisato"},{"codice":"cs","nome":"Czech","termine":"komora","categoria":"non_precisato"}],"lontana":"cs","ambiti":[],"via":"","testo":"From Czech or Slovak komorná (“maid”), from Czech komora (“chamber”)."},{"parola":"komornyik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"butler","termine_origine":"","catena":[{"codice":"cs","nome":"Czech","termine":"","categoria":"prestito"},{"codice":"sk","nome":"Slovak","termine":"komorník","categoria":"prestito"}],"lontana":"sk","ambiti":[],"via":"","testo":"From Czech or Slovak komorník (“butler”)."},{"parola":"kuka","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"garbage can, trash can, refuse bin (especially an outdoor container)","termine_origine":"","catena":[{"codice":"cs","nome":"Czech","termine":"","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Via Czech, from German KUKA, short for Keller und Knappich Augsburg, a German firm which manufactured and supplied orange refuse collection vehicles. Today the company KUKA produces industrial robots and automation technologies."},{"parola":"parázna","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"lecherous, lewd, adulterous (characterized by unchastity)","termine_origine":"prázdná žena","catena":[{"codice":"cs","nome":"Czech","termine":"prázdná žena","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*porzdьnъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Probably borrowed from obsolete Czech prázdná žena (“prostitute”), from Proto-Slavic *porzdьnъ (“empty, void, vain”), compare Polish dom próżny (“brothel”), originally as a noun in Hungarian."},{"parola":"poloska","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stinkbug (Heteroptera)","termine_origine":"","catena":[{"codice":"cs","nome":"Czech","termine":"","categoria":"prestito"},{"codice":"sk","nome":"Slovak","termine":"","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Wanze","categoria":"calco"},{"codice":"en","nome":"English","termine":"bug","categoria":"calco"}],"lontana":"en","ambiti":["militare","diritto_politica"],"via":"","testo":"From Czech or Slovak, compare Czech dialectal ploščka, ploška, plošťka (standard ploštice⁽ᶜˢ⁾), from Czech and Slovak ploský (“flat”). A Slovak form exactly corresponding to Hungarian may have existed but is not attested (cf. Slovak ploštica⁽ˢᵏ⁾). The sense “intercept device” is a calque of German W"},{"parola":"ramaty","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"wretched, rubbishy","termine_origine":"","catena":[{"codice":"cs","nome":"Czech","termine":"","categoria":"non_precisato"}],"lontana":"cs","ambiti":[],"via":"","testo":"Probably a Czech loanword, compare dialectal ramotí (“junk, trash”)."},{"parola":"robot","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"socage, forced labour","termine_origine":"robot","catena":[{"codice":"cs","nome":"Czech","termine":"robot","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*orbota","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"From Bavarian robat, robold, from Czech robota (“forced labour, drudgery”)."},{"parola":"robot","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"robot","termine_origine":"robot","catena":[{"codice":"cs","nome":"Czech","termine":"robot","categoria":"non_precisato"}],"lontana":"cs","ambiti":[],"via":"","testo":"From Czech robot, from robota (“forced labour, drudgery”). Coined in the 1921 science-fiction play R.U.R. (Rossum's Universal Robots) by Karel Čapek."}]}