{"arrivo":"fi","origine":"krl","origine_nome":"Karelian","n":15,"n_alternative":1,"parole":[{"parola":"feresi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sarafan (long, sleeveless, trapeze-shaped traditional jumper dress worn as Karelian folk costume by women and girls)","termine_origine":"feresi","catena":[{"codice":"krl","nome":"Karelian","termine":"feresi","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"ферезь","traslitterazione":"ferezʹ","categoria":"non_precisato"}],"lontana":"ru","ambiti":[],"via":"","testo":"From Karelian feresi, from Russian ферезь (ferezʹ)."},{"parola":"kepeät mullat","pos":"phrase","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"rest in peace","termine_origine":"","catena":[{"codice":"krl","nome":"Karelian","termine":"","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"пусть земля будет пухом","traslitterazione":"pustʹ zemlja budet puxom","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"sit tibi terra levis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Literally translates as light earth/soil, probably through Karelian from Russian пусть земля будет пухом (pustʹ zemlja budet puxom), ultimately from Latin sit tibi terra levis (“may the earth rest lightly on you”)."},{"parola":"kyly","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"synonym of sauna (“sauna”)","termine_origine":"kyly","catena":[{"codice":"krl","nome":"Karelian","termine":"kyly","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","testo":"Probably from Karelian kyly."},{"parola":"käspaikka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rushnyk, especially a Karelian rushnyk","termine_origine":"käspaikka","catena":[{"codice":"krl","nome":"Karelian","termine":"käspaikka","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","testo":"From Karelian käspaikka, equivalent to käs- + paikka."},{"parola":"lanssi","pos":"noun","n_etimologia":3,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"lancers (traditional dance, particularly the Karelian and Ingrian forms of it)","termine_origine":"lanssi","catena":[{"codice":"krl","nome":"Karelian","termine":"lanssi","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"лансье","traslitterazione":"lansʹje","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"lancier","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Probably from Karelian lanssi, from Russian лансье (lansʹje), from French (quadrille des) lanciers."},{"parola":"neiyt","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"maiden, unmarried girl","termine_origine":"neiyt","catena":[{"codice":"krl","nome":"Karelian","termine":"neiyt","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","testo":"Borrowed from Karelian neiyt."},{"parola":"nuoriso","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"youth (collectively)","termine_origine":"nuoriso","catena":[{"codice":"krl","nome":"Karelian","termine":"nuoriso","categoria":"non_precisato"}],"lontana":"krl","ambiti":[],"via":"","testo":"nuori (“young”) + -iso. Coined by Finnish physician and philologist Elias Lönnrot in 1835, possibly after Karelian nuoriso."},{"parola":"peruuttaa","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"to back, back up, reverse; (nautical) to go astern","termine_origine":"peruuttua","catena":[{"codice":"krl","nome":"Karelian","termine":"peruuttua","categoria":"non_precisato"}],"lontana":"krl","ambiti":[],"via":"","testo":"perua (“to withdraw, take back”) + -uuttaa. Coined by Finnish physician and philologist Elias Lönnrot in 1880, possibly after dialectal Karelian peruuttua."},{"parola":"räkkä","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"In the summer of Lapland, the period of vast number of blood-sucking insects.","termine_origine":"räkkä","catena":[{"codice":"krl","nome":"Karelian","termine":"räkkä","categoria":"non_precisato"}],"lontana":"krl","ambiti":[],"via":"","testo":"Akin to räkittää; possibly from Karelian räkkä."},{"parola":"seikka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"thing, matter, circumstance, factor, consideration","termine_origine":"šeikka","catena":[{"codice":"krl","nome":"Karelian","termine":"šeikka","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","testo":"Borrowed from Karelian šeikka."},{"parola":"serkku","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cousin, first cousin","termine_origine":"šeukku","catena":[{"codice":"krl","nome":"Karelian","termine":"šeukku","categoria":"non_precisato"}],"lontana":"krl","ambiti":[],"via":"","testo":"Likely developed from an earlier seukku (with contamination from sirkku (“(dialectal) sister”), derived from sisar), from Karelian šeukku (compare sevoitar), derived from setä."},{"parola":"sorokka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a kind of traditional Karelian women's scarf-like hat made of linen","termine_origine":"sorokka","catena":[{"codice":"krl","nome":"Karelian","termine":"sorokka","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","testo":"From Karelian sorokka."},{"parola":"tsasouna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"An Eastern Orthodox village chapel.","termine_origine":"časoun’a","catena":[{"codice":"krl","nome":"Karelian","termine":"časoun’a","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"часо́вня","traslitterazione":"časóvnja","categoria":"non_precisato"}],"lontana":"ru","ambiti":[],"via":"","testo":"From Karelian časoun’a, from Russian часо́вня (časóvnja)."},{"parola":"tsupukka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a Karelian dish, somewhat similar to a Karelian pasty, but entirely closed with the filling (usually porridge) left ins…","termine_origine":"čupukka","catena":[{"codice":"krl","nome":"Karelian","termine":"čupukka","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","testo":"Borrowed from Karelian čupukka."},{"parola":"tokko","pos":"adv|conj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably; alternatively","significato":"I don't think, hardly (used to express doubt, often with softening clitic -pa or -han)","termine_origine":"toko","catena":[{"codice":"krl","nome":"Karelian","termine":"toko","categoria":"prestito"}],"lontana":"krl","ambiti":[],"via":"","alternative":[{"codice":"krl","nome":"Karelian","termine":"toko","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"токо́","traslitterazione":"tokó","categoria":"non_precisato"}],"testo":"Originates from eastern dialects; probably as a loan from Karelian toko, from dialectal Russian токо́ (tokó); alternatively from toki + -ko."}]}