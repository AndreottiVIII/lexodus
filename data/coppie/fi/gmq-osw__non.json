{"arrivo":"fi","origine":"gmq-osw","origine_nome":"Old Swedish","livello2":"non","livello2_nome":"Old Norse","n":26,"parole":[{"parola":"ankkuri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"anchor (tool to hook a vessel into the seabed)","termine_origine":"","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"akkeri","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*ankurô","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"ancora","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare","finanza","scienza","arte","informatica","sport"],"via":"","testo":"Borrowed from Old Swedish [Term?] (whence Swedish ancker, a variant of ankare; compare Old Swedish ankæri, ankar; perhaps adapted with -uri), ultimately from Old Norse akkeri, from Proto-Germanic *ankurô, itself ultimately from Latin ancora."},{"parola":"jaarli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"earl","termine_origine":"iarl","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"iarl","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"jarl","categoria":"non_precisato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛖᚱᛁᛚᚨᛉ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*erlaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Old Swedish iarl, from Old Norse jarl, from Proto-Norse ᛖᚱᛁᛚᚨᛉ (erilaʀ), from Proto-Germanic *erlaz."},{"parola":"jatuli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of a race of giants.","termine_origine":"*iatul","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"*iatul","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"jǫtunn","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Old Swedish *iatul (compare Old Swedish iætun, Norwegian jøtul), from Old Norse jǫtunn."},{"parola":"katu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"street (paved part of road in a village or a town, especially one bordered by pavements or sidewalks)","termine_origine":"gata","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"gata","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"gata","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*gatwǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Old Swedish gata, from Old Norse gata, from Proto-Germanic *gatwǭ."},{"parola":"korppi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"common raven, Corvus corax","termine_origine":"korper","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"korper","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"korpr","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Old Swedish korper (compare Swedish korp), from Old Norse korpr. Displaced kaarne."},{"parola":"kuori","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"chancel, apse (space around the altar in a church)","termine_origine":"kor","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"kor","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"kórr","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"chorus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Swedish kor, through Old Norse kórr from Latin chorus. Doublet of kuoro."},{"parola":"kyyti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ride, lift (act of transporting someone in a vehicle)","termine_origine":"skiut","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"skiut","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"skjótr","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Old Swedish skiut (compare Swedish skjuts), from Old Norse skjótr."},{"parola":"laari","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"storage bin (especially for grain or other agricultural produce)","termine_origine":"lar","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"lar","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"lár","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Old Swedish lar (compare modern Swedish lår), from Old Norse lár. Akin to Russian ларь (larʹ) (also borrowed from Old Swedish or Old Norse)."},{"parola":"laki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"act (a specific legal statute, inferior to a constitution)","termine_origine":"lagh","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"lagh","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"lǫg","categoria":"non_precisato"}],"lontana":"non","ambiti":["scienza"],"via":"","testo":"Borrowed from Old Swedish lagh (compare Swedish lag), from Old Norse lǫg."},{"parola":"lilja","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lily (flower, Lilium)","termine_origine":"lilia","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"lilia","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"lilja","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"līlia","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"λείριον","categoria":"non_precisato"},{"codice":"cop-fay","nome":"Fayyumic Coptic","termine":"ϩⲗⲏⲣⲓ","categoria":"non_precisato"},{"codice":"egx-dem","nome":"Demotic Egyptian","termine":"","categoria":"non_precisato"},{"codice":"egy","nome":"Egyptian","termine":"ḥrrt","categoria":"non_precisato"}],"lontana":"egy","ambiti":["diritto_politica"],"via":"","testo":"Borrowed from Old Swedish lilia, from Old Norse lilja, from Medieval Latin līlia, plural of līlium, from Ancient Greek λείριον (leírion), from Fayyumic Coptic ϩⲗⲏⲣⲓ (hlēri) (compare Sahidic Coptic ϩⲣⲏⲣⲉ (hrēre)), from Demotic Egyptian (ḥrry), from Egyptian Hr:r-r:*t-M2 (ḥrrt, “flower”). Compare mode"},{"parola":"luhti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the upper floor of a granary or similar structure","termine_origine":"lufft","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"lufft","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"lopt","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Old Swedish lufft, from Old Norse lopt."},{"parola":"lyijy","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lead (Pb; metal)","termine_origine":"blȳ","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"blȳ","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"blý","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*blīwiją","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Old Swedish blȳ, from Old Norse blý, from Proto-Germanic *blīwiją."},{"parola":"löysä","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"runny, watery, soft, not firm","termine_origine":"lø̄s","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"lø̄s","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"lauss","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*lausaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["sport"],"via":"","testo":"Borrowed from Old Swedish lø̄s, from Old Norse lauss, from Proto-Germanic *lausaz. A doublet of lössi, lausas, lauha."},{"parola":"maali","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"target","termine_origine":"māl","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"māl","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"mál","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*maþlą","categoria":"non_precisato"},{"codice":"non","nome":"Old Norse","termine":"mál","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*mēlą","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["musica","militare","sport","diritto_politica"],"via":"","testo":"Borrowed from Old Swedish māl (“measure, amount; sign”) (compare Swedish mål (“target; what one aims to hit”)), from both Old Norse mál (“language, speech”) (from Proto-Germanic *maþlą) and Old Norse mál (“size, measurement, time”) (from Proto-Germanic *mēlą)."},{"parola":"merkki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"marking, mark (written or graphical indication)","termine_origine":"mærki","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"mærki","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"merki","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*markō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Old Swedish mærki (compare modern Swedish märke), from Old Norse merki, from Proto-Germanic *markō."},{"parola":"muotti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mould/mold (hollow form or matrix for shaping a fluid or plastic substance)","termine_origine":"mōt","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"mōt","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"mót","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Old Swedish mōt (“mold, cast”), from Old Norse mót. Doublet of muoto."},{"parola":"paavi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pope","termine_origine":"pavi","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"pavi","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"páfi","categoria":"non_precisato"},{"codice":"osx","nome":"Old Saxon","termine":"pābos","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"pape","categoria":"non_precisato"},{"codice":"la-ecc","nome":"Ecclesiastical Latin","termine":"pāpa","categoria":"non_precisato"}],"lontana":"la-ecc","ambiti":[],"via":"","testo":"Borrowed from Old Swedish pavi, pave (“pope”) (compare modern Swedish påve), from Old Norse páfi, from Old Saxon pābos, pāvos, from Old French pape, from Ecclesiastical Latin pāpa."},{"parola":"pippuri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"pepper (plant of the family Piperaceae)","termine_origine":"piper","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"piper","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"piparr","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"piper","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πέπερι","categoria":"non_precisato"},{"codice":"inc","nome":"Indo-Aryan","termine":"","categoria":"non_precisato"}],"lontana":"inc","ambiti":[],"via":"","testo":"Borrowed from Old Swedish piper, pipper (perhaps adapted with -uri), from Old Norse piparr, from Latin piper (“pepper”), from Ancient Greek πέπερι (péperi, “pepper”), from an Indo-Aryan source; compare Sanskrit पिप्पलि (pippali, “long pepper”)."},{"parola":"piuru","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"synonym of majava (“beaver”)","termine_origine":"biur","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"biur","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"bjórr","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bebruz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰébʰrus","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Swedish biur."},{"parola":"silkki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"silk (fine fiber excreted by the silkworm)","termine_origine":"silke","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"silke","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"silki","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"sēricus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Swedish silke, Old Norse silki, ultimately from Latin sēricus (see it and English silk for further etymology)."},{"parola":"tiili","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"brick (construction block)","termine_origine":"tighl","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"tighl","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"tigl","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*tigulǭ","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tēgula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Swedish tighl, from Old Norse tigl, from Proto-Germanic *tigulǭ, from Latin tēgula."},{"parola":"tori","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"square (open space in a town)","termine_origine":"torgh","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"torgh","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"torg","categoria":"non_precisato"},{"codice":"orv","nome":"Old East Slavic","termine":"търгъ","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*tъrgъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Swedish torgh, from Old Norse torg, itself borrowed from Old East Slavic търгъ (tŭrgŭ), from Proto-Slavic *tъrgъ. Compare Faroese torg, Icelandic torg, Norwegian Bokmål torg, Norwegian Nynorsk torg, Swedish torg. Doublet of turku."},{"parola":"vaaka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"scales, scale (device to measure mass or weight)","termine_origine":"vāgh","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"vāgh","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"vág","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wēgō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Old Swedish vāgh (compare Swedish våg (“scale”)), from Old Norse vág, from Proto-Germanic *wēgō. See also väkä."},{"parola":"vaunu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wagon, coach, stagecoach (see usage notes)","termine_origine":"vaghn","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"vaghn","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"vagn","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wagnaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from Old Swedish vaghn (compare modern Swedish vagn), from Old Norse vagn, from Proto-Germanic *wagnaz."},{"parola":"veto","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"bet, wager (an instance of making a bet)","termine_origine":"væþ","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"væþ","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"veð","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wadją","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Probably borrowed from Old Swedish væþ, vedh, from Old Norse veð, from Proto-Germanic *wadją. Also associated with veto (etymology 1)."},{"parola":"yrtti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"herb","termine_origine":"yrt","catena":[{"codice":"gmq-osw","nome":"Old Swedish","termine":"yrt","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"urt","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wrōts","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*wréh₂ds","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Old Swedish yrt (modern Swedish ört), from Old Norse urt, oblique case form of Proto-Germanic *wrōts, from Proto-Indo-European *wréh₂ds (“root”). Compare English wort, root and Latin rādīx (“root”)."}]}