{"arrivo":"ro","origine":"sh","origine_nome":"Serbo-Croatian","livello2":"bg","livello2_nome":"Bulgarian","n":12,"parole":[{"parola":"barem","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"at least","termine_origine":"barem","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"barem","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"барем","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"باری","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"باری","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian barem or Bulgarian барем (barem), from Ottoman Turkish باری (bari), from Persian باری (bâri)."},{"parola":"ciupercă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fungus","termine_origine":"печурка","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"печурка","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"печурка","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pečura","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed, through metathesis, from Serbo-Croatian печурка (pečurka, “mushroom”) or Bulgarian печурка (pečurka), from Proto-Slavic *pečura."},{"parola":"cucurig","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Unknown; Possibly","significato":"hellebore","termine_origine":"kukurek","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"kukurek","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"кукурег","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Unknown. Possibly from Serbo-Croatian kukurek or Bulgarian кукурег (kukureg, “fragrant hellebore”), кукуряг (kukurjag), but they could also come from Romanian."},{"parola":"drob","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a traditional dish usually served at Easter made from minced up offal and entrails (often of lamb), seasoned with herbs…","termine_origine":"drob","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"drob","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"дроб","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*drobъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian drob or Bulgarian дроб (drob), from Proto-Slavic *drobъ (“entrails”). Doublet of dărab."},{"parola":"lubeniță","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"watermelon","termine_origine":"lubenica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"lubenica","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"любеница","categoria":"prestito"}],"lontana":"bg","ambiti":["cucina"],"via":"","testo":"Borrowed from Serbo-Croatian lubenica or Bulgarian любеница (ljubenica)."},{"parola":"postavă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kneading trough","termine_origine":"postava","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"postava","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"постав","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian postava or Bulgarian постав (postav)."},{"parola":"prepeliță","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"quail","termine_origine":"prepelica","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"prepelica","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"препелица","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*perpelъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian prepelica or Bulgarian препелица (prepelica), from Proto-Slavic *perpelъ."},{"parola":"prâsni","pos":"noun|verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"drops sprayed or splashed","termine_origine":"prsnuti","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"prsnuti","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"пръсна","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian prsnuti or Bulgarian пръсна (prăsna). Compare Russian прыскать (pryskatʹ). The noun is denominated from the verb. Doublet of împroșca. First attested in 1830."},{"parola":"schelă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"scaffolding","termine_origine":"skela","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"skela","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"скеля","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"اسكله","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"scala","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"scala","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian skela (“scaffolding”) or Bulgarian скеля (skelja), from Ottoman Turkish اسكله (iskele, “scaffolding”), from Italian scala (“ladder”), from Latin scala. Doublet of scală, escală, and scară."},{"parola":"sticlete","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"European goldfinch (Carduelis carduelis) (bird)","termine_origine":"steglić","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"steglić","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"щиглец","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ščigъlъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian steglić, Bulgarian щиглец (štiglec), from Proto-Slavic *ščigъlъ, *ščegъlъ."},{"parola":"sârb","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a Serb","termine_origine":"srb","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"srb","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"съ́рбин","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sьrbъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian srb, Srbin or Bulgarian съ́рбин (sắrbin), from Proto-Slavic *sьrbъ."},{"parola":"zaveră","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rebellion, specifically the 1821 Revolution","termine_origine":"zavera","catena":[{"codice":"sh","nome":"Serbo-Croatian","termine":"zavera","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"завера","categoria":"prestito"}],"lontana":"bg","ambiti":[],"via":"","testo":"Borrowed from Serbo-Croatian zavera or Bulgarian завера (zavera)."}]}