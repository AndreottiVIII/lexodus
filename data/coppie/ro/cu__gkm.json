{"arrivo":"ro","origine":"cu","origine_nome":"Old Church Slavonic","livello2":"gkm","livello2_nome":"Byzantine Greek","n":22,"parole":[{"parola":"aprilie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"April","termine_origine":"април҄ь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"април҄ь","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Ἀπρίλιος","categoria":"prestito"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic априль (aprilĭ), from Byzantine Greek Ἀπρίλιος (Aprílios), from Latin (mensis) Aprīlis. Introduced through the Orthodox Church and mostly supplanted the older popular inherited form prier."},{"parola":"chilie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hermit's room","termine_origine":"келиꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"келиꙗ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"κελλία","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cella","categoria":"non_precisato"}],"lontana":"la","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic келиꙗ (kelija), from Byzantine Greek κελλία (kellía), plural of κελλίον (kellíon, “garret”), diminutive of κέλλα (kélla), from Latin cella."},{"parola":"condac","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hymn in honour of a saint","termine_origine":"кондакъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"кондакъ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"κοντάκιον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic кондакъ (kondakŭ), from Byzantine Greek κοντάκιον (kontákion)."},{"parola":"hârtie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"paper","termine_origine":"харътиꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"харътиꙗ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"χαρτί","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic харътиꙗ (xarŭtija, “papyrus, paper”), from Byzantine Greek χαρτί (khartí). Compare Bulgarian хартия (hartija), Macedonian хартија (hartija) and Serbo-Croatian хартија), Aromanian hãrtii. Cf. also the doublet carte, which has the same Ancient Greek root, but passed t"},{"parola":"ianuarie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"January","termine_origine":"иꙗноуарии","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"иꙗноуарии","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Ιανουάριος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) Iānuārius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic иꙗноуарии (ijanuarii), from Byzantine Greek Ιανουάριος (Ianouários), from Latin (mensis) Iānuārius. Doublet of gerar and ghenar. First attested in 1950."},{"parola":"iulie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"July","termine_origine":"июлии","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"июлии","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Ἰούλιος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) iūlius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic июлии (ijulii), from Byzantine Greek Ἰούλιος (Ioúlios), from Latin (mensis) iūlius."},{"parola":"iunie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"June","termine_origine":"июнии","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"июнии","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Ἰούνιος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) iūnius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic июнии (ijunii), from Byzantine Greek Ἰούνιος (Ioúnios), from Latin (mensis) iūnius."},{"parola":"martie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"March","termine_origine":"мартии","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"мартии","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Μάρτιος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) mārtius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic мартии (martii), from Byzantine Greek Μάρτιος (Mártios), from Latin (mensis) mārtius. Doublet of marț, now rare."},{"parola":"noiembrie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"November","termine_origine":"ноѩбр҄ь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"ноѩбр҄ь","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Νοέμβριος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) Novembrius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic ноѩбр҄ь (nojębrʹĭ), from Byzantine Greek Νοέμβριος (Noémbrios), from Latin (mensis) Novembrius."},{"parola":"octombrie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"October","termine_origine":"октѧбрь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"октѧбрь","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Ὀκτώβριος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) Octōber","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic октѧбрь (oktębrĭ), from Byzantine Greek Ὀκτώβριος (Oktṓbrios), from Latin (mensis) Octōber. Compare Greek Οκτώβριος (Októvrios)."},{"parola":"omofor","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"omophorion","termine_origine":"омофоръ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"омофоръ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ὠμοφόριον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic омофоръ (omoforŭ), from Byzantine Greek ὠμοφόριον (ōmophórion)."},{"parola":"patrafir","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"epitrachelion, Eastern Orthodox stole","termine_origine":"епитрахиль","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"епитрахиль","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἐπιτραχήλιον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic епитрахиль (epitraxilĭ), from Byzantine Greek ἐπιτραχήλιον (epitrakhḗlion). Doublet of epitrahil."},{"parola":"proscomidie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"prothesis, Proskomedia","termine_origine":"проскомидиꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"проскомидиꙗ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Προσκομιδή","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic проскомидиꙗ (proskomidija), from Byzantine Greek Προσκομιδή (Proskomidḗ)."},{"parola":"psalm","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"psalm","termine_origine":"псалъмъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"псалъмъ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ψαλμός","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["musica"],"via":"","testo":"Borrowed from Old Church Slavonic псалъмъ (psalŭmŭ), from Byzantine Greek ψαλμός (psalmós)."},{"parola":"rusalcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rusalka; a Slavic female water spirit associated with death by drowning","termine_origine":"роусалка","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"роусалка","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ῥουσάλια","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"rōsālia","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Old Church Slavonic роусалка (rusalka), from Old Church Slavonic роусалиѩ (rusaliję), from Byzantine Greek ῥουσάλια (rhousália), from Latin rōsālia (“festival of the roses”)."},{"parola":"Rusalii","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Whitsuntide; Pentecost","termine_origine":"роусалиѩ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"роусалиѩ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ρουσάλια","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"rosalia","categoria":"non_precisato"}],"lontana":"la","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic роусалиѩ (rusaliję), from Byzantine Greek ρουσάλια (rousália), from Latin rosalia."},{"parola":"scorpie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"scorpion","termine_origine":"скоръпии","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"скоръпии","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"σκορπίον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic скоръпии (skorŭpii), from Byzantine Greek σκορπίον (skorpíon). Doublet of scorpion."},{"parola":"septembrie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"September","termine_origine":"септѧбр҄ь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"септѧбр҄ь","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Σεπτέμβριος","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"(mensis) September","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic септѧбр҄ь (septębrʹĭ), from Byzantine Greek Σεπτέμβριος (Septémbrios), from Latin (mensis) September."},{"parola":"sfeclă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"beet (Beta vulgaris)","termine_origine":"свеклъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"свеклъ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic свеклъ (sveklŭ), from Byzantine Greek, from Ancient Greek σεῦκλον (seûklon). Compare Serbo-Croatian cvikla, Bulgarian цвекло (cveklo), Russian свёкла (svjókla); cf. also Hungarian cékla."},{"parola":"temei","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"grounds, basis","termine_origine":"темель","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"темель","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"θεμέλιον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic темель (temelĭ), from Byzantine Greek θεμέλιον (themélion), from Ancient Greek θεμέλιος (themélios). Doublet of temelie. Compare Serbo-Croatian temelj."},{"parola":"temelie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"foundation (the lowest part of a building)","termine_origine":"темелиѥ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"темелиѥ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"θεμέλιον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic темелиѥ (temelije), from темель (temelĭ) + -иѥ (-ije), from Byzantine Greek θεμέλιον (themélion), from Ancient Greek θεμέλιος (themélios). Compare Old Serbo-Croatian temelije."},{"parola":"tâmpănă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dayereh","termine_origine":"тѫпанъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"тѫпанъ","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"τύμπανον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic тѫпанъ (tǫpanŭ), from Byzantine Greek τύμπανον (túmpanon). Doublet of timpan."}]}