"},{"codice":"uk","nome":"Ukrainian","termine":"ласкавий","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*laskavъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Polish łaskawy or Ukrainian ласкавий (laskavyj), from Proto-Slavic *laskavъ."},{"parola":"nurcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mink; specifically, the European mink, Mustela lutreola, but also applied to other species of the genus Mustela","termine_origine":"nurka","catena":[{"codice":"pl","nome":"Polish","termine":"nurka","categoria":"prestito"},{"codice":"uk","nome":"Ukrainian","termine":"нурка","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*nuriti","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Polish nurka or Ukrainian нурка (nurka), from Proto-Slavic *nuriti."}]}