igine":"prūnus","catena":[{"codice":"la","nome":"Latin","termine":"prūnus","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"προύνη","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Latin prūnus, from Ancient Greek προύνη (proúnē)."},{"parola":"păliur","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"Christ's thorn, Jerusalem thorn (Paliurus spina-christi)","termine_origine":"paliūrus","catena":[{"codice":"la","nome":"Latin","termine":"paliūrus","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"παλίουρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Latin paliūrus, from Ancient Greek παλίουρος (palíouros)."},{"parola":"pănură","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a rough homespun woolen fabric (used to make coats, etc.)","termine_origine":"paenula","catena":[{"codice":"la","nome":"Latin","termine":"paenula","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"φαινόλη","categoria":"non_precisato"}],"lontana":"grc","ambiti":["moda"],"via":"","testo":"Inherited from Latin paenula, from Ancient Greek φαινόλη (phainólē)."},{"parola":"pătrunjel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"parsley (herb)","termine_origine":"petroselīnum","catena":[{"codice":"la","nome":"Latin","termine":"petroselīnum","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πετροσέλῑνον","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Ultimately from Latin petroselīnum, from Ancient Greek πετροσέλῑνον (petrosélīnon, “parsley”), from πέτρος (pétros, “rock, stone”) + σέλῑνον (sélīnon, “celery”)."},{"parola":"retorică","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"rhetoric, oratory","termine_origine":"rhetorica","catena