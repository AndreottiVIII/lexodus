{"arrivo":"ro","origine":"cu","origine_nome":"Old Church Slavonic","livello2":"grc","livello2_nome":"Ancient Greek","n":53,"parole":[{"parola":"acatist","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"akathist","termine_origine":"акатистъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"акатистъ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ακαθίστος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Learned borrowing from Old Church Slavonic акатистъ (akatistŭ), from Ancient Greek ακαθίστος (akathístos)."},{"parola":"aleluia","pos":"intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hallelujah","termine_origine":"алелоуиꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"алелоуиꙗ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀλληλούια","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"הַלְּלוּיָהּ","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic алелоуиꙗ (aleluija), from Ancient Greek ἀλληλούια (allēloúia), from Hebrew הַלְּלוּיָהּ (“Praise Jah!”)."},{"parola":"amvon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pulpit","termine_origine":"амъвонъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"амъвонъ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἄμβων","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic амъвонъ (amŭvonŭ), from Ancient Greek ἄμβων (ámbōn)."},{"parola":"anafură","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wafer","termine_origine":"анафора","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"анафора","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀναφορά","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic анафора (anafora), from Ancient Greek ἀναφορά (anaphorá)."},{"parola":"apostol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"apostle","termine_origine":"апостолъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"апостолъ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀπόστολος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic апостолъ (apostolŭ), from Ancient Greek ἀπόστολος (apóstolos, “messenger, one sent forth”)."},{"parola":"arhanghel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"archangel","termine_origine":"архангелъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"архангелъ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀρχάγγελος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic архангелъ (arxangelŭ), from Ancient Greek ἀρχάγγελος (arkhángelos)."},{"parola":"arhidiacon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"archdeacon","termine_origine":"архидиꙗконъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"архидиꙗконъ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀρχιδιάκονος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic архидиꙗконъ (arxidijakonŭ), from Ancient Greek ἀρχιδιάκονος (arkhidiákonos). Equivalent to arhi- + diacon."},{"parola":"azbuche","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Cyrillic alphabet","termine_origine":"азъбукꙑ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"азъбукꙑ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","term