{"arrivo":"ro","origine":"it","origine_nome":"Italian","livello2":"la-lat","livello2_nome":"Late Latin","n":5,"parole":[{"parola":"abație","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abbey (monastery headed by an abbot)","termine_origine":"abbazia","catena":[{"codice":"it","nome":"Italian","termine":"abbazia","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"abbātia","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["religione"],"via":"","testo":"Borrowed from Italian abbazia, from Late Latin abbātia, from Latin abbās (“abbot”)."},{"parola":"barcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably; perhaps","significato":"boat (watercraft)","termine_origine":"barca","catena":[{"codice":"it","nome":"Italian","termine":"barca","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"barca","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["mare"],"via":"","testo":"Probably borrowed from Italian barca (perhaps partly through a Balkan or eastern intermediate; cf. Greek βάρκα (várka), Turkish barka), from Late Latin barca."},{"parola":"bufal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buffalo","termine_origine":"bufalo","catena":[{"codice":"it","nome":"Italian","termine":"bufalo","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"bufalus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"βούβαλος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian bufalo, from Late Latin bufalus, from Latin būbalus, from Ancient Greek βούβαλος (boúbalos, “antelope, wild ox”)."},{"parola":"căpitan","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"captain (of a vessel)","termine_origine":"capitano","catena":[{"codice":"it","nome":"Italian","termin