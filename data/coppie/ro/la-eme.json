{"arrivo":"ro","origine":"la-eme","origine_nome":"Early Medieval Latin","n":10,"n_alternative":1,"parole":[{"parola":"altminteri","pos":"adv","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"otherwise (in another way)","termine_origine":"alterā mente","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"alterā mente","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin alterā mente."},{"parola":"cicoare","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"cicada (especially Cicada orni)","termine_origine":"cicāla","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"cicāla","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"From Early Medieval Latin cicāla, from Latin cicāda. The hypothetical original Romanian form, *cicară, was probably influenced phonetically by the unrelated word below. Doublet of cicadă, a borrowing."},{"parola":"desface","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to undo","termine_origine":"disfacio","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"disfacio","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin disfacere, from Latin dis- + facere. Synchronically des- + face. Compare Spanish deshacer."},{"parola":"frăsinet","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ash grove, forest of ash trees","termine_origine":"fraxinētum","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"fraxinētum","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"From Early Medieval Latin fraxinētum. By surface analysis, frasin (“ash tree”) + -et. Compare Aromanian frãpsinet."},{"parola":"greu","pos":"adj|noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"heavy","termine_origine":"grevis","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"grevis","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin grevem, alteration of Latin gravem. Compare Aromanian greu. Doublet of grav, a borrowing."},{"parola":"mustață","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"moustache","termine_origine":"mustācium","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"mustācium","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"μύσταξ","traslitterazione":"mústax","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Early Medieval Latin mustācium (via its plural mustācia), ultimately from Ancient Greek μύσταξ (mústax). Compare Aromanian mustatsã."},{"parola":"tindă","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"parlour","termine_origine":"","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"From a Early Medieval Latin or Late Latin tenda, from Vulgar Latin *tendita, substantivized feminine of *tenditus, as a variant form of tentus, perfect passive participle of Latin tendō. Compare Italian tenda, Spanish tienda, Friulian tinde."},{"parola":"trage","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to pull, draw, drag","termine_origine":"trago","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"trago","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"From Early Medieval Latin tragere, from Latin trahere (“to draw, drag”)."},{"parola":"văcar","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"cowherd, neatherd","termine_origine":"vaccārius","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"vaccārius","categoria":"ereditato"}],"lontana":"la-eme","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin vaccārius. Compare Aromanian vãcar."},{"parola":"lemnamă","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from","significato":"a multitude of wood or timber","termine_origine":"lignāmen","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"lignāmen","categoria":"non_precisato"}],"lontana":"la-eme","ambiti":[],"via":"","alternative":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"ereditato"},{"codice":"la-eme","nome":"Early Medieval Latin","termine":"lignāmen","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"lignum","categoria":"ereditato"}],"testo":"From lemn or from a Vulgar Latin or Early Medieval Latin lignāmen, from Latin lignum. Compare Italian legname, Spanish leñame."}]}