ack","termine_origine":"лях","catena":[{"codice":"uk","nome":"Ukrainian","termine":"лях","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*lęxъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Ukrainian лях (ljax), from Old Ruthenian лѧхъ (ljax), from Old East Slavic лѧхъ (lęxŭ), from Proto-Slavic *lęxъ, from Proto-Slavic *lęděninъ (“dweller of wasteland”)."},{"parola":"susai","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sow thistle (Sonchus)","termine_origine":"сусаі","catena":[{"codice":"uk","nome":"Ukrainian","termine":"сусаі","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sъsati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Ukrainian сусаі (susai), from Proto-Slavic *sъsati (“to suck”)."},{"parola":"tovarăș","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"comrade","termine_origine":"товариш","catena":[{"codice":"uk","nome":"Ukrainian","termine":"товариш","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*tovariščь","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"това́рищ","categoria":"non_precisato"}],"lontana":"ru","ambiti":[],"via":"","testo":"Borrowed from Ukrainian товариш (tovaryš), from Proto-Slavic *tovariščь; compare Russian това́рищ (továrišč), Serbo-Croatian товариш, Polish towarzysz, Finnish toveri. Meaning of \"fellow socialist\" borrowed from Russian това́рищ (továrišč)."}]}