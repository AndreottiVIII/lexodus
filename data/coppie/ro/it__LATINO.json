{"arrivo":"ro","origine":"it","origine_nome":"Italian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":95,"parole":[{"parola":"abate","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"abbot","termine_origine":"abate","catena":[{"codice":"it","nome":"Italian","termine":"abate","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"abbas","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀββᾶς","categoria":"non_precisato"},{"codice":"arc","nome":"Aramaic","termine":"אבא","categoria":"non_precisato"}],"lontana":"arc","ambiti":[],"via":"","testo":"Borrowed from Italian abate, from Latin abbās, abbātis, from Ancient Greek ἀββᾶς (abbâs), from Aramaic אבא (’abbā, “father”).","livello2_varieta":"la"},{"parola":"abație","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abbey (monastery headed by an abbot)","termine_origine":"abbazia","catena":[{"codice":"it","nome":"Italian","termine":"abbazia","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"abbātia","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["religione"],"via":"","testo":"Borrowed from Italian abbazia, from Late Latin abbātia, from Latin abbās (“abbot”).","livello2_varieta":"la-lat"},{"parola":"acvariu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aquarium","termine_origine":"aquario","catena":[{"codice":"it","nome":"Italian","termine":"aquario","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aquarium","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian aquario, Latin aquarium. Doublet of the inherited apar.","livello2_varieta":"la"},{"parola":"acvilă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"eagle","termine_origine":"aquila","catena":[{"codice":"it","nome":"Italian","termine":"aquila","categoria":"prestito"},{"codice":"la