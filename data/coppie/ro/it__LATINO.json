oria":"prestito"},{"codice":"de","nome":"German","termine":"negativ","categoria":"prestito"}],"lontana":"de","ambiti":["arte"],"via":"","testo":"Borrowed from Italian negativo or Latin negativus or French negatif or German negativ. Equivalent to nega + -tiv.","livello2_varieta":"la"},{"parola":"nobil","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"noble","termine_origine":"nobile","catena":[{"codice":"it","nome":"Italian","termine":"nobile","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nobilis","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian nobile, Latin nobilis.","livello2_varieta":"la"},{"parola":"notiție","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"news","termine_origine":"notizia","catena":[{"codice":"it","nome":"Italian","termine":"notizia","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"notitia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian notizia, from Latin notitia. Doublet of notiță.","livello2_varieta":"la"},{"parola":"oferi","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to offer","termine_origine":"offerire","catena":[{"codice":"it","nome":"Italian","termine":"offerire","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"offerō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian offerire, from Latin offerō.","livello2_varieta":"la"},{"parola":"omiletic","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"homiletic","termine_origine":"omiletico","catena":[{"codice":"it","nome":"Italian","termine":"omiletico","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"homileticus","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"homilétique","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Italian omiletico or Latin homileticus or French homilétique.","livello2_varieta":"la"},{"parola":"ordin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"order, command","termine_origine":"ordine","catena":[{"codice":"it","nome":"Italian","termine":"ordine","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ordo","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["religione","scienza"],"via":"","testo":"Borrowed from Italian ordine, Latin ordo, ordinem. Doublet of ordine.","livello2_varieta":"la"},{"parola":"ordine","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"order (sequence, succession)","termine_origine":"ordine","catena":[{"codice":"it","nome":"Italian","termine":"ordine","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ordo","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian ordine or Latin ordo, ordinem. Doublet of ordin.","livello2_varieta":"la"},{"parola":"pagină","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"page","termine_origine":"pagina","catena":[{"codice":"it","nome":"Italian","termine":"pagina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pāgina","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pagina, Latin pāgina.","livello2_varieta":"la"},{"parola":"palid","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pale, pallid","termine_origine":"pallido","catena":[{"codice":"it","nome":"Italian","termine":"pallido","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pallidus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pallido, from Latin pallidus.","livello2_varieta":"la"},{"parola":"percola","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to percolate","termine_origine":"percolare","catena":[{"codice":"it","nome":"Italian","termine":"percolare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"percōlō","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian percolare, Latin percōlō.","livello2_varieta":"la"},{"parola":"pericol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"danger, peril, hazard","termine_origine":"pericolo","catena":[{"codice":"it","nome":"Italian","termine":"pericolo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"perīculum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pericolo, Latin perīculum.","livello2_varieta":"la"},{"parola":"pneumă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pneuma","termine_origine":"pneuma","catena":[{"codice":"it","nome":"Italian","termine":"pneuma","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pneuma","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pneuma or Latin pneuma.","livello2_varieta":"la"},{"parola":"prat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hayfield","termine_origine":"prato","catena":[{"codice":"it","nome":"Italian","termine":"prato","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pratum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian prato (“meadow”), from Latin prātum. Most likely borrowed in 19th century.","livello2_varieta":"la"},{"parola":"principe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"prince","termine_origine":"principe","catena":[{"codice":"it","nome":"Italian","termine":"principe","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"princeps","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian principe, from Latin princeps.","livello2_varieta":"la"},{"parola":"pălărie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Unknown","significato":"hat","termine_origine":"cappelleria","catena":[{"codice":"it","nome":"Italian","termine":"cappelleria","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pileum","categoria":"non_precisato"}],"lontana":"la","ambiti":["moda"],"via":"","testo":"Unknown. Most likely an early borrowing from Italian cappelleria, with later apheresis. Less likely from Latin pileum, from pileus (“type of hat”) or Romanian păr (“hair”).","livello2_varieta":"la"},{"parola":"reumatism","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rheumatism","termine_origine":"reumatismo","catena":[{"codice":"it","nome":"Italian","termine":"reumatismo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rheumatismus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian reumatismo, from Latin rheumatismus.","livello2_varieta":"la"},{"parola":"sacru","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sacred","termine_origine":"sacro","catena":[{"codice":"it","nome":"Italian","termine":"sacro","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sacer","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian sacro, Latin sacer, sacrum.","livello2_varieta":"la"},{"parola":"saluta","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to greet, to salute","termine_origine":"","catena":[{"codice":"it","nome":"Italian","termine":"","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"salutare","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian, Latin salutare. Compare the inherited doublet săruta (“to kiss”).","livello2_varieta":"la"},{"parola":"scală","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"tuning dial (on a radio)","termine_origine":"scala","catena":[{"codice":"it","nome":"Italian","termine":"scala","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"scāla","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"σκάλα","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"scala","categoria":"non_precisato"}],"lontana":"it","ambiti":[],"via":"","testo":"Borrowed from Italian scala, from Latin scāla, whence the inherited Romanian doublet scară (“stairs, ladder”). Also a doublet of escală and schelă. The older sense was probably taken from Greek σκάλα (skála) (17th century), itself from Italian scala.","livello2_varieta":"la"},{"parola":"secol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"century","termine_origine":"secolo","catena":[{"codice":"it","nome":"Italian","termine":"secolo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"saeculum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian secolo, Latin saeculum.","livello2_varieta":"la"},{"parola":"smarald","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"emerald","termine_origine":"smeraldo","catena":[{"codice":"it","nome":"Italian","termine":"smeraldo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"smaragdus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"σμάραγδος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian smeraldo, from Latin smaragdus, from Ancient Greek σμάραγδος (smáragdos). See also the variants smaragd (from Greek σμαράγδι (smarágdi)) and smarand.","livello2_varieta":"la"},{"parola":"stabili","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to establish, determine, prove","termine_origine":"stabilire","catena":[{"codice":"it","nome":"Italian","termine":"stabilire","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"stabiliō","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian stabilire, Latin stabilīre.","livello2_varieta":"la"},{"parola":"staniu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tin (element)","termine_origine":"stagno","catena":[{"codice":"it","nome":"Italian","termine":"stagno","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"stannum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian stagno, Latin stannum.","livello2_varieta":"la"},{"parola":"stat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"state, government","termine_origine":"stato","catena":[{"codice":"it","nome":"Italian","termine":"stato","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"stātus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian stato or Latin stātus.","livello2_varieta":"la"},{"parola":"stima","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to esteem, respect, value, reverence, have a high opinion of, make much of","termine_origine":"stimare","catena":[{"codice":"it","nome":"Italian","termine":"stimare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aestimo","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"Borrowed from Italian stimare, from Latin aestimare.","livello2_varieta":"la"},{"parola":"suficiență","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sufficiency","termine_origine":"sufficienza","catena":[{"codice":"it","nome":"Italian","termine":"sufficienza","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sufficientia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian sufficienza, from Latin sufficientia.","livello2_varieta":"la"},{"parola":"sulf","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sulfur (chemical element)","termine_origine":"zolfo","catena":[{"codice":"it","nome":"Italian","termine":"zolfo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sulfur","categoria":"latinismo_dotto"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*swelplos","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian zolfo, Latin sulfur, sulphur, from Proto-Indo-European *swelplos, from the root *swel- (“to burn, smoulder”).","livello2_varieta":"la"},{"parola":"tabulație","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tabulation","termine_origine":"tabulazione","catena":[{"codice":"it","nome":"Italian","termine":"tabulazione","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tabulatio","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian tabulazione, from Latin tabulatio.","livello2_varieta":"la"},{"parola":"terț","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"third","termine_origine":"terzo","catena":[{"codice":"it","nome":"Italian","termine":"terzo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tertius","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian terzo, Latin tertius. Compare the inherited doublet terțiu and tărțiu, cf. also anțărț.","livello2_varieta":"la"},{"parola":"tetrastih","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tetrastich","termine_origine":"tetrastico","catena":[{"codice":"it","nome":"Italian","termine":"tetrastico","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tetrastichus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian tetrastico or Latin tetrastichus.","livello2_varieta":"la"},{"parola":"tratat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"treaty","termine_origine":"trattato","catena":[{"codice":"it","nome":"Italian","termine":"trattato","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tractātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian trattato, from Latin tractātus. Compare French traité, German Traktat.","livello2_varieta":"la"},{"parola":"trădător","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"traitor","termine_origine":"traditore","catena":[{"codice":"it","nome":"Italian","termine":"traditore","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"trāditor","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From the verb trăda + -ător, based on Italian traditore, Latin trāditor.","livello2_varieta":"la"},{"parola":"vatican","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Vatican","termine_origine":"vaticano","catena":[{"codice":"it","nome":"Italian","termine":"vaticano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vātī̆cānus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian vaticano or Latin vātī̆cānus.","livello2_varieta":"la"},{"parola":"velă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sail (of a ship)","termine_origine":"vela","catena":[{"codice":"it","nome":"Italian","termine":"vela","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vela","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian vela, from Latin vela, plural of velum. Doublet of voal and văl.","livello2_varieta":"la"},{"parola":"virtuos","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"virtuous","termine_origine":"virtuoso","catena":[{"codice":"it","nome":"Italian","termine":"virtuoso","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"virtuōsus","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"vertueux","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Italian virtuoso, Latin virtuōsus, based on French vertueux. Compare the inherited doublet vârtos.","livello2_varieta":"la"}]}