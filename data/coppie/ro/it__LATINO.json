ine":"convenientia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian convenienza, itself from Latin convenientia. Doublet of cuviință, which was inherited.","livello2_varieta":"la"},{"parola":"corsar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"corsair","termine_origine":"corsaro","catena":[{"codice":"it","nome":"Italian","termine":"corsaro","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"cursārius","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Italian corsaro. Doublet of husar.","livello2_varieta":"la-med"},{"parola":"costa","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to cost","termine_origine":"costare","catena":[{"codice":"it","nome":"Italian","termine":"costare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"constō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian costare, from Latin constāre. Doublet of the inherited (now archaic) custa and consta, borrowed directly from Latin.","livello2_varieta":"la"},{"parola":"căpitan","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"captain (of a vessel)","termine_origine":"capitano","catena":[{"codice":"it","nome":"Italian","termine":"capitano","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"capitāneus","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Italian capitano (itself from Late Latin capitāneus), entering in the Middle Ages, probably through a Levantine route; cf. Greek καπετάνιος (kapetánios), Turkish kaptan. Compare also Aromanian cãpitan. Doublet of căpătâi.","livello2_varieta":"la-lat"},{"parola":"delfin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dolphin","termine_origine":"d