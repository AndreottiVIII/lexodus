,"nome":"Latin","termine":"alburnum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian alburno or Latin alburnum.","livello2_varieta":"la"},{"parola":"ambii","pos":"det|pron","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"both","termine_origine":"ambe","catena":[{"codice":"it","nome":"Italian","termine":"ambe","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ambō","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian ambe and Latin ambō. Doublet of îmbi.","livello2_varieta":"la"},{"parola":"ament","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"catkin (a type of inflorescence)","termine_origine":"amento","catena":[{"codice":"it","nome":"Italian","termine":"amento","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"amentum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Italian amento, Latin amentum.","livello2_varieta":"la"},{"parola":"amic","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"friend; pal, buddy","termine_origine":"amico","catena":[{"codice":"it","nome":"Italian","termine":"amico","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"amīcus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian amico or directly from Latin amīcus, derived from amō (“love”). First attested in the 19th century.","livello2_varieta":"la"},{"parola":"antecesor","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"predecessor","termine_origine":"antecessore","catena":[{"codice":"it","nome":"Italian","termine":"antecessore","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"antecessor","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian antecessore or Latin antecessor.","livello2_varieta":"la"},{"parola":"arcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ark","termine_origine":"arca","catena":[{"codice":"it","nome":"Italian","termine":"arca","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"arca","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian arca or Latin arca.","livello2_varieta":"la"},{"parola":"arie","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"melody, tune","termine_origine":"aria","catena":[{"codice":"it","nome":"Italian","termine":"aria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"āēr","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾱ̓ήρ","categoria":"prestito"},{"codice":"grk-pro","nome":"Proto-Hellenic","termine":"*auhḗr","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂ewsér","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian aria.","livello2_varieta":"la"},{"parola":"armată","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"army","termine_origine":"armata","catena":[{"codice":"it","nome":"Italian","termine":"armata","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"armāta","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Italian armata, from Medieval Latin armāta.","livello2_varieta":"la-med"},{"parola":"austriac","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Austrian","termine_origine":"austriaco","catena":[{"codice":"it","nome":"Italian","termine":"austriaco","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"austriacus","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian austriaco or Latin austriacus. By surface analysis, Austria + -ac.","livello2_varieta":"la"},{"parola":"barcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably; perhaps","significato":"boat (watercraft)","termine_origine":"barca","catena":[{"codice":"it","nome":"Italian","termine":"barca","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"barca","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["mare"],"via":"","testo":"Probably borrowed from Italian barca (perhaps partly through a Balkan or eastern intermediate; cf. Greek βάρκα (várka), Turkish barka), from Late Latin barca.","livello2_varieta":"la-lat"},{"parola":"bestie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"beast, wild animal","termine_origine":"bestia","catena":[{"codice":"it","nome":"Italian","termine":"bestia","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bēstia","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian bestia, Latin bēstia (19th century).","livello2_varieta":"la"},{"parola":"bufal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buffalo","termine_origine":"bufalo","catena":[{"codice":"it","nome":"Italian","termine":"bufalo","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"bufalus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"βούβαλος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian bufalo, from Late Latin bufalus, from Latin būbalus, from Ancient Greek βούβαλος (boúbalos, “antelope, wild ox”).","livello2_varieta":"la-lat"},{"parola":"campestru","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"campestrian, rustic","termine_origine":"campestre","catena":[{"codice":"it","nome":"Italian","termine":"campestre","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"campester","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian campestre or Latin campester.","livello2_varieta":"la"},{"parola":"campion","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"champion","termine_origine":"campione","catena":[{"codice":"it","nome":"Italian","termine":"campione","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*kampijō","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kampijô","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"campus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian campione, from Medieval Latin or Late Latin campiō, campiōnem, from Frankish *kampijō (or a Lombardic equivalent) from Proto-Germanic *kampijô, based on Latin campus (“level ground”); cf. also French champion.","livello2_varieta":"la-med"},{"parola":"capitel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"capital (uppermost part of a column)","termine_origine":"capitello","catena":[{"codice":"it","nome":"Italian","termine":"capitello","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capitellum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Borrowed from Italian capitello or Latin capitellum.","livello2_varieta":"la"},{"parola":"capitol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chapter (section of a book)","termine_origine":"capitolo","catena":[{"codice":"it","nome":"Italian","termine":"capitolo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capitulum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian capitolo, from Latin capitulum. Doublet of capitul.","livello2_varieta":"la"},{"parola":"caustic","pos":"adj","n_etimologia