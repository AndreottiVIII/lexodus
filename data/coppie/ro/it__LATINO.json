rate","termine_origine":"generare","catena":[{"codice":"it","nome":"Italian","termine":"generare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"generare","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian generare or Latin generare.","livello2_varieta":"la"},{"parola":"gigant","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"giant","termine_origine":"gigante","catena":[{"codice":"it","nome":"Italian","termine":"gigante","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gigās","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"γίγᾱς","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian gigante, from Latin gigās, from Ancient Greek γίγᾱς (gígās, “giant”).","livello2_varieta":"la"},{"parola":"glorie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"glory","termine_origine":"gloria","catena":[{"codice":"it","nome":"Italian","termine":"gloria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"glōria","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian gloria, Latin glōria.","livello2_varieta":"la"},{"parola":"incongruență","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"incongruence","termine_origine":"incongruenza","catena":[{"codice":"it","nome":"Italian","termine":"incongruenza","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"incongruentia","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian incongruenza or Latin incongruentia.","livello2_varieta":"la"},{"parola":"infern","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hell (place where the souls of dead sinners are to be tortured eternally)","termine_origine":"inferno","catena":[{"codice":"it","nome":"Italia