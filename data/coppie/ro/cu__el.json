{"arrivo":"ro","origine":"cu","origine_nome":"Old Church Slavonic","livello2":"el","livello2_nome":"Greek","n":25,"parole":[{"parola":"arhimandrit","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"archimandrite","termine_origine":"архиманьдритъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"архиманьдритъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"αρχιμανδρίτης","categoria":"non_precisato"}],"lontana":"el","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic архиманьдритъ (arximanĭdritŭ), from Greek αρχιμανδρίτης (archimandrítis)."},{"parola":"armean","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"an Armenian person","termine_origine":"армѣнинъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"армѣнинъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"Αρμένιος","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic армѣнинъ (arměninŭ), from Greek Αρμένιος (Arménios). First attested in 1620."},{"parola":"candelă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"oil lamp","termine_origine":"канъдило","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"канъдило","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"καντήλα","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"candēla","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic канъдило (kanŭdilo) or Greek καντήλα (kantíla), κάνδηλα (kándila), from Latin candēla. Compare Bulgarian кандило (kandilo), Serbo-Croatian kàndilo, Aromanian cãndilã. Compare also Turkish kandil."},{"parola":"catavasie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Katavasia (a type of Eastern Orthodox hymn)","termine_origine":"катавасие","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"катавасие","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"καταβασία","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic катавасие (katavasije), from Greek καταβασία (katavasía)."},{"parola":"chedru","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cedar","termine_origine":"кедръ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"кедръ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κέδρος","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic кедръ (kedrŭ), from Greek κέδρος (kédros). Doublet of cedru."},{"parola":"chelar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"steward in charge of the cellars and supplies","termine_origine":"келарь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"келарь","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κελλάριος","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic келарь (kelarĭ), from Greek κελλάριος (kellários)."},{"parola":"chit","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"whale, cetacean","termine_origine":"китъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"китъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κήτος","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic китъ (kitŭ), from Greek κήτος (kítos). Used around the 16th century."},{"parola":"chivot","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"box on the altar in which the communion wafer is kept","termine_origine":"кивотъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"кивотъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κιβώτιον","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic кивотъ (kivotŭ), from Greek κιβώτιον (kivótion), from κῑβωτός (kivotós, “wooden chest”)."},{"parola":"colivie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bird cage","termine_origine":"коульвиꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"коульвиꙗ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κλουβί","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic коульвиꙗ (kulĭvija), from Greek κλουβί (klouví)."},{"parola":"cositor","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tin (element)","termine_origine":"коситеръ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"коситеръ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κασσίτερος","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic коситеръ (kositerŭ), from Greek κασσίτερος (kassíteros)."},{"parola":"crin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lily","termine_origine":"кринъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"кринъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"κρίνο","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic кринъ (krinŭ), from Greek κρίνο (kríno), from Ancient Greek κρίνον (krínon)."},{"parola":"cămilă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"camel (beast of burden)","termine_origine":"камилъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"камилъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"καμήλα","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic камилъ (kamilŭ), from Greek καμήλα (kamíla)."},{"parola":"har","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"grace","termine_origine":"харь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"харь","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"χάρις","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic харь (xarĭ), from Greek χάρις (cháris)."},{"parola":"icoană","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"icon","termine_origine":"икона","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"икона","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"εικόνα","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic икона (ikona), from Greek εικόνα (eikóna), from Ancient Greek εἰκών (eikṓn). Compare Aromanian icoanã. Doublet of icon."},{"parola":"mantie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cloak, cape, robe","termine_origine":"мантиꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"мантиꙗ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"μάντι","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"mantellum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic мантиꙗ (mantija), from Greek μάντι (mánti), from Latin mantellum. Compare Russian мантия (mantija), Macedonian мантија (mantija), Serbo-Croatian mantija. Doublet of manta and mantou."},{"parola":"metoc","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"small monastery, subordinated to another","termine_origine":"метохъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"метохъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"μετόχι","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic метохъ (metoxŭ), from Greek μετόχι (metóchi); compare Bulgarian метох (metoh)."},{"parola":"migdal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"almond (tree)","termine_origine":"мигдалъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"мигдалъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"αμύγδαλο","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic мигдалъ (migdalŭ), from Greek αμύγδαλο (amýgdalo)."},{"parola":"mănăstire","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"monastery","termine_origine":"монастырь","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"монастырь","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"μοναστήρι","categoria":"non_precisato"}],"lontana":"el","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic монастырь (monastyrĭ), from Greek μοναστήρι (monastíri), from Ancient Greek μοναστήριον (monastḗrion) or directly from the Greek source."},{"parola":"mărturisi","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to confess; to own up, to come clean","termine_origine":"марторисати","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"марторисати","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"μαρτυρώ","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic марторисати (martorisati), from Greek μαρτυρώ (martyró). Compare Bulgarian мартирисвам (martirisvam, “to confess”)."},{"parola":"mătanie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"genuflection or bowing in reverence","termine_origine":"метаниꙗ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"метаниꙗ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"μετάνοια","categoria":"non_precisato"}],"lontana":"el","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic метаниꙗ (metanija, “bow”), from Greek μετάνοια (metánoia, “repentence”). Compare Bulgarian метание (metanie)."},{"parola":"naftă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"petroleum","termine_origine":"нафьта","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"нафьта","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"νάφθα","categoria":"prestito"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic нафьта (nafĭta) or Greek νάφθα (náftha)."},{"parola":"patriarhie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"patriarchy, patriarchate","termine_origine":"патриꙝрхиѥ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"патриꙝрхиѥ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"πατριαρχία","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic патриꙝрхиѥ (patrijęrxije), from Greek πατριαρχία (patriarchía). By surface analysis, patriarh + -ie."},{"parola":"piron","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"big nail, holdfast","termine_origine":"пиронъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"пиронъ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"πιρούνι","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic пиронъ (pironŭ), from Greek πιρούνι (piroúni), from Ancient Greek περόνη (perónē, “pin”)."},{"parola":"sicamenă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sycamore","termine_origine":"сикаминиѥ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"сикаминиѥ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"συκάμινος","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic сикаминиѥ (sikaminije), from Greek συκάμινος (sykáminos)."},{"parola":"sărindar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a mass or prayer for the dead (or also for the sick), done for forty days","termine_origine":"сарандаръ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"сарандаръ","categoria":"prestito"},{"codice":"el","nome":"Greek","termine":"σαράνταρι","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic сарандаръ (sarandarŭ), from Greek σαράνταρι (sarántari), from σαράντα (saránta, “forty”)."}]}