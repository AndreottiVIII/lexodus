{"arrivo":"ro","origine":"bg","origine_nome":"Bulgarian","livello2":"ota","livello2_nome":"Ottoman Turkish","n":5,"parole":[{"parola":"canara","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cliff","termine_origine":"канара","catena":[{"codice":"bg","nome":"Bulgarian","termine":"канара","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"كناره","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"کناره","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Bulgarian канара (kanara), from Ottoman Turkish كناره (känarä, “edge, margin”), from Persian کناره (kanâre, “edge, side”)."},{"parola":"coșcogeamite","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"huge","termine_origine":"коскоджамити","catena":[{"codice":"bg","nome":"Bulgarian","termine":"коскоджамити","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"قوص قوجه","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Bulgarian коскоджамити (koskodžamiti), from Ottoman Turkish قوص قوجه (kos koca)."},{"parola":"malac","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"water buffalo calf","termine_origine":"малак","catena":[{"codice":"bg","nome":"Bulgarian","termine":"малак","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"معلق","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"μαλακός","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Borrowed from Bulgarian малак (malak, “water buffalo calf”), from Ottoman Turkish معلق (malak, “water buffalo calf”), from Greek μαλακός (malakós, “soft, gentle”)."},{"parola":"nevăstuică","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"sì","motivo_incerta":"Probably","significato":"weasel","termine_origine":"невестулка","catena":[{"codice":"bg","nome":"Bulgarian","termine":"невестулка","categoria":"calco"},{"codice":"ota","nome":"Ottoman Turkish","termine":"كلینجك","categoria":"calco"},{"codice":"el","nome":"Greek","termine":"νυφίτσα","categoria":"calco"}],"lontana":"el","ambiti":[],"via":"","testo":"From nevastă + -uică, probably based on a superstitious euphemism. Calque of Bulgarian невестулка (nevestulka), Ottoman Turkish كلینجك (gelincik) or Greek νυφίτσα (nyfítsa). Similar words can also be found throughout the Mediterranean: Italian donnola, Portuguese doninha, Spanish comadreja."},{"parola":"testemel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kerchief","termine_origine":"тестемел","catena":[{"codice":"bg","nome":"Bulgarian","termine":"тестемел","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"دستمال","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"دستمال","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Bulgarian тестемел (testemel), from Ottoman Turkish دستمال (destemal), from Persian دستمال (dastmâl)."}]}