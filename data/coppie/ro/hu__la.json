{"arrivo":"ro","origine":"hu","origine_nome":"Hungarian","livello2":"la","livello2_nome":"Latin","n":7,"parole":[{"parola":"curuț","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"participant in the 1514 Dózsa Rebellion","termine_origine":"kuruc","catena":[{"codice":"hu","nome":"Hungarian","termine":"kuruc","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cruciatus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Hungarian kuruc, from Latin cruciatus."},{"parola":"meșter","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"artisan, skilled or qualified worker, artist, master, expert, handyman","termine_origine":"mester","catena":[{"codice":"hu","nome":"Hungarian","termine":"mester","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"magister","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Hungarian mester, ultimately from Latin magister, and therefore a doublet of maistru, taken directly from German, măiestru (inherited) and maestru, from Italian, magistru, from Latin and master, from English."},{"parola":"notarăș","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"notary","termine_origine":"nótárius","catena":[{"codice":"hu","nome":"Hungarian","termine":"nótárius","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nōtārius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Hungarian nótárius, from Latin nōtārius. Doublet of notar."},{"parola":"otrățel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; Possibly","significato":"common bladderwort (Utricularia vulgaris)","termine_origine":"atracél","catena":[{"codice":"hu","nome":"Hungarian","termine":"atracél","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"utricellus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Possibly from Hungarian atracél (though another term in Romanian also exists deriving from this word, atrățel; it is a doublet). Another proposed theory is Latin utricellus, from utriculus, though this is uncertain, as is a derivation from Slavic *jatrocelъ."},{"parola":"probălui","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to try","termine_origine":"próbálni","catena":[{"codice":"hu","nome":"Hungarian","termine":"próbálni","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"probare","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Hungarian próbálni, from Latin probare, from probo."},{"parola":"pălant","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"seedling","termine_origine":"palánta","catena":[{"codice":"hu","nome":"Hungarian","termine":"palánta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"planta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Hungarian palánta, from Latin planta. Doublet of plantă."},{"parola":"tablă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"board, blackboard","termine_origine":"tábla","catena":[{"codice":"hu","nome":"Hungarian","termine":"tábla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tabula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Hungarian tábla, from Latin tabula."}]}