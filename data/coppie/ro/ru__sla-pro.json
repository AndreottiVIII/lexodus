{"arrivo":"ro","origine":"ru","origine_nome":"Russian","livello2":"sla-pro","livello2_nome":"Proto-Slavic","n":21,"parole":[{"parola":"blinie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"blini","termine_origine":"блин","catena":[{"codice":"ru","nome":"Russian","termine":"блин","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*mlinъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian блин (blin), from Proto-Slavic *mlinъ."},{"parola":"bragă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"millet beer","termine_origine":"брага","catena":[{"codice":"ru","nome":"Russian","termine":"брага","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*braga","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["cucina"],"via":"","testo":"Borrowed from Russian брага (braga), from Proto-Slavic *braga."},{"parola":"caleașcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calèche, carriage","termine_origine":"коляска","catena":[{"codice":"ru","nome":"Russian","termine":"коляска","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*kolo","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kʷekʷlom","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Russian коляска (koljaska), diminutive of колесо (koleso), from Old East Slavic колеса (kolesa), plural of коло (kolo), from Proto-Slavic *kolo (“wheel”), from Proto-Indo-European *kʷekʷlom (“circle”), *kʷékʷlos (“circle”). Cognates include English calèche, French calèche, Polish kołas"},{"parola":"ceahol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cover for a wagon","termine_origine":"чехол","catena":[{"codice":"ru","nome":"Russian","termine":"чехол","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*čexъlъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian чехол (čexol), from Proto-Slavic *čexъlъ."},{"parola":"ceașcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cup","termine_origine":"ча́шка","catena":[{"codice":"ru","nome":"Russian","termine":"ча́шка","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*čašьka","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian ча́шка (čáška), from Proto-Slavic *čašьka."},{"parola":"culic","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"curlew (Numenius genus)","termine_origine":"кулик","catena":[{"codice":"ru","nome":"Russian","termine":"кулик","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*kulikъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian кулик (kulik), from Proto-Slavic *kulikъ. Compare Polish kulik."},{"parola":"drujbă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chainsaw (saw with a power-driven chain)","termine_origine":"Дру́жба","catena":[{"codice":"ru","nome":"Russian","termine":"Дру́жба","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*družьba","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian Дру́жба (Drúžba, trademark), from Russian дру́жба (drúžba, “friendship”), from Proto-Slavic *družьba."},{"parola":"gologan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"copper coin","termine_origine":"голован","catena":[{"codice":"ru","nome":"Russian","termine":"голован","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*golva","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian голован (golovan, “big-headed”), referring to the monarch's head depicted on the coin, from голова (golova, “head”), from Proto-Slavic *golva (“head”)."},{"parola":"gomon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hubbub, noise, uproar","termine_origine":"гомон","catena":[{"codice":"ru","nome":"Russian","termine":"гомон","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*gomonъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian гомон (gomon), from Proto-Slavic *gomonъ."},{"parola":"lancaviu","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sly, crafty, cunning","termine_origine":"лукавый","catena":[{"codice":"ru","nome":"Russian","termine":"лукавый","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*lǫkavъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian лукавый (lukavyj), from Proto-Slavic *lǫkavъ."},{"parola":"lom","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"crowbar","termine_origine":"лом","catena":[{"codice":"ru","nome":"Russian","termine":"лом","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*lomъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian лом (lom), from Proto-Slavic *lomъ."},{"parola":"opis","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"inventory","termine_origine":"опис","catena":[{"codice":"ru","nome":"Russian","termine":"опис","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pisati","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*peyḱ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Russian опис (opis), from описать (opisatʹ, “to make an inventory”), from писать (pisatʹ, “to write”), from Old East Slavic писати (pisati, “to write”), from Proto-Slavic *pisati, from Proto-Indo-European *peyḱ-."},{"parola":"piroșcă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pirozhki","termine_origine":"пирожки","catena":[{"codice":"ru","nome":"Russian","termine":"пирожки","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pirogъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian пирожки (pirožki), plural of пирожок (pirožok), diminutive of пирог (pirog, “pie”), from Proto-Slavic *pirogъ. Compare Polish pieróg, Ukrainian пиріг (pyrih)."},{"parola":"pogrom","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pogrom (riot against a particular ethnic or religious group)","termine_origine":"погром","catena":[{"codice":"ru","nome":"Russian","termine":"погром","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*gromъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian погром (pogrom), from по- (po-) + громи́ть (gromítʹ, “to smash, to sack”), from гром (grom, “roar, thunder”), from Proto-Slavic *gromъ (“thunder”)."},{"parola":"potroacă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chicken offal soup","termine_origine":"потроха","catena":[{"codice":"ru","nome":"Russian","termine":"потроха","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*potroxa","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian потроха (potroxa, “offal”), from Proto-Slavic *potroxa, from *troxa."},{"parola":"stroi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"line of soldiers","termine_origine":"строй","catena":[{"codice":"ru","nome":"Russian","termine":"строй","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*strojь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian строй (stroj), from Old East Slavic строи (stroi), from Proto-Slavic *strojь."},{"parola":"velicorus","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Great Russian","termine_origine":"Великоруссы","catena":[{"codice":"ru","nome":"Russian","termine":"Великоруссы","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*velikъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian Великоруссы (Velikorussy), from велико- (veliko-) + Русь (Rusʹ), from великий (velichii, “great”), from Proto-Slavic *velikъ (“great”)."},{"parola":"vinograd","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"vinaigrette","termine_origine":"виноград","catena":[{"codice":"ru","nome":"Russian","termine":"виноград","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*vinogordъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian виноград (vinograd), from Proto-Slavic *vinogordъ."},{"parola":"zapiscă","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"certificate","termine_origine":"записка","catena":[{"codice":"ru","nome":"Russian","termine":"записка","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pisati","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*peyḱ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Russian записка (zapiska), from записать (zapisatʹ, “to write down, to register”), from писать (pisatʹ, “write”), from Old East Slavic писати (pisati, “to write; to paint”), from Proto-Slavic *pisati, from Proto-Indo-European *peyḱ- (“to paint, draw”). Doublet of zapis."},{"parola":"șip","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"European sea sturgeon, Baltic sturgeon (Acipenser sturio)","termine_origine":"шип","catena":[{"codice":"ru","nome":"Russian","termine":"шип","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*šipъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Russian шип (šip, “thorn sturgeon, thorn”), from Proto-Slavic *šipъ (“thorn”)."},{"parola":"țarevici","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tsarevich","termine_origine":"царевич","catena":[{"codice":"ru","nome":"Russian","termine":"царевич","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*cěsařь","categoria":"non_precisato"},{"codice":"gem","nome":"Germanic","termine":"","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kaisaraz","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"Caesar","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Russian царевич (carevič), from царь (carʹ) + -евич (-evič), from Old East Slavic цьсарь (cĭsarĭ), from цѣсарь (cěsarĭ), from Proto-Slavic *cěsařь, from a Germanic language, from Proto-Germanic *kaisaraz, from Latin Caesar."}]}