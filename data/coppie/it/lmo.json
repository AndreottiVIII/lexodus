mine":"*capito","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Presumably borrowed from Lombard cavédan, from Vulgar Latin *capitinem, from Latin capitōnem. Doublet of cavedine f and capitone."},{"parola":"cesata","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"(technical, administrative); fence of a construction site","termine_origine":"cesada","catena":[{"codice":"lmo","nome":"Lombard","termine":"cesada","categoria":"prestito"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Borrowed from Lombard cesada"},{"parola":"ciulare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to fuck, to screw [with con]","termine_origine":"ciolà","catena":[{"codice":"lmo","nome":"Lombard","termine":"ciolà","categoria":"prestito"},{"codice":"rom","nome":"Romani","termine":"ćor","categoria":"non_precisato"}],"lontana":"rom","ambiti":[],"via":"","testo":"Borrowed from Lombard ciolà, from Romani ćor (“thief”). Compare Spanish chorear (“to steal”)."},{"parola":"fesa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"obscure","significato":"rump of veal or beef","termine_origine":"","catena":[{"codice":"lmo","nome":"Lombard","termine":"","categoria":"non_precisato"}],"lontana":"lmo","ambiti":["cucina"],"via":"","testo":"Of obscure Lombard source."},{"parola":"fotbalino","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"table football, table soccer, foosball","termine_origine":"","catena":[{"codice":"lmo","nome":"Lombard","termine":"","categoria":"prestito"}],"lontana":"lmo","ambiti":["sport"],"via":"","testo":"From English football + -ino (diminutive suffix), probably via Lombard."},{"parola":"fraina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buckwheat","termine_origine":"fraina","catena":[{"codice":"lmo","nome":"Lombard","termine":"fraina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"farragō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Lombard fraina, from Latin farragō. Doublet of farragine."},{"parola":"girabacchino","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"brace (tool), brace and bit","termine_origine":"","catena":[{"codice":"lmo","nome":"Lombard","termine":"","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"vilebrequin","categoria":"non_precisato"},{"codice":"dum","nome":"Middle Dutch","termine":"wimmelkijn","categoria":"non_precisato"}],"lontana":"dum","ambiti":[],"via":"","testo":"Lombard [Term?], altered from French vilebrequin (under the influence of girare (“to turn”)), from Middle Dutch wimmelkijn, diminutive of wimmel (“drill”)."},{"parola":"lubbione","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gallery (in a theater)","termine_origine":"lobbión","catena":[{"codice":"lmo","nome":"Lombard","termine":"lobbión","categoria":"non_precisato"}],"lontana":"lmo","ambiti":[],"via":"","testo":"From Lombard lobbión (“loggia”)."},{"parola":"malmostoso","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"sulky, surly, sullen, gruff","termine_origine":"malmostos","catena":[{"codice":"lmo","nome":"Lombard","termine":"malmostos","categoria":"non_precisato"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Derived from Lombard malmostos (“surly, grumpy”, literally “badly juicy”), derived from mal (“badly”) + mostos (“producing must; juicy”, adjective). By surface analysis, mal- + mostoso."},{"parola":"menagramo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jinx (person who is thought to bring bad luck)","termine_origine":"menagràm","catena":[{"codice":"lmo","nome":"Lombard","termine":"menagràm","categoria":"prestito"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Borrowed from Lombard menagràm. By surface analysis, verb-object compound, composed of mena (“to bring”) + gramo (“wretched (things)”)."},{"parola":"meneghino","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Milanese","termine_origine":"Mènegh","catena":[{"codice":"lmo","nome":"Lombard","termine":"Mènegh","categoria":"non_precisato"}],"lontana":"lmo","ambiti":[],"via":"","testo":"From Lombard Mènegh, a male given name corresponding to Italian Domenico (“Dominic”). Compare Venetan Ménego."},{"parola":"monatto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Of uncertain origin; modello unc/uncertain","significato":"during the 17th and 18th centuries, a person who removed corpses during a plague, usually in Milan","termine_origine":"monatt","catena":[{"codice":"lmo","nome":"Lombard","termine":"monatt","categoria":"prestito"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Borrowed from Lombard monatt, of uncertain origin."},{"parola":"mondeghino","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"a type of meatball","termine_origine":"mondeghin","catena":[{"codice":"lmo","nome":"Lombard","termine":"mondeghin","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"albondiguilla","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"بندق","categoria":"non_precisato"},{"codice":"ca","nome":"Catalan","termine":"mandonguilla","categoria":"non_precisato"}],"lontana":"ca","ambiti":["cucina"],"via":"","testo":"Borrowed from Lombard mondeghin (plural mondeghitt), a variant of mondeghili, from Spanish albondiguillo or albondiguito, diminutive form of albóndiga (“meatball”), from Arabic البُنْدُقة (al-bunduqa, literally “the hazelnut”), possibly through Catalan mondonguilla."},{"parola":"ossobuco","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"osso buco (Italian meat dish)","termine_origine":"òss bus","catena":[{"codice":"lmo","nome":"Lombard","termine":"òss bus","categoria":"calco"}],"lontana":"lmo","ambiti":["cucina"],"via":"","testo":"From osso (“bone”) + buco (“hole”, or as an adjective, “hollow”), calqued from Milanese Lombard òss bus."},{"parola":"panettone","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"panettone (Christmas brioche with candied fruit)","termine_origine":"panaton","catena":[{"codice":"lmo","nome":"Lombard","termine":"panaton","categoria":"prestito"}],"lontana":"lmo","ambiti":["cucina"],"via":"","testo":"From Milanese Lombard panaton, an augmentative of pan (“bread”). In sense 2, for its shape."},{"parola":"patta","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"flap (of a pocket)","termine_origine":"*paita","catena":[{"codice":"lmo","nome":"Lombard","termine":"*paita","categoria":"prestito"},{"codice":"lng","nome":"Lombardic","termine":"paita","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*paidu","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*paidō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Lombard *paita, from Lombardic paita, from Proto-West Germanic *paidu, from Proto-Germanic *paidō (“coat, smock, shirt”). Cognate with Old High German pfeit."},{"parola":"prestinaio","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"baker","termine_origine":"prestinee","catena":[{"codice":"lmo","nome":"Lombard","termine":"prestinee","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"pistrīnārius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"An adaptation of Lombard prestinee or pristinee, from Late Latin pistrīnārius, from pistrīnum (“mill, bakery”), in turn from pistor (“baker”), + -ārius."},{"parola":"prevosto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"provost","termine_origine":"prevost","catena":[{"codice":"lmo","nome":"Lombard","termine":"prevost","categoria":"prestito"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Borrowed from Lombard prevost."},{"parola":"prillare","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"to twirl, whirl or spin","termine_origine":"birlà","catena":[{"codice":"lmo","nome":"Lombard","termine":"birlà","categoria":"non_precisato"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Of imitative origin, compare Lombard birlà, birlo. Possibly related with birillo."},{"parola":"sardena","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shad (Alosa agone)","termine_origine":"sardena","catena":[{"codice":"lmo","nome":"Lombard","termine":"sardena","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sardīna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Lombard sardena, from Latin sardīna. Doublet of sardina."},{"parola":"scamone","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"synonym of culaccio: rump/sirloin (cut of meat)","termine_origine":"","catena":[{"codice":"lmo","nome":"Lombard","termine":"","categoria":"non_precisato"}],"lontana":"lmo","ambiti":["cucina"],"via":"","testo":"From Lombard."},{"parola":"schiscetta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a container for the transport and consumption of food; a hamper; a mess tin","termine_origine":"","catena":[{"codice":"lmo","nome":"Lombard","termine":"","categoria":"prestito"}],"lontana":"lmo","ambiti":[],"via":"","testo":"Western Lombard, from From schiscià (“to crush”) + -etta (diminutive suffix), in reference to its flat shape. By surface analysis, schiacciare + -etta."},{"parola":"serizzo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significa