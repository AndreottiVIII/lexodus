{"arrivo":"it","origine":"la-vul","origine_nome":"Vulgar Latin","livello2":"frk","livello2_nome":"Frankish","n":12,"parole":[{"parola":"bisogno","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"need","termine_origine":"*bisonium","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bisonium","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*bisunnija","categoria":"prestito"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *bisonium, borrowed from Frankish *bisunnija."},{"parola":"bucato","pos":"noun","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"washing, laundry","termine_origine":"*būcāta","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*būcāta","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*būkōn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *būcāta, from Frankish *būkōn (“to submerge; to wash”). Cognate with Catalan bugada and French buée."},{"parola":"crosciare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to roar (of rain or falling water)","termine_origine":"*cruscīre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cruscīre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*krustijan","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *cruscīre, from Frankish *krustijan. Otherwise is just another onomatopoeic word. Compare Spanish crujir, Old French croissir"},{"parola":"greppia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"manger","termine_origine":"*creppea","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*creppea","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*krippija","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","ter