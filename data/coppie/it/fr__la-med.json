{"arrivo":"it","origine":"fr","origine_nome":"French","livello2":"la-med","livello2_nome":"Medieval Latin","n":11,"parole":[{"parola":"autorizzare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to give permission; to warrant or authorize","termine_origine":"autoriser","catena":[{"codice":"fr","nome":"French","termine":"autoriser","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"auctorizo","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from French autoriser, from Medieval Latin auctōrizāre. Doublet of ottriare."},{"parola":"carlina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"carline (thistle of genus Carlina)","termine_origine":"carline","catena":[{"codice":"fr","nome":"French","termine":"carline","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"carlina","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from French carline, from Medieval Latin carlina, probably from cardina, a diminutive of Latin carduus (“thistle”), with influence from Carolus Magnus due to an association with Charlemagne."},{"parola":"ciambellano","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chamberlain","termine_origine":"chambellan","catena":[{"codice":"fr","nome":"French","termine":"chambellan","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"camerlingus","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From French chambellan, from Old French chamberlein, Medieval Latin camerlingus, from Frankish. Doublet of camerlengo. See also Old French chambre for details on the sound change from Latin camera."},{"parola":"coalizione","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"coalition","termine_origine":"coalition","catena":[{"codice":"fr","nome":"French","termine":"coalition","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"coalitiō","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from French coalition, from Medieval Latin coalitiōnem (“association”)."},{"parola":"controllo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"check, control, verification, examination, inspection","termine_origine":"contrôle","catena":[{"codice":"fr","nome":"French","termine":"contrôle","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"contrarotula","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":["scienza"],"via":"","testo":"Borrowed from French contrôle."},{"parola":"domino","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"long robe shaped as a cloak with a hood, worn at masked balls","termine_origine":"domino","catena":[{"codice":"fr","nome":"French","termine":"domino","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"dominō","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from French domino, from Medieval Latin dominō, dative of Latin dominus (“lord, master”); possibly from the liturgical phrase benedīcāmus Dominō (literally “let us bless the Lord”)."},{"parola":"filtro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"filter","termine_origine":"filtre","catena":[{"codice":"fr","nome":"French","termine":"filtre","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"filtrum","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*filtir","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*felt","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*peld-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from French filtre, from Medieval Latin filtrum, from Frankish *filtir, plural of *filt, from Proto-West Germanic *felt (“felt”), derived from Proto-Indo-European *peld- (“something beaten or compressed; felt”), derived from the root *pelh₂- (“to beat; to push”)."},{"parola":"garzone","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"(young) boy","termine_origine":"garçon","catena":[{"codice":"fr","nome":"French","termine":"garçon","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"garciō","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*wrakkjō","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wrakjô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from French garçon, from Old French garçon, from Medieval Latin garciō, from earlier *warciō, from Frankish *wrakkijō (“mercenary; servant”), from Proto-Germanic *wrakjô (“exile; warrior”). Cognate with Sicilian jarzuni."},{"parola":"incolore","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"colourless/colorless","termine_origine":"incolore","catena":[{"codice":"fr","nome":"French","termine":"incolore","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"incolor","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from French incolore, from Medieval Latin incolōrem, from in- + color."},{"parola":"radiare","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"to expel (from a group, institution, etc.) (typically as a disciplinary measure)","termine_origine":"radier","catena":[{"codice":"fr","nome":"French","termine":"radier","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"radiō","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"roier","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*riga","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*rica","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":["mare"],"via":"","testo":"Borrowed from French radier, from Medieval Latin radiāre (“to expunge, to delete”), a false relatinization of Old French roier (“to draw a line, to cross out”) (modern French rayer), from roie (“line, ridge between furrows”), from Vulgar Latin *riga, probably from Gaulish *rica (“furrow”)."},{"parola":"ultramontano","pos":"adj|noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"ultramontane","termine_origine":"ultramontain","catena":[{"codice":"fr","nome":"French","termine":"ultramontain","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"ultrāmontānus","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["religione"],"via":"","testo":"Borrowed from French ultramontain, from Medieval Latin ultrāmontānus. By surface analysis, from ultramontano. It was originally used to describe non-Italian supporters of the Pope, as they where \"beyond the mountains\" from Rome."}]}