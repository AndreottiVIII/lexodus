{"arrivo":"it","origine":"la","origine_nome":"Latin","livello2":"cel-gau","livello2_nome":"Gaulish","n":12,"parole":[{"parola":"alauda","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"skylark","termine_origine":"alauda","catena":[{"codice":"la","nome":"Latin","termine":"alauda","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"*alauda","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Learned borrowing from Latin alauda, borrowed from Gaulish *alauda (“skylark”, literally “tuft”). Synonym and doublet of allodola."},{"parola":"alosa","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"shad (fish)","termine_origine":"alausa","catena":[{"codice":"la","nome":"Latin","termine":"alausa","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*alausa","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Latin alausa, from Gaulish *alausa."},{"parola":"becco","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"beak (structure projecting from a bird's face)","termine_origine":"beccus","catena":[{"codice":"la","nome":"Latin","termine":"beccus","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*bekkos","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*bekkos","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":["finanza","scienza"],"via":"","testo":"Inherited from Latin beccus, from Gaulish *bekkos, from Proto-Celtic *bekkos."},{"parola":"benna","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bucket, grab","termine_origine":"benna","catena":[{"codice":"la","nome":"Latin","termine":"benna","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"benna","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"From Latin benna (“carriage”), from Gaulish benna (“carriage”)."},{"parola":"betulla","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"birch","termine_origine":"betulla","catena":[{"codice":"la","nome":"Latin","termine":"betulla","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*betua","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*betwiyos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gʷet-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Latin betulla, diminutive of Gaulish *betua, from Proto-Celtic *betwiyos, *betuyā (“birch”), from Proto-Indo-European *gʷet-. Compare Portuguese bétula, Spanish abedul, Catalan bedoll, French bouleau."},{"parola":"brocco","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"thorn, stick","termine_origine":"broccus","catena":[{"codice":"la","nome":"Latin","termine":"broccus","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*brokkos","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*brokkos","categoria":"ereditato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Inherited from Latin broccus (“protruding (of the teeth)”), of Gaulish origin, related to Irish brog (“awl”)."},{"parola":"broccolo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"broccoli","termine_origine":"broccus","catena":[{"codice":"la","nome":"Latin","termine":"broccus","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":["cucina"],"via":"","testo":"From brocco (“shoot, sprout”) + -olo (which is also the origin of brocade), from Latin broccus (“projecting, pointed”), of Gaulish origin, related to Irish brog (“awl”). Cognate with Sicilian vròcculu."},{"parola":"carro","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a wagon, cart, van, lorry or truck (a means of transport used to carry goods)","termine_origine":"carrus","catena":[{"codice":"la","nome":"Latin","termine":"carrus","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*karros","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*karros","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ḱr̥sós","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Latin carrus. Doublet of curro."},{"parola":"gladio","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"Possibly","significato":"rapier, sword","termine_origine":"gladius","catena":[{"codice":"la","nome":"Latin","termine":"gladius","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"*kladyos","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kladiwos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kelh₂-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Latin gladius, possibly from Gaulish *kladyos (“sword”), from Proto-Celtic *kladiwos (“sword”), from the Proto-Indo-European *kelh₂- (“to beat, break”)."},{"parola":"samara","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"samara (winged indehiscent fruit of trees such as the ash, elm or maple)","termine_origine":"samara","catena":[{"codice":"la","nome":"Latin","termine":"samara","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*samos","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Latin samara, from a Gaulish term derived from Proto-Celtic *samos (“summer”)."},{"parola":"vasso","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"vassal","termine_origine":"vassus","catena":[{"codice":"la","nome":"Latin","termine":"vassus","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"*wassos","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*wastos","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Learned borrowing from Latin vassus, from Gaulish *wassos (“young man, squire”), from Proto-Celtic *wastos (“servant”)."},{"parola":"virola","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ferrule","termine_origine":"viriola","catena":[{"codice":"la","nome":"Latin","termine":"viriola","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*weiros","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Latin viriola (“little bracelet”), diminutive of viria (“bracelet”), from Gaulish, from Proto-Celtic *weiros (“crooked”)."}]}