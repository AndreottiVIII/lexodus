{"arrivo":"it","origine":"en","origine_nome":"English","livello2":"fr","livello2_nome":"French","n":16,"parole":[{"parola":"altoparlante","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"speaker, loudspeaker","termine_origine":"loudspeaker","catena":[{"codice":"en","nome":"English","termine":"loudspeaker","categoria":"calco"},{"codice":"fr","nome":"French","termine":"haut-parleur","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"From alto- + parlante, a calque of English loudspeaker modelled on French haut-parleur."},{"parola":"autocarro","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"lorry/truck","termine_origine":"","catena":[{"codice":"en","nome":"English","termine":"","categoria":"calco"},{"codice":"fr","nome":"French","termine":"autocar","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"From auto- (“car”) + carro (“wagon”), calquing English and French autocar."},{"parola":"bowling","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ten-pin bowling","termine_origine":"bowling","catena":[{"codice":"en","nome":"English","termine":"bowling","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"bowling","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"Unadapted borrowing from English bowling. The sense \"bowling alley\" is a pseudo-anglicism derived from an ellipsis of English bowling alley, borrowed from French bowling."},{"parola":"boxare","pos":"verb","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"to box (fight in a ring)","termine_origine":"to box","catena":[{"codice":"en","nome":"English","termine":"to box","categoria":"calco"},{"codice":"fr","nome":"French","termine":"boxer","categoria":"calco"}],"lontana":"fr","ambiti":["sport"],"via":"","testo":"From boxe + -are, on the model of English to box, French boxer."},{"parola":"colossal","pos":"noun","n_etimologia":1,"categoria":"non_