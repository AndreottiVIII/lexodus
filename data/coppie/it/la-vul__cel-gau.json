{"arrivo":"it","origine":"la-vul","origine_nome":"Vulgar Latin","livello2":"cel-gau","livello2_nome":"Gaulish","n":10,"parole":[{"parola":"allodola","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"skylark (Alauda arvensis)","termine_origine":"*alaudula","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alaudula","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"From a Vulgar Latin *alaudula, the diminutive of Latin alauda (“lark”), of Gaulish origin. Doublet of alauda."},{"parola":"barra","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"rod, bar, slat","termine_origine":"*barra","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*barra","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*barros","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":["scienza"],"via":"","testo":"From Vulgar Latin *barra, possibly from Gaulish *barros (“the bushy end”). Doublet of bar."},{"parola":"barricare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"to barricade","termine_origine":"*barrica","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*barrica","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"From Vulgar Latin *barrica, from *barra, possibly ultimately from Gaulish."},{"parola":"cantina","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"perhaps","significato":"cellar, basement, winery","termine_origine":"*canthus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*canthus","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*cantos","categoria":"non_precisato"},{"codice":"ce