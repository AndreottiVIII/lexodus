ito","incerta":"no","significato":"macramé","termine_origine":"مقرمه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"مقرمه","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"مِقْرَمَة","categoria":"non_precisato"},{"codice":"sem-pro","nome":"Proto-Semitic","termine":"*q-r-m","categoria":"non_precisato"}],"lontana":"sem-pro","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish مقرمه (makrame), from Arabic مِقْرَمَة (miqrama, “ornamental fringe, embroidered veil”), from مِقْرَم (miqram, “bedspread”), from قَرَمَ (qarama, “to gnaw”), from Proto-Semitic *q-r-m."},{"parola":"manti","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"manti (meat-filled pockets of pasta in Turkey and Central Asia)","termine_origine":"مانطی","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"مانطی","categoria":"non_precisato"}],"lontana":"ota","ambiti":[],"via":"","testo":"From Ottoman Turkish مانطی (mantı) or Turkish mantı."},{"parola":"mavì","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sky blue","termine_origine":"ماوی","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"ماوی","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"مَاوِيّ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish ماوی (mavi), from Arabic مَاوِيّ (māwiyy, “watery”)."},{"parola":"minareto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"minaret","termine_origine":"","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"مناره","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"مَنَارَة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish or Turkish minare, from Persian مناره (menâre), from Arabic مَنَارَة (manāra, “lighthouse”)."},{"pa