{"arrivo":"it","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"fr","livello2_nome":"French","n":17,"parole":[{"parola":"aperitivo","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"an apéritif","termine_origine":"aperītīvus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"aperītīvus","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"apéritif","categoria":"non_precisato"}],"lontana":"fr","ambiti":["cucina"],"via":"","testo":"Borrowed from Medieval Latin aperītīvus, from Late Latin apertīvus, from Latin aperiō, and partly from French apéritif.","origine_varieta":"la-med"},{"parola":"colare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to strain (pasta, etc.)","termine_origine":"cōlō","catena":[{"codice":"la","nome":"Latin","termine":"cōlō","categoria":"ereditato"},{"codice":"fr","nome":"French","termine":"couler","categoria":"prestito"}],"lontana":"fr","ambiti":["mare"],"via":"","testo":"Inherited from Latin cōlāre. The meaning \"to sink (of a ship)\" is mediated through French couler, from the same source.","origine_varieta":"la"},{"parola":"cordiale","pos":"adj|noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"warm, cordial","termine_origine":"cordiālis","catena":[{"codice":"la","nome":"Latin","termine":"cordiālis","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Latin cordiālis. Noun meaning via French.","origine_varieta":"la"},{"parola":"destinatario","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"addressee; consignee; payee; destinatary (who is the destination of a performance)","termine_origine":"destinātārius","catena":[{"codice":"la","nome":"Latin","termine":"destinātārius","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"destinataire","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Latin destinātārius and French destinataire.","origine_varieta":"la"},{"parola":"dissecare","pos":"verb","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"Possibly","significato":"to dissect","termine_origine":"dissecō","catena":[{"codice":"la","nome":"Latin","termine":"dissecō","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"disséquer","categoria":"non_precisato"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"Borrowed from Latin dissecāre, possibly through French disséquer.","origine_varieta":"la"},{"parola":"floreale","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"floral","termine_origine":"flōreus","catena":[{"codice":"la","nome":"Latin","termine":"flōreus","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"floréal","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"From Latin flōreus (“flowery”) + -ale, the noun as a calque of French floréal.","origine_varieta":"la"},{"parola":"germile","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"synonym of germinale","termine_origine":"germen","catena":[{"codice":"la","nome":"Latin","termine":"germen","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"germinal","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"From Latin germen (“sprout, bud”) + -ile, calque of French germinal.","origine_varieta":"la"},{"parola":"germinale","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"germinal","termine_origine":"germen","catena":[{"codice":"la","nome":"Latin","termine":"germen","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"germinal","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"From Latin germin- (“sprout, bud”) + -ale, the noun as a calque of French germinal.","origine_varieta":"la"},{"parola":"morganatico","pos":"adj","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"Possibly","significato":"morganatic","termine_origine":"morganaticus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"morganaticus","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"morganatique","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*murgnagebō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin morganaticus (possibly via French morganatique), from Proto-Germanic *murgnagebō (“morning-gift”) (compare Old High German morgangeba), from *murginaz (“morning”) + *gēbǭ (“gift”).","origine_varieta":"la-med"},{"parola":"nevoso","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"Nivôse (the fourth month of the French Republican Calendar)","termine_origine":"nivōsus","catena":[{"codice":"la","nome":"Latin","termine":"nivōsus","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"nivôse","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"Taken from Latin nivōsus (“snowy”), as a calque of French nivôse.","origine_varieta":"la"},{"parola":"percettivo","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"perceptive","termine_origine":"perceptus","catena":[{"codice":"la","nome":"Latin","termine":"perceptus","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"perceptif","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"perceptivus","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Formed from percetto + -ivo (from Latin perceptus), based on French perceptif, or borrowed from Medieval Latin perceptivus.","origine_varieta":"la"},{"parola":"piovoso","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"Pluviôse (the fifth month of the French Republican Calendar)","termine_origine":"pluviōsus","catena":[{"codice":"la","nome":"Latin","termine":"pluviōsus","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"pluviôse","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"Taken from Latin pluviōsus (“rainy”), as a calque of French pluviôse.","origine_varieta":"la"},{"parola":"pulsante","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"button (to be pushed)","termine_origine":"pulsāns","catena":[{"codice":"la","nome":"Latin","termine":"pulsāns","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"poussoir","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Latin pulsantem. The sense “button” is a calque of French poussoir.","origine_varieta":"la"},{"parola":"relegazione","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"relegation","termine_origine":"relegatio","catena":[{"codice":"la","nome":"Latin","termine":"relegatio","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"relégation","categoria":"prestito"}],"lontana":"fr","ambiti":["sport"],"via":"","testo":"Borrowed from Latin relēgātiōnem; in the sports context, borrowed from French relégation.","origine_varieta":"la"},{"parola":"sorta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"sort, type, kind","termine_origine":"*sorta","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sorta","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"sorte","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"From a Vulgar Latin *sorta, itself from Latin sortem, possibly through French sorte.","origine_varieta":"la-vul"},{"parola":"ventoso","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"Ventôse (the sixth month of the French Republican Calendar)","termine_origine":"ventōsus","catena":[{"codice":"la","nome":"Latin","termine":"ventōsus","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"ventôse","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"Taken from Latin ventōsus (“windy”), as a calque of French ventôse.","origine_varieta":"la"},{"parola":"vivanda","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"food, viand","termine_origine":"*vīvanda","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*vīvanda","categoria":"ereditato"},{"codice":"fr","nome":"French","termine":"viande","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"From Vulgar Latin *vīvanda, from Latin vīvenda, from the neuter plural form of vīvendus, from vīvere (“to live”), or more likely borrowed from French viande","origine_varieta":"la-vul"}]}