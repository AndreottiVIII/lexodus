{"arrivo":"it","origine":"pro","origine_nome":"Old Occitan","livello2":"la-lat","livello2_nome":"Late Latin","n":11,"parole":[{"parola":"aguglia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"large sewing needle; compass needle","termine_origine":"agulha","catena":[{"codice":"pro","nome":"Old Occitan","termine":"agulha","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"acūcula","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old Occitan agulha, from Late Latin acūcula, diminutive of Latin acus (“needle”) (whence Italian ago). Doublet of agucchia, now rare. Compare Sicilian agugghia."},{"parola":"augello","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bird","termine_origine":"auzel","catena":[{"codice":"pro","nome":"Old Occitan","termine":"auzel","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"aucellus","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Old Occitan auzel, from Late Latin aucellus m (“little bird”), a diminutive ultimately based on Latin avis f (“bird”). Doublet of uccello, the native counterpart. Compare Sicilian auceḍḍu."},{"parola":"carpentiere","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"carpenter","termine_origine":"carpentier","catena":[{"codice":"pro","nome":"Old Occitan","termine":"carpentier","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"carpentārius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Old Occitan carpentier, from Late Latin carpentārius (“carpenter”), from Latin carpentārius (“wagon-maker, carriage-maker”)."},{"parola":"carriera","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"career","termine_origine":"carreira","catena":[{"codice":"pro","nome":"Old Occitan","termine":"carreira","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"carrāria","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old Occitan carreira or its variants (compare modern Occitan carrièra, also French carrière), from Late Latin carrāria, from Latin carrus. Compare the inherited doublet carraia, now archaic."},{"parola":"cavaliere","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rider or horseman","termine_origine":"cavalier","catena":[{"codice":"pro","nome":"Old Occitan","termine":"cavalier","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"caballārius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old Occitan cavalier (cf. also Old French chevalier), from Late Latin caballārius. See cavallo + -iere. Doublet of cavallaio."},{"parola":"guglia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"spire","termine_origine":"agulha","catena":[{"codice":"pro","nome":"Old Occitan","termine":"agulha","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"acūcula","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["arte"],"via":"","testo":"Apheretic of aguglia, borrowed from Old Occitan agulha, from Late Latin acūcula, a diminutive of Latin acus (“needle, pin”)."},{"parola":"maestrale","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"north-west","termine_origine":"maestral","catena":[{"codice":"pro","nome":"Old Occitan","termine":"maestral","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"magistrālis","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Old Occitan maestral, from Late Latin magistrālis (ventus) (“master (wind)”)."},{"parola":"malvagio","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wicked, malign","termine_origine":"malvatz","catena":[{"codice":"pro","nome":"Old Occitan","termine":"malvatz","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"malifātius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old Occitan malvatz, from Late Latin malifātius (“unfortunate”). Cognate with Spanish and Portuguese malvado, and more distantly with French mauvais."},{"parola":"riparare","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"to escape, to flee, to take refuge","termine_origine":"repairar","catena":[{"codice":"pro","nome":"Old Occitan","termine":"repairar","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"repatriāre","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old Occitan repairar, itself from Late Latin repatriāre (“return to one's country”), from Latin patria."},{"parola":"scudiero","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a squire","termine_origine":"escudier","catena":[{"codice":"pro","nome":"Old Occitan","termine":"escudier","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"scūtārius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["sport"],"via":"","testo":"Borrowed from Old Occitan escudier, from Late Latin scūtārius, from Latin scūtum. Compare French écuyer."},{"parola":"sembrare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to seem, to look (like), to appear","termine_origine":"semblar","catena":[{"codice":"pro","nome":"Old Occitan","termine":"semblar","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"similō","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old Occitan semblar, from Late Latin similāre, a verb based on Latin similis (“similar”). More or less a doublet of somigliare."}]}