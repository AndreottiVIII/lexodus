","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"From Medieval Latin tamisium, probably from Gaulish. Compare French tamis.","origine_varieta":"la-med"},{"parola":"vasso","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"vassal","termine_origine":"vassus","catena":[{"codice":"la","nome":"Latin","termine":"vassus","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"*wassos","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*wastos","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Learned borrowing from Latin vassus, from Gaulish *wassos (“young man, squire”), from Proto-Celtic *wastos (“servant”).","origine_varieta":"la"},{"parola":"vera","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"wedding ring, wedding band","termine_origine":"viria","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"viria","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*viros","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*weiros","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*weyh₁ros","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["arte"],"via":"","testo":"From Late Latin viria (“bracelet”), from Gaulish *viros (“round, crooked”), from Proto-Celtic *weiros (“crooked”), from Proto-Indo-European *weyh₁ros (“turned, twisted, threaded”), from *weyh₁- (“to turn, twist, weave”).","origine_varieta":"la-lat"},{"parola":"virola","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ferrule","termine_origine":"viriola","catena":[{"codice":"la","nome":"Latin","termine":"viriola","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*weiros","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Latin viriola (“little bracelet”), diminutive of viria (“bracelet”), from Gaulish, from Proto-Celtic *weiros (“crooked”).","origine_varieta":"la"}]}