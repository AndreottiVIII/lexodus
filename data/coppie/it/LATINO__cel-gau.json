{"arrivo":"it","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"cel-gau","livello2_nome":"Gaulish","n":32,"parole":[{"parola":"alauda","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"skylark","termine_origine":"alauda","catena":[{"codice":"la","nome":"Latin","termine":"alauda","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"*alauda","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Learned borrowing from Latin alauda, borrowed from Gaulish *alauda (“skylark”, literally “tuft”). Synonym and doublet of allodola.","origine_varieta":"la"},{"parola":"allodola","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"skylark (Alauda arvensis)","termine_origine":"*alaudula","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alaudula","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"From a Vulgar Latin *alaudula, the diminutive of Latin alauda (“lark”), of Gaulish origin. Doublet of alauda.","origine_varieta":"la-vul"},{"parola":"alosa","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"shad (fish)","termine_origine":"alausa","catena":[{"codice":"la","nome":"Latin","termine":"alausa","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*alausa","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Latin alausa, from Gaulish *alausa.","origine_varieta":"la"},{"parola":"bacino","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"bowl","termine_origine":"bacchinon","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"bacchinon","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","amb