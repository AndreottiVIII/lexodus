ice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*meinis","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":["militare"],"via":"","testo":"From Late Latin mina, from Gaulish [Term?], from Proto-Celtic *meinis (“ore, metal”).","origine_varieta":"la-lat"},{"parola":"minare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to mine","termine_origine":"*mina","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*mina","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*meina","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*meinis","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Vulgar Latin *mina, Gaulish *meina (see also Welsh mwyn, Middle Irish míanach (“ore”)), from Proto-Celtic *meinis (“ore, metal”).","origine_varieta":"la-vul"},{"parola":"montone","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ram (male sheep)","termine_origine":"*multo","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*multo","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*molto-","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":["scienza"],"via":"","testo":"Inherited from Vulgar Latin *multōnem, from Gaulish, from Proto-Celtic *molto-.","origine_varieta":"la-vul"},{"parola":"mucciare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"perhaps","significato":"to escape, to slip away, to slip through someone's fingers","termine_origine":"*muciō","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*muciō","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*mūk-",