{"arrivo":"it","origine":"pro","origine_nome":"Old Occitan","livello2":"la","livello2_nome":"Latin","n":14,"parole":[{"parola":"desirare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to wish, desire","termine_origine":"dezirar","catena":[{"codice":"pro","nome":"Old Occitan","termine":"dezirar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dēsīderō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan dezirar, from Latin dēsīderāre (“to want, desire”). Doublet of desiderare."},{"parola":"gente","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"noble","termine_origine":"gent","catena":[{"codice":"pro","nome":"Old Occitan","termine":"gent","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"􂀿homō􂁀 gentis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan gent, from Latin [homō] gentis (“[man] of noble family”)."},{"parola":"governale","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"vane (of a bomb etc.)","termine_origine":"governal","catena":[{"codice":"pro","nome":"Old Occitan","termine":"governal","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gubernāculum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan governal, from Latin gubernāculum."},{"parola":"inveggia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"envy","termine_origine":"enveja","catena":[{"codice":"pro","nome":"Old Occitan","termine":"enveja","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"invidia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan enveja, from Latin invidia. Cognate with Sicilian mmija."},{"parola":"maglia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stitch","termine_origine":"malha","catena":[{"codice":"pro","nome":"Old Occitan","termine":"malha","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"macula","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*smaklom","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["moda","sport"],"via":"","testo":"Borrowed from Old Occitan malha, from Latin macula (“mesh”). Compare Spanish malla, French maille and Portuguese malha."},{"parola":"miraglio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mirror","termine_origine":"miralh","catena":[{"codice":"pro","nome":"Old Occitan","termine":"miralh","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"miror","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"Borrowed from Old Occitan miralh, ultimately derived from Latin mīrārī (“gaze at”)."},{"parola":"mudare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to moult (to shed and replace feathers)","termine_origine":"mudar","catena":[{"codice":"pro","nome":"Old Occitan","termine":"mudar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mūtō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan mudar, from Latin mūtāre (“to change”). Doublet of mutare."},{"parola":"noia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"boredom, tediousness","termine_origine":"enoja","catena":[{"codice":"pro","nome":"Old Occitan","termine":"enoja","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"inodiō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Probably from Old Occitan enoja, from enojar, ultimately from Latin inodiō. See more at annoiare. Cognate with French ennui, Spanish enojo, Portuguese nojo and Galician noxo."},{"parola":"rai","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rays","termine_origine":"rai","catena":[{"codice":"pro","nome":"Old Occitan","termine":"rai","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"radius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan rai, from Latin radius. Doublet of raggio, razzo, and radio, the first two of which were inherited from Latin, while the last was borrowed from Latin."},{"parola":"sconfiggere","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to overcome, to defeat","termine_origine":"esconfire","catena":[{"codice":"pro","nome":"Old Occitan","termine":"esconfire","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"*excōnficiō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan esconfire, from Latin *excōnficiō, from ex- + cōnficiō."},{"parola":"sobranzare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to overwhelm, to overpower, to win","termine_origine":"sobransar","catena":[{"codice":"pro","nome":"Old Occitan","termine":"sobransar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"superō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan sobransar, derived from sobrar, from Latin superāre (“to rise over, go over”)."},{"parola":"sonetto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sonnet","termine_origine":"sonet","catena":[{"codice":"pro","nome":"Old Occitan","termine":"sonet","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sonus","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Borrowed from Old Occitan sonet (“a song”), diminutive of son (“song, sound”), from Latin sonus (“sound”)."},{"parola":"speglio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mirror","termine_origine":"espelh","catena":[{"codice":"pro","nome":"Old Occitan","termine":"espelh","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"speculum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan espelh, from Latin speculum. Doublet of specchio."},{"parola":"vegliare","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to watch over, to care for","termine_origine":"velhar","catena":[{"codice":"pro","nome":"Old Occitan","termine":"velhar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vigilo","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan velhar (cf. Old French veiller), which was inherited from Latin vigilāre. Replaced the original Italian vegghiare, which was inherited from Latin. Also a doublet of vigilare, a learned borrowing from Latin."}]}