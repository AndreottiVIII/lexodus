-pro","nome":"Proto-Italic","termine":"*koinā","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Vulgar Latin *cunla, syncopated form of cūnula, diminutive of Latin cūna, cūnae (“cradle”), from Proto-Italic *koinā, from Proto-Indo-European *ḱoyneh₂, derived from the root *ḱey- (“to be lying down; to settle”). Doublet of cuna."},{"parola":"digiuno","pos":"adj","n_etimologia":3,"categoria":"ereditato","incerta":"no","significato":"ignorant (of)","termine_origine":"","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*jagjūnos","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*Hyeh₂ǵ-yu-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Vulgar Latin, from Latin ieiūnus. The Latin derives from Proto-Italic *jagjūnos, itself from Proto-Indo-European *Hyeh₂ǵ-yu-, adjectival form of *Hyeh₂ǵ-ye/o- (“to sacrifice”)."},{"parola":"fallire","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to miss, to not hit (a target, a ball, etc.)","termine_origine":"*fallīre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fallīre","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*falsō","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)gʷʰh₂el-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Vulgar Latin *fallīre, from Latin fallere."},{"parola":"fuggire","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to escape, run away, scurry away","termine_origine":"*fugīre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fugīre","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*fugiō","categori