{"arrivo":"it","origine":"la-vul","origine_nome":"Vulgar Latin","livello2":"itc-pro","livello2_nome":"Proto-Italic","n":16,"parole":[{"parola":"agosto","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"August","termine_origine":"agustus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"agustus","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*augostos","categoria":"ereditato"}],"lontana":"itc-pro","ambiti":[],"via":"","testo":"From Vulgar Latin agustus, from Latin augustus. Doublet of Augusto."},{"parola":"alba","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"dawn, daybreak, break of day","termine_origine":"*alba","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alba","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*alβos","categoria":"ereditato"}],"lontana":"itc-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *alba, from Latin albus (“white”). Compare French aube."},{"parola":"anatra","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"duck (the bird or its meat)","termine_origine":"*anatria","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*anatria","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*anats","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂énh₂t-","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["cucina"],"via":"","testo":"From Vulgar Latin *anatria, from Latin anatem, from Proto-Italic *anats, from Proto-Indo-European *h₂énh₂t- (“duck”)."},{"parola":"aulire","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to cause a sweet smell, to waft perfume","termine_origine":"","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*odō","categoria":"ere