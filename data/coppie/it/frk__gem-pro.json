{"arrivo":"it","origine":"frk","origine_nome":"Frankish","livello2":"gem-pro","livello2_nome":"Proto-Germanic","n":10,"parole":[{"parola":"brano","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; modello unc/uncertain","significato":"piece, slip, rag, particle","termine_origine":"*brādon","catena":[{"codice":"frk","nome":"Frankish","termine":"*brādon","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brēdô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Uncertain, from Old French braon (“slice of meat”) or Old Spanish brahon, from Frankish *brādon, from Proto-Germanic *brēdô. Compare English brawn."},{"parola":"briglia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"rein","termine_origine":"*brigdil","catena":[{"codice":"frk","nome":"Frankish","termine":"*brigdil","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brigdilaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Probably from Frankish *brigdil, from Proto-Germanic *brigdilaz. Compare Sicilian brigghia."},{"parola":"gualcare","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to full (cloth), to waulk","termine_origine":"*walkōn","catena":[{"codice":"frk","nome":"Frankish","termine":"*walkōn","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*walkōną","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["finanza","moda"],"via":"","testo":"Ultimately from Frankish *walkōn, from Proto-Germanic *walkōną."},{"parola":"scaglia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"scale (keratin piece covering the skin of reptiles and fishes)","termine_origine":"*skallju","catena":[{"codice":"frk","nome":"Frankish","termine":"*skallju","categoria":"non