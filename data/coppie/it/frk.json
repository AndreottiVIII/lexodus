{"arrivo":"it","origine":"frk","origine_nome":"Frankish","n":24,"parole":[{"parola":"agguato","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ambush","termine_origine":"*wahten","catena":[{"codice":"frk","nome":"Frankish","termine":"*wahten","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Old Italian guatare, from Frankish *wahten (“to watch; to guard; to observe”)."},{"parola":"ardire","pos":"verb|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to dare","termine_origine":"*hardijan","catena":[{"codice":"frk","nome":"Frankish","termine":"*hardijan","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Borrowed from Frankish *hardijan (“to harden”)."},{"parola":"brano","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; modello unc/uncertain","significato":"piece, slip, rag, particle","termine_origine":"*brādon","catena":[{"codice":"frk","nome":"Frankish","termine":"*brādon","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brēdô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Uncertain, from Old French braon (“slice of meat”) or Old Spanish brahon, from Frankish *brādon, from Proto-Germanic *brēdô. Compare English brawn."},{"parola":"briglia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"rein","termine_origine":"*brigdil","catena":[{"codice":"frk","nome":"Frankish","termine":"*brigdil","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brigdilaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Probably from Frankish *brigdil, from Proto-Germanic *brigdilaz. Compare Sicilian brigghia."},{"parola":"feltro","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"felt","termine_origine":"*filtir","catena":[{"codice":"frk","nome":"Frankish","termine":"*filtir","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*felt","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":["moda"],"via":"","testo":"Borrowed from Frankish *filtir, from Proto-West Germanic *felt (“felt”). Doublet of filtro."},{"parola":"gualcare","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to full (cloth), to waulk","termine_origine":"*walkōn","catena":[{"codice":"frk","nome":"Frankish","termine":"*walkōn","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*walkōną","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["finanza","moda"],"via":"","testo":"Ultimately from Frankish *walkōn, from Proto-Germanic *walkōną."},{"parola":"guari","pos":"adv","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"very, much","termine_origine":"*waigaro","catena":[{"codice":"frk","nome":"Frankish","termine":"*waigaro","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish *waigaro (“much”), related to *waigr (“resistant”). Related to Middle High German weiger (“serious, grave, severe”). Cognate with French guère, Catalan gaire."},{"parola":"guarire","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"to recover, to get well, to get over","termine_origine":"*warjan","catena":[{"codice":"frk","nome":"Frankish","termine":"*warjan","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*warīre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Frankish *warjan, possibly through the intermediate of a Late Vulgar Latin *warīre, *uarīre. Compare French guérir, Occitan garir, Catalan and Spanish guarir."},{"parola":"maniscalco","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"blacksmith, farrier","termine_origine":"*marhaskalk","catena":[{"codice":"frk","nome":"Frankish","termine":"*marhaskalk","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"mariscalcus","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"From earlier mariscalco, from Frankish *marhaskalk (“servant assigned to horses”), from *marh + *skalk, whence also French maréchal, English marshal, Spanish mariscal; compare Medieval Latin mariscalcus. Doublet of maresciallo."},{"parola":"scaglia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"scale (keratin piece covering the skin of reptiles and fishes)","termine_origine":"*skallju","catena":[{"codice":"frk","nome":"Frankish","termine":"*skallju","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skaljō","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)kelH-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"From Frankish *skallija (“scale, shell”), from Proto-Germanic *skaljō (“scale, shell, husk”) ( > English shell), from Proto-Indo-European *(s)kelH- (“to cut, part, sunder, split, divide”). Compare French écaille, Sicilian scagghia."},{"parola":"scotto","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"the amount to pay for a meal in an inn or tavern","termine_origine":"*skott, *skatt","catena":[{"codice":"frk","nome":"Frankish","termine":"*skott, *skatt","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skattaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Frankish *skott, *skatt (“tax”), from Proto-Germanic *skattaz (“wealth; money”). Compare German Schatz (“treasure”) and Sicilian scuttari."},{"parola":"smeriglio","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"merlin (Falco columbarius)","termine_origine":"","catena":[{"codice":"frk","nome":"Frankish","termine":"","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish."},{"parola":"sperone","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"spur","termine_origine":"*spurō","catena":[{"codice":"frk","nome":"Frankish","termine":"*spurō","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish *spurō."},{"parola":"sprone","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"spur","termine_origine":"*spurō","catena":[{"codice":"frk","nome":"Frankish","termine":"*spurō","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish *spurō."},{"parola":"stallone","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"stallion (male horse kept primarily as a stud)","termine_origine":"*stallo","catena":[{"codice":"frk","nome":"Frankish","termine":"*stallo","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish *stallo. Compare French étalon."},{"parola":"stampare","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to print, to run off","termine_origine":"*stampōn","catena":[{"codice":"frk","nome":"Frankish","termine":"*stampōn","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*stampōną","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Frankish *stampōn, from Proto-Germanic *stampōną."},{"parola":"tappo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cap, cork, stopper, plug","termine_origine":"*tappo","catena":[{"codice":"frk","nome":"Frankish","termine":"*tappo","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*tappô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Frankish *tappo, from Proto-Germanic *tappô (“plug, tap”). Doublet of zaffo."},{"parola":"targa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"plate, shingle (metal etc.)","termine_origine":"*targa","catena":[{"codice":"frk","nome":"Frankish","termine":"*targa","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish *targa (“shield”)."},{"parola":"tasca","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"pocket","termine_origine":"*taskā","catena":[{"codice":"frk","nome":"Frankish","termine":"*taskā","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*taskǭ","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*das-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Frankish *taskā, from Proto-Germanic *taskǭ. Perhaps ultimately from Proto-Indo-European *das-, *des- (“to fray”)."},{"parola":"taso","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"tartar, argol, a red compound deposited during wine making.","termine_origine":"*tas","catena":[{"codice":"frk","nome":"Frankish","termine":"*tas","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*tassaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dāy-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Probably from Frankish *tas (“mass”), from Proto-Germanic *tassaz (“heap, mow”), from Proto-Indo-European *dāy- (“to divide, split, section, part, separate”). Compare French tas (“heap, pile”)."},{"parola":"trambusto","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"turmoil, fuss, ado","termine_origine":"","catena":[{"codice":"frk","nome":"Frankish","termine":"","categoria":"non_precisato"},{"codice":"gem","nome":"Germanic","termine":"","categoria":"non_precisato"}],"lontana":"gem","ambiti":[],"via":"","testo":"From the same Frankish/Germanic source as French tarabuster (“commotion, uproar”)."},{"parola":"trappola","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"trap, snare, catch","termine_origine":"*trappa","catena":[{"codice":"frk","nome":"Frankish","termine":"*trappa","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Frankish *trappa (whence French trappe (“trap”)) + -ola."},{"parola":"uosa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gaiters","termine_origine":"*hosā","catena":[{"codice":"frk","nome":"Frankish","termine":"*hosā","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*husǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Frankish *hosā, from Proto-Germanic *husǭ."},{"parola":"visciola","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sour cherry, morello cherry (fruit of Prunus cerasus var. austera)","termine_origine":"","catena":[{"codice":"frk","nome":"Frankish","termine":"","categoria":"prestito"},{"codice":"lng","nome":"Lombardic","termine":"wīhsila","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wīhsilō","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*weyḱs-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["cucina"],"via":"","testo":"Borrowed from Frankish or Lombardic wīhsila, from Proto-Germanic *wīhsilō, from Proto-Indo-European *weyḱs- (“mistletoe”). Compare German Weichsel."}]}