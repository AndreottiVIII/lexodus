{"arrivo":"it","origine":"es","origine_nome":"Spanish","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":23,"parole":[{"parola":"abelmosco","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"musk mallow (Malva moschata)","termine_origine":"abelmosco","catena":[{"codice":"es","nome":"Spanish","termine":"abelmosco","categoria":"prestito"},{"codice":"la-new","nome":"New Latin","termine":"Abelmoschus","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"حَبّ الْمِسْك","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Spanish abelmosco, from New Latin abelmoschus, from Arabic حَبّ الْمِسْك (ḥabb al-misk, “pills of musk”).","livello2_varieta":"la-new"},{"parola":"barro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a clay used to make pottery","termine_origine":"barro","catena":[{"codice":"es","nome":"Spanish","termine":"barro","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*barrum","categoria":"non_precisato"},{"codice":"qsb-ibe","nome":"Paleo-Hispanic","termine":"","categoria":"non_precisato"}],"lontana":"qsb-ibe","ambiti":[],"via":"","testo":"Borrowed from Spanish barro (“mud; clay”), from Vulgar Latin *barrum, from Paleo-Hispanic.","livello2_varieta":"la-vul"},{"parola":"camerata","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dormitory","termine_origine":"camarada","catena":[{"codice":"es","nome":"Spanish","termine":"camarada","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"camera","categoria":"non_precisato"}],"lontana":"la","ambiti":["diritto_politica"],"via":"","testo":"Borrowed from Spanish camarada (“comrade”), from cámara (“chamber”) derived from Latin camera (“chamber”).","livello2_varieta":"la"},{"parola":"castigliano","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Castilian","termine_origine":