{"arrivo":"it","origine":"pro","origine_nome":"Old Occitan","livello2":"frk","livello2_nome":"Frankish","n":5,"parole":[{"parola":"bugia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"lie, untruth","termine_origine":"bauzia","catena":[{"codice":"pro","nome":"Old Occitan","termine":"bauzia","categoria":"prestito"},{"codice":"frk","nome":"Frankish","termine":"*bausi","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bauscia","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bausuz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Old Occitan bauzia, from Old Frankish *bausī (“deceit”) (possibly through a Vulgar Latin *bauscia (compare also Friulian bausie, Dalmatian bosca, Old French boisie), ultimately from Proto-Germanic *bausuz (“puffed up, arrogant, bad”). Cognate with Dutch boos, German böse, English boast"},{"parola":"lusinga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"flattery","termine_origine":"lauzenga","catena":[{"codice":"pro","nome":"Old Occitan","termine":"lauzenga","categoria":"prestito"},{"codice":"frk","nome":"Frankish","termine":"*lausungu","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Borrowed from Old Occitan lauzenga, from Frankish *lausungu."},{"parola":"tovaglia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"tablecloth, cloth","termine_origine":"toalha","catena":[{"codice":"pro","nome":"Old Occitan","termine":"toalha","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*þwahilu","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Probably from Old Occitan toalha, from Frankish *þwahilu. Cognate with Portuguese toalha (“towel”)."},{"parola":"traboccare","pos":"verb","n_etimologia":1,"catego