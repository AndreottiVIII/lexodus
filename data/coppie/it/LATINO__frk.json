":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"sky blue","termine_origine":"blāvus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"blāvus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*blāu","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*blēwaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Late Latin blāvus, from Frankish *blāu, from Proto-Germanic *blēwaz (“blue, yellowish-gray”). Compare the doublet blu.","origine_varieta":"la-lat"},{"parola":"bisogno","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"need","termine_origine":"*bisonium","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bisonium","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*bisunnija","categoria":"prestito"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *bisonium, borrowed from Frankish *bisunnija.","origine_varieta":"la-vul"},{"parola":"bordo","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"edge, border, margin, hem, rim","termine_origine":"bordum","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"bordum","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*bord","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*burdą","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["mare"],"via":"","testo":"Borrowed from Medieval Latin bordum (“plank, board”), from Frankish *bord, from Proto-Germanic *burdą (“board; table”).","origine_varieta":"la-med"},{"parola":"bosco","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"woodland","termine_origine":"boscus","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"boscus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*busk","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*buskaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin boscus, borrowed from Frankish *busk, from Proto-Germanic *buskaz.","origine_varieta":"la-eme"},{"parola":"brodo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"broth; clear soup","termine_origine":"brodium","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"brodium","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*broþ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bruþą","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Late Latin brodium, from Frankish *broþ, from Proto-Germanic *bruþą, the same root as English broth. Compare French brouet, Old French breu, Catalan brou, Piedmontese breu, Friulian brût, Sicilian brodu, Spanish bodrio, Portuguese brodo.","origine_varieta":"la-lat"},{"parola":"bruno","pos":"adj|noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"dark gray, almost black","termine_origine":"brūnus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"brūnus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brūnaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰerH-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["diritto_politica"],"via":"","testo":"From Medieval Latin brūnus \"brown, brunet\" (whence also Spanish bruno, French brun, Dalmatian broin), from Frankish *brūn, from Proto-Germanic *brūnaz (“brown”), from Proto-Indo-European *bʰerH- (“shining, brown”). Akin to Old Dutch brūn \"brown\" (Dutch bruin \"brown\"), Old High German brūn \"brown\" (G","origine_varieta":"la-med"},{"parola":"bucato","pos":"noun","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"washing, laundry","termine_origine":"*būcāta","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*būcāta","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*būkōn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *būcāta, from Frankish *būkōn (“to submerge; to wash”). Cognate with Catalan bugada and French buée.","origine_varieta":"la-vul"},{"parola":"camerlengo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"chamberlain","termine_origine":"camarlingus","catena":[{"codice":"la","nome":"Latin","termine":"camarlingus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*kamarling","categoria":"prestito"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Old Italian camarlingo, inherited from Medieval Latin camarlingus. Doublet of ciambellano. Cognates include Old High German chamarling and French chambellan.","origine_varieta":"la"},{"parola":"campione","pos":"noun|adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"champion, ace, master","termine_origine":"","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*kampijō","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kampijô","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"campus","categoria":"non_precisato"}],"lontana":"la","ambiti":["sport"],"via":"","testo":"From Medieval Latin or Late Latin campiōnem, campiōnem (“champion, fighter”), from Frankish *kampijō (or a Lombardic equivalent) from Proto-Germanic *kampijô, based on Latin campus (“level ground”).","origine_varieta":"la-med"},{"parola":"crosciare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to roar (of rain or falling water)","termine_origine":"*cruscīre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cruscīre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*krustijan","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *cruscīre, from Frankish *krustijan. Otherwise is just another onomatopoeic word. Compare Spanish crujir, Old French croissir","origine_varieta":"la-vul"},{"parola":"fiasca","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"flask","termine_origine":"flasca","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"flasca","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*flaskā","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Late Latin flasca (“bottle, container”), from Old Frankish *flaskā (“bottle, flask”),","origine_varieta":"la-lat"},{"parola":"fiasco","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"flask","termine_origine":"flascō","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"flascō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*flaska","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*flaskǭ","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*plek-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin flascō, flasca (“bottle, container”), from Old Frankish *flaska (“bottle, flask”), from Proto-Germanic *flaskǭ (“bottle”), from Proto-Germanic *flehtaną (“to plait”), from Proto-Indo-European *plek- (“to weave, braid”). Akin to Old High German flasca (“flask”), Old English ","origine_varieta":"la-lat"},{"parola":"gala","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bow (ornament on a dress etc.)","termine_origine":"","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wal-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*welh₁-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Medieval Latin, Latinized form of Frankish *wala (“good, well”), from Proto-Germanic *wal-, from Proto-Indo-European *welh₁- (“to choose, wish”).","origine_varieta":"la-med"},{"parola":"greppia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"manger","termine_origine":"*creppea","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*creppea","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*krippija","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kribjǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Vulgar Latin *creppea (“crib, manger, trough”), from Old Frankish *krippija, *kribbija (“crib, stall”), from Proto-Germanic *kribjǭ (“crib”). More at crib.","origine_varieta":"la-vul"},{"parola":"gruppo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"group, cluster, party, team, covey","termine_origine":"*cruppus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cruppus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*krupp","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kruppaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*grewbʰ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["musica","sport"],"via":"","testo":"From Vulgar Latin *cruppus, (cf. Renaissance Latin grupus).","origine_varieta":"la-vul"},{"parola":"guado","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"ford","termine_origine":"*uadam","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*uadam","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*wad","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wadą","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*wadʰom","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"vadum","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Vulgar Latin *uadam, *wadam, from Frankish *wad, from Proto-Germanic *wadą (“ford”), from Proto-Indo-European *wadʰom, *wh₂dʰóm (ultimately from the root *weh₂dʰ-). Compare French gué (“ford”), Catalan gual, Occitan ga. Other sources list it as deriving from Latin vadum, itself from the same Pr","origine_varieta":"la-vul"},{"parola":"guaragno","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a stallion","termine_origine":"waraniō","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"waraniō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*wrainijō","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wrainijô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Medieval Latin waraniō, warangio, borrowed from Frankish *wrainijō (“stallion”), from Proto-Germanic *wrainijô.","origine_varieta":"la-med"},{"parola":"guardare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to look at, to watch, to glance or gaze at","termine_origine":"wardō","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"wardō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*wardēn","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wardāną","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin wardāre.","origine_varieta":"la-eme"},{"parola":"guastare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to ruin, to damage","termine_origine":"vastō","catena":[{"codice":"la","nome":"Latin","termine":"vastō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*wōstijan","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Latin vastāre, influenced by Frankish *wōstijan. Compare Portuguese gastar, Spanish gastar (“to spend”).","origine_varieta":"la"},{"parola":"guerra","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"war, warfare","termine_origine":"werra","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"werra","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*werʀu","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin werra, from Frankish *werʀu (“confusion; quarrel”).","origine_varieta":"la-eme"},{"parola":"installare","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to install, to place","termine_origine":"installō","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"installō","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*stall","categoria":"non_precisato"}],"lontana":"frk","ambiti":["scienza"],"via":"","testo":"From Medieval Latin īnstallāre (“to install, put in place, establish”), from in- + stallum (“stall”), from Frankish *stall (“stall, position, place”).","origine_varieta":"la-med"},{"parola":"lobia","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"balcony","termine_origine":"laubia","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"laubia","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*laubijā","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Late Latin laubia, from Frankish *laubijā (“shelter, arbour”). Doublet of loggia.","origine_varieta":"la-lat"},{"parola":"marchesa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"marchioness","termine_origine":"marchionissa","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"marchionissa","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*markōn","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*markō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["diritto_politica"],"via":"","testo":"From Medieval Latin marchionissa, feminine form of marchion, from Late Latin marcha, from Frankish *markōn (“to mark, mark out, to press with the foot”), from Proto-Germanic *markō (“area, region, edge, rim, border”). Cognate with Sicilian marchisa.","origine_varieta":"la-med"},{"parola":"palla","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"alternatively","significato":"ball (object used for playing games)","termine_origine":"balla","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"balla","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*ballu","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*balluz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰel-","categoria":"non_precisato"},{"codice":"lng","nome":"Lombardic","termine":"*palla","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*ballô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["militare","scienza","sport","diritto_politica"],"via":"","testo":"From Medieval Latin balla, palla, bala, from Frankish *ballu, from Proto-Germanic *balluz, from Proto-Indo-European *bʰoln- (“bubble”), from *bʰel- (“to blow, swell, inflate”). Alternatively, via Lombardic *palla, from Proto-Germanic *ballô, from the same ultimate origin. Compare Sicilian baḍḍa.","origine_varieta":"la-med"},{"parola":"pantofola","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Of uncertain origin; Unknown; Possibly","significato":"slipper","termine_origine":"*patta","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*patta","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*patta","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*pat-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)pent-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["moda"],"via":"","testo":"First element from Vulgar Latin *patta (“paw, foot”), from Frankish *patta (“paw, sole of the foot”), from Proto-Germanic *pat-, *paþa- (“to walk, tread, go, step”), of uncertain origin and relation. Possibly from Proto-Indo-European *(s)pent-, *(s)pat- (“path; to walk”), a variant of Proto-Indo-Eur","origine_varieta":"la-vul"},{"parola":"raspare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to rasp","termine_origine":"*raspāre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*raspāre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*hraspōn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *raspāre, from Frankish *hraspōn.","origine_varieta":"la-vul"},{"parola":"snello","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"fast, quick","termine_origine":"*snellus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*snellus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*snell","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*snellaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Vulgar Latin *snellus (“brisk, lively”) (compare Old French esnel, isnel (“sudden, quick”), Occitan isnel, irnel (“lively”)), from Frankish *snell, *snel (“sudden, quick”) from Proto-Germanic *snellaz (“active, sudden, quick”). Akin to Old High German snel, snell (“bold, agile, lively, swift, b","origine_varieta":"la-vul"},{"parola":"sparagnare","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to save, to save up","termine_origine":"sparāniāre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"sparāniāre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*sparanjan","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*sparāną","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin sparāniāre (attested in the Reichenau Glossary), from Frankish *sparanjan, from Proto-Germanic *sparāną (compare French épargner, English spare and Dutch/German sparen). Cognate with Sicilian sparagnari.","origine_varieta":"la-vul"},{"parola":"spelta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"spelt (Triticum spelta)","termine_origine":"spelta","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"spelta","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*spelta","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*spiltaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Late Latin spelta (“spelt”), from Frankish *spelta (“spelt”), from Proto-Germanic *spiltaz (“spelt”).","origine_varieta":"la-lat"},{"parola":"spione","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"sneak, telltale","termine_origine":"","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*spehō","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *spiō, from Frankish *spehō (“spy”), from Frankish *spehōn (“to spy”). By surface analysis, spiare (“to spy”) + -one.","origine_varieta":"la-vul"},{"parola":"tetta","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"boob, booby, tit, jug (slang expression for breast)","termine_origine":"titta","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"titta","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*titta","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*titt-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*tata-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Late Latin titta, titia, from Frankish *titta, from Proto-Germanic *titt- (“teat; nipple; breast”), from Proto-Indo-European *tata- (“father; parent; nipple”). Compare also French tette, Spanish and Portuguese teta, Romanian țâță, English teat. The word is found in many European languages and m","origine_varieta":"la-lat"},{"parola":"toppo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"stump (of a felled tree etc.)","termine_origine":"*toppus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*toppus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*topp","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *toppus, from Frankish *topp (“summit, top”).","origine_varieta":"la-vul"},{"parola":"troppo","pos":"det|pron|adv","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"too much, (in the plural) too many","termine_origine":"troppus","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"troppus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*þorp","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*þurpą","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*trab-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Early Medieval Latin troppus, borrowed from Frankish *þorp (“a cluster, agglomeration\", also \"collection of houses, village”), from Proto-Germanic *þurpą (“village”), from Proto-Indo-European *trab-, *treb- (“dwelling, room”). Cognate with French trop (“too much”), Piedmontese tròp/trop. More a","origine_varieta":"la-eme"},{"parola":"trottare","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to trot (along)","termine_origine":"*trottāre","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"*trottāre","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*trotton","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*trudōną","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Medieval Latin *trottāre, *trotāre (“to go”), from Frankish *trottōn (“to go, run”), from Proto-Germanic *trudōną, *trudaną, *tradjaną (“to go, step, tread”).","origine_varieta":"la-med"},{"parola":"vimpa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"vimpa","termine_origine":"vimpa","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"vimpa","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*wimpil","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wimpilaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Medieval Latin vimpa, from Frankish *wimpil, *wimpila (“head scarf”), from Proto-Germanic *wimpilaz, from Proto-Germanic *wīpaną (“to wind, swing”).","origine_varieta":"la-med"}]}