{"arrivo":"de","origine":"af","origine_nome":"Afrikaans","n":21,"n_alternative":0,"parole":[{"parola":"abkommen","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to come from, to derive from","termine_origine":"afkom","catena":[{"codice":"af","nome":"Afrikaans","termine":"afkom","categoria":"non_precisato"}],"lontana":"af","ambiti":["sport"],"via":"","testo":"From Middle High German abekomen, from Old High German abaqueman, from ab- (“from”) + kweman (“to come”). The sense \"grow gaunt\" is attested since the 15th century as a shortening of the phrase \"vom Fleisch abkommen\". The specifically Namibian use is a loan meaning from Afrikaans afkom."},{"parola":"afrikaans","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Afrikaans (language)","termine_origine":"Afrikaans","catena":[{"codice":"af","nome":"Afrikaans","termine":"Afrikaans","categoria":"prestito"}],"lontana":"af","ambiti":[],"via":"","testo":"Borrowed from Afrikaans Afrikaans."},{"parola":"Apartheid","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"apartheid (South African policy of racial segregation and discrimination)","termine_origine":"apartheid","catena":[{"codice":"af","nome":"Afrikaans","termine":"apartheid","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"apartheid","categoria":"ereditato"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Afrikaans apartheid."},{"parola":"Bakkie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bakkie","termine_origine":"bakkie","catena":[{"codice":"af","nome":"Afrikaans","termine":"bakkie","categoria":"non_precisato"}],"lontana":"af","ambiti":[],"via":"","testo":"From Afrikaans bakkie."},{"parola":"bedonnert","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"angry, upset","termine_origine":"bedonnerd","catena":[{"codice":"af","nome":"Afrikaans","termine":"bedonnerd","categoria":"prestito"}],"lontana":"af","ambiti":[],"via":"","testo":"Borrowed from Afrikaans bedonnerd, an alternative form of bedonderd."},{"parola":"Biltong","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"biltong","termine_origine":"biltong","catena":[{"codice":"af","nome":"Afrikaans","termine":"biltong","categoria":"prestito"}],"lontana":"af","ambiti":["cucina"],"via":"","testo":"Borrowed from Afrikaans biltong."},{"parola":"Dagga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dagga, marijuana","termine_origine":"dagga","catena":[{"codice":"af","nome":"Afrikaans","termine":"dagga","categoria":"prestito"},{"codice":"naq","nome":"Khoekhoe","termine":"daxab","categoria":"non_precisato"}],"lontana":"naq","ambiti":[],"via":"","testo":"Borrowed from Afrikaans dagga, from Khoekhoe daxab."},{"parola":"Donga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"donga","termine_origine":"donga","catena":[{"codice":"af","nome":"Afrikaans","termine":"donga","categoria":"prestito"},{"codice":"zu","nome":"Zulu","termine":"ū́dongá","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mʊ̀dòngà","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Afrikaans donga, from Zulu udonga."},{"parola":"Ducker","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"duiker","termine_origine":"duiker","catena":[{"codice":"af","nome":"Afrikaans","termine":"duiker","categoria":"prestito"}],"lontana":"af","ambiti":[],"via":"","testo":"Borrowed from Afrikaans duiker."},{"parola":"Erdmännchen","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"meerkat (Suricata suricatta)","termine_origine":"erdmannetjie","catena":[{"codice":"af","nome":"Afrikaans","termine":"erdmannetjie","categoria":"non_precisato"}],"lontana":"af","ambiti":["scienza"],"via":"","testo":"From Erde (