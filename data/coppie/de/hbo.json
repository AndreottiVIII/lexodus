{"arrivo":"de","origine":"hbo","origine_nome":"Biblical Hebrew","n":7,"parole":[{"parola":"Gott mit uns","pos":"phrase","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"\"God is with us\"","termine_origine":"עִמָּנוּאֵל","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"עִמָּנוּאֵל","categoria":"non_precisato"},{"codice":"grc-koi","nome":"Koine Greek","termine":"μεθ’ ἡμῶν ὁ Θεός","categoria":"non_precisato"}],"lontana":"grc-koi","ambiti":[],"via":"","testo":"Interpretation of Biblical Hebrew עִמָּנוּאֵל ('imanu'éll) (Isaiah 7:14, 8:10) and Koine Greek μεθ’ ἡμῶν ὁ Θεός (meth’ hēmôn ho Theós) (Matthew 1:23). Compare Russian с на́ми Бог (s námi Bog)."},{"parola":"hosianna","pos":"intj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hosanna","termine_origine":"הוֹשַׁע נָא","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"הוֹשַׁע נָא","categoria":"non_precisato"}],"lontana":"hbo","ambiti":[],"via":"","testo":"Ultimately from Biblical Hebrew הוֹשַׁע נָא (hōsha‘ nā, “please save”)."},{"parola":"Kasper","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"clown (normally a puppet)","termine_origine":"גִּזְבָּר","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"גִּזְבָּר","categoria":"non_precisato"},{"codice":"syc","nome":"Classical Syriac","termine":"ܓܙܒܪܐ","categoria":"non_precisato"},{"codice":"peo","nome":"Old Persian","termine":"*ganzabarah","categoria":"non_precisato"},{"codice":"xme-old","nome":"Old Median","termine":"*ganǰabarah","categoria":"non_precisato"}],"lontana":"xme-old","ambiti":[],"via":"","testo":"Byform of the name German Kaspar, via Biblical Hebrew גִּזְבָּר (gizbar) from Classical Syriac ܓܙܒܪܐ (gēzaḇrā), from Old Persian *ganzabarah, from Old Median *ganǰabarah. Compare Bavarian Kasperl."},{"parola":"Krethi und Plethi","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"every Tom, Dick and Harry; all kinds of different people","termine_origine":"כרתי ופלתי","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"כרתי ופלתי","categoria":"non_precisato"}],"lontana":"hbo","ambiti":[],"via":"","testo":"From Biblical Hebrew כרתי ופלתי (kərēṯī u-pəlēṯī, “Cherethites and Pelethites”). Compare Swedish kreti och pleti etc."},{"parola":"Leviathan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"leviathan","termine_origine":"לִוְיָתָן","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"לִוְיָתָן","categoria":"prestito"}],"lontana":"hbo","ambiti":["religione"],"via":"","testo":"Borrowed from Biblical Hebrew לִוְיָתָן (liwyāṯān)."},{"parola":"Tohuwabohu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chaos, tohu-bohu","termine_origine":"תוהו ובוהו","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"תוהו ובוהו","categoria":"prestito"}],"lontana":"hbo","ambiti":[],"via":"","testo":"Borrowed from Biblical Hebrew תוהו ובוהו (tōhū wā-ḇōhū) in Genesis 1:2, from תֹהוּ (tōhū, “formlessness, nothingness”) + בֹּהוּ (bōhū, “voidness, desolation”)."},{"parola":"Zehn Gebote","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"the Ten Commandments","termine_origine":"עֲשֶׂרֶת הַדְּבָרִים","catena":[{"codice":"hbo","nome":"Biblical Hebrew","termine":"עֲשֶׂרֶת הַדְּבָרִים","categoria":"calco"}],"lontana":"hbo","ambiti":[],"via":"","testo":"Calque of Biblical Hebrew עֲשֶׂרֶת הַדְּבָרִים ('aséret had'varím, “the ten items”), from Exodus 34:28, Deuteronomy 4:13 and Deuteronomy 10:4."}]}