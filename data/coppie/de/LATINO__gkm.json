{"arrivo":"de","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"gkm","livello2_nome":"Byzantine Greek","n":8,"parole":[{"parola":"Alphabet","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"alphabet (the set of letters used when writing in a language)","termine_origine":"alphabētum","catena":[{"codice":"la","nome":"Latin","termine":"alphabētum","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἀλφάβητον","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Latin alphabētum.","origine_varieta":"la"},{"parola":"Ambo","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"ambo (stationary podium)","termine_origine":"ambō","catena":[{"codice":"la-ecc","nome":"Ecclesiastical Latin","termine":"ambō","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἄμβων","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Ecclesiastical Latin ambō, from Byzantine Greek ἄμβων (ámbōn).","origine_varieta":"la-ecc"},{"parola":"Arsenik","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"arsenic (arsenic trioxide, not the element)","termine_origine":"arsenicum","catena":[{"codice":"la","nome":"Latin","termine":"arsenicum","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἀρσενικόν","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"زرنيخ","categoria":"prestito"},{"codice":"syc","nome":"Classical Syriac","termine":"ܙܪܢܝܟܐ","categoria":"non_precisato"},{"codice":"pal","nome":"Middle Persian","termine":"","categoria":"prestito"},{"codice":"xme-old","nome":"Old Median","termine":"*zaraniyakā","categoria":"non_precisato"}],"lontana":"xme-old","ambiti":[],"via":"","testo":"Borrowed from Latin arsenicum.","origine_varieta":"la"},{"parola":"Ketzer","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"heretic (male or of unspecified gender)","termine_origine":"Catharī","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"Catharī","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Καθαροί","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["religione"],"via":"","testo":"From Middle High German ketzer, from Old High German ketzer, kether, from Medieval Latin Catharī, from Byzantine Greek Καθαροί (Katharoí), substantive form of Ancient Greek καθαρός (katharós, “pure”). Doublet of Katharer. See English Cathar.","origine_varieta":"la-med"},{"parola":"Metaphysik","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"metaphysics","termine_origine":"metaphysica","catena":[{"codice":"la","nome":"Latin","termine":"metaphysica","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"μεταφυσική","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"From Latin metaphysica, from Byzantine Greek μεταφυσική (metaphusikḗ). By surface analysis, meta- + Physik.","origine_varieta":"la"},{"parola":"Opal","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"opal","termine_origine":"opalus","catena":[{"codice":"la","nome":"Latin","termine":"opalus","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ὀπάλλιος","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"उपल","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"From Latin opalus, from Byzantine Greek ὀπάλλιος (opállios), from Sanskrit उपल (upala, “gem, stone”).","origine_varieta":"la"},{"parola":"russisch","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Russian","termine_origine":"Russus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"Russus","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Ῥῶς","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"From Middle High German rūzesch, from Rūz, from Old High German Rūzo, from Medieval Latin Russus, from Byzantine Greek Ῥῶς (Rhôs). By surface analysis, Russe + -isch.","origine_varieta":"la-med"},{"parola":"Sklave","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"slave","termine_origine":"sclavus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"sclavus","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Σκλάβος","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"From Late Middle High German sklafe (15th c.), a relatinisation of older slave (13th c.), from Medieval Latin s(c)lavus, from Late Latin Sclavus, from Byzantine Greek Σκλάβος (Sklábos); see that Greek entry and slave for more. Doublet of Slawe and ciao.","origine_varieta":"la-med"}]}