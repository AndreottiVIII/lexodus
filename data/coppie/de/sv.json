{"arrivo":"de","origine":"sv","origine_nome":"Swedish","n":19,"n_alternative":1,"parole":[{"parola":"Alk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"auk, any bird of the family Alcidae","termine_origine":"alka","catena":[{"codice":"sv","nome":"Swedish","termine":"alka","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"alka","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*alkǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Swedish alka (used scientifically by Carl von Linné), from Old Norse alka, from Proto-Germanic *alkǭ."},{"parola":"Desman","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"desman (animal)","termine_origine":"desman","catena":[{"codice":"sv","nome":"Swedish","termine":"desman","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"dēsem","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"bisamum","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"בושם","traslitterazione":"bāśām, bōśem","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Swedish desman (“musk” as in desmanråtta “muskrat”), from older desma, desme, from Middle Low German dēsem, from Old Saxon desamo, alteration of *besamo, from Late Latin bisamum (“musk”), from Hebrew בשם (bāśām, bōśem). Doublet of Bisam and Balsam."},{"parola":"Finne","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"Finn (person from Finland)","termine_origine":"finne","catena":[{"codice":"sv","nome":"Swedish","termine":"finne","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"Finnr","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Swedish finne, from Old Norse Finnr (“Finn”). Related to Old English Finnas."},{"parola":"Flinte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"shotgun","termine_origine":"flinta","catena":[{"codice":"sv","nome":"Swedish","termine":"flinta","categoria":"prestito"}],"lontana":"sv","ambiti":["militare"],"via":"","testo":"Probably from Swedish flinta (borrowed during the Thirty Years's War). The word goes back to the ignition with a flint."},{"parola":"Flugscham","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"flight shame","termine_origine":"flygskam","catena":[{"codice":"sv","nome":"Swedish","termine":"flygskam","categoria":"calco"}],"lontana":"sv","ambiti":[],"via":"","testo":"Calque of Swedish flygskam, Flug + Scham"},{"parola":"Julklapp","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of Wichteln; secret Santa","termine_origine":"julklapp","catena":[{"codice":"sv","nome":"Swedish","termine":"julklapp","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"Borrowed from Swedish julklapp (“Christmas present”)."},{"parola":"Knäckebrot","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"crispbread","termine_origine":"knäckebröd","catena":[{"codice":"sv","nome":"Swedish","termine":"knäckebröd","categoria":"calco"}],"lontana":"sv","ambiti":["cucina"],"via":"","testo":"Partial calque of Swedish knäckebröd. The first component is unaltered from Swedish knäcka (“to crack, snap”). German-speakers commonly analyse it as knacken + Brot, which is ultimately both semantically and etymologically correct."},{"parola":"Kohte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of conical tent with an open fireplace in the middle, used by German scouts","termine_origine":"kåta","catena":[{"codice":"sv","nome":"Swedish","termine":"kåta","categoria":"prestito"},{"codice":"fi","nome":"Finnish","termine":"kota","categoria":"non_precisato"}],"lontana":"fi","ambiti":[],"via":"","testo":"Borrowed from Swedish kåta or Finnish kota, which see for more. The unusual spelling with ⟨h⟩ serves to distinguish the word from Kote (“hut”), a byform of Kate. Compare also Northern Sami goahti, which may have inspired this."},{"parola":"Lappe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"native of Lapland","termine_origine":"lapp","catena":[{"codice":"sv","nome":"Swedish","termine":"lapp","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"From Swedish lapp. See also Lappland."},{"parola":"Moped","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"moped","termine_origine":"moped","catena":[{"codice":"sv","nome":"Swedish","termine":"moped","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"Borrowed from Swedish moped."},{"parola":"Ombudsfrau","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ombudswoman","termine_origine":"ombudsman","catena":[{"codice":"sv","nome":"Swedish","termine":"ombudsman","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"Analogy of Ombudsmann, from Swedish ombudsman. Also analyzable as Ombuds- + Frau."},{"parola":"Ombudsmann","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ombudsman","termine_origine":"ombudsman","catena":[{"codice":"sv","nome":"Swedish","termine":"ombudsman","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"Borrowed from Swedish ombudsman."},{"parola":"Os","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"ridge","termine_origine":"ås","catena":[{"codice":"sv","nome":"Swedish","termine":"ås","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"Borrowed from Swedish ås"},{"parola":"Plogging","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"plogging","termine_origine":"plogging","catena":[{"codice":"sv","nome":"Swedish","termine":"plogging","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"Borrowed from Swedish plogging."},{"parola":"Schäre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"skerry (flat, rocky isle, especially in Scandinavia)","termine_origine":"skären","catena":[{"codice":"sv","nome":"Swedish","termine":"skären","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"schēre","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"sker","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"17th century, backformation from Swedish skären, definite plural of skär n, perhaps through Middle Low German schēr(e) (“reef”). All eventually from Old Norse sker."},{"parola":"Schörl","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Unknown; Possibly","significato":"schorl","termine_origine":"skör","catena":[{"codice":"sv","nome":"Swedish","termine":"skör","categoria":"non_precisato"}],"lontana":"sv","ambiti":["scienza"],"via":"","testo":"Unknown; possibly from Swedish skör (“brittle”)."},{"parola":"Skarn","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"skarn","termine_origine":"skarn","catena":[{"codice":"sv","nome":"Swedish","termine":"skarn","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"skarn","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skarną","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Swedish skarn (“filth”), from Old Norse skarn, from Proto-Germanic *skarną."},{"parola":"Öre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"öre, øre (Scandinavian unit of currency)","termine_origine":"öre","catena":[{"codice":"sv","nome":"Swedish","termine":"öre","categoria":"prestito"},{"codice":"da","nome":"Danish","termine":"øre","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*aurijaz","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"aureus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Swedish öre and Danish øre, from Proto-Germanic *aurijaz, from Latin aureus."},{"parola":"Lumme","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"A seabird belonging to the genera Uria of the auk family Alcidae, particularly the common guillemot, Uria aalge","termine_origine":"lom","catena":[{"codice":"sv","nome":"Swedish","termine":"lom","categoria":"non_precisato"}],"lontana":"sv","ambiti":[],"via":"","alternative":[{"codice":"da","nome":"Danish","termine":"lom","categoria":"non_precisato"},{"codice":"sv","nome":"Swedish","termine":"lom","categoria":"non_precisato"},{"codice":"non","nome":"Old Norse","termine":"lómr","categoria":"non_precisato"}],"testo":"From either Danish lom or Swedish lom, ultimately from Old Norse lómr (“loon”)."}]}