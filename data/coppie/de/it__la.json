{"arrivo":"de","origine":"it","origine_nome":"Italian","livello2":"la","livello2_nome":"Latin","n":58,"parole":[{"parola":"Ambiente","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ambiance","termine_origine":"ambiente","catena":[{"codice":"it","nome":"Italian","termine":"ambiente","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ambiēns","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian ambiente, from Latin ambiēns, present active participle of ambiō (“to surround”). Doublet of ambient."},{"parola":"Arie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aria (solo singing piece, notably in operatic genres)","termine_origine":"aria","catena":[{"codice":"it","nome":"Italian","termine":"aria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"āēr","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾱ̓ήρ","categoria":"prestito"},{"codice":"grk-pro","nome":"Proto-Hellenic","termine":"*auhḗr","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂ewsér","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["musica"],"via":"","testo":"Borrowed from Italian aria, from Latin āēr (“air (atmosphere), breath”)."},{"parola":"Bass","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bass (low spectrum of sound)","termine_origine":"basso","catena":[{"codice":"it","nome":"Italian","termine":"basso","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bassus","categoria":"ereditato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian basso (“low”), from Latin bassus (“low”)."},{"parola":"benedeien","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"to bless","termine_origine":"benedire","catena":[{"codice":"it","nome":"Italian","termine":"benedire","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"benedico","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle High German benedīen, benedīgen, probably through Italian benedire, eventually from Latin benedicere (“to speak well of someone or something; to bless”)."},{"parola":"Bratsche","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"viola","termine_origine":"viola da braccio","catena":[{"codice":"it","nome":"Italian","termine":"viola da braccio","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"bracchium","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"From Bratschgeige, from Italian viola da braccio, from viola and braccio (“arm”), from Latin bracchium. Doublet of Bratze."},{"parola":"Bratze","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"forepaw of an animal (e.g. wild ones like lion and bear, but also of tamed ones like dog and cat)","termine_origine":"braccio","catena":[{"codice":"it","nome":"Italian","termine":"braccio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"brachium, bracchium","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"βραχίων","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian braccio (“arm”), from Latin brachium, bracchium, from Ancient Greek βραχίων (brakhíōn). Doublet of Bratsche."},{"parola":"Chianti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Chianti (Tuscan red wine)","termine_origine":"chianti","catena":[{"codice":"it","nome":"Italian","termine":"chianti","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"","categoria":"non_precisato"},{"codice":"ett","nome":"Etruscan","termine":"𐌂𐌋𐌀𐌍𐌕𐌄","categoria":"non_precisato"}],"lontana":"ett","ambiti":["cucina"],"via":"","testo":"Borrowed from Italian chianti, after Chianti, its area of production. Through Latin from the Etruscan 𐌂𐌋𐌀𐌍𐌕𐌄 (clante)."},{"parola":"Cicerone","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cicerone (guide who accompanies visitors)","termine_origine":"cicerone","catena":[{"codice":"it","nome":"Italian","termine":"cicerone","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Cicerō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian cicerone."},{"parola":"Diva","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A diva (vocal star)","termine_origine":"diva","catena":[{"codice":"it","nome":"Italian","termine":"diva","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"divus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian diva, from Latin divus 'divinity'."},{"parola":"Finale","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"final","termine_origine":"finale","catena":[{"codice":"it","nome":"Italian","termine":"finale","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fīnālis","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"final","categoria":"calco"}],"lontana":"en","ambiti":["sport"],"via":"","testo":"Borrowed from Italian finale in the 17th c., initially in the form Final. Pfeifer also considers a direct borrowing from Latin fīnālis on account of the Italian term potentially being attested later. The sports sense is a 20th c. semantic loan from English final."},{"parola":"Frittate","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pancake strips","termine_origine":"frittata","catena":[{"codice":"it","nome":"Italian","termine":"frittata","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"frīgere#Latin","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"From Italian frittata, from Italian fritto, Past Participle of Italian friggere (“to fry, to sizzle”), from Latin frīgere (“to roast, fry”)."},{"parola":"Fuge","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"fugue","termine_origine":"fuga","catena":[{"codice":"it","nome":"Italian","termine":"fuga","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fuga","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"From Italian fuga, itself borrowed from Latin fuga."},{"parola":"Granate","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a grenade (weapon)","termine_origine":"granata","catena":[{"codice":"it","nome":"Italian","termine":"granata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"grānum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian granata (“pomegranate”), from Latin grānum (“grain, seed”)."},{"parola":"Gusto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"appetite; desire","termine_origine":"gusto","catena":[{"codice":"it","nome":"Italian","termine":"gusto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gustus","categoria":"non_precisato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*gustus","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ǵéwstus","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian gusto, from Latin gustus (“tasting”), from Proto-Italic *gustus, from Proto-Indo-European *ǵéwstus."},{"parola":"Inferno","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"inferno (catastrophic scenario, especially involving fire)","termine_origine":"inferno","catena":[{"codice":"it","nome":"Italian","termine":"inferno","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"īnfernus (locus)","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian inferno, from Latin īnfernus (locus) (“hell”). Adopted in the context of Dante’s Inferno. Freer use chiefly since the 19th century."},{"parola":"Kadenz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a cadenza (a part of a piece of music)","termine_origine":"cadenza","catena":[{"codice":"it","nome":"Italian","termine":"cadenza","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cadentia","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian cadenza, from Latin cadentia."},{"parola":"Kanal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"canal (man-made watercourse)","termine_origine":"canale","catena":[{"codice":"it","nome":"Italian","termine":"canale","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"canalis","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"channel","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"15th century, from Italian canale, from Latin canalis. The broadcasting sense is a semantic loan from English channel."},{"parola":"Kantilene","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cantilena","termine_origine":"cantilena","catena":[{"codice":"it","nome":"Italian","termine":"cantilena","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cantilēna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian cantilena, from Latin cantilēna."},{"parola":"Kapital","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"capital","termine_origine":"capitale","catena":[{"codice":"it","nome":"Italian","termine":"capitale","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capitālis","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","scienza"],"via":"","testo":"Borrowed from Italian capitale (“(economic) capital”), from Latin capitālis."},{"parola":"Kassa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cash desk","termine_origine":"cassa","catena":[{"codice":"it","nome":"Italian","termine":"cassa","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capsa","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian cassa (“case, crate”), from Latin capsa (“box”)."},{"parola":"Katakombe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"catacomb (underground cemetery)","termine_origine":"catacomba","catena":[{"codice":"it","nome":"Italian","termine":"catacomba","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"catacumbae","categoria":"non_precisato"}],"lontana":"la","ambiti":["sport"],"via":"","testo":"18th century, from Italian catacomba, from Latin catacumbae."},{"parola":"Kohlrabi","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"kohlrabi","termine_origine":"cavoli rape","catena":[{"codice":"it","nome":"Italian","termine":"cavoli rape","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"caulis","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"From Italian cavoli rape, plural of cavolo rapa. The first element was altered after Kohl (“cabbage”), which is cognate with the Italian through Latin caulis. Compare Hunsrik Kohlraab."},{"parola":"Konsum","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"consumption, intake (the act of eating, drinking or using)","termine_origine":"consumo","catena":[{"codice":"it","nome":"Italian","termine":"consumo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cōnsūmō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From earlier Consumo, borrowed from Italian consumo, from Latin cōnsūmō."},{"parola":"Konzert","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"concert (musical event)","termine_origine":"concerto","catena":[{"codice":"it","nome":"Italian","termine":"concerto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"concertō","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed in the 17th century from Italian concerto, ultimately from Latin concertō (“to dispute”)."},{"parola":"Kuppel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dome (structural element resembling the hollow upper half of a sphere)","termine_origine":"cupola","catena":[{"codice":"it","nome":"Italian","termine":"cupola","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cupula","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Borrowed from Italian cupola, from Latin cupula (“little tub”); from cupa, cuppa (“cup”); named for its resemblance to a cup turned over. Doublet of Kübel."},{"parola":"legieren","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to alloy","termine_origine":"legare","catena":[{"codice":"it","nome":"Italian","termine":"legare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ligō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian legare, from Latin ligō (“to bind”), + -ieren."},{"parola":"Libero","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"libero","termine_origine":"libero","catena":[{"codice":"it","nome":"Italian","termine":"libero","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"līber","categoria":"latinismo_dotto"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*louðeros","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₁léwdʰeros","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["sport"],"via":"","testo":"Borrowed from Italian libero."},{"parola":"Lingua franca","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lingua franca","termine_origine":"lingua franca","catena":[{"codice":"it","nome":"Italian","termine":"lingua franca","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"lingua","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian lingua franca (“Frankish language”), the plural is from Latin lingua."},{"parola":"Marille","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"apricot","termine_origine":"armellino","catena":[{"codice":"it","nome":"Italian","termine":"armellino","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"armeniacum","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"Ᾰ̓ρμενῐ́ᾱ","categoria":"prestito"},{"codice":"peo","nome":"Old Persian","termine":"𐎠𐎼𐎷𐎡𐎴","categoria":"prestito"}],"lontana":"peo","ambiti":[],"via":"","testo":"Borrowed from Italian armellino. Do not confuse with the nightshade Morelle and the cherry Morelle (“morello”), Schattenmorelle, which have been mixed up in dialects; an older form of this Marille word Ammarelle meant a kind of cherry."},{"parola":"Null","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"zero (a numeral; numeric symbol of zero)","termine_origine":"nulla","catena":[{"codice":"it","nome":"Italian","termine":"nulla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nūlla","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*né","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"Since late 16th c. From earlier form Nulla (c. 1500), from Italian nulla, from Latin nūlla, feminine of nūllus (“no one”), ultimately from Proto-Indo-European *né, *óynos and *-lós."},{"parola":"null","pos":"num|adj|adv","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"zero; nil; nought; (tennis) love (integer number between −1 and 1, denoting no quantity at all)","termine_origine":"nulla","catena":[{"codice":"it","nome":"Italian","termine":"nulla","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"nulla","categoria":"non_precisato"}],"lontana":"la","ambiti":["diritto_politica"],"via":"","testo":"From the noun Null (“the number zero”), from Italian nulla, from Latin nulla, feminine singular of nullus (“no, none”)."},{"parola":"Nummer","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"number; see usage notes below","termine_origine":"numero","catena":[{"codice":"it","nome":"Italian","termine":"numero","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"numerus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From earlier Numero, from Italian numero, from Latin numerus (“number”). The feminine gender is probably due to the influence of Zahl f (“number”)."},{"parola":"Oper","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"opera (theatrical work, combining drama, music, song and sometimes dance)","termine_origine":"opera","catena":[{"codice":"it","nome":"Italian","termine":"opera","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"opera","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*opos","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₃épos","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian opera."},{"parola":"Ortolan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ortolan (Emberiza hortulana)","termine_origine":"ortolano","catena":[{"codice":"it","nome":"Italian","termine":"ortolano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"hortulānus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian ortolano, from Latin hortulānus (“gardener”)."},{"parola":"Piano","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"piano (musical instrument)","termine_origine":"piano","catena":[{"codice":"it","nome":"Italian","termine":"piano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"plānus","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian piano which was clipped from pianoforte, from Latin plānus."},{"parola":"Pietà","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pietà (sculpture or painting of the Virgin Mary holding and mourning the dead body of Jesus)","termine_origine":"pietà","catena":[{"codice":"it","nome":"Italian","termine":"pietà","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pietās","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pietà, from Latin pietās."},{"parola":"Pirat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pirate (a criminal who plunders at sea)","termine_origine":"pīrāta","catena":[{"codice":"it","nome":"Italian","termine":"pīrāta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pīrāta","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πειρατής","categoria":"non_precisato"}],"lontana":"grc","ambiti":["mare","diritto_politica"],"via":"","testo":"Borrowed from Italian pirata, from Latin pīrāta, from Ancient Greek πειρατής (peiratḗs)."},{"parola":"Polenta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"polenta (maize porridge, often fried)","termine_origine":"polenta","catena":[{"codice":"it","nome":"Italian","termine":"polenta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"polenta","categoria":"ereditato"}],"lontana":