{"arrivo":"de","origine":"bar","origine_nome":"Bavarian","livello2":"gmh","livello2_nome":"Middle High German","n":11,"parole":[{"parola":"Gfrast","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"young rascal","termine_origine":"Gfrast","catena":[{"codice":"bar","nome":"Bavarian","termine":"Gfrast","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"gevræʒe","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*fraetan","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"From Bavarian Gfrast, from Middle High German gevræʒe, gevræze, from vrâʒ, from Middle High German frezzen, from Old High German frezzan, firezzan, from Proto-West Germanic *fraetan. Doublet of Gefresse."},{"parola":"Glumpert","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stuff, junk, odds and ends","termine_origine":"Glumpert","catena":[{"codice":"bar","nome":"Bavarian","termine":"Glumpert","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"lumpe","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Via Bavarian Glumpert from Middle High German lumpe. Related to Gelumpe."},{"parola":"Gwirks","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tricky or complicated situation, imbroglio, entanglement","termine_origine":"Gwirks","catena":[{"codice":"bar","nome":"Bavarian","termine":"Gwirks","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"gewürk","categoria":"ereditato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*wirkijan","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wirkijaną","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Bavarian Gwirks, Middle High German gewürk, gewürke or gewürche, from wirken, from Old High German wirken, from Proto-West Germanic *wirkijan, from Proto-Germanic *wirkijaną. Related to Gewirk and Gewirke."},{"parola":"Hendl","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chicken, especially one that is young","termine_origine":"Hendl","catena":[{"codice":"bar","nome":"Bavarian","termine":"Hendl","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"hendl","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Via Bavarian Hendl from Middle High German hendl, hendel, henel, from Old High German *henil, diminutive of Old High German hano (“cock, rooster”), equivalent to Hahn + -el."},{"parola":"Maut","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"toll (for a road, tunnel etc.)","termine_origine":"","catena":[{"codice":"bar","nome":"Bavarian","termine":"","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"mūte","categoria":"ereditato"},{"codice":"got","nome":"Gothic","termine":"𐌼𐍉𐍄𐌰","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*mōtō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"A Bavarian word, from Middle High German mūte, from Old High German mūta, borrowed from Gothic 𐌼𐍉𐍄𐌰 (mōta), from Proto-Germanic *mōtō. Cognate with Old English mōt and Swedish muta"},{"parola":"narrisch","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"silly, idiotic","termine_origine":"narrisch","catena":[{"codice":"bar","nome":"Bavarian","termine":"narrisch","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"nerrisch","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"From Bavarian narrisch, from Middle High German nerrisch, from Old High German nerrisk."},{"parola":"Pülcher","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"croo