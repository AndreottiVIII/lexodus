prestito","incerta":"no","significato":"curb bit, curb (driving bit for a horse)","termine_origine":"kantár","catena":[{"codice":"hu","nome":"Hungarian","termine":"kantár","categoria":"prestito"}],"lontana":"hu","ambiti":["sport"],"via":"","testo":"Borrowed from Hungarian kantár (“bridle”)."},{"parola":"Kutsche","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"carriage, coach (a wagon, usually upholstered, pulled by horses)","termine_origine":"kocsi","catena":[{"codice":"hu","nome":"Hungarian","termine":"kocsi","categoria":"prestito"}],"lontana":"hu","ambiti":[],"via":"","testo":"Borrowed from Hungarian kocsi, from the village of Kocs. Doublet of Coach."},{"parola":"Langos","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional Hungarian fried dough, usually seasoned with garlic, sour cream or cheese and sold as a fast food.","termine_origine":"lángos","catena":[{"codice":"hu","nome":"Hungarian","termine":"lángos","categoria":"prestito"}],"lontana":"hu","ambiti":["cucina"],"via":"","testo":"Borrowed from Hungarian lángos, from láng (“flame”) + -os."},{"parola":"Lellek","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"punk, flunkey","termine_origine":"lélek","catena":[{"codice":"hu","nome":"Hungarian","termine":"lélek","categoria":"prestito"}],"lontana":"hu","ambiti":[],"via":"","testo":"Borrowed from Hungarian lélek. The word is alleged to have arisen regionally in the Ruhrgebiet in the mid-2000s, then rearose to popularity from around 2020."},{"parola":"Letscho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lecsó (traditional vegetable ragout)","termine_origine":"lecsó","catena":[{"codice":"hu","nome":"Hungarian","termine":"lecsó","categoria":"prestito"}],"lontana":"hu","ambiti":["cucina"],"via":"","testo":"Borrowed from Hungarian lecsó."},{"parola":"Mohar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"