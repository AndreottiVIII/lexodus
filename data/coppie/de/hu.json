rc","nome":"Ancient Greek","termine":"πέπερι","traslitterazione":"péperi","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"पिप्पलि","traslitterazione":"pippali","categoria":"non_precisato"}],"lontana":"sa","ambiti":["cucina"],"via":"","testo":"Borrowed from Hungarian paprika, from Serbo-Croatian pàprika, from pȁpar, from Proto-Slavic *pьpьrь, from Latin piper, from Ancient Greek πέπερι (péperi, “pepper”), from Sanskrit पिप्पलि (pippali, “long pepper”)."},{"parola":"Pogatsche","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A type of small pancake.","termine_origine":"pogácsa","catena":[{"codice":"hu","nome":"Hungarian","termine":"pogácsa","categoria":"prestito"}],"lontana":"hu","ambiti":[],"via":"","testo":"Borrowed from Hungarian pogácsa."},{"parola":"Primas","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"the head fiddler of a Sinti music group","termine_origine":"prímás","catena":[{"codice":"hu","nome":"Hungarian","termine":"prímás","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"prīmās","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["musica"],"via":"","testo":"Borrowed from Hungarian prímás, also from Late Latin prīmās (“chief”)."},{"parola":"Puszta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pusta","termine_origine":"puszta","catena":[{"codice":"hu","nome":"Hungarian","termine":"puszta","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pustъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Hungarian puszta. Ultimately from Proto-Slavic *pustъ."},{"parola":"Schabracke","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shabrack (decorative saddlecloth)","termine_origine":"csábrák","catena":[{"codice":"hu","nome":"Hungarian","termine":"csábrák","categoria":"prestito"},{"codice":"ota","nome"