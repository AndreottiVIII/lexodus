{"arrivo":"de","origine":"tr","origine_nome":"Turkish","n":22,"parole":[{"parola":"Abrasch","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abrash (variation or deviation of a colour in Oriental rugs)","termine_origine":"abraş","catena":[{"codice":"tr","nome":"Turkish","termine":"abraş","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"أَبْرَش","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Turkish abraş, from Ottoman Turkish ابراش, from Arabic أَبْرَش (ʔabraš, “dappled, mottled”)."},{"parola":"Aische","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"a woman or girl of Turkish descent","termine_origine":"Ayşe","catena":[{"codice":"tr","nome":"Turkish","termine":"Ayşe","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"عَائِشَة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Turkish Ayşe, from Arabic عَائِشَة (ʕāʔiša). The use as a common noun is due to the name's commonness among Turkish immigrants, possibly reinforced by the unrelated noun Ische (“gal, chick”)."},{"parola":"Alman","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"someone with stereotypical German traits","termine_origine":"Alman","catena":[{"codice":"tr","nome":"Turkish","termine":"Alman","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"Allemand","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Turkish Alman (“German”), ultimately from French Allemand."},{"parola":"baba","pos":"adj","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"boss, rad, fly","termine_origine":"baba","catena":[{"codice":"tr","nome":"Turkish","termine":"baba","categoria":"prestito"}],"lontana":"tr","ambiti":[],"via":"","testo":"From Turkish baba."},{"parola":"Baklava","pos":"noun","n_etimologia":1,"categoria":"p