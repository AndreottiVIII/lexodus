{"arrivo":"de","origine":"fr","origine_nome":"French","livello2":"es","livello2_nome":"Spanish","n":20,"parole":[{"parola":"Alkoven","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"alcove, particularly: a bed built or let into the wall","termine_origine":"alcôve","catena":[{"codice":"fr","nome":"French","termine":"alcôve","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"alcoba","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"قبة","categoria":"non_precisato"},{"codice":"gml","nome":"Middle Low German","termine":"koven","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"From French alcôve f, from Spanish alcoba, from Arabic القبَة. The later final -n and masculine gender in German through association with unrelated Middle Low German koven (“stable, shed, nook”)."},{"parola":"Aviso","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"light and fast warship with few weapons","termine_origine":"aviso","catena":[{"codice":"fr","nome":"French","termine":"aviso","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"barca de aviso","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"avis","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from French aviso, from Spanish barca de aviso, from French avis."},{"parola":"Cedille","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cedilla","termine_origine":"cédille","catena":[{"codice":"fr","nome":"French","termine":"cédille","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"cedilla","categoria":"non_precisato"}],"lontana":"es","ambiti":[],"via":"","testo":"Borrowed from French cédille, from Spanish cedilla, from zedilla."},{"parola":"Dorade","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of Goldbrasse (“seabream”)","termine_origine":"dorade","c