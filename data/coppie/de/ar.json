{"arrivo":"de","origine":"ar","origine_nome":"Arabic","n":63,"parole":[{"parola":"Aba","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aba","termine_origine":"عَبَاءَة","catena":[{"codice":"ar","nome":"Arabic","termine":"عَبَاءَة","categoria":"prestito"}],"lontana":"ar","ambiti":["finanza","moda"],"via":"","testo":"Borrowed from Arabic عَبَاءَة (ʕabāʔa)."},{"parola":"achtbar","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"reputable, respectable","termine_origine":"أَكْبَر","catena":[{"codice":"ar","nome":"Arabic","termine":"أَكْبَر","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Middle High German ahtbære, ahtebære. Equivalent to Acht + -bar. Potentially originally derived in part or in whole from Arabic أَكْبَر (ʔakbar, “big, great, powerful”) during the Crusades."},{"parola":"Ali","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a Muslim, especially Turkish, immigrant (or descendant of immigrants)","termine_origine":"عَلِيّ","catena":[{"codice":"ar","nome":"Arabic","termine":"عَلِيّ","categoria":"prestito"}],"lontana":"ar","ambiti":[],"via":"","testo":"Eventually from Arabic عَلِيّ (ʕaliyy)."},{"parola":"Aqal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"agal (headband worn by Arab men)","termine_origine":"عِقَال","catena":[{"codice":"ar","nome":"Arabic","termine":"عِقَال","categoria":"prestito"}],"lontana":"ar","ambiti":["moda"],"via":"","testo":"Borrowed from Arabic عِقَال (ʕiqāl)."},{"parola":"Atlas","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"atlas satin","termine_origine":"أَطْلَس","catena":[{"codice":"ar","nome":"Arabic","termine":"أَطْلَس","categoria":"prestito"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Arabic أَطْلَس (ʔaṭlas)."},{"parola":"Bamia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","signific