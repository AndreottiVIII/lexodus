{"arrivo":"de","origine":"gsw","origine_nome":"Alemannic German","n":35,"parole":[{"parola":"Alb","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"mountainous area, upland","termine_origine":"Alp","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Alp","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"albe","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Alp, from Middle High German albe, from Old High German alba."},{"parola":"Böschung","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"embankment (incline in the terrain, often fortified and running in parallel to a path, road or river)","termine_origine":"","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"","categoria":"non_precisato"}],"lontana":"gsw","ambiti":[],"via":"","testo":"From a western, probably Alemannic German, form of Busch (“bush”) – compare Luxembourgish Bësch – directly suffixed with -ung. The expected underlying verb böschen is only attested later and probably a back-formation."},{"parola":"Chlapf","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"clap (any loud, sudden, explosive sound made by striking hard surfaces together, or resembling such a sound)","termine_origine":"Chlapf","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Chlapf","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Unadapted borrowing from Alemannic German Chlapf. Doublet of Klapf."},{"parola":"Eigenbrötler","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"maverick, loner; someone who keeps themselves to themselves, follows their own path, and appears not to attach great va…","termine_origine":"","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"","categoria":"non_precisato"}],"lontana":"gsw","ambiti":[],"via":"","testo":"From Alemannic German (standard 19th century). Equivalent to eigen + Brot + -ler, literally “own-breader”, originally referring to a bachelor with his own household; compare Middle High German eigen brōt in the sense of “own household”."},{"parola":"Firn","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"névé, firn","termine_origine":"firn","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"firn","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German firn."},{"parola":"Gletscher","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"glacier","termine_origine":"Gletscher","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Gletscher","categoria":"prestito"},{"codice":"rm","nome":"Romansh","termine":"glatscher","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*glaciārium","categoria":"ereditato"}],"lontana":"la-vul","ambiti":["scienza"],"via":"","testo":"Borrowed from Alemannic German Gletscher, from Romansh glatscher, from Vulgar Latin *glaciārium. First attested in the sixteenth century. Cognate with French glacier."},{"parola":"Guggenmusik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the music played on Fasnacht","termine_origine":"Guggemusig","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Guggemusig","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Guggemusig."},{"parola":"Jass","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jass","termine_origine":"Jass","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Jass","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"","categoria":"non_precisato"}],"lontana":"nl","ambiti":["sport"],"via":"","testo":"Borrowed from Alemannic German Jass, from Dutch."},{"parola":"Jucker","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"coach horse, light carriage horse","termine_origine":"jucken","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"jucken","categoria":"non_precisato"}],"lontana":"gsw","ambiti":[],"via":"","testo":"From Alemannic German jucken, a synonym of German springen. cf. juckeln."},{"parola":"Kantönligeist","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a mindset or ideological trend wherein the sovereignty and interests of a particular canton are seen as supreme over fe…","termine_origine":"Kantönligeischt","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Kantönligeischt","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Kantönligeischt."},{"parola":"Kartoffelstock","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"mashed potatoes","termine_origine":"Härdöpfelstock","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Härdöpfelstock","categoria":"calco"}],"lontana":"gsw","ambiti":["cucina"],"via":"","testo":"Calque of Alemannic German Härdöpfelstock: Kartoffel + Stock"},{"parola":"Kilch","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kilch, whitefish (freshwater fish of the genus Coregonus)","termine_origine":"Kilch","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Kilch","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"kelch","categoria":"ereditato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"From Alemannic German Kilch, from Middle High German kelch, from Old High German chelch. Doublet of Kelch \"double chin\"."},{"parola":"Käppi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kepi","termine_origine":"","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"","categoria":"prestito"}],"lontana":"gsw","ambiti":["moda"],"via":"","testo":"Originally an Alemannic German diminutive of Kappe."},{"parola":"Käs","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cheese","termine_origine":"Käs","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Käs","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Käs. Austrian German variant of Käse (“cheese”) (alongside Kas which is mainly used outside of Vorarlberg). Used in compounds referring to certain dishes that contain cheese such as Käsknöpfle."},{"parola":"Lavabo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sink, washbasin","termine_origine":"Lavabo","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Lavabo","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"lavabo","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Lavabo, itself borrowed from French lavabo."},{"parola":"Lawine","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"avalanche","termine_origine":"Lauwin","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Lauwin","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"lowin","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"labina","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Alemannic German Lauwin, from Middle High German lowin, *lawene (compare Bavarian Laun, Lan), from Old High German lowin, lewina, from Late Latin labina, from Latin lābī (“to glide”)."},{"parola":"Löli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of Tollpatsch (“clumsy person; fool”)","termine_origine":"Löli","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Löli","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Löli. Related to dialectal lollen, lallen (“to babble”)."},{"parola":"Löss","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"loess","termine_origine":"lösch","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"lösch","categoria":"prestito"}],"lontana":"gsw","ambiti":["scienza"],"via":"","testo":"Perhaps from Alemannic German lösch (“loose”)."},{"parola":"Maitli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"girl, lass","termine_origine":"Maitli","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Maitli","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Maitli."},{"parola":"Müsli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"muesli, granola","termine_origine":"Müesli","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Müesli","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German Müesli, diminutive of Mues, itself cognate to German Mus and English mush (“stew, pottage”)."},{"parola":"poppen","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"to play with dolls","termine_origine":"","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Derived from an Alemannic German cognate of Puppe (“doll”)."},{"parola":"Putsch","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"coup d'état, armed uprising, putsch","termine_origine":"Putsch","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Putsch","categoria":"prestito"}],"lontana":"gsw","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from Alemannic German Putsch (literally “blow”), popularized in the context of the Züriputsch in Zurich (1839)."},{"parola":"Rappen","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rappen (a unit of currency in Switzerland and Liechtenstein, equal to one-hundredth of a Swiss franc)","termine_origine":"Rapp","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Rapp","categoria":"prestito"}],"lontana":"gsw","ambiti":["finanza"],"via":"","testo":"From a variant of Alemannic German Rapp (“raven”). Doublet of Rabe."},{"parola":"Rucksack","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"backpack","termine_origine":"Ruggsack","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Ruggsack","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"From Alemannic German Ruggsack, equivalent to Standard German Rücken (“back”) + Sack (“sack”). Compare Dutch rugzak, English rucksack, Danish rygsæk, Russian рюкзак (rjukzak), and Swedish ryggsäck."},{"parola":"Rösti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rösti, hash browns","termine_origine":"","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"","categoria":"prestito"}],"lontana":"gsw","ambiti":["cucina"],"via":"","testo":"Borrowed from Alemannic German, from the same root as rösten (“to roast, to toast”)."},{"parola":"Rüebli","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"carrot","termine_origine":"Rüebli","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Rüebli","categoria":"non_precisato"}],"lontana":"gsw","ambiti":["cucina"],"via":"","testo":"Borrowed from Alemannic German Rüebli."},{"parola":"Schmutziger Donnerstag","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"Fat Thursday (the last Thursday before Lent)","termine_origine":"Schmutzige Dunschtig","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Schmutzige Dunschtig","categoria":"calco"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Calque of Alemannic German Schmutzige Dunschtig. Although cognate with Standard German schmutzig (“dirty”), the meaning of the Alemannic term is \"fatty, greasy\"."},{"parola":"Schoggi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of Schokolade","termine_origine":"Schoggi","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Schoggi","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Alemannic German Schoggi."},{"parola":"Spätzle","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Unclear; Possibly; obscure","significato":"spaetzle (southern German kind of noodles)","termine_origine":"Spätzle","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Spätzle","categoria":"prestito"},{"codice":"roa-rhe","nome":"Rhaeto-Romance","termine":"","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"battuo","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Alemannic German Spätzle, unclear if. # a diminutive of Spatz (“sparrow”), comparing the name of the dish Rindsvögel # or in another ablaut to the family of Spitze (“cusp, peak”), German Spieß (“spit”), comparing to the Italian spirelli (literally “little spires or coils”); compare its"},{"parola":"Strolch","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Of uncertain origin; Possibly","significato":"a rascal","termine_origine":"strollen","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"strollen","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"astrologo","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"strolchen","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Related to Alemannic German strollen, of uncertain origin, but possibly from Italian astrologo (“astrologer”). Related also to German strolchen."},{"parola":"töggelen","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of kickern","termine_origine":"töggele","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"töggele","categoria":"prestito"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Borrowed from Alemannic German töggele."},{"parola":"Töggelikasten","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"synonym of Kickertisch","termine_origine":"Töggelichaschte","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Töggelichaschte","categoria":"calco"}],"lontana":"gsw","ambiti":[],"via":"","testo":"Partial calque of Alemannic German Töggelichaschte."},{"parola":"Wechte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cornice (overhanging edge of snow)","termine_origine":"Wächti","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Wächti","categoria":"prestito"}],"lontana":"gsw","ambiti":["scienza","sport"],"via":"","testo":"Borrowed from Alemannic German Wächti, an abstract noun derived from the equivalent of wehen (“to blow (of wind)”)."},{"parola":"Znüni","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A mid-morning snack or second breakfast.","termine_origine":"Znüni","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Znüni","categoria":"prestito"}],"lontana":"gsw","ambiti":["cucina"],"via":"","testo":"From Alemannic German Znüni, z'Nüüni, from zue (“at”) and nüün (“nine”)."},{"parola":"Zvieri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A mid-afternoon snack or afternoon tea.","termine_origine":"Zvieri","catena":[{"codice":"gsw","nome":"Alemannic German","termine":"Zvieri","categoria":"prestito"}],"lontana":"gsw","ambiti":["cucina"],"via":"","testo":"From Alemannic German Zvieri, z'Vieri, from zue (“at”) and vier (“four”)."}]}