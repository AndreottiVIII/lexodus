":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"Borrowed from German Kruft, from Latin crypta, from Ancient Greek κρυπτή (kruptḗ), female form of the adjective κρυπτός (kruptós). Doublet of krypta (“crypt”).","livello2_varieta":"la"},{"parola":"kverulant","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"complainer","termine_origine":"Querulant","catena":[{"codice":"de","nome":"German","termine":"Querulant","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"querulans","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from German Querulant, from Medieval Latin querulans.","livello2_varieta":"la-med"},{"parola":"lavina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"avalanche (large sliding mass of snow and ice)","termine_origine":"Lawine","catena":[{"codice":"de","nome":"German","termine":"Lawine","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"labina","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from German Lawine, ultimately from Late Latin labina.","livello2_varieta":"la-lat"},{"parola":"mapa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"map (visual representation of an area)","termine_origine":"Mappe","catena":[{"codice":"de","nome":"German","termine":"Mappe","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"mappa mundī","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from German Mappe, from Medieval Latin mappa mundī, from Latin mappa.","livello2_varieta":"la-med"},{"parola":"metoda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"method (process by which a task is completed)","termine_origine":"Methode","catena":[{"codice":"de","nome":"German","termine":"Methode","categoria":"prestito"},{"codice