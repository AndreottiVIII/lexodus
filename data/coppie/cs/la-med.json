o":"camomile","termine_origine":"","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["cucina"],"via":"","testo":"Inherited from Old Czech heřmánek, from heřman + -ek, from Medieval Latin, later found in translingual Chamomilla romana, Chamaemelum romanum, Anthemis romana, and the like."},{"parola":"instrumentál","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"instrumental, instrumental case (case to express agency or means)","termine_origine":"īnstrūmentālis","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"īnstrūmentālis","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["scienza"],"via":"","testo":"From Medieval Latin īnstrūmentālis, from īnstrūmentum (“instrument, tool”), from īnstruō (“build, construct; arrange”)."},{"parola":"kancionál","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hymnal (collection of church songs)","termine_origine":"cantiōnālis","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"cantiōnālis","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["musica","religione"],"via":"","testo":"Inherited from Old Czech kancionál, from Medieval Latin cantiōnāle, from Latin cantiō."},{"parola":"klávesa","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"key (on a musical instrument)","termine_origine":"clāvēs","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"clāvēs","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin clāvēs, a plural of Medieval Latin clāvis (“key”), originally a mechanism for closing pipes of an organ."},{"parola":"kontrolovat","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to check; to check for","termine_origine":"contrarotulum","catena":[{"codice":"la-med","nome":"Medieval Latin","termin