icato":"cretin","termine_origine":"crétin","catena":[{"codice":"fr","nome":"French","termine":"crétin","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"christiānus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from French crétin from an Alpine dialectal form of chrétien, from Vulgar Latin christiānus in the sense of “anyone in Christendom”, often with a sense of “poor fellow”.","livello2_varieta":"la-vul"},{"parola":"malér","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trouble","termine_origine":"malheur","catena":[{"codice":"fr","nome":"French","termine":"malheur","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"malus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from French malheur from mal (from Latin malus (“bad”)) + heur (“chance”) (from Latin augurium (“divination, omen”)). First attested in the 19th century.","livello2_varieta":"la"},{"parola":"metr","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"meter (US), metre (UK)","termine_origine":"mètre","catena":[{"codice":"fr","nome":"French","termine":"mètre","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"metrum","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"μέτρον","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from French mètre.","livello2_varieta":"la"},{"parola":"naivní","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"naive","termine_origine":"naïf","catena":[{"codice":"fr","nome":"French","termine":"naïf","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"nātīvus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From German naiv + -ní, from French naïf, from Latin nātīvus.","livello2_varieta":"la"},{"parola":"negližé","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"négligée","termine_origine":"négligé","catena":[{"codice":"fr","nome":"French","termine":"négligé","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"negligere","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Derived from French négligé (“underdressed; loose garment”), past participle of négliger (“to neglect”), from Latin negligere.","livello2_varieta":"la"},{"parola":"pivoňka","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"peony (Paeonia genus of flowering plants)","termine_origine":"pivoine","catena":[{"codice":"fr","nome":"French","termine":"pivoine","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"paeōnia","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"παιωνία","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Probably from French pivoine, from Latin paeōnia (“peony”), from Ancient Greek παιωνία (paiōnía, “peony”), + -ka.","livello2_varieta":"la"},{"parola":"prestiž","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"prestige","termine_origine":"prestige","catena":[{"codice":"fr","nome":"French","termine":"prestige","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"praestīgium","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from French prestige.","livello2_varieta":"la"},{"parola":"režim","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"regime, mode (mode of rule or management)","termine_origine":"régime","catena":[{"codice":"fr","nome":"French","termine":"régime","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"regimen","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from French régime, from Latin regimen.","livello2_varieta":"la"},{"parola":"sekretář","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"secretary (person keeping records)","termine_origine":"secrétaire","catena":[{"codice":"fr","nome":"French","termine":"secrétaire","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"sēcrētārius","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from French secrétaire, from Medieval Latin sēcrētārius (“one entrusted with secrets”), from Latin sēcrētus (“confided only to a few”).","livello2_varieta":"la-med"},{"parola":"sezóna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"season (part of year with something special)","termine_origine":"saison","catena":[{"codice":"fr","nome":"French","termine":"saison","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"satiō","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from French saison.","livello2_varieta":"la"},{"parola":"terén","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ground","termine_origine":"terrain","catena":[{"codice":"fr","nome":"French","termine":"terrain","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*terranum","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*terzeznos","categoria":"ereditato"}],"lontana":"itc-pro","ambiti":[],"via":"","testo":"Borrowed from French terrain.","livello2_varieta":"la-vul"},{"parola":"uniforma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"uniform (outfit)","termine_origine":"uniforme","catena":[{"codice":"fr","nome":"French","termine":"uniforme","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ūnifōrmis","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["moda"],"via":"","testo":"Borrowed from French uniforme.","livello2_varieta":"la"},{"parola":"vizita","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a visit by a doctor or team of doctors to the patient's bedside","termine_origine":"visite","catena":[{"codice":"fr","nome":"French","termine":"visite","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"visitare","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Derived from French visite, from Latin visitare.","livello2_varieta":"la"},{"parola":"žampion","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"any mushroom of the genus Agaricus, often a champignon (Agaricus bisporus) or a field mushroom (Agaricus campestris)","termine_origine":"champignon","catena":[{"codice":"fr","nome":"French","termine":"champignon","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*campāniolus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"de","testo":"Borrowed from French champignon (possibly through German Champignon)), which comes from Vulgar Latin *campāniolus (“growing in the field”), derived from Latin campānia (“field”), from campus (“field”). Compare šampion, kemp or kampaň. First attested in the 19th century.","livello2_varieta":"la-vul"},{"parola":"žampión","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"any mushroom of the genus Agaricus, often a champignon (Agaricus bisporus) or a field mushroom (Agaricus campestris)","termine_origine":"champignon","catena":[{"codice":"fr","nome":"French","termine":"champignon","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*campāniolus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"de","testo":"Borrowed from French champignon (possibly through German Champignon)), which comes from Vulgar Latin *campāniolus (“growing in the field”), derived from Latin campānia (“field”), from campus (“field”). Compare šampion, kemp or kampaň.","livello2_varieta":"la-vul"},{"parola":"žurnál","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"journal","termine_origine":"journal","catena":[{"codice":"fr","nome":"French","termine":"journal","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"diurnālis","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from French journal. First attested in the 19th century.","livello2_varieta":"la"}]}