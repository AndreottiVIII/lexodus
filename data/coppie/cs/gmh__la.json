{"arrivo":"cs","origine":"gmh","origine_nome":"Middle High German","livello2":"la","livello2_nome":"Latin","n":19,"parole":[{"parola":"anýz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"anise (plant and spice)","termine_origine":"anīs","catena":[{"codice":"gmh","nome":"Middle High German","termine":"anīs","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"anīsum","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἄννησον","categoria":"prestito"},{"codice":"egy","nome":"Egyptian","termine":"jnst","categoria":"prestito"}],"lontana":"egy","ambiti":["cucina"],"via":"","testo":"Inherited from Old Czech anýž, from Middle High German anīs, from Latin anisum, from Ancient Greek ἄνισον (ánison)."},{"parola":"bažant","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pheasant","termine_origine":"vasant","catena":[{"codice":"gmh","nome":"Middle High German","termine":"vasant","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"phasianus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"φασιανός","categoria":"non_precisato"}],"lontana":"grc","ambiti":["militare","diritto_politica"],"via":"","testo":"Inherited from Old Czech bažant, from Middle High German vasant, from Latin phasianus, from Ancient Greek φασιανός (phasianós)."},{"parola":"cimbuří","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"battlement, crenellation","termine_origine":"zibōrje","catena":[{"codice":"gmh","nome":"Middle High German","termine":"zibōrje","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cibōrium","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Inherited from Old Czech cimbořie, from Middle High German zibōrje, from Latin cibōrium. Other theories include German Zinnenburg."},{"parola":"fortna","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"small gate","termine_origine":"phorte","catena":[{"codice":"gmh","nome":"Middle High German","termine":"phorte","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"porta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Czech fortna, from Middle High German phorte (“gate”), from Latin porta (“gate”)."},{"parola":"hmoždíř","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"mortar (a hollow vessel used to pound, crush, rub, grind or mix ingredients with a pestle)","termine_origine":"mörser","catena":[{"codice":"gmh","nome":"Middle High German","termine":"mörser","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"mortārium","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Inherited from Old Czech moždieř, from Middle High German mörser, ultimately from Latin mortārium. Reanalysed as hmoždit + -íř."},{"parola":"hont","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"plank, slab","termine_origine":"gant","catena":[{"codice":"gmh","nome":"Middle High German","termine":"gant","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"canthērius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Czech hont, from Middle High German gant, from Latin canthērius."},{"parola":"komnata","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"chamber","termine_origine":"chomenate","catena":[{"codice":"gmh","nome":"Middle High German","termine":"chomenate","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"camīnāta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Czech komňata, from Middle High German chomenate, from Latin camīnāta."},{"parola":"korba","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"truckbed","termine_origine":"korp","catena":[{"codice":"gmh","nome":"Middle High German","termine":"korp","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"corbis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Czech korba, from Middle High German korp (German Korb), from Latin corbis. Related to krabice inherited from Proto-Slavic."},{"parola":"křižmo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"chrism (mixture of oil and balm, consecrated for use as an anointing fluid in certain Christian ceremonies, especially…","termine_origine":"chrismo","catena":[{"codice":"gmh","nome":"Middle High German","termine":"chrismo","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"chrīsma","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"χρῖσμα","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"Inherited from Old Czech křižmo, from Middle High German chrismo, from Latin chrīsma, from Ancient Greek χρῖσμα (khrîsma)."},{"parola":"křída","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chalk (for writing)","termine_origine":"krīde","catena":[{"codice":"gmh","nome":"Middle High German","termine":"krīde","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"crēta","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Middle High German krīde, from Latin crēta."},{"parola":"lampa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lamp","termine_origine":"lampe","catena":[{"codice":"gmh","nome":"Middle High German","termine":"lampe","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"lampas","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"λαμπάς","categoria":"non_precisato"}],"lontana":"grc",