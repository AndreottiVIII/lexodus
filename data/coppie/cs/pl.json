{"arrivo":"cs","origine":"pl","origine_nome":"Polish","n":75,"parole":[{"parola":"blizna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stigma (the sticky part of a flower that receives pollen during pollination)","termine_origine":"blizna","catena":[{"codice":"pl","nome":"Polish","termine":"blizna","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*blizna","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Polish blizna, from Proto-Slavic *blizna."},{"parola":"brunátný","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"purple, ruddy","termine_origine":"brunatny","catena":[{"codice":"pl","nome":"Polish","termine":"brunatny","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish brunatny."},{"parola":"burka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A dress made from felt or karakul (the short curly fur of young lambs of the breed of that name), traditionally worn by…","termine_origine":"burka","catena":[{"codice":"pl","nome":"Polish","termine":"burka","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"бу́рка","categoria":"non_precisato"}],"lontana":"ru","ambiti":[],"via":"","testo":"Borrowed from Polish burka, from Russian бу́рка (búrka)."},{"parola":"burák","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"sugar beet","termine_origine":"burak","catena":[{"codice":"pl","nome":"Polish","termine":"burak","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish burak."},{"parola":"choroš","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"polypore","termine_origine":"chorosz","catena":[{"codice":"pl","nome":"Polish","termine":"chorosz","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"","categoria":"prestito"}],"lontan