{"arrivo":"el","origine":"vec","origine_nome":"Venetan","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":25,"parole":[{"parola":"-αδόρος","pos":"suffix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"added to another noun or verb to create agent nouns denoting illegal or negative actions","termine_origine":"-ador","catena":[{"codice":"vec","nome":"Venetan","termine":"-ador","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"-ator","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Ultimately (through Venetan -ador) from Latin -ator","livello2_varieta":"la"},{"parola":"αβέρτος","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"open","termine_origine":"averto","catena":[{"codice":"vec","nome":"Venetan","termine":"averto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"apertus","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"From Venetan averto, from Latin apertus.","livello2_varieta":"la"},{"parola":"αλισίβα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lye (alkaline solution)","termine_origine":"lisiva","catena":[{"codice":"vec","nome":"Venetan","termine":"lisiva","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"lixivus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Venetan lisiva, ultimately from Latin lixivus.","livello2_varieta":"la"},{"parola":"ατσάλι","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"steel","termine_origine":"azzal","catena":[{"codice":"vec","nome":"Venetan","termine":"azzal","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"aciarium","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["scienza"],"via":"","testo":"From medieval Venetan azzal, (modern azhal açal, asal), from Late Latin aciarium (“steel”), from Latin acies (“sharp edge”).","livello2_varieta":"la-lat"},{"parola":"βέρα","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"wedding ring","termine_origine":"vera","catena":[{"codice":"vec","nome":"Venetan","termine":"vera","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"viria","categoria":"non_precisato"}],"lontana":"la","ambiti":["moda"],"via":"","testo":"From Byzantine Greek βέρα (béra), from Venetan vera, from Latin viria.","livello2_varieta":"la"},{"parola":"γαζία","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the needle bush or sweet acacia (Vachellia farnesiana)","termine_origine":"gazia","catena":[{"codice":"vec","nome":"Venetan","termine":"gazia","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"acacia","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀκακία","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"An αντιδάνειο (antidáneio, “repatriated loanword”). Borrowed from Venetan gazia (compare Italian gaggia), from Late Latin acacia, from Ancient Greek ἀκακία (akakía), from ἀκή (akḗ, “point”). Doublet of ακακία (akakía).","livello2_varieta":"la-lat"},{"parola":"γαρύφαλλο","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"clove (spice)","termine_origine":"garofolo","catena":[{"codice":"vec","nome":"Venetan","termine":"garofolo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"caryophyllus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"καρυόφυλλον","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"From γαρούφαλο (garoúfalo), from Venetan garofolo, from Latin caryophyllus (“clove”), ultimately from Ancient Greek καρυόφυλλον (karuóphullon, “clove tree”).","livello2_varieta":"la"},{"parola":"κάδρο","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"frame, picture frame","termine_origine":"quadro","catena":[{"codice":"vec","nome":"Venetan","termine":"quadro","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"quadrum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Byzantine Greek κάδρον (kádron), from Venetan quadro, from Latin quadrum.","livello2_varieta":"la"},{"parola":"καβάλα","pos":"noun|adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"equestrianism, horsemanship","termine_origine":"cavala","catena":[{"codice":"vec","nome":"Venetan","termine":"cavala","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"caballa","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":["militare","diritto_politica"],"via":"","testo":"Inherited from Byzantine Greek καβάλα (kabála, “mare; equestrianism, horsemanship; cavalry”), borrowed from Venetan cavala or Late Latin caballa. The adverbialization of the noun occurred analogously to γραμμή (grammí).","livello2_varieta":"la-lat"},{"parola":"καδένα","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"chain at neck, wrist","termine_origine":"cadena","catena":[{"codice":"vec","nome":"Venetan","termine":"cadena","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"catēna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Venetan cadena, from Latin catēna.","livello2_varieta":"la"},{"parola":"καλάρω","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to submerge fishing nets","termine_origine":"calar","catena":[{"codice":"vec","nome":"Venetan","termine":"calar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*calāre","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"χαλάω","categoria":"non_precisato"}],"lontana":"grc","ambiti":["mare"],"via":"","testo":"Borrowed from Venetan calar (“to sink, submerge”), from Vulgar Latin *calāre (“to loosen and let drop, submerge”), from Latin chalāre, from Ancient Greek χαλάω (khaláō, “to slacken, loosen”).","livello2_varieta":"la-vul"},{"parola":"κορδέλα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ribbon","termine_origine":"cordela","catena":[{"codice":"vec","nome":"Venetan","termine":"cordela","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"chorda","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"χορδή","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Venetan cordela, from Venetan corda, inherited from Latin chorda, ultimately from Ancient Greek χορδή (khordḗ).","livello2_varieta":"la"},{"parola":"κουβέρτα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"blanket","termine_origine":"coverta","catena":[{"codice":"vec","nome":"Venetan","termine":"coverta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cooperta","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"Borrowed from Venetan coverta, from Latin cooperta. Compare standard Italian coperta, French couvert(ur)e.","livello2_varieta":"la"},{"parola":"κουζίνα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kitchen","termine_origine":"cusina","catena":[{"codice":"vec","nome":"Venetan","termine":"cusina","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"cocīna","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Venetan cusina, from Late Latin cocīna, from earlier coquīna.","livello2_varieta":"la-lat"},{"parola":"κουμπάρος","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"One's best man, koumbaros: the primary attendant (to the couple) in a wedding ceremony.","termine_origine":"compare","catena":[{"codice":"vec","nome":"Venetan","termine":"compare","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"compater","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Venetan compare (“godfather”), conpare, from Latin compater, compatrem, from cum (“with”) + pater (“father”).","livello2_varieta":"la"},{"parola":"κουνιάδα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sister-in-law, specifically spouse's sister","termine_origine":"cognada","catena":[{"codice":"vec","nome":"Venetan","termine":"cognada","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cognāta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Venetan cognada, cugnada, from Latin cognāta.","livello2_varieta":"la"},{"parola":"κουνιάδος","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"brother-in-law, specifically spouse's brother","termine_origine":"cognado","catena":[{"codice":"vec","nome":"Venetan","termine":"cognado","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cognātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Venetan cognado, cugnado, from Latin cognātus.","livello2_varieta":"la"},{"parola":"μαραγκός","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"carpenter","termine_origine":"marangon","catena":[{"codice":"vec","nome":"Venetan","termine":"marangon","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"From Venetan marangon (“carpenter”), from a Medieval Latin development of Latin mergus (“diver, loon”); see there for more.","livello2_varieta":"la-med"},{"parola":"μπουνάτσα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lull, dead calm, calm sea","termine_origine":"bonazza","catena":[{"codice":"vec","nome":"Venetan","termine":"bonazza","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bonacia","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"μᾰλᾰκῐ́ᾱ","categoria":"prestito"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Venetan bonazza. Doublet of μαλακός (malakós) and μαλακία (malakía).","livello2_varieta":"la-vul"},{"parola":"μπόρα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cloudburst, downpour, rainstorm, rain squall","termine_origine":"bora","catena":[{"codice":"vec","nome":"Venetan","termine":"bora","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"boreas","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"Βορέας","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"Borrowed from Venetan bora (“north-eastern wind”), from Latin boreas (“north wind”), from Ancient Greek Βορέας (Boréas). Compare Turkish bora (“squall”).","livello2_varieta":"la"},{"parola":"ρόδα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wheel","termine_origine":"roda","catena":[{"codice":"vec","nome":"Venetan","termine":"roda","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rota","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Venetan roda, from Latin rota (“wheel”).","livello2_varieta":"la"},{"parola":"σαλάτα","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"salad (a dish, usually served cold, prepared usually from vegetables)","termine_origine":"salata","catena":[{"codice":"vec","nome":"Venetan","termine":"salata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sal","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Venetan salata, ultimately derived from Latin sal (“salt”).","livello2_varieta":"la"},{"parola":"στιφάδο","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stifado (a savoury stew)","termine_origine":"stufado","catena":[{"codice":"vec","nome":"Venetan","termine":"stufado","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"extufo","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"τύφος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"From Venetan stufado, from Latin extufare, from Ancient Greek τύφος (túphos, “steam”). Compare Italian stufato.","livello2_varieta":"la"},{"parola":"τορναδόρος","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"turner","termine_origine":"tornidor","catena":[{"codice":"vec","nome":"Venetan","termine":"tornidor","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tornator","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","scienza","arte"],"via":"","testo":"Ultimately (through Venetan tornidor), from Latin tornator : note: τορνάρω (tornáro, “to turn”) + -αδόρος (-adóros, “occupation”).","livello2_varieta":"la"},{"parola":"φουρτούνα","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rough sea, storm, tempest, squall","termine_origine":"fortuna","catena":[{"codice":"vec","nome":"Venetan","termine":"fortuna","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fortūna","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From Byzantine Greek φορτούνα (phortoúna), borrowed from Venetan fortuna, from Latin fortūna.","livello2_varieta":"la"}]}