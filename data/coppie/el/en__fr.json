{"arrivo":"el","origine":"en","origine_nome":"English","livello2":"fr","livello2_nome":"French","n":16,"parole":[{"parola":"άβυσσος","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"abyss, deep chasm","termine_origine":"abyss","catena":[{"codice":"en","nome":"English","termine":"abyss","categoria":"calco"},{"codice":"fr","nome":"French","termine":"abysse","categoria":"calco"}],"lontana":"fr","ambiti":["mare","scienza"],"via":"","testo":"Learnedly, from Ancient Greek ἄβυσσος (ábussos). For the scientific term, semantic loan from English abyss or French abysse."},{"parola":"ίδρυμα","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"institution, foundation, institute","termine_origine":"institute","catena":[{"codice":"en","nome":"English","termine":"institute","categoria":"calco"},{"codice":"fr","nome":"French","termine":"institut","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"Koine Greek ἵδρῡμα (hídrūma, “establishment; shrine”). Also semantic loan from English institute, foundation or French institut, fondation."},{"parola":"αναπαυτικός","pos":"adj","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"snug, cosy","termine_origine":"comfortable","catena":[{"codice":"en","nome":"English","termine":"comfortable","categoria":"calco"},{"codice":"fr","nome":"French","termine":"confortable","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"Learned borrowing from Koine Greek ἀναπαυστικός (anapaustikós), with semantic loan from English comfortable and French confortable."},{"parola":"βεσέ","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"WC, water closet, (UK) toilet","termine_origine":"WC","catena":[{"codice":"en","nome":"English","termine":"WC","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"WC","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from English WC. The letters, prono