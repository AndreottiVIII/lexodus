{"arrivo":"el","origine":"it","origine_nome":"Italian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":60,"parole":[{"parola":"άμπακας","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a lot, large quantity mainly used in the phrase","termine_origine":"abaco","catena":[{"codice":"it","nome":"Italian","termine":"abaco","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"abacus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἄβαξ","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"An αντιδάνειο (antidáneio): From άμπακος (ámpakos) with a metaplasm of the ending to -ας (-as), inherited from Medieval Byzantine Greek ἄμπακος (ámpakos, “a plate with sand for writing at school”), from Italian abaco (“abacus”), from Latin abacus, from Ancient Greek ἄβαξ (ábax). The sense \"voracious","livello2_varieta":"la"},{"parola":"άρια","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aria (musical piece for a solo voice with orchestral accompaniment in an opera or cantata)","termine_origine":"aria","catena":[{"codice":"it","nome":"Italian","termine":"aria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"āēr","categoria":"ereditato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian aria.","livello2_varieta":"la"},{"parola":"αβαντάρω","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to support, help (especially with advancement)","termine_origine":"avantare","catena":[{"codice":"it","nome":"Italian","termine":"avantare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"adventare","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian avantare, from Latin adventare.","livello2_varieta":"la"},{"parola":"αντίο","pos":"intj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato"