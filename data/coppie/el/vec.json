significato":"stifado (a savoury stew)","termine_origine":"stufado","catena":[{"codice":"vec","nome":"Venetan","termine":"stufado","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"extufo","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"τύφος","traslitterazione":"túphos","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"From Venetan stufado, from Latin extufare, from Ancient Greek τύφος (túphos, “steam”). Compare Italian stufato."},{"parola":"στραπατσάδα","traslitterazione":"strapatsáda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"strapatsada (tomato and egg dish)","termine_origine":"strapazzada","catena":[{"codice":"vec","nome":"Venetan","termine":"strapazzada","categoria":"prestito"}],"lontana":"vec","ambiti":["cucina"],"via":"","testo":"From Venetan strapazzada, from strapazzar (“to treat roughly; to scramble (eggs)”) + -ada (forms verbal nouns). Related to Italian strapazzare."},{"parola":"τζίφρα","traslitterazione":"tzífra","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"signature, especially when sloppy, hasty or illegible","termine_origine":"zifra","catena":[{"codice":"vec","nome":"Venetan","termine":"zifra","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan zifra."},{"parola":"τιμονιέρης","traslitterazione":"timoniéris","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"helmsman","termine_origine":"timonier","catena":[{"codice":"vec","nome":"Venetan","termine":"timonier","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"From Venetan timonier."},{"parola":"τιμόνι","traslitterazione":"timóni","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"steering wheel (of car), helm, tiller (of boat) (steering apparatus)","termine_origine":"timon","catena":[{"codice":"vec","nome":"Venetan","termine":"timon","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"From Byzantine Greek τιμόνι (timóni), from Venetan timon."},{"parola":"τορναδόρος","traslitterazione":"tornadóros","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"turner","termine_origine":"tornidor","catena":[{"codice":"vec","nome":"Venetan","termine":"tornidor","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tornator","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","scienza","arte"],"via":"","testo":"Ultimately (through Venetan tornidor), from Latin tornator : note: τορνάρω (tornáro, “to turn”) + -αδόρος (-adóros, “occupation”)."},{"parola":"τράτα","traslitterazione":"tráta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"trawl, fishing net used for trawling","termine_origine":"trata","catena":[{"codice":"vec","nome":"Venetan","termine":"trata","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"tratto","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tractus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Venetan trata, from Italian tratto, from Latin tractus, perfect passive participle of trahō (“to drag; extract”)."},{"parola":"τσαμπί","traslitterazione":"tsampí","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bunch (of fruit)","termine_origine":"zambin","catena":[{"codice":"vec","nome":"Venetan","termine":"zambin","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"zampa","categoria":"non_precisato"}],"lontana":"it","ambiti":[],"via":"","testo":"Borrowed from Venetan zambin (“animal's leg”), from Italian zampa (“animal's leg, paw”). Compare Mariupol Greek цамби́ (cambí)."},{"parola":"τσαρτσάρα","traslitterazione":"tsartsára","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mistle thrush, Turdus viscivorus","termine_origine":"zazzara","catena":[{"codice":"vec","nome":"Venetan","termine":"zazzara","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan zazzara, compare Italian zazzera."},{"parola":"τσατσάρα","traslitterazione":"tsatsára","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"comb (tool for combing one's hair)","termine_origine":"zazzara","catena":[{"codice":"vec","nome":"Venetan","termine":"zazzara","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan zazzara (“a type of long hairstyle for men”). See also τσαρτσάρα (tsartsára, “mistle thrush”), Italian zazzera."},{"parola":"τσιγάρο","traslitterazione":"tsigáro","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cigarette","termine_origine":"cigàro","catena":[{"codice":"vec","nome":"Venetan","termine":"cigàro","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan cigàro (“cigarette”)."},{"parola":"τσιγαρίζω","traslitterazione":"tsigarízo","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to brown, to roast","termine_origine":"cigar","catena":[{"codice":"vec","nome":"Venetan","termine":"cigar","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"Inherited from Byzantine Greek τσιγαρίζω (tsigarízō), from Venetan cigar or Italian zigare + -ίζω (-ízō), of onomatopoeic origin."},{"parola":"τσόντα","traslitterazione":"tsónta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gusset (small piece of cloth inserted in a garment, for the purpose of strengthening some part or giving it a tapering…","termine_origine":"zonta","catena":[{"codice":"vec","nome":"Venetan","termine":"zonta","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan zonta (“addition”), a variant form of xonta."},{"parola":"φανέλα","traslitterazione":"fanéla","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"flannel (soft cloth material)","termine_origine":"fanela","catena":[{"codice":"vec","nome":"Venetan","termine":"fanela","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"flanella","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"flanelle","categoria":"non_precisato"}],"lontana":"fr","ambiti":["moda","sport"],"via":"","testo":"Borrowed from Venetan fanela, from Italian flanella, from French flanelle."},{"parola":"φουρτούνα","traslitterazione":"fourtoúna","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rough sea, storm, tempest, squall","termine_origine":"fortuna","catena":[{"codice":"vec","nome":"Venetan","termine":"fortuna","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fortūna","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From Byzantine Greek φορτούνα (phortoúna), borrowed from Venetan fortuna, from Latin fortūna."},{"parola":"φόδρα","traslitterazione":"fódra","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lining, inner coating","termine_origine":"fodra","catena":[{"codice":"vec","nome":"Venetan","termine":"fodra","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"Borrowed from Venetan fodra, itself a loan tracing back to Proto-Germanic *fōdrą (“sheath”), from Proto-Indo-European *peh₂- (“to protect, guard”). Doublet of φούτερ (foúter), borrowed directly from Germanic, which has come to mean “sweatshirt”."},{"parola":"μπομπότα","traslitterazione":"bompóta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; Probably; or from; or possibly; modello unc/uncertain","significato":"cornbread, hoecake","termine_origine":"boba","catena":[{"codice":"vec","nome":"Venetan","termine":"boba","categoria":"prestito"}],"lontana":"vec","ambiti":["cucina"],"via":"","alternative":[{"codice":"vec","nome":"Venetan","termine":"boba","categoria":"prestito"},{"codice":"sq","nome":"Albanian","termine":"bobotë","categoria":"prestito"},{"codice":"ro","nome":"Romanian","termine":"bobotă","categoria":"prestito"}],"testo":"Uncertain. Probably borrowed from * Venetan boba, and children's word *bobotta * or possibly from Albanian bobot(ë) + suffix -α * or from Romanian bobotă."},{"parola":"φάτσα","traslitterazione":"fátsa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"more than one origin proposed","significato":"face","termine_origine":"fazza","catena":[{"codice":"vec","nome":"Venetan","termine":"fazza","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","alternative":[{"codice":"vec","nome":"Venetan","termine":"fazza","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"faccia","categoria":"prestito"}],"testo":"Borrowed from Venetan fazza, and later from Italian faccia in sense 3."},{"parola":"φόρα","traslitterazione":"fóra","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from; either","significato":"public, open (people as a whole as opposed to a private group)","termine_origine":"fora","catena":[{"codice":"vec","nome":"Venetan","termine":"fora","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","alternative":[{"codice":"la","nome":"Latin","termine":"fora","categoria":"latinismo_dotto"},{"codice":"vec","nome":"Venetan","termine":"fora","categoria":"non_precisato"}],"testo":"Either from Latin fora (“markets, forums”), plural of forum or from old Italian adverb fora or fuora, Venetan fora (“outside”)."}]}