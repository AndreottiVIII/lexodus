{"arrivo":"da","origine":"ang","origine_nome":"Old English","n":10,"n_alternative":3,"parole":[{"parola":"blæk","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ink","termine_origine":"blæc","catena":[{"codice":"ang","nome":"Old English","termine":"blæc","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"From Old English blæc (“black”)."},{"parola":"danegæld","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Danegeld (a tax raised to pay tribute to Viking raiders)","termine_origine":"danegeld","catena":[{"codice":"ang","nome":"Old English","termine":"danegeld","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"Derived from Old English danegeld. In modern Danish gæld means \"debt\"."},{"parola":"då","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a doe","termine_origine":"da","catena":[{"codice":"ang","nome":"Old English","termine":"da","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*daihā","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dʰeh₁(y)-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Danish da, from Old English da, from Proto-West Germanic *daihā, from Proto-Indo-European *dʰeh₁(y)-."},{"parola":"port","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gate","termine_origine":"port","catena":[{"codice":"ang","nome":"Old English","termine":"port","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"porta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Norse portr m, port n, borrowed via Old English port m (“gate”) from Latin porta. Compare also German Pforte."},{"parola":"prædike","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to preach (to give a sermon)","termine_origine":"predician","catena":[{"codice":"ang","nome":"Old English","termine":"predician","categoria":"non_precisato"},{"codice":"osx","nome":"Old Saxon","termine":"predikōn","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"praedicō","categoria":"non_precisato"}],"lontana":"la","ambiti":["religione"],"via":"","testo":"From Old Danish predike, borrowed from Old English predician or Old Saxon predikōn, from Latin praedicō (“to announce, (Christian) to preach”). Compare also Swedish predika, German predigen, Dutch prediken."},{"parola":"skrifte","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"a confession (the disclosure of one's sins to God or a priest in order to obtain absolution)","termine_origine":"scrift","catena":[{"codice":"ang","nome":"Old English","termine":"scrift","categoria":"non_precisato"}],"lontana":"ang","ambiti":["religione"],"via":"","testo":"From Old Danish skrift, originally a genitive of skripta. From Old English scrift. Same word of skrift"},{"parola":"solsort","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Eurasian blackbird (Turdus merula)","termine_origine":"sugesweard","catena":[{"codice":"ang","nome":"Old English","termine":"sugesweard","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"Maybe from Old English sugesweard. Compare Norwegian Nynorsk sysvorte, and Jutish sælsort."},{"parola":"kristne","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"to convert to Christianity; Christianize","termine_origine":"cristnian","catena":[{"codice":"ang","nome":"Old English","termine":"cristnian","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","alternative":[{"codice":"non","nome":"Old Norse","termine":"kristna","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"cristnian","categoria":"non_precisato"},{"codice":"non","nome":"Old Norse","termine":"kristinn","categoria":"non_precisato"}],"testo":"From Old Norse kristna, either borrowed from Old English cristnian or derived independently from Old Norse kristinn (“Christian”)."},{"parola":"mønt","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"coin","termine_origine":"mynet","catena":[{"codice":"ang","nome":"Old English","termine":"mynet","categoria":"non_precisato"}],"lontana":"ang","ambiti":["finanza"],"via":"","alternative":[{"codice":"gml","nome":"Middle Low German","termine":"munte","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"mynet","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"moneta","categoria":"non_precisato"}],"testo":"From either Middle Low German munte or Old English mynet, from Latin moneta (“coin”)."},{"parola":"præst","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from; either","significato":"priest (clergyman)","termine_origine":"prēost","catena":[{"codice":"ang","nome":"Old English","termine":"prēost","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","alternative":[{"codice":"non","nome":"Old Norse","termine":"prestr","categoria":"ereditato"},{"codice":"osx","nome":"Old Saxon","termine":"prēstar","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"prēost","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"presbyter","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πρεσβύτερος","traslitterazione":"presbúteros","categoria":"non_precisato"}],"testo":"From Old Norse prestr, either from Old Saxon prēstar or from Old English prēost, both of which are borrowed from Latin presbyter (“elder, priest”) (= Ancient Greek πρεσβύτερος (presbúteros, “older, senior; elder”))."}]}