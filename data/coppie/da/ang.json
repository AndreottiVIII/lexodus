{"arrivo":"da","origine":"ang","origine_nome":"Old English","n":7,"parole":[{"parola":"blæk","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ink","termine_origine":"blæc","catena":[{"codice":"ang","nome":"Old English","termine":"blæc","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"From Old English blæc (“black”)."},{"parola":"danegæld","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Danegeld (a tax raised to pay tribute to Viking raiders)","termine_origine":"danegeld","catena":[{"codice":"ang","nome":"Old English","termine":"danegeld","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"Derived from Old English danegeld. In modern Danish gæld means \"debt\"."},{"parola":"då","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a doe","termine_origine":"da","catena":[{"codice":"ang","nome":"Old English","termine":"da","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*daihā","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dʰeh₁(y)-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Danish da, from Old English da, from Proto-West Germanic *daihā, from Proto-Indo-European *dʰeh₁(y)-."},{"parola":"port","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gate","termine_origine":"port","catena":[{"codice":"ang","nome":"Old English","termine":"port","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"porta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Norse portr m, port n, borrowed via Old English port m (“gate”) from Latin porta. Compare also German Pforte."},{"parola":"prædike","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to preach (to give a sermon)","t