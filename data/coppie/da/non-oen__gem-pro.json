{"arrivo":"da","origine":"non-oen","origine_nome":"Old East Norse","livello2":"gem-pro","livello2_nome":"Proto-Germanic","n":11,"parole":[{"parola":"bod","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"booth, stall","termine_origine":"bóð","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"bóð","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bōþō","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Danish bōð, from Old East Norse bóð, from Proto-Germanic *bōþō (“building, dwelling”), cognate with Old West Norse búð, English booth, German Bude."},{"parola":"bro","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"bridge","termine_origine":"brō","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"brō","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brūwō","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰruh-","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Danish bro, from Old East Norse brō, from Proto-Germanic *brūwō (“bridge; brow”), from Proto-Indo-European *bʰruh- (“beam, bridge”)."},{"parola":"bud","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"command","termine_origine":"buð","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"buð","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*budą","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Danish buth n, from Old East Norse buð n, from Proto-Germanic *budą (“offer, message”), cognate with Swedish bud, Dutch bod, German Gebot."},{"parola":"bænk","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"bench","termine_origine":"*benkr","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"*benkr","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bankiz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old East Norse *benkr, from Proto-Germanic *bankiz."},{"parola":"eder","pos":"pron","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"accusative second-person pronoun, plural or in deferent speech (accusative of I)","termine_origine":"iðʀ","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"iðʀ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*izwiz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old East Norse iðʀ, from Proto-Germanic *izwiz."},{"parola":"I","pos":"pron","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"you, you all (second person plural)","termine_origine":"*īʀ","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"*īʀ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*jūz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*yúHs","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old East Norse *īʀ, from Proto-Germanic *jūz, from Proto-Indo-European *yúHs. Cognate with Swedish ni, Norwegian Nynorsk de, Faroese tær, and Icelandic þér."},{"parola":"svamp","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"sponge","termine_origine":"svampr","catena":[{"codice":"non-oen","nome":"Old East Norse","termine":"svampr","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*swampaz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*swombʰ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Danish swamp, from Old East Norse svampr, from Proto-Germanic *swampaz (“sponge, fungus”), variant of *swammaz, from Proto-Indo-European *swombʰ-