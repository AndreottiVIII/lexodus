un","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"northern gannet (Morus bassanus)","termine_origine":"súla","catena":[{"codice":"fo","nome":"Faroese","termine":"súla","categoria":"prestito"},{"codice":"is","nome":"Icelandic","termine":"súla","categoria":"prestito"}],"lontana":"is","ambiti":["scienza"],"via":"","testo":"Borrowed from Faroese súla, Icelandic súla, identical with the former word (referring to the cleft between the wings)."},{"parola":"tjald","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"weed, pot","termine_origine":"tjaldur","catena":[{"codice":"fo","nome":"Faroese","termine":"tjaldur","categoria":"non_precisato"}],"lontana":"fo","ambiti":[],"via":"","testo":"From Faroese tjaldur (“oystercatcher”). At one point in time, marijuana was imported to Denmark from the same quay as the Faroese passenger ship Tjaldur docked. Hence the birth of the slang term."}]}