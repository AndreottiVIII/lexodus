{"arrivo":"da","origine":"fo","origine_nome":"Faroese","n":11,"parole":[{"parola":"døgling","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of toothed whale, odontocete: Hyperoodon latifrons Gray or possibly all hyperoodons;","termine_origine":"døglingur","catena":[{"codice":"fo","nome":"Faroese","termine":"døglingur","categoria":"prestito"}],"lontana":"fo","ambiti":[],"via":"","testo":"Borrowed from Faroese døglingur."},{"parola":"grindedrab","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"grindadrap","termine_origine":"grindadráp","catena":[{"codice":"fo","nome":"Faroese","termine":"grindadráp","categoria":"prestito"}],"lontana":"fo","ambiti":[],"via":"","testo":"From Faroese grindadráp, equivalent to grinde(hval) (“pilot (whale)”) + drab (“killing”)"},{"parola":"grindehval","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pilot whale, (Globicephala melas)","termine_origine":"grindahvalur","catena":[{"codice":"fo","nome":"Faroese","termine":"grindahvalur","categoria":"non_precisato"}],"lontana":"fo","ambiti":[],"via":"","testo":"From Faroese grindahvalur."},{"parola":"kjove","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"skua (Stercorariidae)","termine_origine":"kjógvi","catena":[{"codice":"fo","nome":"Faroese","termine":"kjógvi","categoria":"non_precisato"},{"codice":"is","nome":"Icelandic","termine":"kjói","categoria":"non_precisato"}],"lontana":"is","ambiti":[],"via":"","testo":"From Faroese kjógvi, or Icelandic kjói. Onomatopoeic."},{"parola":"lomvi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"a bird of the genus Uria, the murres or guillemots, particularly the common murre (Uria aalge)","termine_origine":"lomvigi","catena":[{"codice":"fo","nome":"Faroese","termine":"lomvigi","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termi