:"non_precisato"}],"lontana":"fy","ambiti":[],"via":"","testo":"From Dutch sjouw (part-time work), possibly from West Frisian seeuw (“lake”), in the meaning 'to drag goods ashore through the lake'. The meaning 'amusement' developed via 'coincidence, random event', cf. compound words such as drengesjov."},{"parola":"sjover","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cur, rogue","termine_origine":"sjouwer","catena":[{"codice":"nl","nome":"Dutch","termine":"sjouwer","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch sjouwer (“freelancer”), from sjouwen (“to work hard”). See sjov."},{"parola":"slitage","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wear and tear","termine_origine":"slijtage","catena":[{"codice":"nl","nome":"Dutch","termine":"slijtage","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch slijtage."},{"parola":"smølf","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"smurf","termine_origine":"smurf","catena":[{"codice":"nl","nome":"Dutch","termine":"smurf","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"schtroumpf","categoria":"non_precisato"}],"lontana":"fr","ambiti":["arte"],"via":"","testo":"From Dutch smurf, changed from French schtroumpf."},{"parola":"sprøjte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a device with a pressure chamber and a narrow opening for squirting or drawing fluid; syringe, squirt","termine_origine":"spuit","catena":[{"codice":"nl","nome":"Dutch","termine":"spuit","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Alteration (under the influence of semantically similar words such as sprude, sprutte) of earlier spøjte, from Dutch spuit, from spuiten. Borrowed and altered parallel to the verb sprøjte."},{"parola":"sprøjte","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"to squirt, spout, spurt (eject from a narrow opening, as from a syringe, spout, hose, etc.)","termine_origine":"spuiten","catena":[{"codice":"nl","nome":"Dutch","termine":"spuiten","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Alteration (under the influence of semantically similar words such as sprude, sprutte) of earlier spøjte, from Dutch spuiten. Borrowed and altered parallel to the noun sprøjte."},{"parola":"spule","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to hose down; to wash by directing a strong stream of water towards","termine_origine":"spoelen","catena":[{"codice":"nl","nome":"Dutch","termine":"spoelen","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch spoelen (“to wash up, rinse”)"},{"parola":"stillads","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"scaffold(ing)","termine_origine":"stellage","catena":[{"codice":"nl","nome":"Dutch","termine":"stellage","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch stellage."},{"parola":"stovt","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hardy, stalwart","termine_origine":"stout","catena":[{"codice":"nl","nome":"Dutch","termine":"stout","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*stultaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Dutch stout, ultimately from Proto-Germanic *stultaz, whence also stolt (“proud”). Also related to stout (“type of beer”), which is borrowed from English."},{"parola":"sydvest","pos":"noun|adv","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"The southwest.","termine_origine":"zuidwester","catena":[{"codice":"nl","nome":"Dutch","termine":"zuidwester","categoria":"non_precisato"}],"lontana":"nl","ambiti":["moda"],"via":"","testo":"From syd + vest; headgear from Dutch zuidwester."},{"parola":"te","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tea (plant) (Camellia sinensis)","termine_origine":"thee","catena":[{"codice":"nl","nome":"Dutch","termine":"thee","categoria":"prestito"},{"codice":"nan-hbl","nome":"Hokkien","termine":"茶","traslitterazione":"tê","categoria":"non_precisato"}],"lontana":"nan-hbl","ambiti":[],"via":"","testo":"Borrowed from Dutch thee, from Hokkien 茶 (tê, “tea”), compare English tea, German Tee, French thé."},{"parola":"togt","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"expedition, often to pillage or wage war.","termine_origine":"tocht","catena":[{"codice":"nl","nome":"Dutch","termine":"tocht","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*tuhtiz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Dutch tocht (“march, trip”), from Proto-Germanic *tuhtiz (“pulling”), cognate with German Zucht (“discipline”) and Middle Low German tucht (“discipline”) (whence Danish tugt). The Germanic noun is derived from the verb *teuhaną (“to lead, pull”), cf. German ziehen."},{"parola":"tombak","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tombac","termine_origine":"tombak","catena":[{"codice":"nl","nome":"Dutch","termine":"tombak","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch tombak."},{"parola":"vaterpas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"spirit level","termine_origine":"waterpas","catena":[{"codice":"nl","nome":"Dutch","termine":"waterpas","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch waterpas."},{"parola":"appelsin","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"An orange, a fruit from the tree Citrus sinensis.","termine_origine":"appelsien","catena":[{"codice":"nl","nome":"Dutch","termine":"appelsien","categoria":"non_precisato"}],"lontana":"nl","ambiti":["cucina"],"via":"","alternative":[{"codice":"nl","nome":"Dutch","termine":"appelsien","categoria":"non_precisato"},{"codice":"nds-de","nome":"German Low German","termine":"Appelsin","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"pomme de Sine","categoria":"non_precisato"}],"testo":"Loan word from late 17th century from either Dutch appelsien or German Low German Appelsin f (“Chinese apple; apple from China”), compare German Apfelsine. It is a calque of French pomme de Sine (“apple from China”)."},{"parola":"brak","pos":"adj","n_etimologia":2,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"brackish, brack water","termine_origine":"brak","catena":[{"codice":"nl","nome":"Dutch","termine":"brak","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","alternative":[{"codice":"nds","nome":"Low German","termine":"brack","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"brak","categoria":"non_precisato"}],"testo":"From either Low German brack or Dutch brak."},{"parola":"frikadelle","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"alternatively","significato":"meatball (traditionally made with pork)","termine_origine":"frikadel","catena":[{"codice":"nl","nome":"Dutch","termine":"frikadel","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","alternative":[{"codice":"de","nome":"German","termine":"Frikadelle","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"frikadel","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"fricandeau","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"frittella","categoria":"non_precisato"}],"testo":"From German Frikadelle (“meatball”), borrowed via Dutch frikadel, from French fricandeau (“a dish with sliced veal”). Alternatively, from Italian frittella (“fritter, flapjack”)."},{"parola":"gylp","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; either; modello unc/uncertain","significato":"fly (on the front of pants)","termine_origine":"gulp","catena":[{"codice":"nl","nome":"Dutch","termine":"gulp","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","alternative":[{"codice":"nds","nome":"Low German","termine":"gülp","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"gulp","categoria":"prestito"}],"testo":"Uncertain. Borrowed from either Low German gülp or Dutch gulp. Doublet of glubende."},{"parola":"orkan","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"a hurricane","termine_origine":"orkaan","catena":[{"codice":"nl","nome":"Dutch","termine":"orkaan","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","alternative":[{"codice":"de","nome":"German","termine":"Orkan","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"orkaan","categoria":"non_precisato"},{"codice":"es","nome":"Spanish","termine":"huracán","categoria":"non_precisato"},{"codice":"tnq","nome":"Taíno","termine":"*hurakā","categoria":"non_precisato"}],"testo":"Via either German Orkan or Dutch orkaan, from Spanish huracán, from Taíno *hurakā."},{"parola":"syd","pos":"adv","n_etimologia":2,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"south, southwards, (south from one's immediate position)","termine_origine":"zuid","catena":[{"codice":"nl","nome":"Dutch","termine":"zuid","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","alternative":[{"codice":"gml","nome":"Middle Low German","termine":"sut","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"zuid","categoria":"non_precisato"}],"testo":"From either Middle Low German sut or Dutch zuid."}]}