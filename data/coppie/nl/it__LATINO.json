{"arrivo":"nl","origine":"it","origine_nome":"Italian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":31,"parole":[{"parola":"altviool","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a viola, string instrument of the violin family in the alto range","termine_origine":"alto","catena":[{"codice":"it","nome":"Italian","termine":"alto","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"altus","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Compound of alt (“alto”) + viool (“violin; string instrument”), with alt deriving from Italian alto, from Latin altus (“high”).","livello2_varieta":"la"},{"parola":"animo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"desire, interest in doing something","termine_origine":"animo","catena":[{"codice":"it","nome":"Italian","termine":"animo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"animus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian animo, from Latin animus.","livello2_varieta":"la"},{"parola":"arena","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"arena (enclosed area for the presentation of sporting or other spectacular events)","termine_origine":"arena","catena":[{"codice":"it","nome":"Italian","termine":"arena","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"arēna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian arena, from Latin arēna.","livello2_varieta":"la"},{"parola":"belladonna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of wolfskers (“deadly nightshade (Atropa belladonna)”)","termine_origine":"belladonna","catena":[{"codice":"it","nome":"Italian","termine":"belladonna","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"blādōna","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*blātōnā","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*blātus","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰléh₃tus","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian belladonna (bella donna, literally “beautiful lady”), altered by folk etymology from Medieval Latin blādōna (“nightshade”), from Gaulish *blātōnā, blātunā, from Proto-Celtic *blātus (“flower”), from Proto-Indo-European *bʰléh₃tus, from *bʰleh₃- (“blossom, flower”).","livello2_varieta":"la-med"},{"parola":"bruto","pos":"adj|adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gross (excluding deductions)","termine_origine":"brutto","catena":[{"codice":"it","nome":"Italian","termine":"brutto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"brūtus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian brutto, bruto, from Latin brūtus. Doublet of bruut.","livello2_varieta":"la"},{"parola":"castraat","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a castrato, male who has been castrated, surgically emasculated","termine_origine":"castrato","catena":[{"codice":"it","nome":"Italian","termine":"castrato","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"castrō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian castrato, from Latin castrō (“to castrate”), likely from caedō (“to cut”).","livello2_varieta":"la"},{"parola":"condensator","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"capacitor","termine_origine":"condensatore","catena":[{"codice":"it","nome":"Italian","termine":"condensatore","categoria":"prestito"},{"codice":"la-new","nome":"New Latin","termine":"condensator","categoria":"latinismo_dotto"}],"lontana":"la-new","ambiti":["finanza","scienza","informatica"],"via":"","testo":"Borrowed from Italian condensatore or New Latin condensator.","livello2_varieta":"la-new"},{"parola":"corso","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"parade","termine_origine":"corso","catena":[{"codice":"it","nome":"Italian","termine":"corso","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cursus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian corso, from Latin cursus.","livello2_varieta":"la"},{"parola":"diva","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a diva","termine_origine":"diva","catena":[{"codice":"it","nome":"Italian","termine":"diva","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"diva","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian diva (“goddess”), from Latin diva, feminine form of divus.","livello2_varieta":"la"},{"parola":"finale","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a final, e.g. the end-round in a competition","termine_origine":"finale","catena":[{"codice":"it","nome":"Italian","termine":"finale","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"finālis","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"finale","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Italian finale, from Latin finālis. The sports sense derived from French finale. Doublet of finaal.","livello2_varieta":"la"},{"parola":"fresco","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fresco","termine_origine":"fresco","catena":[{"codice":"it","nome":"Italian","termine":"fresco","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*friscum","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*friskaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["arte"],"via":"","testo":"From Italian fresco, from Vulgar Latin *friscum, from Proto-Germanic *friskaz. Doublet of vers and fris.","livello2_varieta":"la-vul"},{"parola":"gireren","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to transfer, to wire transfer, to pay by giro","termine_origine":"girare","catena":[{"codice":"it","nome":"Italian","termine":"girare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gȳrō","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian girare, from Latin gȳrō, from Ancient Greek.","livello2_varieta":"la"},{"parola":"giro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"giro (transfer of funds)","termine_origine":"giro","catena":[{"codice":"it","nome":"Italian","termine":"giro","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gyrus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"γῦρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian giro, from Latin gyrus, from Ancient Greek γῦρος (gûros, “circle”).","livello2_varieta":"la"},{"parola":"inferno","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hell-like place or situation","termine_origine":"inferno","catena":[{"codice":"it","nome":"Italian","termine":"inferno","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"infernus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian inferno (“hell”), from Latin infernus (“of the lower regions”), inferna (“the lower regions”); see infernal. The meaning \"big fire\" came as a figurative use from the traditional idea of hellfire.","livello2_varieta":"la"},{"parola":"kapitaal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fortune n","termine_origine":"capitale","catena":[{"codice":"it","nome":"Italian","termine":"capitale","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capitālis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian capitale, from Latin capitālis (“of the head”) (in sense “head of cattle”), from caput (“head”).","livello2_varieta":"la"},{"parola":"kapper","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"caper bush (Capparis spinosa)","termine_origine":"cappero","catena":[{"codice":"it","nome":"Italian","termine":"cappero","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capparis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κάππαρις","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian cappero, from Latin capparis, from Ancient Greek κάππαρις (kápparis).","livello2_varieta":"la"},{"parola":"kattebel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"a short, hastily written letter","termine_origine":"scartabello","catena":[{"codice":"it","nome":"Italian","termine":"scartabello","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cartabulum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From older cartabelle, from Italian scartabello, possibly from Latin cartabulum. Changed by folk etymology to kat + -e- + bel.","livello2_varieta":"la"},{"parola":"lava","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lava","termine_origine":"lava","catena":[{"codice":"it","nome":"Italian","termine":"lava","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"lābēs","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian lava, from Neapolitan and Sicilian lava (“lava; downpour overflowing the streets”), likely from Latin lābēs (“a fall; a collapse; subsidence”).","livello2_varieta":"la"},{"parola":"limpido","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"exactly, precisely (of sums of money)","termine_origine":"limpido","catena":[{"codice":"it","nome":"Italian","termine":"limpido","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"limpidus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian limpido, from Latin limpidus.","livello2_varieta":"la"},{"parola":"manco","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shortage, deficit","termine_origine":"manco","catena":[{"codice":"it","nome":"Italian","termine":"manco","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mancus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian manco, from Latin mancus.","livello2_varieta":"la"},{"parola":"omerta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"omertà, (extensively) wall of silence, code of silence","termine_origine":"omertà","catena":[{"codice":"it","nome":"Italian","termine":"omertà","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"humilitās","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian omertà, from a Southern dialectal rhotacist variant of umiltà (“humility”), from Latin humilitās, from humilis (“humble”), from humus (“ground, soil”).","livello2_varieta":"la"},{"parola":"pasta","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"pasta","termine_origine":"pasta","catena":[{"codice":"it","nome":"Italian","termine":"pasta","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"pasta","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"παστά","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian pasta, from Late Latin pasta, from Ancient Greek παστά (pastá).","livello2_varieta":"la-lat"},{"parola":"patina","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"patina: the color or incrustation which age gives to works of art; especially, the green oxidation which covers aging c…","termine_origine":"patina","catena":[{"codice":"it","nome":"Italian","termine":"patina","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"patina","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian patina, itself from Latin patina (“dish, pan”). Doublet of pan and pateen.","livello2_varieta":"la"},{"parola":"salto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"somersault, flip (jump where one makes a 360° rotation)","termine_origine":"salto","catena":[{"codice":"it","nome":"Italian","termine":"salto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"saltus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian salto, from Latin saltus. First attested in the 18th century.","livello2_varieta":"la"},{"parola":"scala","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"assortment, range","termine_origine":"scala","catena":[{"codice":"it","nome":"Italian","termine":"scala","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"scāla","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian scala, from Latin scāla.","livello2_varieta":"la"},{"parola":"solo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"solo (piece or passage performed or typified by a single performer)","termine_origine":"solo","catena":[{"codice":"it","nome":"Italian","termine":"solo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"solus","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian solo, from Latin solus.","livello2_varieta":"la"},{"parola":"spon","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a bung","termine_origine":"spunta","catena":[{"codice":"it","nome":"Italian","termine":"spunta","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"expunctum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle Dutch spont, from Italian spunta, from Latin expunctum.","livello2_varieta":"la"},{"parola":"studio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a studio flat/apartment","termine_origine":"studio","catena":[{"codice":"it","nome":"Italian","termine":"studio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"studium","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian studio, from Latin studium. Doublet of studie and etude.","livello2_varieta":"la"},{"parola":"subito","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"immediately, suddenly","termine_origine":"subito","catena":[{"codice":"it","nome":"Italian","termine":"subito","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"subitō","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian subito, from Latin subitō.","livello2_varieta":"la"},{"parola":"tempo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tempo (pace, relative speed)","termine_origine":"tempo","catena":[{"codice":"it","nome":"Italian","termine":"tempo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tempus","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian tempo, from Latin tempus (“time”).","livello2_varieta":"la"},{"parola":"travestiet","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"transvestite","termine_origine":"travestire","catena":[{"codice":"it","nome":"Italian","termine":"travestire","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian travestire, from tra (“through, over”) + vestire (“to dress”), from Latin.","livello2_varieta":"la"}]}