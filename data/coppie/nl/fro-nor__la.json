{"arrivo":"nl","origine":"fro-nor","origine_nome":"Old Northern French","livello2":"la","livello2_nome":"Latin","n":6,"parole":[{"parola":"abeel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"abele; term used of certain poplars, mainly the white poplar (Populus alba), grey poplar (Populus × canescens) or black…","termine_origine":"abiel","catena":[{"codice":"fro-nor","nome":"Old Northern French","termine":"abiel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"albellus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle Dutch abeel, from Old Northern French abiel, from Latin albellus, a diminutive of albus (“white”)."},{"parola":"canvas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"canvas, sail","termine_origine":"canevas","catena":[{"codice":"fro-nor","nome":"Old Northern French","termine":"canevas","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cannabis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κάνναβις","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"canvas","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"From Middle Dutch canevas, from Old Northern French canevas, from Latin cannabis, from Ancient Greek κάνναβις (kánnabis). The spelling was lated influenced by English canvas. Doublet of cannabis and hennep."},{"parola":"fluwijn","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"synonym of steenmarter (“beech marten (Martes foina)”)","termine_origine":"*floïne","catena":[{"codice":"fro-nor","nome":"Old Northern French","termine":"*floïne","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fāgīna (mūstēla)","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle Dutch fluwijn, from Old Northern French *floïne (modern Picard floène, flouène), a variant of Old French foïne (modern French fouine), from Latin fāgīna (mūstēla) (“beech weasel”)."},{"parola":"karbonkel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ruby, garnet","termine_origine":"carbuncle","catena":[{"codice":"fro-nor","nome":"Old Northern French","termine":"carbuncle","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"carbunculus","categoria":"non_precisato"}],"lontana":"la","ambiti":["diritto_politica"],"via":"","testo":"From Middle Dutch carbonkel, from Old Northern French carbuncle, from Latin carbunculus."},{"parola":"kasteel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"castle, either palatial or fortified","termine_origine":"castel","catena":[{"codice":"fro-nor","nome":"Old Northern French","termine":"castel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"castellum","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare","sport"],"via":"","testo":"From Middle Dutch castēel, from Old Northern French castel, from Latin castellum. Doublet of Kessel, chateau, Castilië, castellum, ketella, and telo."},{"parola":"klant","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"customer, client","termine_origine":"calant","catena":[{"codice":"fro-nor","nome":"Old Northern French","termine":"calant","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"caleō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle Dutch calant (“person, friend”), from Old Northern French calant (compare regular Old French chalant), from Old French chaloir (“to heat, to care about”), from Latin caleō (“to be hot”)."}]}