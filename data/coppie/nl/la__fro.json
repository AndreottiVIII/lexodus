{"arrivo":"nl","origine":"la","origine_nome":"Latin","livello2":"fro","livello2_nome":"Old French","n":14,"parole":[{"parola":"abstinentie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"abstinence","termine_origine":"abstinentia","catena":[{"codice":"la","nome":"Latin","termine":"abstinentia","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"abstinence","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"From Middle Dutch abstinentie, from Latin abstinentia, likely by way of Old French abstinence."},{"parola":"autoriseren","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"authorize","termine_origine":"auctōrizō","catena":[{"codice":"la","nome":"Latin","termine":"auctōrizō","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"auctoriser","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"From Middle Dutch auctoriseren, from Latin auctōrizō (perhaps via Old French auctoriser). Doublet of octrooieren. Misspellings with -th- influenced by authenticeren and/or English authorize are common."},{"parola":"cirkel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"circle","termine_origine":"circulus","catena":[{"codice":"la","nome":"Latin","termine":"circulus","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"cercle","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"From Middle Dutch cirkel, from Latin circulus or Old French cercle, itself from Latin."},{"parola":"contemplatie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"contemplation","termine_origine":"contemplātiō","catena":[{"codice":"la","nome":"Latin","termine":"contemplātiō","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"contempla