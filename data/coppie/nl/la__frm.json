{"arrivo":"nl","origine":"la","origine_nome":"Latin","livello2":"frm","livello2_nome":"Middle French","n":14,"parole":[{"parola":"anticiperen","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"to anticipate","termine_origine":"anticipō","catena":[{"codice":"la","nome":"Latin","termine":"anticipō","categoria":"non_precisato"},{"codice":"frm","nome":"Middle French","termine":"anticiper","categoria":"non_precisato"}],"lontana":"frm","ambiti":[],"via":"","testo":"From Middle Dutch anticiperen, from Latin anticipō (possibly via Middle French anticiper)."},{"parola":"applauderen","pos":"verb","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"to applaud","termine_origine":"applaudō","catena":[{"codice":"la","nome":"Latin","termine":"applaudō","categoria":"latinismo_dotto"},{"codice":"frm","nome":"Middle French","termine":"applaudir","categoria":"prestito"}],"lontana":"frm","ambiti":[],"via":"","testo":"Borrowed from Latin applaudō or Middle French applaudir."},{"parola":"clausule","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a clause, provision, stipulation in a contract, law etc.","termine_origine":"clausula","catena":[{"codice":"la","nome":"Latin","termine":"clausula","categoria":"non_precisato"},{"codice":"frm","nome":"Middle French","termine":"clausule","categoria":"non_precisato"}],"lontana":"frm","ambiti":[],"via":"","testo":"From Middle Dutch clausule, from Latin clausula. The stress shift to penultimate by influenced by Middle French clausule."},{"parola":"conjunctuur","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"economic condition; conjuncture","termine_origine":"coniunctura","catena":[{"codice":"la","nome":"Latin","termine":"coniunctura","categoria":"latinismo_dotto"},{"codice":"frm","nome":"Middle French","termine":"conjoncture","categoria":"prestito"}],"lontana":"frm","ambiti":[],"vi