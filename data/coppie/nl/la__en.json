{"arrivo":"nl","origine":"la","origine_nome":"Latin","livello2":"en","livello2_nome":"English","n":14,"parole":[{"parola":"aquarium","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"aquarium","termine_origine":"aquārium","catena":[{"codice":"la","nome":"Latin","termine":"aquārium","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"aquarium","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Latin aquārium. Influenced by English aquarium. Doublet of aker."},{"parola":"consensus","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"consensus","termine_origine":"cōnsēnsus","catena":[{"codice":"la","nome":"Latin","termine":"cōnsēnsus","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"consensus","categoria":"prestito"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Latin cōnsēnsus or English consensus, itself borrowed from Latin."},{"parola":"crux","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"crucial or otherwise serious, difficult problem","termine_origine":"crux","catena":[{"codice":"la","nome":"Latin","termine":"crux","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"crux","categoria":"prestito"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Latin crux or English crux, in the phrase crux interpretum."},{"parola":"discriminatie","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"discrimination (different treatment based on demographic or other categorical characteristics)","termine_origine":"discrīminātio","catena":[{"codice":"la","nome":"Latin","termine":"discrīminātio","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"discrimination","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"discrimination","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Latin discrīminātio. The current sense “different treatment” derives from English discrimination, from French discrimination."},{"parola":"exponent","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"exponent (number by which a base is raised to a power)","termine_origine":"expōnēns","catena":[{"codice":"la","nome":"Latin","termine":"expōnēns","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"exponent","categoria":"non_precisato"}],"lontana":"en","ambiti":["scienza"],"via":"","testo":"Learned borrowing from Latin expōnēns. The sense “typical representative” is from English exponent."},{"parola":"forum","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"forum (ancient Roman marketplace)","termine_origine":"forum","catena":[{"codice":"la","nome":"Latin","termine":"forum","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"forum","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Latin forum. The sense “Internet forum” comes from English forum."},{"parola":"inflatie","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"stomach bloat","termine_origine":"īnflātiō","catena":[{"codice":"la","nome":"Latin","termine":"īnflātiō","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"inflation","categoria":"calco"}],"lontana":"en","ambiti":["finanza","scienza"],"via":"","testo":"The medical sense is borrowed from Latin īnflātiō. The other senses are a semantic loan from English inflation."},{"parola":"partitie","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"partition, especially of territory","termine_origine":"partitio","catena":[{"codice":"la","nome":"Latin","termine":"partitio","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"partition","categoria":"non_precisato"}],"lontana":"en","ambiti":["scienza","informatica"],"via":"","testo":"Borrowed from Latin partitio. The computing sense derived from English partition."},{"parola":"premie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"a prize, a reward","termine_origine":"praemium","catena":[{"codice":"la","nome":"Latin","termine":"praemium","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"premium","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"From Latin praemium possibly through English premium."},{"parola":"venster","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"window","termine_origine":"fenestra","catena":[{"codice":"la","nome":"Latin","termine":"fenestra","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"window","categoria":"calco"}],"lontana":"en","ambiti":["scienza","arte","informatica"],"via":"","testo":"From Middle Dutch venster, venstre, veinster, from Old Dutch fenstar, from Latin fenestra. The computing sense is a semantic loan from English window."},{"parola":"ventilatie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"ventilation (replacement of stale air with fresh)","termine_origine":"ventilatio","catena":[{"codice":"la","nome":"Latin","termine":"ventilatio","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"ventilation","categoria":"prestito"}],"lontana":"en","ambiti":[],"via":"","testo":"From Latin ventilatio, perhaps via English ventilation. Equivalent to ventileren + -atie."},{"parola":"vibrator","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"Probably","significato":"vibrator (vibrating sex toy)","termine_origine":"vibrator","catena":[{"codice":"la","nome":"Latin","termine":"vibrator","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"vibrator","categoria":"prestito"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Latin vibrator. The sense for the sex toy probably derives from English vibrator."},{"parola":"virus","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"virus","termine_origine":"vīrus","catena":[{"codice":"la","nome":"Latin","termine":"vīrus","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"virus","categoria":"non_precisato"}],"lontana":"en","ambiti":["scienza","informatica"],"via":"","testo":"From Latin vīrus. Coined in the virological sense by Martinus Beijerinck; the word had been previously used for pathogens, although not for viruses in the modern sense. The computing sense derives from English virus."},{"parola":"vocaal","pos":"noun|adj|adv","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"a vowel","termine_origine":"vōcālis","catena":[{"codice":"la","nome":"Latin","termine":"vōcālis","categoria":"latinismo_dotto"},{"codice":"en","nome":"English","termine":"vocal","categoria":"non_precisato"}],"lontana":"en","ambiti":["scienza"],"via":"","testo":"Borrowed from Latin vōcālis. The sense “outspoken” likely comes from English vocal."}]}