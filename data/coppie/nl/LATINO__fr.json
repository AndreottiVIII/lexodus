":"insinuō","categoria":"calco"},{"codice":"fr","nome":"French","termine":"insinuer","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"From in + boezem + -en, likely a calque of Latin insinuō or French insinuer.","origine_varieta":"la"},{"parola":"irrationeel","pos":"adj","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"irrational (contrary to reason)","termine_origine":"irratiōnālis","catena":[{"codice":"la","nome":"Latin","termine":"irratiōnālis","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"irrationnel","categoria":"prestito"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"Borrowed from Latin irratiōnālis or French irrationnel. Equivalent to in- + rationeel.","origine_varieta":"la"},{"parola":"menopauze","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"menopause","termine_origine":"menopausis","catena":[{"codice":"la","nome":"Latin","termine":"menopausis","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"ménopause","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Latin menopausis, which is the oldest form in Dutch. The current spelling is based on French ménopause.","origine_varieta":"la"},{"parola":"obstrueren","pos":"verb","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"to obstruct","termine_origine":"obstruo","catena":[{"codice":"la","nome":"Latin","termine":"obstruo","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"obstruer","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"17th century. Borrowed from Latin obstruō, obstruere and French obstruer.","origine_varieta":"la"},{"parola":"ontologie","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"Possibly","significato":"ontology (the metaphysical study of being)","termine_origine":"ontologia","catena":[{"codice":"la-new","nome":"New Latin","termine":"ontologia","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"ontologie","categoria":"prestito"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"From New Latin ontologia, possibly via French ontologie. By surface analysis, onto- + -logie.","origine_varieta":"la-new"},{"parola":"optatief","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"the optative mood or a word therein","termine_origine":"optātīvus","catena":[{"codice":"la","nome":"Latin","termine":"optātīvus","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"optatif","categoria":"prestito"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"From Latin optātīvus, probably via French optatif.","origine_varieta":"la"},{"parola":"ovipaar","pos":"adj","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"oviparous (producing eggs that mature and hatch outside the body)","termine_origine":"oviparus","catena":[{"codice":"la","nome":"Latin","termine":"oviparus","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"ovipare","categoria":"prestito"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"Borrowed from Latin oviparus or French ovipare.","origine_varieta":"la"},{"parola":"ovovivipaar","pos":"adj","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"ovoviviparous (producing eggs that hatch inside the parent's body)","termine_origine":"ovoviviparus","catena":[{"codice":"la","nome":"Latin","termine":"ovoviviparus","categoria":"latinismo_dotto"},{"codice":"fr","nome":"French","termine":"ovovivipare","categoria":"prestito"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"Borrowed from Latin ovoviviparus or French ovovivipare.","origine_varieta":"la"},{"parola":"palinodie","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"a palinode, a formal rhetorical 