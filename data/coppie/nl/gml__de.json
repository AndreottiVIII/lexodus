{"arrivo":"nl","origine":"gml","origine_nome":"Middle Low German","livello2":"de","livello2_nome":"German","n":5,"parole":[{"parola":"daalder","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"thaler","termine_origine":"dāler","catena":[{"codice":"gml","nome":"Middle Low German","termine":"dāler","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Taler","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*dal","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*dalą","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["finanza"],"via":"","testo":"Borrowed from Middle Low German dāler, from German Taler, a shortening of Joachimsthaler and Schlickenthaler."},{"parola":"grens","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"physical, territorial border, frontier","termine_origine":"grense","catena":[{"codice":"gml","nome":"Middle Low German","termine":"grense","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Grenze","categoria":"prestito"},{"codice":"zlw-opl","nome":"Old Polish","termine":"granica","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*granica","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed in the 16th century from Middle Low German grense, grenitse and/or German Grenze, both ultimately from Old Polish granica, from Proto-Slavic *granica."},{"parola":"raadszendbode","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"an emissary from a city, almost exclusively from a Hanseatic city","termine_origine":"rādessendebōde","catena":[{"codice":"gml","nome":"Middle Low German","termine":"rādessendebōde","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Ratssendebote","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"F