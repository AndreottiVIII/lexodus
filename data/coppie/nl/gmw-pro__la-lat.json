{"arrivo":"nl","origine":"gmw-pro","origine_nome":"Proto-West Germanic","livello2":"la-lat","livello2_nome":"Late Latin","n":8,"parole":[{"parola":"bus","pos":"noun","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"a container, a box, a tin","termine_origine":"*buhsā","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*buhsā","categoria":"ereditato"},{"codice":"la-lat","nome":"Late Latin","termine":"buxis","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"πυξίς","categoria":"prestito"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Middle Dutch busse, from Old Dutch *bussa, from Proto-West Germanic *buhsā. Doublet of buks (“shotgun”), box, and pyxis."},{"parola":"ezel","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"donkey, ass (Equus asinus or Equus asinus asinus)","termine_origine":"*asil","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*asil","categoria":"ereditato"},{"codice":"la-lat","nome":"Late Latin","termine":"asellus","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Middle Dutch ēsel, from Old Dutch esil, from Proto-West Germanic *asil, from Late Latin asellus."},{"parola":"gember","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ginger (Zingiber officinale, a plant)","termine_origine":"*gingiberō","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*gingiberō","categoria":"ereditato"},{"codice":"la-lat","nome":"Late Latin","termine":"gingiber","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"ζιγγίβερις","categoria":"prestito"},{"codice":"pra-sau","nome":"Sauraseni Prakrit","termine":"𑀲𑀺𑀁𑀕𑀺𑀯𑁂𑀭","categoria":"non_precisato"},{"codice":"oty","nome":"Old Tamil","termine":"𑀇𑀜𑁆𑀘𑀺𑀯𑁂𑀭𑁆","categoria":"prestito"}],"lontana":"oty","ambiti":["cucina"],"via":"","testo":"From Middle Dutch gingebare, from Old Dutch *gingi