logia":1,"categoria":"prestito","incerta":"no","significato":"asshole, motherfucker","termine_origine":"mamapanpan","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"mamapanpan","categoria":"prestito"}],"lontana":"srn","ambiti":[],"via":"","testo":"Borrowed from Sranan Tongo mamapanpan, from the phrase yu mama panpan (“your mother's vagina”)."},{"parola":"markoesa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"passion fruit","termine_origine":"markusa","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"markusa","categoria":"prestito"},{"codice":"car","nome":"Kari'na","termine":"merekuja","categoria":"non_precisato"},{"codice":"arw","nome":"Lokono","termine":"merekoya","categoria":"non_precisato"}],"lontana":"arw","ambiti":["cucina"],"via":"","testo":"From Sranan Tongo markusa, from Kari'na merekuja and/or Lokono merekoya."},{"parola":"mattie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"friend, mate, buddy","termine_origine":"mati","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"mati","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"maatje","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Sranan Tongo mati (“friend”), from Dutch maatje."},{"parola":"mooiboy","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"attractive male; (chiefly Suriname) Casanova, lady-killer; (chiefly Netherlands, Belgium) pretty boy, himbo","termine_origine":"moiboi","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"moiboi","categoria":"calco"}],"lontana":"srn","ambiti":[],"via":"","testo":"Calque of Sranan Tongo moiboi, from moiboifudada (“Casanova, lady-killer; braggart”). Equivalent to mooi (“pretty, beautiful”) + boy (“guy, boy”). Popularized in the Netherlands and Belgium in the 2010s."},{"parola":"mopé","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hog plum, Spondi