{"arrivo":"nl","origine":"srn","origine_nome":"Sranan Tongo","n":89,"parole":[{"parola":"als","pos":"conj|prep","n_etimologia":1,"categoria":"calco","incerta":"sì","motivo_incerta":"Possibly","significato":"if, when","termine_origine":"efu","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"efu","categoria":"calco"}],"lontana":"srn","ambiti":[],"via":"","testo":"From Middle Dutch alse, an unstressed form of also (modern alzo). The sense “whether” is possibly a semantic loan from Sranan Tongo efu (“if, when; if, whether”)."},{"parola":"angisa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a headkerchief traditionally worn by Afro-Surinamese women; the way it is tied can convey specific messages or proverbs","termine_origine":"angisa","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"angisa","categoria":"prestito"},{"codice":"en","nome":"English","termine":"handkercher","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Unadapted borrowing from Sranan Tongo angisa, from English handkercher."},{"parola":"bakabana","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a Surinamese-style banana fritter","termine_origine":"bakabana","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"bakabana","categoria":"prestito"}],"lontana":"srn","ambiti":[],"via":"","testo":"Unadapted borrowing from Sranan Tongo bakabana (baka (“to bake”) + bana (“plantain”))."},{"parola":"barkie","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"one hundred euros","termine_origine":"barki","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"barki","categoria":"prestito"}],"lontana":"srn","ambiti":[],"via":"","testo":"Borrowed from Sranan Tongo barki (“100 in any currency”)."},{"parola":"bastiaan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of basya (“assistant village chief”)","termine_origine":"basya","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"basya","categoria":"prestito"},{"codice":"en","nome":"English","termine":"overseer","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Sranan Tongo basya, from English overseer."},{"parola":"basya","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Maroon or Amerindian assistant village chief; the lowest tier in the hierarchy of tribal authority","termine_origine":"basya","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"basya","categoria":"prestito"},{"codice":"en","nome":"English","termine":"overseer","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Unadapted borrowing from Sranan Tongo basya, from English overseer. Doublet of bastiaan and officier."},{"parola":"bigi yari","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of kroonjaar (“milestone anniversary”)","termine_origine":"bigi yari","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"bigi yari","categoria":"prestito"}],"lontana":"srn","ambiti":[],"via":"","testo":"Unadapted borrowing from Sranan Tongo bigi yari (“big year”)."},{"parola":"bitawiri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Cestrum latifolium, the young leaves of which are eaten as a vegetable","termine_origine":"bitawiwiri","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"bitawiwiri","categoria":"prestito"}],"lontana":"srn","ambiti":["cucina"],"via":"","testo":"From Sranan Tongo bitawiwiri."},{"parola":"boegroe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a bead inserted permanently under the skin of the penis, supposedly in order to increase pleasure during vaginal or ana…","termine_origine":"bugru","catena":[{"codice":"srn","nome":"Sranan Tongo","termine":"bugru","categoria":"prestito"}],"lontana":"srn","ambiti":[],"via":"","testo":"Borrowed