{"arrivo":"nl","origine":"en","origine_nome":"English","livello2":"hi","livello2_nome":"Hindi","n":4,"parole":[{"parola":"cheeta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cheetah (Acinonyx jubatus)","termine_origine":"cheetah","catena":[{"codice":"en","nome":"English","termine":"cheetah","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"चीता","categoria":"non_precisato"},{"codice":"pra-sau","nome":"Sauraseni Prakrit","termine":"𑀘𑀺𑀢𑁆𑀢𑀕","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"चित्रक","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Borrowed from English cheetah, from Hindi चीता (cītā), from Sauraseni Prakrit 𑀘𑀺𑀢𑁆𑀢𑀕 (cittaga), from Sanskrit चित्रक (citraka, “leopard”)."},{"parola":"jungle","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jungle, dense tropical rainforest","termine_origine":"jungle","catena":[{"codice":"en","nome":"English","termine":"jungle","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"जंगल","categoria":"non_precisato"},{"codice":"ur","nome":"Urdu","termine":"جنگل","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"जङ्गल","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Borrowed from English jungle, from Hindi जंगल (jaṅgal) and Urdu جنگل (jangal), from Sanskrit जङ्गल (jaṅgala, “arid, sterile, desert”)."},{"parola":"pyjama","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"pyjamas, a matching set of light material trousers and vest for wearing to bed and sleeping in","termine_origine":"pyjamas","catena":[{"codice":"en","nome":"English","termine":"pyjamas","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"पैजामा","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"پایجامه","categoria":"non_precisato"}],"lontana":"fa","ambiti":["moda"],"via":"","testo":"Borrowed from English pyjamas, with spelling pronunciation, from pai jamahs (“loose trousers tied at the waist, worn by Muslims in India”), adopted by colonials, especially for nightwear, probably from Hindi पैजामा (paijāmā, “pajama”), itself from Persian پایجامه."},{"parola":"shampoo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"shampoo (product for washing hair)","termine_origine":"shampoo","catena":[{"codice":"en","nome":"English","termine":"shampoo","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"चाँपो","categoria":"non_precisato"}],"lontana":"hi","ambiti":[],"via":"","testo":"Borrowed from English shampoo, from Hindi चाँपो (cā̃po). In this instance, ⟨-oo⟩ is pronounced as /oː/ instead of /u/, and it is possibly a spelling pronunciation."}]}