{"arrivo":"nl","origine":"jv","origine_nome":"Javanese","n":19,"n_alternative":1,"parole":[{"parola":"baboe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"amah, ayah; a native Indonesian woman employed as a wet nurse, nanny and/or maid by Europeans in the former Dutch East…","termine_origine":"ꦧꦧꦸ","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦧꦧꦸ","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦧꦧꦸ (babu, “female servant”, literally “mother”), from Old Javanese babu (“mother; older servant”) (cf. wawuh (“familiar, acquainted”)). Compare Portuguese babo."},{"parola":"bouw","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"a unit of measure for area on Java, equivalent to about 0.7 hectare; a portion of agricultural land of this size","termine_origine":"ꦧꦲꦸ","termine_origine_traslitterazione":"bahu","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦧꦲꦸ","traslitterazione":"bahu","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦧꦲꦸ (bahu)."},{"parola":"doekoen","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dukun, a Javan or Malay witch doctor or folk healer","termine_origine":"dukun","catena":[{"codice":"jv","nome":"Javanese","termine":"dukun","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"dukun","categoria":"prestito"}],"lontana":"ms","ambiti":[],"via":"","testo":"Borrowed from Javanese dukun or Malay dukun."},{"parola":"guleh","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"a soup made with beef or goat tripe and coconut milk, eaten with compressed rice cakes","termine_origine":"gule","catena":[{"codice":"jv","nome":"Javanese","termine":"gule","categoria":"prestito"},{"codice":"ta","nome":"Tamil","termine":"குழை","traslitterazione":"kuḻai","categoria":"non_precisato"}],"lontana":"ta","ambiti":[],"via":"","testo":"Borrowed from Javanese gule, from Old Javanese gulay, probably from Tamil குழை (kuḻai, “to become soft, well cooked”)."},{"parola":"kali","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"river","termine_origine":"ꦏꦭꦶ","termine_origine_traslitterazione":"kali","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦏꦭꦶ","traslitterazione":"kali","categoria":"prestito"},{"codice":"poz-pro","nome":"Proto-Malayo-Polynesian","termine":"*kali","categoria":"non_precisato"}],"lontana":"poz-pro","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦏꦭꦶ (kali), from Old Javanese kali, from Proto-Malayo-Polynesian *kali."},{"parola":"kebon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a garden in the Dutch East Indies","termine_origine":"ꦏꦼꦧꦺꦴꦤ꧀","termine_origine_traslitterazione":"kebon","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦏꦼꦧꦺꦴꦤ꧀","traslitterazione":"kebon","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦏꦼꦧꦺꦴꦤ꧀ (kebon). In the sense “gardener” a shortening from tukang kebun."},{"parola":"kris","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kris (Indonesian or Malay with a wavy blade)","termine_origine":"ꦏꦼꦫꦶꦱ꧀","termine_origine_traslitterazione":"keris","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦏꦼꦫꦶꦱ꧀","traslitterazione":"keris","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦏꦼꦫꦶꦱ꧀ (keris), from Old Javanese kĕris, kris."},{"parola":"kroepoek","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"prawn crackers, or any other deep-fried crackers from Indonesian (Javanese) cuisine","termine_origine":"ꦏꦿꦸꦥꦸꦏ꧀","termine_origine_traslitterazione":"krupuk","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦏꦿꦸꦥꦸꦏ꧀","traslitterazione":"krupuk","categoria":"prestito"}],"lontana":"jv","ambiti":["cucina"],"via":"","testo":"Borrowed from Javanese ꦏꦿꦸꦥꦸꦏ꧀ (krupuk), from Old Javanese kurupuk (“a crunchy flake”). Compare to Malay keropok, Indonesian kerupuk, and Tagalog kropek."},{"parola":"mas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gold weight","termine_origine":"emas","catena":[{"codice":"jv","nome":"Javanese","termine":"emas","categoria":"non_precisato"}],"lontana":"jv","ambiti":[],"via":"","testo":"From Javanese emas."},{"parola":"motjo","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"the activity of reading a text aloud to an audience in the evening in a singsong voice","termine_origine":"ꦩꦕ","termine_origine_traslitterazione":"maca","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦩꦕ","traslitterazione":"maca","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Possibly from Javanese ꦩꦕ (maca)."},{"parola":"petoet","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"prison, slammer","termine_origine":"pethut","catena":[{"codice":"jv","nome":"Javanese","termine":"pethut","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese pethut (“outlaw leader”)."},{"parola":"poeri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"palace or residence of an Indonesian native ruler","termine_origine":"ꦥꦸꦫꦶ","termine_origine_traslitterazione":"puri","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦥꦸꦫꦶ","traslitterazione":"puri","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"puri","categoria":"prestito"},{"codice":"kaw","nome":"Old Javanese","termine":"purī","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"पुरी","traslitterazione":"purī","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦥꦸꦫꦶ (puri, “palace”), Malay puri (“palace”), from Old Javanese purī, from Sanskrit पुरी (purī)."},{"parola":"roedjak","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the traditional Indonesian (originally Javanese) salad dish consist of fruits and vegetables","termine_origine":"ꦫꦸꦗꦏ꧀","termine_origine_traslitterazione":"rujak","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦫꦸꦗꦏ꧀","traslitterazione":"rujak","categoria":"prestito"}],"lontana":"jv","ambiti":["cucina"],"via":"","testo":"From Javanese ꦫꦸꦗꦏ꧀ (rujak), from Old Javanese rujāk."},{"parola":"santen","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"coconut milk","termine_origine":"ꦱꦤ꧀ꦠꦼꦤ꧀","termine_origine_traslitterazione":"santen","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦱꦤ꧀ꦠꦼꦤ꧀","traslitterazione":"santen","categoria":"prestito"}],"lontana":"jv","ambiti":["cucina"],"via":"","testo":"Borrowed from Javanese ꦱꦤ꧀ꦠꦼꦤ꧀ (santen)."},{"parola":"sjambok","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a sjambok, a long heavy whip","termine_origine":"cambuk","catena":[{"codice":"jv","nome":"Javanese","termine":"cambuk","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"cambuk","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"چابک","traslitterazione":"čâbok","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Javanese cambuk or Malay cambuk, ultimately from Persian چابک (čâbok)."},{"parola":"tjapar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mung bean sprout(s), shoots of the mung bean","termine_origine":"ꦕꦥꦂ","termine_origine_traslitterazione":"capar","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦕꦥꦂ","traslitterazione":"capar","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦕꦥꦂ (capar, “sprout”)."},{"parola":"waringin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"weeping fig (\"the tree Ficus benjamina\")","termine_origine":"ꦮꦫꦶꦔꦶꦤ꧀","termine_origine_traslitterazione":"waringin","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦮꦫꦶꦔꦶꦤ꧀","traslitterazione":"waringin","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Javanese ꦮꦫꦶꦔꦶꦤ꧀ (waringin)."},{"parola":"waroeboom","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sea hibiscus, cottonwood hibiscus (Talipariti tiliaceum, syn. Hibiscus tiliaceus)","termine_origine":"waru","catena":[{"codice":"jv","nome":"Javanese","termine":"waru","categoria":"prestito"}],"lontana":"jv","ambiti":[],"via":"","testo":"Compound of waroe (“sea hibiscus”) + boom (“tree”). The first element is borrowed from Javanese waru."},{"parola":"pienter","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"apt, quick to learn","termine_origine":"ꦥꦶꦤ꧀ꦠꦼꦂ","termine_origine_traslitterazione":"pinter","catena":[{"codice":"jv","nome":"Javanese","termine":"ꦥꦶꦤ꧀ꦠꦼꦂ","traslitterazione":"pinter","categoria":"non_precisato"}],"lontana":"jv","ambiti":[],"via":"","alternative":[{"codice":"ms","nome":"Malay","termine":"pinter","categoria":"prestito"},{"codice":"jv","nome":"Javanese","termine":"ꦥꦶꦤ꧀ꦠꦼꦂ","traslitterazione":"pinter","categoria":"non_precisato"},{"codice":"bew","nome":"Betawi","termine":"pinter","categoria":"non_precisato"}],"testo":"Borrowed from Malay pinter (“gifted, smart”), from Javanese ꦥꦶꦤ꧀ꦠꦼꦂ (pinter, “clever”), either directly or via Betawi pinter."}]}