ia":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"talon, claw (sharp, hooked claw of a bird of prey or other predatory animal)","termine_origine":"*gripiz","catena":[{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*gripiz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","alternative":[{"codice":"fr","nome":"French","termine":"griffe","categoria":"prestito"},{"codice":"frm","nome":"Middle French","termine":"griffe","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"","categoria":"non_precisato"},{"codice":"goh","nome":"Old High German","termine":"grif","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*gripiz","categoria":"non_precisato"}],"testo":"Borrowed from French griffe (“talon”), from Middle French griffe, either deverbal from griffer, which see, or through an unattested Old French noun from Old High German grif, from Proto-Germanic *gripiz, which would make it a doublet of gryf (“grip”). First attested in 1807."}]}