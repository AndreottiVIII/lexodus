,"categoria":"prestito"}],"lontana":"cs","ambiti":[],"via":"","testo":"Borrowed from Czech honem."},{"parola":"japoniec","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Jap (offensive term for a Japanese person)","termine_origine":"Japonec","catena":[{"codice":"cs","nome":"Czech","termine":"Japonec","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"япо́нец","traslitterazione":"japónec","categoria":"prestito"}],"lontana":"ru","ambiti":["cucina","scienza"],"via":"","testo":"Borrowed from Czech Japonec or Russian япо́нец (japónec). By surface analysis, Japonia + -ec. For noun 2 sense 2, it was believed that this fish was a subspecies of the goldfish (Carassius auratus; Polish karaś chiński), which is native to Asia (including Japan)."},{"parola":"jałmużna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"alms (something given to the poor as charity)","termine_origine":"almužna","catena":[{"codice":"cs","nome":"Czech","termine":"almužna","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"almuosen","categoria":"prestito"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*alemōsinā","categoria":"ereditato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alēmosyna","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"ἐλεημοσύνη","traslitterazione":"eleēmosúnē","categoria":"prestito"}],"lontana":"grc","ambiti":["finanza"],"via":"","testo":"Borrowed from Czech almužna. Doublet of elemozyna."},{"parola":"kastrol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of rondel","termine_origine":"kastrol","catena":[{"codice":"cs","nome":"Czech","termine":"kastrol","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"casserole","categoria":"prestito"}],"lontana":"fr","ambiti":["cucina"],"via":"","testo":"Borrowed from Czech kastrol."},{"parola":"klasztor","pos":"noun","n_e