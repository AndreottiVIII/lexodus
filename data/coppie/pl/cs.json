{"arrivo":"pl","origine":"cs","origine_nome":"Czech","n":98,"n_alternative":1,"parole":[{"parola":"bachor","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"belly; stomach of an animal; intestines","termine_origine":"bachor","catena":[{"codice":"cs","nome":"Czech","termine":"bachor","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pǫxyrь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Judging by its distribution, borrowed from Czech bachor, from Old Czech bachoř, from Proto-Slavic *pǫxyrь"},{"parola":"barchet","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of barchan (“fustian”)","termine_origine":"barchet","catena":[{"codice":"cs","nome":"Czech","termine":"barchet","categoria":"prestito"}],"lontana":"cs","ambiti":["moda"],"via":"","testo":"Borrowed from Czech barchet. Compare Silesian barchet."},{"parola":"bardon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a lutelike or lyrelike stringed instrument","termine_origine":"bardun","catena":[{"codice":"cs","nome":"Czech","termine":"bardun","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"pardune","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["musica"],"via":"","testo":"Borrowed from Czech bardun, from Middle High German pardune."},{"parola":"cwał","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gallop (four-beat horse gait)","termine_origine":"cval","catena":[{"codice":"cs","nome":"Czech","termine":"cval","categoria":"prestito"}],"lontana":"cs","ambiti":[],"via":"","testo":"Borrowed from Czech cval."},{"parola":"cybeb","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dark brown, long raisin","termine_origine":"cibéba","catena":[{"codice":"cs","nome":"Czech","termine":"cibéba","categoria":"prestito"},{"codice":"de","nome":"German","termine