ermine":"Kruft","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"crypta","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κρυπτή","traslitterazione":"kruptḗ","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione","arte"],"via":"","testo":"Borrowed from Czech kruchta, from German Kruft, from Latin crypta, from Ancient Greek κρυπτή (kruptḗ), female form of the adjective κρυπτός (kruptós). Doublet of krypta (“crypt”)."},{"parola":"kusza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; Unknown; perhaps; modello unc/uncertain","significato":"crossbow (mechanised weapon, based on the bow and arrow)","termine_origine":"kuše","catena":[{"codice":"cs","nome":"Czech","termine":"kuše","categoria":"prestito"}],"lontana":"cs","ambiti":["militare"],"via":"","testo":"Uncertain. Perhaps borrowed from Czech kuše with further etymology unknown."},{"parola":"kłus","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trot (horse gait)","termine_origine":"klus","catena":[{"codice":"cs","nome":"Czech","termine":"klus","categoria":"prestito"}],"lontana":"cs","ambiti":[],"via":"","testo":"Borrowed from Czech klus."},{"parola":"lamować","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to edge by sewing, to border by sewing","termine_origine":"lemovat","catena":[{"codice":"cs","nome":"Czech","termine":"lemovat","categoria":"prestito"}],"lontana":"cs","ambiti":["moda"],"via":"","testo":"Borrowed from Czech lemovat."},{"parola":"laska","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; modificatore <unc> nel legame","significato":"attractive woman; babe","termine_origine":"láska","catena":[{"codice":"cs","nome":"Czech","termine":"láska","categoria":"prestito"}],"lontana":"cs","ambiti":[],"via":"","testo":"Possibly borrowed from Czech láska."},{"parola":"lewar","pos":"noun","n