{"arrivo":"pl","origine":"cs","origine_nome":"Czech","livello2":"sla-pro","livello2_nome":"Proto-Slavic","n":11,"parole":[{"parola":"bachor","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"belly; stomach of an animal; intestines","termine_origine":"bachor","catena":[{"codice":"cs","nome":"Czech","termine":"bachor","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pǫxyrь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Judging by its distribution, borrowed from Czech bachor, from Old Czech bachoř, from Proto-Slavic *pǫxyrь"},{"parola":"hasło","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"password","termine_origine":"heslo","catena":[{"codice":"cs","nome":"Czech","termine":"heslo","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*gъslo","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech heslo."},{"parola":"hledać","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of szukać","termine_origine":"hledat","catena":[{"codice":"cs","nome":"Czech","termine":"hledat","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ględati","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech hledat. Doublet of ględać and hlodać."},{"parola":"masarz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"butcher","termine_origine":"masař","catena":[{"codice":"cs","nome":"Czech","termine":"masař","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*męsarь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech masař, ultimately from Proto-Slavic *męsarь. Doublet of mięsiarz."},{"parola":"nóg","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"griffin","termine_origine":"noh","catena":[{"codice":"cs","nome":"Czech","termine":"noh","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Possibly borrowed from Czech noh, or inherited from Proto-Slavic ultimately from Proto-Slavic *jьnogъ. First attested in 1528. Displaced by gryf."},{"parola":"obecny","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"present (of a person, in a particular place)","termine_origine":"obecný","catena":[{"codice":"cs","nome":"Czech","termine":"obecný","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*obьťьnъ","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech obecný. First attested in 1539. Sense 2 is a specialization of sense 5. By surface analysis, obec + -ny. Displaced and doublet of obiecny, an inherited form."},{"parola":"ocel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calkin","termine_origine":"ocel","catena":[{"codice":"cs","nome":"Czech","termine":"ocel","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*ocelь","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"aciāle","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Czech ocel, from Proto-Slavic *ocelь, *ocělь, from Late Latin aciāle, from Latin aciēs, from ācer."},{"parola":"płaz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"amphibian","termine_origine":"plaz","catena":[{"codice":"cs","nome":"Czech","termine":"plaz","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pȏlzъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech plaz, from Proto-Slavic *pȏlzъ. Doublet of płóz (“skid, runner”) and połoz (“colubrid”)."},{"parola":"robot","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"robot","termine_origine":"robot","catena":[{"codice":"cs","nome":"Czech","termine":"robot","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*orbota","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech robot, from robota (“drudgery, servitude”), from Old Czech robota, from Proto-Slavic *orbota, from *orbiti + *-ota."},{"parola":"tachać","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"to lug, to tote","termine_origine":"tahat","catena":[{"codice":"cs","nome":"Czech","termine":"tahat","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*tęgati","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Possibly from Czech tahat, from Proto-Slavic *tęgati. Doublet of ciągać (“to drag”)."},{"parola":"zacny","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"virtuous, righteous","termine_origine":"vzácný","catena":[{"codice":"cs","nome":"Czech","termine":"vzácný","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*vъzęťьnъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Czech vzácný, from Proto-Slavic *vъzęťьnъ, from *vъzęti. The loss of w was due to contamination from cny."}]}