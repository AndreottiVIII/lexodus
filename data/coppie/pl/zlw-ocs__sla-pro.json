{"arrivo":"pl","origine":"zlw-ocs","origine_nome":"Old Czech","livello2":"sla-pro","livello2_nome":"Proto-Slavic","n":16,"parole":[{"parola":"bisior","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"byssus (long fine silky filaments excreted by several mollusks)","termine_origine":"biser","catena":[{"codice":"zlw-ocs","nome":"Old Czech","termine":"biser","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*bisьrь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["scienza","moda"],"via":"","testo":"Inherited from Old Polish bisior, from Old Czech biser, from Proto-Slavic *bisьrь, under influence of byssus."},{"parola":"brama","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gate","termine_origine":"brána","catena":[{"codice":"zlw-ocs","nome":"Old Czech","termine":"brána","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*borna","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Czech brána, from Proto-Slavic *borna. Doublet of brona (“harrow”)."},{"parola":"chuć","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"desire, wish, willingness","termine_origine":"chuť","catena":[{"codice":"zlw-ocs","nome":"Old Czech","termine":"chuť","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*xǫtь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Inherited from Old Polish chuć, from Old Czech chuť, from Proto-Slavic *xǫtь, *xutь. Doublet of chęć (“wish”)."},{"parola":"małżonka","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"someone else's spouse, wife","termine_origine":"malženka","catena":[{"codice":"zlw-ocs","nome":"Old Czech","termine":"malženka","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*malъžena","categoria":"non_