{"arrivo":"pl","origine":"orv","origine_nome":"Old East Slavic","n":13,"parole":[{"parola":"bieluń","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"thorn apple (any plant of the genus Datura)","termine_origine":"беленъ","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"беленъ","categoria":"prestito"}],"lontana":"orv","ambiti":[],"via":"","testo":"Inherited from Old Polish bieluń."},{"parola":"bohater","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hero (person of great bravery)","termine_origine":"богатꙑрь","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"богатꙑрь","categoria":"non_precisato"},{"codice":"trk","nome":"Turkic","termine":"","categoria":"non_precisato"}],"lontana":"trk","ambiti":["scienza","arte","sport"],"via":"","testo":"Borrowed from Old East Slavic богатꙑрь (bogatyrĭ), from a Turkic language. First attested in 1606. Doublet of bogatyr. Compare Kyrgyz баатыр (baatır), Mongolian баатар (baatar) and Persian بهادر (bahâdor)."},{"parola":"gruby","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"thick (of an object)","termine_origine":"грубъ","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"грубъ","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*grǫbъ","categoria":"ereditato"},{"codice":"ine-bsl-pro","nome":"Proto-Balto-Slavic","termine":"*gru(m)b-","categoria":"non_precisato"}],"lontana":"ine-bsl-pro","ambiti":[],"via":"","testo":"Inherited from Old Polish gruby, from Old East Slavic грубъ (grubŭ), from Proto-Slavic *grǫbъ. Doublet of gręby and hruby. Compare Kashubian grëbi and Silesian hruby."},{"parola":"kaleta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pocket","termine_origine":"калита","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"калита","categoria":"prestito"},{"codice":"trk","nome":"Turkic","termine":"","categoria":"non_precisato"}],"lontana":"trk","ambiti":["finanza"],"via":"","testo":"Borrowed from Old East Slavic калита (kalita), from a Turkic language. Compare Russian калита (kalita), Kazakh қалта (qalta)."},{"parola":"kołpak","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hubcap","termine_origine":"колпакъ","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"колпакъ","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"قلپاق","categoria":"non_precisato"}],"lontana":"ota","ambiti":["mare","moda"],"via":"","testo":"Borrowed from Old East Slavic колпакъ (kolpakŭ), from Ottoman Turkish قلپاق."},{"parola":"pieczara","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"grotto (small cave)","termine_origine":"печера","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"печера","categoria":"prestito"}],"lontana":"orv","ambiti":[],"via":"","testo":"Borrowed from Old East Slavic печера (pečera)."},{"parola":"prażnik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of święto /odpust (“holiday, parish festival”)","termine_origine":"пра́здник","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"пра́здник","categoria":"prestito"},{"codice":"cu","nome":"Old Church Slavonic","termine":"праздьникъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*porzdьnikъ","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":["finanza","religione"],"via":"","testo":"Inherited from Old Polish prażnik, borrowed from Old East Slavic пра́здник (prázdnik), borrowed from Old Church Slavonic праздьникъ (prazdĭnikŭ), from Proto-Slavic *porzdьnikъ, from *porzdьnъ + *-ikъ."},{"parola":"pud","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pood (obsolete Russian unit of mass, equal to 40 Russian funt, or about 16.38 kg)","termine_origine":"пудъ","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"пудъ","categoria":"prestito"}],"lontana":"orv","ambiti":[],"via":"","testo":"Inherited from Old Polish pud."},{"parola":"soból","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sable (Martes zibellina)","termine_origine":"соболь","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"соболь","categoria":"prestito"}],"lontana":"orv","ambiti":[],"via":"","testo":"Borrowed from Old East Slavic соболь (sobolĭ)."},{"parola":"stołp","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"keep, donjon (main tower of a castle or fortress, located within the castle walls)","termine_origine":"стълбъ","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"стълбъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*stъlbъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old East Slavic стълбъ (stŭlbŭ), from Proto-Slavic *stъlbъ (“post”). Doublet of słup, an inherited form."},{"parola":"sulica","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"dart (pointed missile weapon, intended to be thrown by the hand; for example, a short lance or javelin)","termine_origine":"сулица","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"сулица","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sudlica","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Inherited from Old Polish sulica, possibly from Old East Slavic сулица (sulica), from Proto-Slavic *sudlica."},{"parola":"Wołoch","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Vlach (person from Wallachia or of Wallachian descent)","termine_origine":"волохъ","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"волохъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*volxъ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*walhaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Old East Slavic волохъ (voloxŭ), from Proto-Slavic *volxъ, from Proto-Germanic *walhaz. Doublet of Walia, wałach, Wałach, Włoch, and Włochy."},{"parola":"wołoski","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Vlach (person from Wallachia or of Wallachian descent)","termine_origine":"","catena":[{"codice":"orv","nome":"Old East Slavic","termine":"","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*volšьskъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old East Slavic, from Proto-Slavic *volšьskъ. By surface analysis, Wołoch + -ski. Doublet of włoski (“Italian”)."}]}