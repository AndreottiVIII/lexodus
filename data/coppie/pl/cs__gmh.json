{"arrivo":"pl","origine":"cs","origine_nome":"Czech","livello2":"gmh","livello2_nome":"Middle High German","n":13,"parole":[{"parola":"bardon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a lutelike or lyrelike stringed instrument","termine_origine":"bardun","catena":[{"codice":"cs","nome":"Czech","termine":"bardun","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"pardune","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["musica"],"via":"","testo":"Borrowed from Czech bardun, from Middle High German pardune."},{"parola":"jałmużna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"alms (something given to the poor as charity)","termine_origine":"almužna","catena":[{"codice":"cs","nome":"Czech","termine":"almužna","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"almuosen","categoria":"prestito"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*alemōsinā","categoria":"ereditato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alēmosyna","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"ἐλεημοσύνη","categoria":"prestito"}],"lontana":"grc","ambiti":["finanza"],"via":"","testo":"Borrowed from Czech almužna. Doublet of elemozyna."},{"parola":"konew","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jug","termine_origine":"konev","catena":[{"codice":"cs","nome":"Czech","termine":"konev","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"kanne","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["cucina"],"via":"","testo":"Borrowed from Czech konev, from Middle High German kanne."},{"parola":"moszcz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"must (fruit juice for fermentation, usually from grapes)","termine_origine":"mošt","catena":[{"codice":"cs","nome":"Czech","termine":"mošt","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"most","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"mustum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Czech mošt, from Middle High German most, from Latin mustum."},{"parola":"pończocha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stocking (thin elastic garments covering the leg)","termine_origine":"punčocha","catena":[{"codice":"cs","nome":"Czech","termine":"punčocha","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"puntschuoch, buntschuoch","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["moda"],"via":"","testo":"Borrowed from Czech punčocha, from Middle High German puntschuoch, buntschuoch. Compare German Bundschuh."},{"parola":"szafran","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"crocus (any plant of the genus Crocus)","termine_origine":"šafrán","catena":[{"codice":"cs","nome":"Czech","termine":"šafrán","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"safrân, saffrân","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"safrānum","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"زَعْفَرَان","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Perhaps borrowed from Czech šafrán, from Middle High German safrân, saffrân, from Medieval Latin safrānum, from Arabic زَعْفَرَان (zaʕfarān)."},{"parola":"szermierz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fencer","termine_origine":"šermíř","catena":[{"codice":"cs","nome":"Czech","termine":"šermíř","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"schërmen","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["sport"],"via":"","testo":"Borrowed from Czech šermíř, from šermovat (“to fence”), from Middle High German schërmen (“to fence, to screen, to protect”)."},{"parola":"szermować","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to fence (to engage in the sport of fencing)","termine_origine":"šermovat","catena":[{"codice":"cs","nome":"Czech","termine":"šermovat","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"schërmen","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*skirmijan","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skirmiz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)ker-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["militare","sport","diritto_politica"],"via":"","testo":"Borrowed from Czech šermovat, from Middle High German schërmen (“to fence, to screen, to protect”), from Old High German skirmen, from Proto-West Germanic *skirmijan, from *skirmi (“covering, screen, shelter”), from Proto-Germanic *skirmiz, from Proto-Indo-European *(s)ker- (“to cut off”). By surfac"},{"parola":"szpiegować","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to spy (to act as a spy)","termine_origine":"špehovat","catena":[{"codice":"cs","nome":"Czech","termine":"špehovat","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"spëhen","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*spehōną","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Czech špehovat, from Middle High German spëhen, from Old High German spehōn, from Proto-Germanic *spehōną, from Proto-Indo-European *spéḱ-eh₂-ti, from *speḱ-."},{"parola":"warcaby","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"draughts (UK), checkers (US)","termine_origine":"vrhcáby","catena":[{"codice":"cs","nome":"Czech","termine":"vrhcáby","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"wurfzabel","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["sport"],"via":"","testo":"Borrowed from Czech vrhcáby, from Middle High German wurfzabel."},{"parola":"zamsz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"suede","termine_origine":"zámiš","catena":[{"codice":"cs","nome":"Czech","termine":"zámiš","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"samisch","categoria":"non_precisato"},{"codice":"frm","nome":"Middle French","termine":"chamois","categoria":"non_precisato"}],"lontana":"frm","ambiti":[],"via":"ar","testo":"Borrowed from Czech zámiš, from Middle High German samisch, later sämisch, from Middle French chamois, identical to the animal name chamois; in this understanding also Spanish gamuza and Portuguese camurça use the same word for the caprine and for the hide. Discarded derivations : Note that a lot of"},{"parola":"ćwok","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cull, dink, gudgeon, nong, numbnuts, schlump","termine_origine":"cvok","catena":[{"codice":"cs","nome":"Czech","termine":"cvok","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"zwëc","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Borrowed from Czech cvok (“loon, nutcase”), from Middle High German zwëc. Doublet of ćwiek (“hobnail, stud”)."},{"parola":"żołd","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"soldier's pay","termine_origine":"žold","catena":[{"codice":"cs","nome":"Czech","termine":"žold","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"sold","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"solt","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"soldus","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","militare","diritto_politica"],"via":"","testo":"Borrowed from Czech žold, from Middle High German sold, from Old French solt, from Latin soldus, from solidum."}]}