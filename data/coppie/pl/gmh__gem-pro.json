o"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Old Polish pręgierz, from Middle High German pranger (“pillory”), ultimately from Proto-Germanic *pranganą (“to press”)."},{"parola":"rum","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"broken debris, rock crumbs","termine_origine":"rūm","catena":[{"codice":"gmh","nome":"Middle High German","termine":"rūm","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*rūmą","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(H)rewH-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Middle High German rūm."},{"parola":"skrzat","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gnome, imp","termine_origine":"scrato","catena":[{"codice":"gmh","nome":"Middle High German","termine":"scrato","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skrattuz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Old Polish krzat, from Middle High German scrato, from Proto-Germanic *skrattuz. Compare Czech skřet /skřítek, Slovene škrat, German Schrat."},{"parola":"szlachta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"nobility, gentry (noble or privileged social class)","termine_origine":"slahte","catena":[{"codice":"gmh","nome":"Middle High German","termine":"slahte","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*slahtō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["diritto_politica"],"via":"","testo":"Inherited from Old Polish ślachta, ślechta, from Middle High German slahte, from Old High German slahta, from Proto-Germanic *slahtō. Compare German Geschlecht, Italian schiatta."},{"parola":"szopa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hut, shed (structure)","termine_origine":"schopf","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schopf","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skup-","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Middle High German schopf(e), from Proto-Germanic *skup-."},{"parola":"tratwa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"raft","termine_origine":"trift","catena":[{"codice":"gmh","nome":"Middle High German","termine":"trift","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*driftiz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["mare"],"via":"","testo":"Inherited from Old Polish trafta, trawta, tryfta, from Middle High German trift, from Proto-Germanic *driftiz. Doublet of dryf (“drift, leeway”)."},{"parola":"wachta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"watch","termine_origine":"wahte","catena":[{"codice":"gmh","nome":"Middle High German","termine":"wahte","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wahtwō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Middle High German wahte, from Old High German wahta, from Proto-Germanic *wahtwō (“watch, vigil”)."},{"parola":"łotr","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"villain, scoundrel","termine_origine":"lotter","catena":[{"codice":"gmh","nome":"Middle High German","termine":"lotter","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*ludraz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Old Polish łotr."}]}