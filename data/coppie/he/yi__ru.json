{"arrivo":"he","origine":"yi","origine_nome":"Yiddish","livello2":"ru","livello2_nome":"Russian","n":5,"parole":[{"parola":"־ניק","pos":"suffix","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"-nik, -er: Denoting persons by membership, occupation or attribute.","termine_origine":"־ניק","catena":[{"codice":"yi","nome":"Yiddish","termine":"־ניק","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"-ник","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"-nik","categoria":"non_precisato"},{"codice":"sla","nome":"Slavic","termine":"","categoria":"non_precisato"}],"lontana":"sla","ambiti":[],"via":"","testo":"From Yiddish ־ניק (-nik), from Russian -ник (-nik), Polish -nik and others, ultimately of Slavic origin. See further etymology at Russian -ник (-nik)."},{"parola":"בודקה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"booth","termine_origine":"בודקע","catena":[{"codice":"yi","nome":"Yiddish","termine":"בודקע","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"бу́дка","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"buda","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"buode","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bōþō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Yiddish בודקע (budke, “booth, stall”), from Russian бу́дка (búdka, “kennel, doghouse, booth”), from Polish buda (“shack, shanty”), from Middle High German buode, from Proto-Germanic *bōþō (“building, hut”). Cognates with English booth and German Bude (“booth, stall”)."},{"parola":"ז׳רגון","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jargon","termine_origine":"זשאַרגאָן","catena":[{"codice":"yi","nome":"Yiddish","termine":"זשאַרגאָן","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"жаргон","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"jargon","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Yiddish זשאַרגאָן (zhargon), from Russian жаргон (žargon), from French jargon."},{"parola":"פוגרום","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pogrom (riot aimed at persecution or massacre of a particular ethnic or religious group, usually Jews)","termine_origine":"פּאָגראָם","catena":[{"codice":"yi","nome":"Yiddish","termine":"פּאָגראָם","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"погро́м","categoria":"non_precisato"}],"lontana":"ru","ambiti":[],"via":"","testo":"From Yiddish פּאָגראָם (pogrom), from Russian погро́м (pogróm)."},{"parola":"צאר","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tsar","termine_origine":"צאַר","catena":[{"codice":"yi","nome":"Yiddish","termine":"צאַר","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"царь","categoria":"non_precisato"}],"lontana":"ru","ambiti":["diritto_politica"],"via":"","testo":"From Yiddish צאַר (tsar), from Russian царь (carʹ). Doublet of קֵיסָר (qeysár)."}]}