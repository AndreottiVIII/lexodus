:"alternatively","significato":"backgammon","termine_origine":"شش","termine_origine_traslitterazione":"šeš","catena":[{"codice":"fa","nome":"Persian","termine":"شش","traslitterazione":"šeš","categoria":"non_precisato"}],"lontana":"fa","ambiti":["sport"],"via":"","alternative":[{"codice":"tr","nome":"Turkish","termine":"beş","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"شش","traslitterazione":"šeš","categoria":"non_precisato"}],"testo":"From שֵׁשׁ (shesh, “six”) + Turkish beş (“five”). The first element could alternatively be derived from Persian شش (šeš, “six”)."}]}