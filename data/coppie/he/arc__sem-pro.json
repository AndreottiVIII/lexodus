{"arrivo":"he","origine":"arc","origine_nome":"Aramaic","livello2":"sem-pro","livello2_nome":"Proto-Semitic","n":6,"parole":[{"parola":"אבא","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"father (a male parent, especially of a human; a male who parents a child (which he has sired, adopted, fostered, etc.))","termine_origine":"אַבָּא","catena":[{"codice":"arc","nome":"Aramaic","termine":"אַבָּא","categoria":"prestito"},{"codice":"sem-pro","nome":"Proto-Semitic","termine":"*ʾab-","categoria":"ereditato"}],"lontana":"sem-pro","ambiti":[],"via":"","testo":"Borrowed from Aramaic אַבָּא (ʾabbā). Ultimately from Proto-Semitic *ʾab-. Doublet of אָב ('áv), which is inherited."},{"parola":"אמא","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mother","termine_origine":"אִמָּא","catena":[{"codice":"arc","nome":"Aramaic","termine":"אִמָּא","categoria":"prestito"},{"codice":"sem-pro","nome":"Proto-Semitic","termine":"*ʔimm-","categoria":"ereditato"},{"codice":"afa-pro","nome":"Proto-Afroasiatic","termine":"*ʔim-","categoria":"ereditato"}],"lontana":"afa-pro","ambiti":[],"via":"","testo":"Borrowed from Aramaic אִמָּא (ʾimmā)."},{"parola":"האריק","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to ground, to earth","termine_origine":"אַרְקָא","catena":[{"codice":"arc","nome":"Aramaic","termine":"אַרְקָא","categoria":"prestito"},{"codice":"sem-pro","nome":"Proto-Semitic","termine":"*ʔarṣ́-","categoria":"ereditato"}],"lontana":"sem-pro","ambiti":[],"via":"","testo":"Denominated from Aramaic אַרְקָא (ʾarqā, “earth, land”), variant of אַרְעָא (ʾarʿā), inherited from Proto-Semitic *ʔarṣ́-. Doublet of אֶרֶץ."},{"parola":"הוארק","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to be grounded, to be earthed","termine_origine":"אַרְקָא","catena":[{"codice":"arc","nome":"Aramaic","termine":"אַרְקָא","categoria":"prestito"},{"codice":"sem-pro","nome":"Prot