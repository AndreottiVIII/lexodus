incerta":"no","significato":"a gulp, sip","termine_origine":"","catena":[{"codice":"yi","nome":"Yiddish","termine":"","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Schluck","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Borrowed from Yiddish [Term?], German Schluck, deverbal from schlucken (“to swallow, gulp”)."},{"parola":"שלייקס","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"suspenders","termine_origine":"שלייקעס","catena":[{"codice":"yi","nome":"Yiddish","termine":"שלייקעס","categoria":"prestito"},{"codice":"uk","nome":"Ukrainian","termine":"шле́йки","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"szlejka","categoria":"non_precisato"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Yiddish שלייקעס (shleykes), from Ukrainian шле́йки (šléjky), plural of шле́йка (šléjka); from Polish szlejka, diminutive of szleja (see szelka (“strap, suspender”))."},{"parola":"שמוק","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"schmuck","termine_origine":"שמאָק","catena":[{"codice":"yi","nome":"Yiddish","termine":"שמאָק","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"From Yiddish שמאָק (shmok)."},{"parola":"שפיץ","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sharp tip","termine_origine":"שפּיץ","catena":[{"codice":"yi","nome":"Yiddish","termine":"שפּיץ","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"spitze","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*spitjaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Yiddish שפּיץ (shpits), from Middle High German spitze, from Old High German spizza, from Proto-Germanic *spitjaz."},{"parola":"שפיצי","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pointed, pointy","termine_origine":"שפּיציק","catena":[{"codice":"yi","nome":"Yiddish","termine":"שפּיציק","categoria":"non_precisato"}],"lontana":"yi","ambiti":[],"via":"","testo":"From שפיץ (shpits) + ־י (-í), inspired by Yiddish שפּיציק (shpitsik)"},{"parola":"שפריץ","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"spritz, sprinkle; splash, spray; squirt","termine_origine":"שפּריץ","catena":[{"codice":"yi","nome":"Yiddish","termine":"שפּריץ","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"Borrowed from Yiddish שפּריץ (shprits)."},{"parola":"תחת","pos":"prep|noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"below","termine_origine":"תּחת","catena":[{"codice":"yi","nome":"Yiddish","termine":"תּחת","categoria":"calco"}],"lontana":"yi","ambiti":[],"via":"","testo":"Related to Arabic تَحْتَ (taḥta), Ge'ez ታሕተ (taḥtä), Ugaritic 𐎚𐎈𐎚 (tḥt /⁠taḥta⁠/). The \"buttocks\" sense might be a semantic loan from Yiddish תּחת (tokhes)."},{"parola":"תכלס","pos":"adv|intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"unexpectedly true, actually","termine_origine":"תּכלית","catena":[{"codice":"yi","nome":"Yiddish","termine":"תּכלית","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"תַּכְלִית","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish תּכלית (takhles, “goal”) after being borrowed from the original Hebrew תַּכְלִית (takhlít, “purpose, aim”), which is a doublet."}]}