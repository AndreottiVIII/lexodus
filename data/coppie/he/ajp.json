:[],"via":"","testo":"From South Levantine Arabic سَلَامْتَك (salāmtak, “get well”), from Arabic سَلَامَتُكَ (salāmatuka, “your safety”)."},{"parola":"עלק","pos":"intj|adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yeah, right, as if","termine_origine":"قال لك","catena":[{"codice":"ajp","nome":"South Levantine Arabic","termine":"قال لك","categoria":"prestito"}],"lontana":"ajp","ambiti":[],"via":"","testo":"From South Levantine Arabic قال لك (ʔāl lak/lek, “he said to you”)."},{"parola":"צנובר","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pine nut (the edible seed of any of several species of evergreen pine, especially Pinus pinea, Pinus cembra, and Pinus…","termine_origine":"صنوبر","catena":[{"codice":"ajp","nome":"South Levantine Arabic","termine":"صنوبر","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"صَنَوْبَر","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from South Levantine Arabic صنوبر (ṣnōbar), from Arabic صَنَوْبَر (ṣanawbar)."},{"parola":"שאפה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chick, an attractive young woman","termine_origine":"شقفة","catena":[{"codice":"ajp","nome":"South Levantine Arabic","termine":"شقفة","categoria":"prestito"}],"lontana":"ajp","ambiti":[],"via":"","testo":"Borrowed from South Levantine Arabic شقفة (šaqfa /⁠ˈʃaʔ.fa⁠/, “attractive woman”)."},{"parola":"שופוני","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A show-off, one who attracts attention through arrogant behavior or through a prominent, eye-popping appearance","termine_origine":"شُوفُونِي يَا نَاس","catena":[{"codice":"ajp","nome":"South Levantine Arabic","termine":"شُوفُونِي يَا نَاس","categoria":"prestito"}],"lontana":"ajp","ambiti":[],"via":"","testo":"From South Levantine Arabic شُوفُونِي يَا نَاس (“Look at me, people”)."}]}