o"}],"lontana":"la-lat","ambiti":["cucina"],"via":"","testo":"Borrowed from French champagne, from the region Champagne, from Late Latin campānia (compare Campania Remensis), from campaneus, from Latin campus."},{"parola":"שף","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"chef","termine_origine":"chef","catena":[{"codice":"fr","nome":"French","termine":"chef","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Internationalism, from French chef."},{"parola":"תה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tea","termine_origine":"thé","catena":[{"codice":"fr","nome":"French","termine":"thé","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Tee","categoria":"prestito"}],"lontana":"de","ambiti":["cucina"],"via":"","testo":"Borrowed from Western European languages, compare French thé and German Tee."},{"parola":"תזה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a thesis (a proposition or statement supported by arguments.)","termine_origine":"thèse","catena":[{"codice":"fr","nome":"French","termine":"thèse","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"thesis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"θέσις","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from French thèse, from Latin thesis, itself borrowed from Ancient Greek θέσις (thésis)."},{"parola":"תפוח אדמה","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"potato (the edible starchy tuber of the plant species Solanum tuberosum)","termine_origine":"pomme de terre","catena":[{"codice":"fr","nome":"French","termine":"pomme de terre","categoria":"calco"}],"lontana":"fr","ambiti":["cucina"],"via":"","testo":"Calque of French pomme de terre (literally “apple of [the] earth”), like Dutch aardappel and others."}]}