ategoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"From French stage, likely reinforced by Polish staż."},{"parola":"סלון","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"living room","termine_origine":"salon","catena":[{"codice":"fr","nome":"French","termine":"salon","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Internationalism, from French salon."},{"parola":"ספלאולוגיה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"speleology (the study of caves)","termine_origine":"spéléologie","catena":[{"codice":"fr","nome":"French","termine":"spéléologie","categoria":"prestito"}],"lontana":"fr","ambiti":["scienza"],"via":"","testo":"From French spéléologie, coined by Émile Rivière in 1890. Cognate with Russian спелеология (speleologija), Polish speleologia, and other Slavic synonyms."},{"parola":"סקסופון","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a saxophone","termine_origine":"saxophone","catena":[{"codice":"fr","nome":"French","termine":"saxophone","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from French saxophone, a combination of the surname of its inventor Adolphe Sax (1814–1894) + -o- + -phone (“something that makes a sound”). Compare saxophone."},{"parola":"פודרה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"face powder; a usually perfumed cosmetic powder","termine_origine":"poudre","catena":[{"codice":"fr","nome":"French","termine":"poudre","categoria":"prestito"}],"lontana":"fr","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from French poudre (“powder”)."},{"parola":"פיקניק","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a picnic","termine_origine":"pique-nique","catena":[{"codice":"fr","nome":"French","termine":"pique-nique","categoria":"prestito"},{"codice":"en","nome":"Engli