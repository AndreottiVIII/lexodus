..."},{"parola":"מסה","pos":"noun","n_etimologia":2,"categoria":"calco","incerta":"no","significato":"test, trial, temptation","termine_origine":"essai","catena":[{"codice":"fr","nome":"French","termine":"essai","categoria":"calco"}],"lontana":"fr","ambiti":[],"via":"","testo":"The third sense is a calque of French essai (literally “trial”)."},{"parola":"מסז׳","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a massage","termine_origine":"massage","catena":[{"codice":"fr","nome":"French","termine":"massage","categoria":"prestito"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from French massage."},{"parola":"מרתון","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A marathon, road race.","termine_origine":"marathon","catena":[{"codice":"fr","nome":"French","termine":"marathon","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"Μαραθών","categoria":"prestito"}],"lontana":"grc","ambiti":["sport"],"via":"","testo":"Borrowed from French marathon (and reinforced by cognates), coined in 1894 by linguist Michel Bréal for the first modern time Olympic Games after Ancient Greek Μαραθών (Marathṓn), a town northeast of Athens. Phidippides the Greek ran the distance from Marathon to Athens to deliver a message regardin"},{"parola":"נישה","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a niche (cavity, hollow, or recess)","termine_origine":"niche","catena":[{"codice":"fr","nome":"French","termine":"niche","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nīdus","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","scienza"],"via":"","testo":"Ultimately borrowed from French niche, from Old French niche, from nicher (“make a nest”) (modern French nicher), from Latin nīdus (“nest”)."},{"parola":"נפוטיזם","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"nepotism","termine_origine":"népo