ato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Andalusian Arabic رَزْمَة (rázma), from Arabic رِزْمَة (rizma, “bundle”)."},{"parola":"rajola","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"floor tile","termine_origine":"","catena":[{"codice":"xaa","nome":"Andalusian Arabic","termine":"","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"آجُرّ","traslitterazione":"al-ʔājurr","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Andalusian Arabic laǧûra, from Arabic الْآجُرّ (al-ʔājurr)."},{"parola":"raval","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"suburb","termine_origine":"الرَبَض","termine_origine_traslitterazione":"ar-rabáḍ","catena":[{"codice":"xaa","nome":"Andalusian Arabic","termine":"الرَبَض","traslitterazione":"ar-rabáḍ","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"رَبَض","traslitterazione":"rabaḍ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Andalusian Arabic الرَبَض (ar-rabáḍ), from Arabic رَبَض (rabaḍ, “outskirts”). Cognate to Spanish arrabal."},{"parola":"rivet","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"weather strip, draught excluder","termine_origine":"رباط","termine_origine_traslitterazione":"ribāt","catena":[{"codice":"xaa","nome":"Andalusian Arabic","termine":"رباط","traslitterazione":"ribāt","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"رِبَاط","traslitterazione":"ribāṭ","categoria":"ereditato"}],"lontana":"ar","ambiti":["moda"],"via":"","testo":"Borrowed from Andalusian Arabic رباط (ribāt)."},{"parola":"rècula","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pack train, mule train","termine_origine":"رَكْبَة","termine_origine_traslitterazione":"rakba","catena":[{"codice":"xaa","nome":"Andalusian Arabic","termine":"رَكْبَة","traslitterazione":