termine":"ribote","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Occitan ribota (“noisy revelry”), from French ribote."},{"parola":"rocafort","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Roquefort (type of cheese)","termine_origine":"Ròcafòrt","catena":[{"codice":"oc","nome":"Occitan","termine":"Ròcafòrt","categoria":"prestito"}],"lontana":"oc","ambiti":["cucina"],"via":"","testo":"Borrowed from Occitan Ròcafòrt, the name of the town in Occitania where it originated."},{"parola":"rondinar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to grumble (to complain)","termine_origine":"rondinar","catena":[{"codice":"oc","nome":"Occitan","termine":"rondinar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"grunniō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Occitan rondinar, from earlier rondir, from Latin grundīre (“to grunt”)."},{"parola":"salsa rolla","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rouille","termine_origine":"rolha","catena":[{"codice":"oc","nome":"Occitan","termine":"rolha","categoria":"non_precisato"}],"lontana":"oc","ambiti":["cucina"],"via":"","testo":"From Occitan rolha (“egg yolk”)."},{"parola":"tancar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to close","termine_origine":"tancar","catena":[{"codice":"oc","nome":"Occitan","termine":"tancar","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"Borrowed from Occitan tancar. First attested in the 12th century."},{"parola":"tarasca","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tarasque","termine_origine":"tarasca","catena":[{"codice":"oc","nome":"Occitan","termine":"tarasca","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"From Occitan tarasca."},{"parola":"tartana","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tartane (a small fishing boat with a single mast and a lateen sail)","termine_origine":"tartana","catena":[{"codice":"oc","nome":"Occitan","termine":"tartana","categoria":"prestito"}],"lontana":"oc","ambiti":["mare"],"via":"","testo":"Borrowed from Occitan tartana (“bird of prey, falcon”)."},{"parola":"tatxa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tack (a short nail with a flat head)","termine_origine":"tacha","catena":[{"codice":"oc","nome":"Occitan","termine":"tacha","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"Borrowed from Occitan tacha."},{"parola":"trufa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"truffle","termine_origine":"trufa","catena":[{"codice":"oc","nome":"Occitan","termine":"trufa","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"Borrowed from Occitan trufa. Doublet of tòfona."},{"parola":"trufada","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"truffade (Occitan potato dish)","termine_origine":"trufada","catena":[{"codice":"oc","nome":"Occitan","termine":"trufada","categoria":"prestito"}],"lontana":"oc","ambiti":["cucina"],"via":"","testo":"Borrowed from Occitan trufada, from trufa (“potato”)."},{"parola":"userda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"alfalfa","termine_origine":"*userda","catena":[{"codice":"oc","nome":"Occitan","termine":"*userda","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"Borrowed from Occitan *userda, rebracketing of luserda, variant form of luserna. Cognate with French luzerne."},{"parola":"varenga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rib, strut","termine_origine":"varenga","catena":[{"codice":"oc","nome":"Occitan","termine":"varenga","categoria":"prestito"},{"codice":"fr","n