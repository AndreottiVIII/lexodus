:[{"codice":"oc","nome":"Occitan","termine":"escabel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"scabellum","categoria":"non_precisato"}],"lontana":"la","ambiti":["militare","sport","diritto_politica"],"via":"","testo":"Uncertain, perhaps from Old Catalan escabot, from Occitan escabel, from Latin scabellum (“footstool”)."},{"parola":"espertinar","pos":"verb|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to snack","termine_origine":"espertina","catena":[{"codice":"oc","nome":"Occitan","termine":"espertina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vespertina","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"From espertina + -ar, from Occitan espertina, from Latin vespertina."},{"parola":"felibre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"félibre","termine_origine":"felibre","catena":[{"codice":"oc","nome":"Occitan","termine":"felibre","categoria":"prestito"}],"lontana":"oc","ambiti":["scienza","arte"],"via":"","testo":"From Occitan felibre, a word coined by Frédéric Mistral via a misdivision of Sepher, libre."},{"parola":"galifardeu","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bailiff, constable","termine_origine":"galavard","catena":[{"codice":"oc","nome":"Occitan","termine":"galavard","categoria":"non_precisato"}],"lontana":"oc","ambiti":["diritto_politica"],"via":"","testo":"Derived from Old Catalan galavardeu (with influence from califa (“caliph”)); from Occitan galavard (“scruffy man”)."},{"parola":"gardí","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"common rudd (Scardinius erythrophthalmus)","termine_origine":"gàrri","catena":[{"codice":"oc","nome":"Occitan","termine":"gàrri","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"Perhaps borrowed from Occitan gàrri (“Atlantic stargazer”), with dissimilation of /rr/ to /rd/, or derived from the name Gardin, of Germanic origin."},{"parola":"garlopa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jack plane","termine_origine":"garlopo","catena":[{"codice":"oc","nome":"Occitan","termine":"garlopo","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"warlope","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Occitan garlopo, from dialectal French warlope."},{"parola":"garneu","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cunning; malicious","termine_origine":"gronard","catena":[{"codice":"oc","nome":"Occitan","termine":"gronard","categoria":"non_precisato"}],"lontana":"oc","ambiti":[],"via":"","testo":"From Occitan gronard, from gronir (“to grunt”). Cognate with English gurnard."},{"parola":"gavanyar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to damage","termine_origine":"gabanhà","catena":[{"codice":"oc","nome":"Occitan","termine":"gabanhà","categoria":"prestito"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*borgōn","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"Borrowed from Occitan gabanhà, by metathesis from Old Occitan barganhar, from Proto-West Germanic *borgōn. Doublet of barganyar."},{"parola":"gavarra","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"a river barge","termine_origine":"gabarra","catena":[{"codice":"oc","nome":"Occitan","termine":"gabarra","categoria":"prestito"},{"codice":"eu","nome":"Basque","termine":"gabarra","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"carabus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Occitan gabarra, from Basque gabarra, perhaps from Latin carabus."},{"parola":"goda","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"laziness","termine_origine":"gòda","catena":[{"codice":"oc","nome":"Occitan","termine":"gòda","categoria":"non_precisato"}],"lontana":"oc","ambiti":[],"via":"","testo":"From Occitan gòda."},{"parola":"gripau","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Unknown; Possibly","significato":"toad","termine_origine":"grapaut","catena":[{"codice":"oc","nome":"Occitan","termine":"grapaut","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"crapaud","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*krappō","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Unknown derivation, possibly from Occitan grapaut or French crapaud, which both likely derived from Frankish *krappō (“hook”)."},{"parola":"magret","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"magret","termine_origine":"magret","catena":[{"codice":"oc","nome":"Occitan","termine":"magret","categoria":"prestito"}],"lontana":"oc","ambiti":["cucina"],"via":"","testo":"Borrowed from Occitan magret."},{"parola":"mostarda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"mustard","termine_origine":"mostarda","catena":[{"codice":"oc","nome":"Occitan","termine":"mostarda","categoria":"prestito"}],"lontana":"oc","ambiti":["cucina"],"via":"","testo":"Probably borrowed from Occitan mostarda; compare French moutarde."},{"parola":"musar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to waste time","termine_origine":"musar","catena":[{"codice":"oc","nome":"Occitan","termine":"musar","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"musare","categoria":"prestito"}],"lontana":"it","ambiti":[],"via":"","testo":"Borrowed from Occitan musar or Italian musare."},{"parola":"niçard","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta