{"arrivo":"ca","origine":"oc","origine_nome":"Occitan","n":46,"n_alternative":2,"parole":[{"parola":"ardit","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"farthing","termine_origine":"hardit","catena":[{"codice":"oc","nome":"Occitan","termine":"hardit","categoria":"prestito"},{"codice":"en","nome":"English","termine":"farthing","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Occitan hardit, from English farthing."},{"parola":"bastard","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"illegitimate (born out of wedlock)","termine_origine":"bastard","catena":[{"codice":"oc","nome":"Occitan","termine":"bastard","categoria":"non_precisato"}],"lontana":"oc","ambiti":[],"via":"","testo":"From Occitan bastard."},{"parola":"beta","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"boat; specifically a small, flat-bottom boat common to the coasts of Provence and Languedoc","termine_origine":"beta","catena":[{"codice":"oc","nome":"Occitan","termine":"beta","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","testo":"Borrowed from Occitan beta."},{"parola":"bústia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"mailbox, letterbox","termine_origine":"bóstia","catena":[{"codice":"oc","nome":"Occitan","termine":"bóstia","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"boiste","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"buxis","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Occitan bóstia, from Old French boiste (modern French boîte), from Late Latin buxis (“box”). Compare Italian busta (“envelope”)."},{"parola":"cabrestant","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"capstan, winch","termine_origine":"cabestran","catena":[{"codice":"oc","nome":"Occit