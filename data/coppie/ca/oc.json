ato":"to leave, to get out from, to gush","termine_origine":"salhir","catena":[{"codice":"oc","nome":"Occitan","termine":"salhir","categoria":"prestito"}],"lontana":"oc","ambiti":[],"via":"","alternative":[{"codice":"la","nome":"Latin","termine":"salīre","categoria":"ereditato"},{"codice":"oc","nome":"Occitan","termine":"salhir","categoria":"prestito"}],"testo":"From Latin salīre or from Occitan salhir."}]}