{"arrivo":"ca","origine":"gmw-pro","origine_nome":"Proto-West Germanic","n":7,"parole":[{"parola":"brilla","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bridle","termine_origine":"*brigdil","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*brigdil","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brigdilaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Proto-West Germanic *brīdil, from Proto-Germanic *brigdilaz. Doublet of brida and cognate of English bridle."},{"parola":"busca","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"a thin branch, straw, spill, etc.","termine_origine":"*busk","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*busk","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":["scienza","informatica"],"via":"","testo":"Perhaps related to Proto-West Germanic *busk (“bush, thicket”)."},{"parola":"carpó","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"coccyx","termine_origine":"*kropp","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*kropp","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kruppaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["scienza"],"via":"","testo":"By metathesis from earlier crepó (compare Occitan crepon), from a diminutive of Proto-West Germanic *kropp, from Proto-Germanic *kruppaz (“body, trunk, crop”)."},{"parola":"esquerp","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rude","termine_origine":"*skarp","catena":[{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*skarp","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skarpaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"