significato":"war","termine_origine":"werra","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"werra","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*werʀu","categoria":"non_precisato"}],"lontana":"frk","ambiti":["militare"],"via":"","testo":"Inherited from Old Catalan guerra~gerra, from Early Medieval Latin werra, from Frankish *werʀu (“confusion; quarrel”).","origine_varieta":"la-eme"},{"parola":"instal·lar","pos":"verb","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"to install","termine_origine":"īnstallāre","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"īnstallāre","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*stall","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*stallaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*stelǝ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza","informatica"],"via":"","testo":"Borrowed from Medieval Latin īnstallāre (“to install, put in place, establish”), from Latin in- + stallum (“stall”), from Frankish *stall (“stall, position, place”), from Proto-Germanic *stallaz (“place, position”), from Proto-Indo-European *stelǝ-, *stAlǝn-, *stAlǝm- (“stem, trunk”).","origine_varieta":"la-med"},{"parola":"pot","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"jar, canister, vessel","termine_origine":"pottum","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"pottum","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*pott","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*puttaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*budnós","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin pottum, pottus (“pot, jar”), from Frankish *pott, from Proto-Germanic *puttaz (“pot”), from Proto-Indo-European *budnós (“a type of vessel”). Cognate with French pot, English pot, Saterland Frisian Pot, Dutch pot, German Low German Pott, German Pott, Swedish potta (“chamb","origine_varieta":"la-vul"},{"parola":"raspar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to scrape (draw a sharp object along a surface)","termine_origine":"*raspāre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*raspāre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*hraspōn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *raspāre, from Frankish *hraspōn.","origine_varieta":"la-vul"},{"parola":"robar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"to rob, steal","termine_origine":"raubō","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"raubō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*raubōn","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*raubōną","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*Hrewp-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin raubāre.","origine_varieta":"la-lat"},{"parola":"seny","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"sense, common sense, sensibleness","termine_origine":"*sennus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sennus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*sinn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Old Catalan sen, from Vulgar Latin *sennus, from Frankish *sinn, possibly influenced by Latin sensus (“sense”).","origine_varieta":"la-vul"}]}