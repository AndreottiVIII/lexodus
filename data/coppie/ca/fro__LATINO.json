{"arrivo":"ca","origine":"fro","origine_nome":"Old French","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":28,"parole":[{"parola":"aliar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to ally","termine_origine":"aliier","catena":[{"codice":"fro","nome":"Old French","termine":"aliier","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"alligō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French aliier, from Latin alligāre.","livello2_varieta":"la"},{"parola":"bisell","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"bezel","termine_origine":"bisel","catena":[{"codice":"fro","nome":"Old French","termine":"bisel","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bisalus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["musica"],"via":"","testo":"Borrowed from Old French bisel, possibly from Vulgar Latin *bisalus.","livello2_varieta":"la-vul"},{"parola":"campió","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"champion","termine_origine":"campion","catena":[{"codice":"fro","nome":"Old French","termine":"campion","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"campiō","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*kampijō","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*kampijô","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"campus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French campion, from Late Latin campiōnem (“champion, fighter”), from Frankish *kampijō, from Proto-Germanic *kampijô, based on Latin campus (“level ground”).","livello2_varieta":"la-lat"},{"parola":"carruatge","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"carriage","termine_origine":"cariage","catena":[{"codice":"fro","nome":"Old French","termine":"cariage","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"carrus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Akin to Occitan cariatge. Probably borrowed from Old French cariage, from a derivative of Latin carrus.","livello2_varieta":"la"},{"parola":"coca","pos":"noun","n_etimologia":3,"categoria":"non_precisato","incerta":"no","significato":"cog (type of sailing ship)","termine_origine":"coque","catena":[{"codice":"fro","nome":"Old French","termine":"coque","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"caudica","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"Inherited from Old Catalan coca, from Old French coque, ultimately from Latin caudica (“small ship made of tree trunks”).","livello2_varieta":"la"},{"parola":"cofre","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"chest, coffer (large box often used for storage)","termine_origine":"cofre","catena":[{"codice":"fro","nome":"Old French","termine":"cofre","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cŏphĭnus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κόφινος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Old Catalan cofre, from Old French cofre, from Latin cŏphĭnus (“basket, pan”), from Ancient Greek κόφινος (kóphinos). First attested in the 13th century.","livello2_varieta":"la"},{"parola":"cospell","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"planchet (coin blank)","termine_origine":"cospel","catena":[{"codice":"fro","nome":"Old French","termine":"cospel","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cuspidellus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Old French cospel, from Vulgar Latin *cuspidellus, diminutive of Latin cuspis (“point, tip”). Doublet of copel·la.","livello2_varieta":"la-vul"},{"parola":"covard","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cowardly","termine_origine":"coart","catena":[{"codice":"fro","nome":"Old French","termine":"coart","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cōda","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old French coart, from coe (“tail”), from Latin cōda (“tail”). Cognate with French couard, English coward.","livello2_varieta":"la"},{"parola":"daina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fallow deer","termine_origine":"dain","catena":[{"codice":"fro","nome":"Old French","termine":"dain","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"dāmus","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Old French dain, from Late Latin dāmus, a masculine variant of Latin dāma (“fallow deer, buck, doe”). Originally masculine in Old Catalan, daine shifted to daina under the influence of words like cabra (“goat”), ovella (“sheep”), etc. via the plural form daines.","livello2_varieta":"la-lat"},{"parola":"duc","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"duke (ruler of a duchy)","termine_origine":"duc","catena":[{"codice":"fro","nome":"Old French","termine":"duc","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dux","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French duc, from Latin dux (“leader”).","livello2_varieta":"la"},{"parola":"festival","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"festival","termine_origine":"festival","catena":[{"codice":"fro","nome":"Old French","termine":"festival","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fēstīvālis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French festival, from Latin fēstīvālis.","livello2_varieta":"la"},{"parola":"fletxa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"arrow","termine_origine":"fleche","catena":[{"codice":"fro","nome":"Old French","termine":"fleche","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fleccia","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["militare","sport"],"via":"","testo":"Inherited from Old Catalan flecha, from Old French fleche, from Vulgar Latin *fleccia, of Frankish origin.","livello2_varieta":"la-vul"},{"parola":"granja","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"farm","termine_origine":"grange","catena":[{"codice":"fro","nome":"Old French","termine":"grange","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*grānica","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["agricoltura"],"via":"","testo":"Inherited from Old Catalan granja, borrowed from Old French grange, from Vulgar Latin *grānica. First attested in 1323.","livello2_varieta":"la-vul"},{"parola":"joia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"joy","termine_origine":"joie","catena":[{"codice":"fro","nome":"Old French","termine":"joie","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gaudia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French joie, from Latin gaudia, plural of gaudium (“joy”).","livello2_varieta":"la"},{"parola":"joia","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"jewel","termine_origine":"joiel","catena":[{"codice":"fro","nome":"Old French","termine":"joiel","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*jocale","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Inherited from Old Catalan joiell, borrowed from Old French joiel, from Vulgar Latin *jocale (“graceful object”), from Latin iocus (“game; playing; joke”).","livello2_varieta":"la-vul"},{"parola":"joiell","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jewel","termine_origine":"joiel","catena":[{"codice":"fro","nome":"Old French","termine":"joiel","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Old French joiel, from Vulgar Latin *iocāle (“graceful object”), from Latin iocus (“game; playing; joke”).","livello2_varieta":"la-vul"},{"parola":"khan","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"khan","termine_origine":"chan","catena":[{"codice":"fro","nome":"Old French","termine":"chan","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"chanus","categoria":"non_precisato"},{"codice":"trk","nome":"Turkic","termine":"","categoria":"non_precisato"},{"codice":"otk","nome":"Old Turkic","termine":"","categoria":"non_precisato"}],"lontana":"otk","ambiti":[],"via":"","testo":"From Old French chan, from Medieval Latin chanus, caanus, of Turkic origin, from Old Turkic xān (“Central Asian khan”), probably ultimately of non-Turkic (Central Asian) origin.","livello2_varieta":"la-med"},{"parola":"llotja","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gallery","termine_origine":"loge","catena":[{"codice":"fro","nome":"Old French","termine":"loge","categoria":"prestito"},{"codice":"la-eme","nome":"Early Medieval Latin","termine":"laubia","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*laubijā","categoria":"prestito"}],"lontana":"frk","ambiti":["arte"],"via":"","testo":"Inherited from Old Catalan loja, borrowed from Old French loge, from Early Medieval Latin laubia, borrowed from Frankish *laubijā, from Proto-West Germanic *laub + *-jō.","livello2_varieta":"la-eme"},{"parola":"mastí","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mastiff","termine_origine":"mastin","catena":[{"codice":"fro","nome":"Old French","termine":"mastin","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"(canis) *mānsuetinus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Old French mastin, from Vulgar Latin (canis) *mānsuetinus (“tamed (dog)”), from Latin mānsuetus (“tamed”).","livello2_varieta":"la-vul"},{"parola":"oripell","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tinsel","termine_origine":"oripel","catena":[{"codice":"fro","nome":"Old French","termine":"oripel","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aurea pellis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French oripel, from Latin aurea pellis (“golden skin”).","livello2_varieta":"la"},{"parola":"paella","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"frying pan","termine_origine":"paelle","catena":[{"codice":"fro","nome":"Old French","termine":"paelle","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"patella","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"From Old French paelle (“pan”), from Latin patella (“pan”). Compare Occitan paela.","livello2_varieta":"la"},{"parola":"paisà","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a fellow countryman","termine_origine":"païsan","catena":[{"codice":"fro","nome":"Old French","termine":"païsan","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pagus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French païsan, from Latin pagus (“countryside”).","livello2_varieta":"la"},{"parola":"pitxer","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ewer, pitcher","termine_origine":"pichier","catena":[{"codice":"fro","nome":"Old French","termine":"pichier","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bīcārium","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French pichier, from Latin bīcārium. Cognate with English pitcher and beaker, from the same Latin source.","livello2_varieta":"la"},{"parola":"sarja","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"twill (pattern)","termine_origine":"sarge","catena":[{"codice":"fro","nome":"Old French","termine":"sarge","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sarica","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["moda"],"via":"","testo":"Borrowed from Old French sarge, from Vulgar Latin *sarica, from Latin sērica (“silk garments”).","livello2_varieta":"la-vul"},{"parola":"sotjar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to spy on, to watch covertly","termine_origine":"soschier","catena":[{"codice":"fro","nome":"Old French","termine":"soschier","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"suspicor","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old French soschier, from Latin suspicārī.","livello2_varieta":"la"},{"parola":"tapís","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tapestry","termine_origine":"tapiz","catena":[{"codice":"fro","nome":"Old French","termine":"tapiz","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*tappetium","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Old French tapiz, from Vulgar Latin *tappetium, from Latin tapēs, tapētem.","livello2_varieta":"la-vul"},{"parola":"treu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of sail","termine_origine":"tref","catena":[{"codice":"fro","nome":"Old French","termine":"tref","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"trabs","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"Borrowed from Old French tref, from Latin trabs. Doublet of trava.","livello2_varieta":"la"},{"parola":"xemeneia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"chimney","termine_origine":"cheminee","catena":[{"codice":"fro","nome":"Old French","termine":"cheminee","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"camīnāta","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["arte"],"via":"","testo":"Inherited from Old Catalan xemenea, from Old French cheminee, from Late Latin camīnāta.","livello2_varieta":"la-lat"}]}