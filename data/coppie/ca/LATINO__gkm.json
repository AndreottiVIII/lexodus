{"arrivo":"ca","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"gkm","livello2_nome":"Byzantine Greek","n":10,"parole":[{"parola":"ambó","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"ambo (raised platform in an early Christian church)","termine_origine":"ambo","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"ambo","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἄμβων","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin ambōnem, from Byzantine Greek ἄμβων (ámbōn, “pulpit”).","origine_varieta":"la-med"},{"parola":"arsènic","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"arsenic","termine_origine":"arsenicum","catena":[{"codice":"la","nome":"Latin","termine":"arsenicum","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἀρσενικόν","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"زرنيخ","categoria":"prestito"},{"codice":"syc","nome":"Classical Syriac","termine":"ܙܪܢܝܟܐ","categoria":"non_precisato"},{"codice":"pal","nome":"Middle Persian","termine":"","categoria":"prestito"},{"codice":"xme-old","nome":"Old Median","termine":"*zaraniyakā","categoria":"non_precisato"}],"lontana":"xme-old","ambiti":[],"via":"","testo":"Borrowed from Latin arsenicum.","origine_varieta":"la"},{"parola":"eslau","pos":"adj|noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"Slav, Slavic","termine_origine":"Slavus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"Slavus","categoria":"latinismo_dotto"},{"codice":"gkm","nome":"Byzantine Greek","termine":"Σκλάβος","categoria":"non_precisato"}],"lontana":"gkm","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin Slavus, from Late Latin Sclavus, from Byzantine Greek Σκλάβος (Sklábos), which see for more. See also the related esclau.","origi