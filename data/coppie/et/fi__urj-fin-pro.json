{"arrivo":"et","origine":"fi","origine_nome":"Finnish","livello2":"urj-fin-pro","livello2_nome":"Proto-Finnic","n":5,"parole":[{"parola":"ahm","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wolverine, glutton (Gulo gulo)","termine_origine":"ahma","catena":[{"codice":"fi","nome":"Finnish","termine":"ahma","categoria":"prestito"},{"codice":"urj-fin-pro","nome":"Proto-Finnic","termine":"*ahma","categoria":"non_precisato"}],"lontana":"urj-fin-pro","ambiti":[],"via":"","testo":"Borrowed from Finnish ahma, from Proto-Finnic *ahma."},{"parola":"hetk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"moment (in time)","termine_origine":"hetki","catena":[{"codice":"fi","nome":"Finnish","termine":"hetki","categoria":"prestito"},{"codice":"urj-fin-pro","nome":"Proto-Finnic","termine":"*hetki","categoria":"non_precisato"}],"lontana":"urj-fin-pro","ambiti":[],"via":"","testo":"Borrowed from Finnish hetki, from Proto-Finnic *hetki."},{"parola":"kuuluma","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to belong","termine_origine":"kuulua","catena":[{"codice":"fi","nome":"Finnish","termine":"kuulua","categoria":"prestito"},{"codice":"urj-fin-pro","nome":"Proto-Finnic","termine":"*kuuludak","categoria":"ereditato"}],"lontana":"urj-fin-pro","ambiti":[],"via":"","testo":"The sense \"to belong\" is borrowed from Finnish kuulua (“to belong”), while the dialectal sense \"to be heard\" is inherited from Proto-Finnic *kuuludak."},{"parola":"orb","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"orphan","termine_origine":"orpo","catena":[{"codice":"fi","nome":"Finnish","termine":"orpo","categoria":"prestito"},{"codice":"urj-fin-pro","nome":"Proto-Finnic","termine":"*orpoi","categoria":"non_precisato"},{"codice":"fiu-pro","nome":"Proto-Finno-Ugric","termine":"*orpa","categoria":"non_precisato"},{"codice":"iir-pro","nome":"Proto-Indo-Iranian","termine":"*Hár