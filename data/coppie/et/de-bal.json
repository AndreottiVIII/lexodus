{"arrivo":"et","origine":"de-bal","origine_nome":"Baltic German","n":8,"n_alternative":2,"parole":[{"parola":"kemmerg","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"toilet","termine_origine":"Kämmerchen","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Kämmerchen","categoria":"non_precisato"},{"codice":"gml","nome":"Middle Low German","termine":"","categoria":"prestito"}],"lontana":"gml","ambiti":[],"via":"","testo":"From Baltic German Kämmerchen. Possibly an older Middle Low German loan, but it is unattested. See also kamber (“chamber”), which is the affixless version of this root."},{"parola":"kukkel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bun, loaf (a small round loaf of bread)","termine_origine":"Kuckel","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Kuckel","categoria":"non_precisato"},{"codice":"bat","nome":"Baltic","termine":"","categoria":"non_precisato"}],"lontana":"bat","ambiti":["cucina"],"via":"","testo":"From dialectal or Baltic German Kuckel, ultimately from a Baltic language, compare Latvian kukulis, Lithuanian kukulys. First attested in 1869."},{"parola":"pits","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a shot glass","termine_origine":"Spitzglas","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Spitzglas","categoria":"non_precisato"}],"lontana":"de-bal","ambiti":[],"via":"","testo":"Shortened from pitsklaas or pitsiklaas, from Baltic German Spitzglas."},{"parola":"pliit","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"stove","termine_origine":"Pliete","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Pliete","categoria":"non_precisato"}],"lontana":"de-bal","ambiti":[],"via":"","testo":"From Russian плита (plita). Influenced by Baltic German Pliete, which is also a loan from Russian. Dialectal pliita, pliida are direct loans from Russian."},{"parola":"rosolje","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"a type of beetroot salad","termine_origine":"Risoll","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Risoll","categoria":"non_precisato"}],"lontana":"de-bal","ambiti":[],"via":"","testo":"From Baltic German Risoll. Ultimately possibly from Russian рассол (rassol), рассольник (rassolʹnik), or Polish rosół. See also Finnish rosolli, which refers to a very similar dish."},{"parola":"vadak","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; Possibly; modello unc/uncertain","significato":"whey (liquid remaining after milk has been curdled)","termine_origine":"Waddacke","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Waddacke","categoria":"non_precisato"},{"codice":"gml","nome":"Middle Low German","termine":"waddeke","categoria":"non_precisato"}],"lontana":"gml","ambiti":["cucina"],"via":"","testo":"Uncertain. Possibly from Baltic German Waddacke, ultimately from Middle Low German waddeke."},{"parola":"kuul","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"alternatively","significato":"ball, especially a heavy one","termine_origine":"Kugel","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Kugel","categoria":"prestito"}],"lontana":"de-bal","ambiti":[],"via":"","alternative":[{"codice":"de-bal","nome":"Baltic German","termine":"Kugel","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"kūle","categoria":"non_precisato"}],"testo":"From Baltic German Kugel, where the ⟨g⟩ was pronounced [ɣ]. Alternatively from Middle Low German kūle."},{"parola":"vunts","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"alternatively","significato":"moustache","termine_origine":"Wunzen","catena":[{"codice":"de-bal","nome":"Baltic German","termine":"Wunzen","categoria":"prestito"}],"lontana":"de-bal","ambiti":[],"via":"","alternative":[{"codice":"de-bal","nome":"Baltic German","termine":"Wunzen","categoria":"prestito"},{"codice":"pl","nome":"Polish","termine":"wąsy","categoria":"non_precisato"}],"testo":"From Baltic German Wunzen. Alternatively from Polish wąsy."}]}