ato":"bath, bathtub","termine_origine":"Wanne","catena":[{"codice":"de","nome":"German","termine":"Wanne","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vannus","categoria":"non_precisato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*watnos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂weh₁-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from German Wanne (“tub”), from Middle High German wanne, from Old High German wanna (“tub”), from Latin vannus (“a winnowing basket”), from Proto-Italic *watnos, from Proto-Indo-European *h₂weh₁- (“to blow”).","livello2_varieta":"la"},{"parola":"vein","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wine (alcoholic beverage obtained by fermentation of berry or fruit juice)","termine_origine":"Wein","catena":[{"codice":"de","nome":"German","termine":"Wein","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vīnum","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"From German Wein during the 19th century, ultimately from Latin vīnum. Doublet of viin (“vodka”). First attested in 1869.","livello2_varieta":"la"},{"parola":"virsik","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"peach","termine_origine":"Pfirsich","catena":[{"codice":"de","nome":"German","termine":"Pfirsich","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"persica","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"From German Pfirsich, ultimately from Latin persica.","livello2_varieta":"la"}]}