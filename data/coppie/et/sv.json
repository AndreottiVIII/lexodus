ito"}],"lontana":"gml","ambiti":[],"via":"","testo":"Borrowed from Swedish sticka or Middle Low German sticke. Compare Finnish tikku."},{"parola":"tubakas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tobacco","termine_origine":"tobak","catena":[{"codice":"sv","nome":"Swedish","termine":"tobak","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Tobak","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Swedish tobak or German Tobak, Tubak."},{"parola":"tups","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tuft, tassel","termine_origine":"tofs","catena":[{"codice":"sv","nome":"Swedish","termine":"tofs","categoria":"non_precisato"}],"lontana":"sv","ambiti":[],"via":"","testo":"From Swedish tofs or Estonian Swedish tωps. Compare Finnish tupsu."},{"parola":"vaar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of vanaisa","termine_origine":"far","catena":[{"codice":"sv","nome":"Swedish","termine":"far","categoria":"prestito"}],"lontana":"sv","ambiti":[],"via":"","testo":"From Swedish far."},{"parola":"ärtu","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hearts","termine_origine":"hjärter","catena":[{"codice":"sv","nome":"Swedish","termine":"hjärter","categoria":"non_precisato"},{"codice":"gml","nome":"Middle Low German","termine":"herte","categoria":"non_precisato"}],"lontana":"gml","ambiti":["sport"],"via":"","testo":"From Swedish hjärter. Less likely from Middle Low German herte, which is also seen in the archaic/poetic term härtu (“dear”). As card games were first introduced to Estonia during the Swedish era, a borrowing from Swedish seems more likely."},{"parola":"apteek","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably; or possibly","significato":"pharmacy, chemist","termine_origine":"apotek","catena":[{