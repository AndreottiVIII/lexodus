{"arrivo":"sv","origine":"fro","origine_nome":"Old French","livello2":"la","livello2_nome":"Latin","n":10,"parole":[{"parola":"dubbel","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"double","termine_origine":"double","catena":[{"codice":"fro","nome":"Old French","termine":"double","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"duplus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Swedish dobel, dobbell, dubbel, from Old French double, from Latin duplus."},{"parola":"etymologi","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"etymology (study of the history of words, a branch of linguistics)","termine_origine":"ethimologie","catena":[{"codice":"fro","nome":"Old French","termine":"ethimologie","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"etymologia","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἐτυμολογία","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Old French ethimologie, from Latin etymologia, from Ancient Greek ἐτυμολογία (etumología), from ἔτυμον (étumon, “true sense”) and -λογία (-logía, “study of”), from λόγος (lógos)."},{"parola":"kvitta","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to not matter","termine_origine":"quiter","catena":[{"codice":"fro","nome":"Old French","termine":"quiter","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"quieto","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Swedish qvitta, from Old French quiter, from Latin quiētāre. Germanic cognates include Dutch kwijten (“to quit”), Low German quitten (“to quit”), German quitten, quittieren, Danish kvitte, Icelandic kvitta."},{"parola":"not","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"note.","termine_origine":"note","ca