ece of ice, broken ice”)."},{"parola":"kenning","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kenning","termine_origine":"kenning","catena":[{"codice":"is","nome":"Icelandic","termine":"kenning","categoria":"prestito"}],"lontana":"is","ambiti":["arte"],"via":"","testo":"Borrowed from Icelandic kenning."},{"parola":"sejd","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"seiðr","termine_origine":"seiður","catena":[{"codice":"is","nome":"Icelandic","termine":"seiður","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"seiðr","categoria":"prestito"}],"lontana":"non","ambiti":["scienza"],"via":"","testo":"Borrowed from Icelandic seiður or Old Norse seiðr. First attested in 1712."},{"parola":"tölt","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tölt","termine_origine":"tölt","catena":[{"codice":"is","nome":"Icelandic","termine":"tölt","categoria":"prestito"}],"lontana":"is","ambiti":[],"via":"","testo":"Borrowed from Icelandic tölt"},{"parola":"van","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"a member of the Vanir","termine_origine":"vanir","catena":[{"codice":"is","nome":"Icelandic","termine":"vanir","categoria":"prestito"}],"lontana":"is","ambiti":["scienza"],"via":"","testo":"Borrowed from Icelandic vanir (plural). First attested in 1737."}]}