{"arrivo":"sv","origine":"non","origine_nome":"Old Norse","livello2":"ang","livello2_nome":"Old English","n":11,"parole":[{"parola":"bläck","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ink; pigment or dye for writing, printing etc","termine_origine":"blæk","catena":[{"codice":"non","nome":"Old Norse","termine":"blæk","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"blæc","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"From Old Norse blæk, from Old English blæc (“black, ink”)"},{"parola":"båt","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a boat","termine_origine":"bátr","catena":[{"codice":"non","nome":"Old Norse","termine":"bátr","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"bāt","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*bait","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":["mare"],"via":"","testo":"From Old Swedish bāter, from Old Norse bátr, from Old English bāt (“boat”), from Proto-West Germanic *bait."},{"parola":"djävul","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a devil (evil creature)","termine_origine":"djǫfull","catena":[{"codice":"non","nome":"Old Norse","termine":"djǫfull","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"dēofol","categoria":"prestito"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*diubul","categoria":"ereditato"},{"codice":"la","nome":"Latin","termine":"diabolus","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"διάβολος","categoria":"prestito"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Old Swedish diævul, from Old Norse djǫfull, ultimately from Latin diabolus, from Ancient Greek διάβολος (diábolos). Compare Danish djævel, Norwegian djevel, Icelandic djöfull, English devil, Dutch duivel, German Teufel."},{"parola":"engelsk","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"English; of or pertaining to England.","termine_origine":"engilskr","catena":[{"codice":"non","nome":"Old Norse","termine":"engilskr","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"Englisc","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"From Old Norse engilskr, enskr, \"English\", from Old English Englisc, from engle, angle, \"Angles\"."},{"parola":"hird","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"bodyguard for chieftain or king","termine_origine":"hirð","catena":[{"codice":"non","nome":"Old Norse","termine":"hirð","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"hīred","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*hīwarād","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"From Old Swedish hirþ (“bodyguard”), from Old Norse hirð, a borrowing from Old English hīred, from Proto-West Germanic *hīwarād (“relationship; family”). Related to German Heirat (“wedding”) and English hired. See also Icelandic hirð."},{"parola":"kyrka","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a church (building)","termine_origine":"kirkja","catena":[{"codice":"non","nome":"Old Norse","termine":"kirkja","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"cirice","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*kirikā","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"κυριακόν (δόμα)","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["religione"],"via":"","testo":"From Old Swedish kyrkia, kirkia, from Old Norse kirkja, from Old English cirice, from Late Proto-West Germanic *kirikā, from Byzantine Greek κυριακόν (δόμα) (kuriakón (dóma), literally “Lord's (house)”), from Ancient Greek κύριος (kúrios, “lord”)."},{"parola":"kål","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cabbage; edible plants of the species Brassica oleracea; more generally any plant in the genus Brassica","termine_origine":"kál","catena":[{"codice":"non","nome":"Old Norse","termine":"kál","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"cawel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"caulis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"καυλός","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kaw(ǝ)l","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Swedish kāl, from Old Norse kál, from Old English cawel, caul, cāl, from Latin caulis, from Ancient Greek καυλός (kaulós, “stem”), from Proto-Indo-European *kaw(ǝ)l or *kowos."},{"parola":"munk","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a monk","termine_origine":"munkr","catena":[{"codice":"non","nome":"Old Norse","termine":"munkr","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"munuc","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Mönch","categoria":"prestito"}],"lontana":"de","ambiti":["religione","sport"],"via":"","testo":"Inherited from Old Swedish munker, from Old Norse munkr, from Old English munuc. In pastry sense; debated. According to some a comparison with the tonsure of medieval monks. According to others, and more probable according to historian Harrison, a comparison to the bodily roundness of monks. In prin"},{"parola":"pryda","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"decorate, adorn, grace","termine_origine":"prýða","catena":[{"codice":"non","nome":"Old Norse","termine":"prýða","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"prūd","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"From Old Swedish prydha, from Old Norse prýða, probably a borrowing from Old English prūd (“proud, noble”). Compare Danish pryde."},{"parola":"såpa","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to rub with soft soap (especially to make very slippery)","termine_origine":"sápa","catena":[{"codice":"non","nome":"Old Norse","termine":"sápa","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"sāpe","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*saipǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From late Old Norse sápa, from Old English sāpe, from Proto-Germanic *saipǭ."},{"parola":"ärke-","pos":"prefix","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"arch- (describing seniority or superiority)","termine_origine":"erki-","catena":[{"codice":"non","nome":"Old Norse","termine":"erki-","categoria":"ereditato"},{"codice":"ang","nome":"Old English","termine":"ærce-","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"archi-","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀρχι-","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Old Swedish ærke-, from Old Norse erki-, from Old English ærce-, from Latin archi-, from Ancient Greek ἀρχι- (arkhi-)."}]}