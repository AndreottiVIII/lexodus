,"categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"conductus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian condottiere, from condotto, from Latin conductus. Doublet of konduktör.","livello2_varieta":"la"},{"parola":"kujonera","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bully, demean","termine_origine":"coglione","catena":[{"codice":"it","nome":"Italian","termine":"coglione","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cōleus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Derived from Italian coglione, from Latin cōleus. By surface analysis, kujon + -era. Cognate of Danish kujonere, German kujonieren, Dutch koeioneren, French couillonner.","livello2_varieta":"la"},{"parola":"melon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"melon","termine_origine":"melone","catena":[{"codice":"it","nome":"Italian","termine":"melone","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"melo","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["cucina"],"via":"","testo":"Borrowed from Italian melone, from Late Latin mēlō, mēlōnem.","livello2_varieta":"la-lat"},{"parola":"motto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a motto","termine_origine":"motto","catena":[{"codice":"it","nome":"Italian","termine":"motto","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"muttum","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Italian motto, from Late Latin muttum.","livello2_varieta":"la-lat"},{"parola":"pari","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"par (value equalling the face value)","termine_origine":"pari","catena":[{"codice":"it","nome":"Italian","termine":"pari","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pār","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"Borrowed from Italian pari, from Latin pār (“equal”).","livello2_varieta":"la"},{"parola":"sardell","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"anchovy, Engraulis encrasicolus","termine_origine":"sardella","catena":[{"codice":"it","nome":"Italian","termine":"sardella","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sarda","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian sardella, from Latin sarda. Doublet of sard, sardin, and Sardinien.","livello2_varieta":"la"},{"parola":"sardin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pilchard (Sardina pilchardus)","termine_origine":"sardina","catena":[{"codice":"it","nome":"Italian","termine":"sardina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sarda","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian sardina, from Latin sarda. Doublet of sard, sardell, and Sardinien.","livello2_varieta":"la"},{"parola":"skala","pos":"noun|verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"a scale; ordered numerical sequence","termine_origine":"scala","catena":[{"codice":"it","nome":"Italian","termine":"scala","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"scala","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza","informatica"],"via":"","testo":"Borrowed from Italian scala, from Latin scala (see there for more). Attested since 1636. Compare Norwegian and Danish skala, German Skala, English scale. Related to echelong, eskalera, schalad, skalär, skandera.","livello2_varieta":"la"},{"parola":"studio","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"studio","termine_origine":"studio","catena":[{"codice":"it","nome":"Italian","termine":"studio","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"studium","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian studio, from Latin studium.","livello2_varieta":"la"},{"parola":"tempo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pace, tempo","termine_origine":"tempo","catena":[{"codice":"it","nome":"Italian","termine":"tempo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tempus","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica","sport"],"via":"","testo":"Borrowed from Italian tempo, from Latin tempus (“time”).","livello2_varieta":"la"},{"parola":"tivoli","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"an amusement park","termine_origine":"Tivoli","catena":[{"codice":"it","nome":"Italian","termine":"Tivoli","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"Tībur","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"After the Jardin de Tivoli in Paris, in turn from Italian Tivoli (a city in Lazio), from Latin Tībur.","livello2_varieta":"la"},{"parola":"villa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a villa, a house (free-standing family house of any size but the very smallest)","termine_origine":"villa","catena":[{"codice":"it","nome":"Italian","termine":"villa","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"villa","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian villa, from Latin villa.","livello2_varieta":"la"},{"parola":"virtuos","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a virtuoso (person with outstanding ability, especially musical ability, but also more general)","termine_origine":"virtuoso","catena":[{"codice":"it","nome":"Italian","termine":"virtuoso","categoria":"prestito"},{"codice":"la-lat","nome":"Late Lat