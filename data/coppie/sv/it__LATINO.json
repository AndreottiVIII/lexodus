{"arrivo":"sv","origine":"it","origine_nome":"Italian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":20,"parole":[{"parola":"altan","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a deck (adjoining a building – like a porch / veranda without a roof, with or without a railing)","termine_origine":"altana","catena":[{"codice":"it","nome":"Italian","termine":"altana","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"altus","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"From Italian altana (“balcony”), from alto, from Latin altus (“high”).","livello2_varieta":"la"},{"parola":"aria","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"an aria","termine_origine":"aria","catena":[{"codice":"it","nome":"Italian","termine":"aria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"āēr","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾱ̓ήρ","categoria":"prestito"},{"codice":"grk-pro","nome":"Proto-Hellenic","termine":"*auhḗr","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂ewsér","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian aria.","livello2_varieta":"la"},{"parola":"biennal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"biennial, biennale","termine_origine":"biennale","catena":[{"codice":"it","nome":"Italian","termine":"biennale","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"biennalis","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["arte"],"via":"","testo":"Borrowed from Italian biennale, from Late Latin biennalis.","livello2_varieta":"la-lat"},{"parola":"dukat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ducat (gold coin)","termine_origine":"ducato","catena":[{"codice":"it","nome":"Italian","t