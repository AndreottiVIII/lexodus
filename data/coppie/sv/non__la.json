{"arrivo":"sv","origine":"non","origine_nome":"Old Norse","livello2":"la","livello2_nome":"Latin","n":20,"parole":[{"parola":"biskop","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a bishop (church official)","termine_origine":"biskup","catena":[{"codice":"non","nome":"Old Norse","termine":"biskup","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"episcopus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἐπίσκοπος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"From Old Swedish biskoper, biskuper (with more spellings), from Old Norse biskup, from Latin episcopus (“overseer, supervisor”), from Ancient Greek ἐπίσκοπος (epískopos, “overseer”)."},{"parola":"brev","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a letter (written communication)","termine_origine":"bréf","catena":[{"codice":"non","nome":"Old Norse","termine":"bréf","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"breve","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Norse bréf, from Latin breve (“breve scriptum”)."},{"parola":"djäkne","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"male pupil","termine_origine":"djákni","catena":[{"codice":"non","nome":"Old Norse","termine":"djákni","categoria":"ereditato"},{"codice":"la","nome":"Latin","termine":"diāconus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"διᾱ́κονος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Old Swedish diækn, diækne, from Old Norse djákni, from Latin diāconus, from Ancient Greek διᾱ́κονος (diā́konos, “servant”). Doublet of diakon."},{"parola":"kamel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"camel (especially the Bactrian camel, Camelus bactrianus)","termine_origin