n","termine":"poena","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ποινή","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Old Swedish pina, from Old Norse pína, from Latin poena, from Ancient Greek ποινή (poinḗ). Cognate of Danish pine, Icelandic pína, German Pein. Compare origin of English pain, French peine."},{"parola":"port","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a larger entrance","termine_origine":"port","catena":[{"codice":"non","nome":"Old Norse","termine":"port","categoria":"ereditato"},{"codice":"la","nome":"Latin","termine":"porta","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza","informatica"],"via":"","testo":"From late Old Norse port n, portr m, from Latin porta f. Computing sense a semantic loan from English."},{"parola":"psalm","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"a hymn, a church song","termine_origine":"salmr","catena":[{"codice":"non","nome":"Old Norse","termine":"salmr","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"psalmus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ψαλμός","categoria":"non_precisato"}],"lontana":"grc","ambiti":["musica"],"via":"","testo":"From Old Swedish salmber, psalmber, from Old Norse salmr, psalmr, from Latin psalmus, from Ancient Greek ψαλμός (psalmós, “the sound emenating from twitching or twanging perhaps with the hands or fingers, mostly of musical strings”)."},{"parola":"socka","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"a sock (especially a thicker or shorter one – compare strumpa)","termine_origine":"sokkr","catena":[{"codice":"non","nome":"Old Norse","termine":"sokkr","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"soccus","categoria":"non_precisato"},{"