:"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from German Viktualien, derived from Latin victualia. First attested in 1579.","livello2_varieta":"la"},{"parola":"vändkrets","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tropic","termine_origine":"Wendekreis","catena":[{"codice":"de","nome":"German","termine":"Wendekreis","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"circulus tropicus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κύκλος τροπικός","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"vända + krets. From German Wendekreis, from Latin circulus tropicus, from Ancient Greek κύκλος τροπικός (kúklos tropikós).","livello2_varieta":"la"}]}