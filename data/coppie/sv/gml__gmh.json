{"arrivo":"sv","origine":"gml","origine_nome":"Middle Low German","livello2":"gmh","livello2_nome":"Middle High German","n":5,"parole":[{"parola":"ganska","pos":"adv","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pretty, quite, rather","termine_origine":"gans","catena":[{"codice":"gml","nome":"Middle Low German","termine":"gans","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"ganz","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*gant","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"From Middle Low German gans, gansch, from Middle High German ganz, from Old High German ganz, from Proto-West Germanic *gant."},{"parola":"kurbits","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a style of decorative floral painting with large, fantastical flowers, especially associated with Dalecarlia","termine_origine":"körvitz","catena":[{"codice":"gml","nome":"Middle Low German","termine":"körvitz","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"kürbiz","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*kurbit","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"Borrowed from Middle Low German körvitz, itself borrowed from Middle High German kürbiz, from Old High German kurbiz, from Proto-West Germanic *kurbit."},{"parola":"socker","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"sugar; sucrose in the form of small crystals","termine_origine":"sucker","catena":[{"codice":"gml","nome":"Middle Low German","termine":"sucker","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"zucker","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"zucchero","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"سُكَّر","categoria":"prest