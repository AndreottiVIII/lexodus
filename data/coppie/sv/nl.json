{"arrivo":"sv","origine":"nl","origine_nome":"Dutch","n":69,"parole":[{"parola":"afrikaans","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Afrikaans (language)","termine_origine":"Afrikaans","catena":[{"codice":"nl","nome":"Dutch","termine":"Afrikaans","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch Afrikaans."},{"parola":"aktie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"share, stock (US)","termine_origine":"actie","catena":[{"codice":"nl","nome":"Dutch","termine":"actie","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"āctiō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Dutch actie, from Latin āctiō. Cognate of German Aktie. Doublet of akt and aktion."},{"parola":"babord","pos":"adv|noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"aport, on the left side of a vessel","termine_origine":"bakboord","catena":[{"codice":"nl","nome":"Dutch","termine":"bakboord","categoria":"calco"}],"lontana":"nl","ambiti":[],"via":"","testo":"From bak (“back, behind”) + bord (“bord, side of ship”), i.e. the side you turned your back to when steering the vessel as the steering oar was on starboard side. Calque of Dutch bakboord. First attested in 1691."},{"parola":"bambu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bamboo (plant; material)","termine_origine":"bamboe","catena":[{"codice":"nl","nome":"Dutch","termine":"bamboe","categoria":"prestito"},{"codice":"pt","nome":"Portuguese","termine":"bambu","categoria":"non_precisato"},{"codice":"ms","nome":"Malay","termine":"bambu","categoria":"non_precisato"},{"codice":"kn","nome":"Kannada","termine":"ಬಮ್ಬು","categoria":"non_precisato"}],"lontana":"kn","ambiti":[],"via":"","testo":"From Dutch bamboe, from Portuguese bambu, from Malay bambu, from Kannada ಬಮ್ಬು (bambu)."},{"parola":"bank","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a bank (financial institution, branch of such an institution)","termine_origine":"bank","catena":[{"codice":"nl","nome":"Dutch","termine":"bank","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Bank","categoria":"non_precisato"},{"codice":"nds","nome":"Low German","termine":"bank","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"banco","categoria":"non_precisato"},{"codice":"goh","nome":"Old High German","termine":"banc","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*banki","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bankiz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["finanza"],"via":"","testo":"From Dutch bank, German Bank or Low German bank, all from Italian banco, from Old High German banc, from Proto-West Germanic *banki, from Proto-Germanic *bankiz."},{"parola":"bark","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"barque (type of ship)","termine_origine":"bark","catena":[{"codice":"nl","nome":"Dutch","termine":"bark","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"barque","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed from Dutch bark, from French barque."},{"parola":"bedarra","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to calm, to fade, to weaken, to blow over (of a storm or strong wind)","termine_origine":"bedaren","catena":[{"codice":"nl","nome":"Dutch","termine":"bedaren","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"be- + darra, from Low German or Dutch bedaren, used in Swedish since 1765."},{"parola":"blaj","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"nonsense, (silly) crap, mumbo jumbo","termine_origine":"blaai","catena":[{"codice":"nl","nome":"Dutch","termine":"blaai","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Possibly borrowed from Dutch blaai (“noise, commotion”), from or related to Middle Dutch blayen (“to blow, flutter”)."},{"parola":"blomkål","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cauliflower","termine_origine":"bloemkool","catena":[{"codice":"nl","nome":"Dutch","termine":"bloemkool","categoria":"prestito"}],"lontana":"nl","ambiti":["cucina"],"via":"","testo":"Borrowed from Dutch bloemkool."},{"parola":"bogsera","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to tow, to haul","termine_origine":"boegseren","catena":[{"codice":"nl","nome":"Dutch","termine":"boegseren","categoria":"prestito"},{"codice":"pt","nome":"Portuguese","termine":"puxar","categoria":"non_precisato"}],"lontana":"pt","ambiti":[],"via":"","testo":"Borrowed from Dutch boegseren, from Portuguese puxar (“to pull”)."},{"parola":"bornera","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fizz, effervesce","termine_origine":"borneeren","catena":[{"codice":"nl","nome":"Dutch","termine":"borneeren","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From archaic Dutch borneeren, from Dutch born (“spring”). Compare bronwater (“mineral water”)."},{"parola":"by","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"gust, rush of wind","termine_origine":"bui","catena":[{"codice":"nl","nome":"Dutch","termine":"bui","categoria":"non_precisato"},{"codice":"nds","nome":"Low German","termine":"bö","categoria":"non_precisato"}],"lontana":"nds","ambiti":[],"via":"","testo":"From Dutch bui or Low German bö, böe, böje. Cognate with Danish byge, Norwegian Bokmål byge, bøye and Norwegian Nynorsk bye, bøye."},{"parola":"börs","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stock market, stock exchange, bourse","termine_origine":"beurs","catena":[{"codice":"nl","nome":"Dutch","termine":"beurs","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch beurs."},{"parola":"dagg","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Unknown","significato":"rope's end","termine_origine":"dag","catena":[{"codice":"nl","nome":"Dutch","termine":"dag","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch dag, further origin unknown. Compare French dague."},{"parola":"durk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"deck; floor of a ship","termine_origine":"durk","catena":[{"codice":"nl","nome":"Dutch","termine":"durk","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"dork","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*dalk","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch durk or Middle Low German dork, both possibly ultimately from Proto-West Germanic *dalk. Further origin dubious. Cognate of Norwegian Bokmål dørk."},{"parola":"däck","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tyre","termine_origine":"dek","catena":[{"codice":"nl","nome":"Dutch","termine":"dek","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"From Dutch dek (“cover, surface”)."},{"parola":"ebb","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ebb, low tide","termine_origine":"","catena":[{"codice":"nl","nome":"Dutch","termine":"","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Ebbe","categoria":"prestito"}],"lontana":"de","ambiti":[],"via":"","testo":"From Dutch or German Ebbe."},{"parola":"fallrep","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"either","significato":"accommodation ladder","termine_origine":"valreep","catena":[{"codice":"nl","nome":"Dutch","termine":"valreep","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch valreep. By surface analysis, fall + rep. Originally about the two ropes on either side of the ladder. Cognate of Danish faldereb, German Fallreep."},{"parola":"fika","pos":"noun|verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"having coffee, tea, saft (“cordial, squash”), or the like, usually with cookies, pastries, or other (sweet) snacks, usu…","termine_origine":"koffie","catena":[{"codice":"nl","nome":"Dutch","termine":"koffie","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"This sense is attested in writing from 1910. One possible explanation is that the word is formed by backslang of the syllables in the dialectal word kaffi (“coffee”), from Dutch koffie or a similar source. Another possible etymology is that it is derived from the older verb fika (desire, crave – see"},{"parola":"förtöja","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to moor, to tie up (to a fixed point above water)","termine_origine":"vertuien","catena":[{"codice":"nl","nome":"Dutch","termine":"vertuien","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch vertuien (or Middle Low German vortoien), from Dutch tuien. Cognate of Danish fortøje. Original sense was likely close to \"tie up\". See also German vertäuen."},{"parola":"gas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gas; a state of matter","termine_origine":"gas","catena":[{"codice":"nl","nome":"Dutch","termine":"gas","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch gas."},{"parola":"genever","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jenever","termine_origine":"jenever","catena":[{"codice":"nl","nome":"Dutch","termine":"jenever","categoria":"prestito"},{"codice":"fro","nome":"Old French","termine":"genevre","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"From Dutch jenever, from Old French genevre."},{"parola":"gira","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to yaw, to turn","termine_origine":"gieren","catena":[{"codice":"nl","nome":"Dutch","termine":"gieren","categoria":"prestito"},{"codice":"nds","nome":"Low German","termine":"giren","categoria":"prestito"}],"lontana":"nds","ambiti":["mare","finanza","scienza"],"via":"","testo":"Borrowed from Dutch gieren (“to yaw”) or Low German giren. First attested in 1690. Cognate of German gieren (“to yaw”), Danish gire, and Norwegian geira (“go wrong”)."},{"parola":"haj","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"shark","termine_origine":"haai","catena":[{"codice":"nl","nome":"Dutch","termine":"haai","categoria":"non_precisato"},{"codice":"vls","nome":"West Flemish","termine":"haaie","categoria":"non_precisato"}],"lontana":"vls","ambiti":[],"via":"","testo":"From Dutch haai or West Flemish haaie (formerly spelt haeye). Cognate with English haye, German Hai."},{"parola":"harpun","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a harpoon","termine_origine":"harpoen","catena":[{"codice":"nl","nome":"Dutch","termine":"harpoen","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"harpon","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"harpago","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Dutch harpoen, from Old French harpon, from harpe (“dog's claw”), from Latin harpago (“grappling hook”)."},{"parola":"has","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hindleg, back leg of an animal","termine_origine":"haas","catena":[{"codice":"nl","nome":"Dutch","termine":"haas","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch haas."},{"parola":"hissa","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to hoist (raise with ropes or the like)","termine_origine":"hijsen","catena":[{"codice":"nl","nome":"Dutch","termine":"hijsen","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"","categoria":"prestito"}],"lontana":"gml","ambiti":[],"via":"","testo":"From Dutch hijsen or Middle Low German hissen."},{"parola":"hushåll","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"a household, a home","termine_origine":"huishoud","catena":[{"codice":"nl","nome":"Dutch","termine":"huishoud","categoria":"calco"}],"lontana":"nl","ambiti":[],"via":"","testo":"Calque of Dutch huishoud or Middle Low German husholt; equivalent to hus + håll."},{"parola":"häck","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"upper part of transom","termine_origine":"hek","catena":[{"codice":"nl","nome":"Dutch","termine":"hek","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch hek (“stern”)"},{"parola":"hängmatta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A hammock; a bed of cloth or net suspended between two trees or poles.","termine_origine":"hangmat","catena":[{"codice":"nl","nome":"Dutch","termine":"hangmat","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"hamaca","categoria":"non_precisato"},{"codice":"tnq","nome":"Taíno","termine":"amaca, *hamaka","categoria":"non_precisato"}],"lontana":"tnq","ambiti":[],"via":"","testo":"Borrowed from Dutch hangmat, by folk etymology reinterpreted as hänga (“hang”) + matta (“rug”). Ultimately derived from Spanish hamaca, from Taíno amaca, *hamaka. Compare origin of French hamac and German Hängematte. First attested in 1679. Doublet of hammock (“hammock; canopy swing”)."},{"parola":"kackerlacka","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cockroach","termine_origine":"kakkerlak","catena":[{"codice":"nl","nome":"Dutch","termine":"kakkerlak","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch kakkerlak, compare Icelandic kakkalakki."},{"parola":"kalfatra","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"caulk","termine_origine":"kalefateren","catena":[{"codice":"nl","nome":"Dutch","termine":"kalefateren","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"calafatare","categoria":"non_precisato"}],"lontana":"it","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch kalefateren, from Italian calafatare. Cognate with German kalfatern, French calfater."},{"parola":"kapa","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to hijack; to seize control over something","termine_origine":"kapen","catena":[{"codice":"nl","nome":"Dutch","termine":"kapen","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch kapen."},{"parola":"kavaj","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lounge jacket","termine_origine":"kabaai","catena":[{"codice":"nl","nome":"Dutch","termine":"kabaai","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"kebaya","categoria":"prestito"},{"codice":"pt","nome":"Portuguese","termine":"cabaia","categoria":"prestito"},{"codice":"si","nome":"Sinhalese","termine":"කබාය","categoria":"prestito"}],"lontana":"si","ambiti":[],"via":"","testo":"From Dutch kabaai, kabaja, a jacket worn in Indonesia over a sarong. From Malay kebaya, from Arabic قَبَايَة (qabāya), colloquial form of قَبَاء (qabāʔ, “tunic, gown”)."},{"parola":"krapp","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"madder (Rubia tinctoria)","termine_origine":"krap","catena":[{"codice":"nl","nome":"Dutch","termine":"krap","categoria":"prestito"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*krappō","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"Borrowed from Dutch krap, from Middle Dutch crappe, from Proto-West Germanic *krappō (“hook”)."},{"parola":"kryssa","pos":"verb","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"to write an x in a fill-in box","termine_origine":"kruisen","catena":[{"codice":"nl","nome":"Dutch","termine":"kruisen","categoria":"calco"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Calque of Dutch kruisen. By surface analysis, kryss + -a. Nautical sense attested since 1823, marking sense attested since 1931."},{"parola":"kryssare","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"cruiser","termine_origine":"kruiser","catena":[{"codice":"nl","nome":"Dutch","termine":"kruiser","categoria":"calco"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Calque of Dutch kruiser. By surface analysis, kryssa + -are. Cognate of Danish krydser and German Kreuzer."},{"parola":"kultje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"strong breeze, moderate gale (number 6 to 7 winds on the 12-step Beaufort scale)","termine_origine":"koeltje","catena":[{"codice":"nl","nome":"Dutch","termine":"koeltje","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch koeltje."},{"parola":"kätting","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"thick chain","termine_origine":"ketting","catena":[{"codice":"nl","nome":"Dutch","termine":"ketting","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch ketting."},{"parola":"laber","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"weak, moderate","termine_origine":"labber","catena":[{"codice":"nl","nome":"Dutch","termine":"labber","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch labber."},{"parola":"lov","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"a turn, a round","termine_origine":"loef","catena":[{"codice":"nl","nome":"Dutch","termine":"loef","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch loef."},{"parola":"lova","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"to turn a sailing boat more towards the wind","termine_origine":"loeven","catena":[{"codice":"nl","nome":"Dutch","termine":"loeven","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch loeven, from loef (“windward side”). Cognate with Danish luve."},{"parola":"luffa","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"","termine_origine":"loeven","catena":[{"codice":"nl","nome":"Dutch","termine":"loeven","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch loeven or English luff."},{"parola":"makrill","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mackerel, Scomber scombrus","termine_origine":"makreel","catena":[{"codice":"nl","nome":"Dutch","termine":"makreel","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch makreel."},{"parola":"mall","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a template","termine_origine":"mal","catena":[{"codice":"nl","nome":"Dutch","termine":"mal","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch mal."},{"parola":"matjessill","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"matjes herring","termine_origine":"maatjesharing","catena":[{"codice":"nl","nome":"Dutch","termine":"maatjesharing","categoria":"calco"}],"lontana":"nl","ambiti":[],"via":"","testo":"Calque of Dutch maatjesharing. First part related to Dutch maagd (“maiden”), second part from sill."},{"parola":"matros","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"seaman, sailor","termine_origine":"matroos","catena":[{"codice":"nl","nome":"Dutch","termine":"matroos","categoria":"prestito"},{"codice":"frm","nome":"Middle French","termine":"matelot","categoria":"non_precisato"},{"codice":"dum","nome":"Middle Dutch","termine":"mattenoot","categoria":"non_precisato"}],"lontana":"dum","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch matroos, from Middle French matelots pl (“sailors”), from Old French matenot (“sailor, bunkmate”), likely from Middle Dutch mattenoot. Possibly a compound of a word for \"mat\" or \"food\" together with an old cognate of German Genosse, thus \"bunk mate\" or \"food mate\". Possibly cogna"},{"parola":"moj","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calm","termine_origine":"mooi","catena":[{"codice":"nl","nome":"Dutch","termine":"mooi","categoria":"prestito"}],"lontana":"nl","ambiti":["scienza"],"via":"","testo":"Borrowed from Dutch mooi (“beautiful”)."},{"parola":"mops","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pug","termine_origine":"mops","catena":[{"codice":"nl","nome":"Dutch","termine":"mops","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Low German or Dutch mops, used in Swedish since 1733."},{"parola":"palla","pos":"verb|intj","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"To have enough strength, will, or stamina for something.","termine_origine":"pal staan","catena":[{"codice":"nl","nome":"Dutch","termine":"pal staan","categoria":"prestito"},{"codice":"nds","nome":"Low German","termine":"pall staan","categoria":"non_precisato"}],"lontana":"nds","ambiti":[],"via":"","testo":"Affix of pall + -ar, from stå pall (“stand firm”). Borrowed from Dutch pal staan, from Low German pall staan. Interjection sense possibly an ellipsis of the negative pallar inte (\"do not have energy/stamina/will\")."},{"parola":"presenning","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; nodo incerto nell'albero","significato":"a tarpaulin, a tarp","termine_origine":"presenning","catena":[{"codice":"nl","nome":"Dutch","termine":"presenning","categoria":"prestito"},{"codice":"pt","nome":"Portuguese","termine":"percinta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"praecingō","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Dutch presenning, possibly borrowed from Portuguese percinta, from Latin praecingō, from prae- + cingō."},{"parola":"rabatt","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"a flowerbed","termine_origine":"rabat","catena":[{"codice":"nl","nome":"Dutch","termine":"rabat","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch rabat."},{"parola":"rotting","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"any of several species of climbing palm of the genus Calamus; rattan","termine_origine":"rotting","catena":[{"codice":"nl","nome":"Dutch","termine":"rotting","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"rotang","categoria":"non_precisato"}],"lontana":"ms","ambiti":[],"via":"","testo":"From Dutch rotting, rotan, from Malay rotang."},{"parola":"ryttare","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"a rider (a mounted person)","termine_origine":"ruiter","catena":[{"codice":"nl","nome":"Dutch","termine":"ruiter","categoria":"calco"},{"codice":"gml","nome":"Middle Low German","termine":"","categoria":"non_precisato"}],"lontana":"gml","ambiti":["agricoltura"],"via":"dum","testo":"Calque of Dutch ruiter (via Middle Dutch or Middle Low German), equivalent to rida (“to ride”) + -are (“-er”). Compare Danish rytter, German Reuter."},{"parola":"rädisa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"radish (plant)","termine_origine":"radijs","catena":[{"codice":"nl","nome":"Dutch","termine":"radijs","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch radijs"},{"parola":"sjabbig","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; Possibly","significato":"shabby, scruffy","termine_origine":"schabbig","catena":[{"codice":"nl","nome":"Dutch","termine":"schabbig","categoria":"prestito"},{"codice":"en","nome":"English","termine":"shabby","categoria":"prestito"}],"lontana":"en","ambiti":[],"via":"","testo":"Uncertain. Likely from a dialectal variant of sabba (compare sjabbla). Possibly borrowed from Dutch schabbig or English shabby. Compare with origin of skabbig."},{"parola":"sjåare","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"worker","termine_origine":"sjouwer","catena":[{"codice":"nl","nome":"Dutch","termine":"sjouwer","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch sjouwer, agent noun of sjouwen. Cognate of English shover. By surface analysis, sjåa + -are."},{"parola":"skoja","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to travel around in freedom without a plan or profession, to run around in a playful manner, to fool around","termine_origine":"schooien","catena":[{"codice":"nl","nome":"Dutch","termine":"schooien","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"Cognate with Danish skøje, from Dutch schooien, used in Swedish since 1766"},{"parola":"slitage","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wear and tear (deterioration from ordinary use)","termine_origine":"slijtage","catena":[{"codice":"nl","nome":"Dutch","termine":"slijtage","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch slijtage, equivalent to slita with an ending reminiscent of läckage. Compare Norwegian slitasje."},{"parola":"smurf","pos":"noun|intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"smurf","termine_origine":"smurf","catena":[{"codice":"nl","nome":"Dutch","termine":"smurf","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"schtroumpf","categoria":"non_precisato"}],"lontana":"fr","ambiti":["arte"],"via":"","testo":"Borrowed from Dutch smurf, from French schtroumpf."},{"parola":"spant","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a frame, a rib (beam running from the keel (bottom) to the gunwale (top edge) of a boat, sometimes also of longitudinal…","termine_origine":"spant","catena":[{"codice":"nl","nome":"Dutch","termine":"spant","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch spant. Doublet of spänna."},{"parola":"stiltje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"either","significato":"calm, lull (period with no wind)","termine_origine":"stilte","catena":[{"codice":"nl","nome":"Dutch","termine":"stilte","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"From Dutch stilte. Either influenced by Dutch stilletjes, or by Swedish kultje (itself from Dutch koeltje, diminutive of koelte). Cognate of English still."},{"parola":"stå pall","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to manage to withstand stresses; to hold up, to stand up, to stand firm, etc.","termine_origine":"pal staan","catena":[{"codice":"nl","nome":"Dutch","termine":"pal staan","categoria":"prestito"},{"codice":"nds","nome":"Low German","termine":"pall staan","categoria":"non_precisato"}],"lontana":"nds","ambiti":[],"via":"","testo":"Compound of stå (“stand”) + pall (“catch; stopping mechanism”). Borrowed from Dutch pal staan (“stand firm”), from Low German pall staan."},{"parola":"svaja","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sway (swing back and forth)","termine_origine":"zwaaien","catena":[{"codice":"nl","nome":"Dutch","termine":"zwaaien","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"swaien","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"Borrowed from Dutch zwaaien or Middle Low German swaien."},{"parola":"tamp","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The end, or end piece, of a rope","termine_origine":"tamp","catena":[{"codice":"nl","nome":"Dutch","termine":"tamp","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Likely from Dutch tamp."},{"parola":"vaja","pos":"verb","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"to rock, to sway; slowly and gently move back and forth, usually moved by wind or water","termine_origine":"waaien","catena":[{"codice":"nl","nome":"Dutch","termine":"waaien","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wēaną","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂weh₁-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Dutch waaien, from Proto-Germanic *wēaną, from Proto-Indo-European *h₂weh₁-."},{"parola":"vant","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shroud: a rope or cable serving to support the mast sideways","termine_origine":"want","catena":[{"codice":"nl","nome":"Dutch","termine":"want","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"From Dutch want (“rigging”)."},{"parola":"våffla","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a waffle (flat pastry)","termine_origine":"wafel","catena":[{"codice":"nl","nome":"Dutch","termine":"wafel","categoria":"prestito"},{"codice":"de","nome":"German","termine":"wabe","categoria":"prestito"},{"codice":"frm","nome":"Middle French","termine":"vaufre","categoria":"prestito"}],"lontana":"frm","ambiti":[],"via":"","testo":"Borrowed from Dutch wafel (“waffle”) from Middle Dutch wāfel (“waffle”) derivating from a Middle Dutch word corresponding to German wabe (“honey comb”) with roots in Middle French vaufre (“weaving”). Attested in Swedish since 1642."},{"parola":"äntra","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"board (enter a ship)","termine_origine":"enteren","catena":[{"codice":"nl","nome":"Dutch","termine":"enteren","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"entrer","categoria":"non_precisato"}],"lontana":"fr","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch enteren, from French entrer. Doublet of entré."}]}