":[{"codice":"gml","nome":"Middle Low German","termine":"rar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rarus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle Low German rar, ultimately borrowed from Latin rarus. False friend of Norwegian rar, Danish rar and English rare, although being etymologically related to all of them."},{"parola":"ros","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a rose (flower, shrub, or heraldic charge)","termine_origine":"rose","catena":[{"codice":"gml","nome":"Middle Low German","termine":"rose","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"rosa","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Swedish ros‚ from Middle Low German rose, from Latin rosa."},{"parola":"simpel","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"very easy; trivial","termine_origine":"simpel","catena":[{"codice":"gml","nome":"Middle Low German","termine":"simpel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"simplex","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Swedish simpel, from Middle Low German simpel, from Latin simplex."},{"parola":"spont","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"slat, tongue (part of a board or plank which fits into a groove)","termine_origine":"spunt","catena":[{"codice":"gml","nome":"Middle Low German","termine":"spunt","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"expūnctum","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"From Middle Low German spunt, ultimately from Latin expūnctum."},{"parola":"stat","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A state; a nation.","termine_origine":"stat","catena":[{"codice":"gml","nome":"Middle Low German","termine":"stat","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"status","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle Low German stat, from Latin status."}]}