timologia":1,"categoria":"prestito","incerta":"no","significato":"properties, props","termine_origine":"реквизи́т","catena":[{"codice":"ru","nome":"Russian","termine":"реквизи́т","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"requīsītus","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Borrowed from Russian реквизи́т (rekvizít), from Latin requīsītus. Compare Belarusian рэквізі́т (rekvizít), Polish rekwizyt."}]}