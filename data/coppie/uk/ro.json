{"arrivo":"uk","origine":"ro","origine_nome":"Romanian","n":22,"n_alternative":0,"parole":[{"parola":"барза","traslitterazione":"bárza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stork","termine_origine":"barză","catena":[{"codice":"ro","nome":"Romanian","termine":"barză","categoria":"prestito"}],"lontana":"ro","ambiti":[],"via":"","testo":"Borrowed from Romanian barză."},{"parola":"бриндза","traslitterazione":"brýndza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bryndza","termine_origine":"brânză","catena":[{"codice":"ro","nome":"Romanian","termine":"brânză","categoria":"prestito"}],"lontana":"ro","ambiti":["cucina"],"via":"","testo":"Borrowed from Romanian brânză."},{"parola":"бринза","traslitterazione":"brýnza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bryndza","termine_origine":"brânză","catena":[{"codice":"ro","nome":"Romanian","termine":"brânză","categoria":"prestito"}],"lontana":"ro","ambiti":["cucina"],"via":"","testo":"Borrowed from Romanian brânză."},{"parola":"ватра","traslitterazione":"vátra","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fireside, bonfire, hearth","termine_origine":"vatră","catena":[{"codice":"ro","nome":"Romanian","termine":"vatră","categoria":"prestito"},{"codice":"als","nome":"Tosk Albanian","termine":"vatër","categoria":"non_precisato"},{"codice":"sqj-pro","nome":"Proto-Albanian","termine":"*ōtar","categoria":"non_precisato"}],"lontana":"sqj-pro","ambiti":[],"via":"","testo":"Borrowed from Romanian vatră or Aromanian vatrã, which in turn are borrowed from Tosk Albanian vatër (definite form vatra), from Proto-Albanian *ōtar, obtained through the *o to *vo-/*va- development which is observed exclusively in the Albanian language as the diphthongization of *o in the two majo"},{"parola":"гирло","traslitterazione":"hýrlo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":