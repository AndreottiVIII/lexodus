{"arrivo":"uk","origine":"ota","origine_nome":"Ottoman Turkish","livello2":"fa","livello2_nome":"Persian","n":8,"parole":[{"parola":"баклажан","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"aubergine (fruit of the plant)","termine_origine":"بادلجان","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"بادلجان","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"بادنجان","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"From Ottoman Turkish بادلجان (bâdlicân), from Persian بادنجان (bâdenjân)."},{"parola":"гяур","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"giaour (infidel)","termine_origine":"كاور","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"كاور","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"گاور","categoria":"non_precisato"}],"lontana":"fa","ambiti":["religione"],"via":"","testo":"Borrowed from Ottoman Turkish كاور (gâvur), from Persian گاور (gâvor). Replaced Old Ruthenian кгауръ (gaur), гауръ (haur) in 18th century, possibly under influence of Western European languages."},{"parola":"зурна","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"zurna","termine_origine":"زورنا⁩","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"زورنا⁩","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"زرنا⁩","categoria":"non_precisato"}],"lontana":"fa","ambiti":["musica"],"via":"","testo":"Borrowed from Ottoman Turkish زورنا (zurna), from Persian زرنا (zornâ)."},{"parola":"кав'яр","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"caviar","termine_origine":"خاویار","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"خاویار","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"خاویار","categoria":"non_precisato"}],"lontana":"fa","ambiti":["cucina"],"via":"","testo":"Derived via Western European languages from Ottoman Turkish خاویار (havyar), from Persian خاویار (xâvyâr)."},{"parola":"лелека","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"stork","termine_origine":"لیلك","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"لیلك","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"لکلک","categoria":"non_precisato"},{"codice":"sem","nome":"Semitic","termine":"","categoria":"non_precisato"}],"lontana":"sem","ambiti":[],"via":"","testo":"From Ottoman Turkish لیلك (leylek), لكلك (leklek, leylek), from Persian لکلک (lak-lak), probably ultimately from Semitic."},{"parola":"парча","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"brocade (fabric)","termine_origine":"پارچه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"پارچه","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"پارچه","categoria":"non_precisato"}],"lontana":"fa","ambiti":["moda"],"via":"","testo":"Borrowed from Ottoman Turkish پارچه (parça), from Persian پارچه (pârče)."},{"parola":"ревінь","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rhubarb (any plant of the genus Rheum)","termine_origine":"راوند","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"راوند","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"ریوند","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish راوند (ravent), from Persian راوند (râvand). Compare Russian реве́нь (revénʹ), Belarusian рэве́нь (revjénʹ)."},{"parola":"фарфор","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"porcelain, china","termine_origine":"فغفوری","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فغفوری","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"فغفوری","categoria":"non_precisato"},{"codice":"sog","nome":"Sogdian","termine":"𐼱𐼲𐼾𐼰𐼴𐽀","categoria":"non_precisato"}],"lontana":"sog","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish فغفوری (fağfûrî, “Chinese [porcelain]”), from Persian فغفوری (faġfuri, “Chinese [porcelain]”), from فغفور (faġfur, “emperor of China”) + ـی (-i), from Sogdian 𐼱𐼲𐼾𐼰𐼴𐽀 (βɣpʾwr /⁠βaγpūr⁠/); see it for more."}]}