tegoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish صفران (Turkish şafran), from Arabic زَعْفَرَان (zaʕfarān)."},{"parola":"шафран","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"saffron","termine_origine":"صفران","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"صفران","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"زَعْفَرَان","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish صفران (Turkish şafran), from Arabic زَعْفَرَان (zaʕfarān)."},{"parola":"яничар","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"janissary (Ottoman soldier)","termine_origine":"یڭیچری","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"یڭیچری","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"From Ottoman Turkish یڭیچری (yeniçeri), from یڭی (yeni, “new”) + چری (çeri, “soldier”)."},{"parola":"інжир","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fig","termine_origine":"⁧انجیر","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"⁧انجیر","categoria":"prestito"}],"lontana":"ota","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish انجیر (“incir”)"}]}