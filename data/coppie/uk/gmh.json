{"arrivo":"uk","origine":"gmh","origine_nome":"Middle High German","n":20,"parole":[{"parola":"байстрюк","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bastard (illegitimate son)","termine_origine":"bastart","catena":[{"codice":"gmh","nome":"Middle High German","termine":"bastart","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Ultimately from Middle High German bastart (compare modern German Bastard)."},{"parola":"бархат","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"velvet","termine_origine":"barchât","catena":[{"codice":"gmh","nome":"Middle High German","termine":"barchât","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"barracanus","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"بَرَّكَان","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Middle High German barchât, from Medieval Latin barracanus, from Arabic بَرَّكَان (barrakān, “a kind of black gown”)."},{"parola":"блават","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cornflower (Centaurea cyanus)","termine_origine":"blâvar","catena":[{"codice":"gmh","nome":"Middle High German","termine":"blâvar","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["moda"],"via":"","testo":"Inherited from Old Ruthenian блаватъ (blavat), ultimately from Middle High German blâvar."},{"parola":"клейнод","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"jewel, gemstone, precious stone","termine_origine":"kleinōt","catena":[{"codice":"gmh","nome":"Middle High German","termine":"kleinōt","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Inherited from Old Ruthenian клейнотъ (klejnot), borrowed from Middle High German kleinōt, kleinœte. The modern form is due to influence from New High German Kleinod."},{"parola":"коновка","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bucket","termine_origine":"kanne","catena":[{"codice":"gmh","nome":"Middle High German","termine":"kanne","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["cucina"],"via":"","testo":"Ultimately from Middle High German kanne."},{"parola":"крамниця","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"shop, store (establishment that sells goods)","termine_origine":"krām","catena":[{"codice":"gmh","nome":"Middle High German","termine":"krām","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"kram","categoria":"non_precisato"},{"codice":"goh","nome":"Old High German","termine":"kram","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*krimman","categoria":"non_precisato"},{"codice":"goh","nome":"Old High German","termine":"kram","categoria":"non_precisato"},{"codice":"sla","nome":"Slavic","termine":"","categoria":"non_precisato"},{"codice":"cu","nome":"Old Church Slavonic","termine":"грамъ","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gremH-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From крам (kram, “goods, an object used for trading”) + -ниця (-nycja), from Middle High German krām or Middle High German krāme (maybe partially through Polish kram), from Old High German kram, most likely from Proto-West Germanic *krimman (“to cram, to stuff”) or Proto-West Germanic *krāma- (a roo"},{"parola":"ліхтар","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"lantern","termine_origine":"liuhtære","catena":[{"codice":"gmh","nome":"Middle High German","termine":"liuhtære","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"lichtarz","categoria":"non_precisato"}],"lontana":"pl","ambiti":[],"via":"","testo":"Probably from Middle High German liuhtære (“candlestick”) via Polish lichtarz (“candlestick”). Compare Russian dial. лихта́р (lixtár, “candlestick”), German Leuchter (“candlestick”)."},{"parola":"рима","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rhyme","termine_origine":"rīm","catena":[{"codice":"gmh","nome":"Middle High German","termine":"rīm","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"rime","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"rhythmus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ῥυθμός","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Middle High German rīm from Old French rime from Latin rhythmus from Ancient Greek ῥυθμός (rhuthmós)."},{"parola":"рота","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"company","termine_origine":"rotte","catena":[{"codice":"gmh","nome":"Middle High German","termine":"rotte","categoria":"prestito"}],"lontana":"gmh","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from Middle High German rotte (“detachment, unit, crowd”)."},{"parola":"тарілка","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"plate, dish","termine_origine":"talier","catena":[{"codice":"gmh","nome":"Middle High German","termine":"talier","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["musica"],"via":"pl","testo":"From Middle High German talier through Polish talerz (“plate”) + -ка (-ka), with metathesis of l and r."},{"parola":"фіранка","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"curtain","termine_origine":"furhanck","catena":[{"codice":"gmh","nome":"Middle High German","termine":"furhanck","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"firanka","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"From Middle High German furhanck through Polish firanka. Compare with German Vorhang and Yiddish פֿאָרהאַנג (forhang)/Yiddish פֿירהאַנג (firhang)."},{"parola":"шлунок","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"stomach","termine_origine":"geslünge","catena":[{"codice":"gmh","nome":"Middle High German","termine":"geslünge","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["scienza"],"via":"","testo":"From Middle High German geslünge. Compare modern German Geschlinge."},{"parola":"шрам","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"scar, cicatrix (a permanent mark on the skin sometimes caused by the healing of a wound)","termine_origine":"schramme","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schramme","categoria":"prestito"}],"lontana":"gmh","ambiti":["scienza"],"via":"","testo":"Borrowed from Middle High German schramme, schramm (whence also German Schramme)."},{"parola":"штивний","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stiff, rigid","termine_origine":"stīf","catena":[{"codice":"gmh","nome":"Middle High German","termine":"stīf","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"stīf","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*stīfaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*steypós","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"sztywny","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"From Middle High German stīf or Middle Low German stīf (both from Proto-Germanic *stīfaz, from Proto-Indo-European *steypós) + Ukrainian -ний (-nyj), likely mediated by Polish sztywny."},{"parola":"шуба","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fur coat (for men or women)","termine_origine":"schūbe","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schūbe","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"giubba","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"جُبَّة","categoria":"non_precisato"}],"lontana":"ar","ambiti":["moda"],"via":"","testo":"Borrowed from Middle High German schūbe, from Italian giubba, from Arabic جُبَّة (jubba, “long garment”)."},{"parola":"шум","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"foam, froth","termine_origine":"schūm","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schūm","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*skūmaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Middle High German schūm, from Old High German scūm, from Proto-Germanic *skūmaz. Cognate with English scum, German Schaum."},{"parola":"шуміти","pos":"verb","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"to bubble, to foam, to froth","termine_origine":"schūm","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schūm","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"From шум (šum, “foam, froth”) + -і́ти (-íty), from Middle High German schūm. Compare Belarusian шуме́ць (šumjécʹ), Polish szumieć."},{"parola":"шурувати","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"to stoke, to poke (:firebox, furnace, to promote burning)","termine_origine":"schürn","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schürn","categoria":"prestito"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Borrowed from Middle High German schürn (whence German schüren) in the sense \"to stoke, to poke\", and from German scheuern (possibly via Polish szorować) in the sense \"to scour, to scrub\". Compare Russian шурова́ть (šurovátʹ), Belarusian шурава́ць (šuravácʹ)."},{"parola":"шуруп","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"wood screw","termine_origine":"schrūbe","catena":[{"codice":"gmh","nome":"Middle High German","termine":"schrūbe","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Variant of шруб (šrub) possibly influenced by East Slavic pleophony (polnoglasie), from Old Ruthenian шрубъ (šrub), from Middle High German schrūbe (whence German Schraube)."},{"parola":"ґрунт","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"soil, ground, bottom","termine_origine":"grunt","catena":[{"codice":"gmh","nome":"Middle High German","termine":"grunt","categoria":"non_precisato"}],"lontana":"gmh","ambiti":["scienza"],"via":"","testo":"Inherited from Old Ruthenian кгрунтъ (grunt), ґрунтъ (grunt), from Middle High German grunt."}]}