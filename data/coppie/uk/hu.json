"hu","nome":"Hungarian","termine":"csuha","categoria":"prestito"}],"lontana":"hu","ambiti":["moda"],"via":"","testo":"Borrowed from Hungarian csuha. By surface analysis, чуга (čuha) + -а́й (-áj)."},{"parola":"ґазда","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"owner, proprietor","termine_origine":"gazda","catena":[{"codice":"hu","nome":"Hungarian","termine":"gazda","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*gostьpoda","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"From Hungarian gazda, from Proto-Slavic *gostьpoda. Doublet of госпо́дь (hospódʹ), госпо́да (hospóda), and госпо́дар (hospódar)."},{"parola":"ґандж","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"defect, fault, vice","termine_origine":"gáncs","catena":[{"codice":"hu","nome":"Hungarian","termine":"gáncs","categoria":"prestito"}],"lontana":"hu","ambiti":[],"via":"","testo":"Borrowed from Hungarian gáncs."}]}