{"arrivo":"uk","origine":"la","origine_nome":"Latin","livello2":"pl","livello2_nome":"Polish","n":6,"parole":[{"parola":"вохра","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"ochre","termine_origine":"ochra","catena":[{"codice":"la","nome":"Latin","termine":"ochra","categoria":"latinismo_dotto"},{"codice":"pl","nome":"Polish","termine":"ochra","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"ὤχρα","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Latin ochra through Polish ochra, ultimately from Ancient Greek ὤχρα (ṓkhra)."},{"parola":"займенник","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"sì","motivo_incerta":"Possibly","significato":"pronoun","termine_origine":"pronomen","catena":[{"codice":"la","nome":"Latin","termine":"pronomen","categoria":"calco"},{"codice":"pl","nome":"Polish","termine":"zaimek","categoria":"calco"}],"lontana":"pl","ambiti":[],"via":"","testo":"From за (za) + іме́н- (imén-) + -ник (-nyk), a calque of Latin pronomen, possibly via Polish zaimek."},{"parola":"медитація","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"meditation","termine_origine":"meditātiō","catena":[{"codice":"la","nome":"Latin","termine":"meditātiō","categoria":"latinismo_dotto"},{"codice":"pl","nome":"Polish","termine":"medytacja","categoria":"non_precisato"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Latin meditātiō, via Polish medytacja. Compare Russian медита́ция (meditácija)."},{"parola":"поспільщина","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"republic","termine_origine":"rēs pūblica","catena":[{"codice":"la","nome":"Latin","termine":"rēs pūblica","categoria":"calco"},{"codice":"pl","nome":"Polish","termine":"rzeczpospolita","categoria":"calco"}],"lontana":"pl","ambiti":[],"via":"","testo":"From поспі́льний (pospílʹnyj) + -щина (-ščyna). Calque of Latin rēs pūbli