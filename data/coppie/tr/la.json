{"arrivo":"tr","origine":"la","origine_nome":"Latin","n":36,"parole":[{"parola":"-izm","pos":"suffix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"-ism","termine_origine":"-ismus","catena":[{"codice":"la","nome":"Latin","termine":"-ismus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Ottoman Turkish ـیزم (-izm), from Latin -ismus."},{"parola":"-sel","pos":"suffix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Suffix turning a word into an adjective.","termine_origine":"-alis","catena":[{"codice":"la","nome":"Latin","termine":"-alis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Coined from the last three letters of French universel (“universal”) during the Turkish language reform. First used in evrensel, the equivalent of the same word (1934). Ultimately derived from Latin -alis."},{"parola":"abdomen","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"abdomen","termine_origine":"abdōmen","catena":[{"codice":"la","nome":"Latin","termine":"abdōmen","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From Latin abdōmen."},{"parola":"ambi-","pos":"prefix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ambi-","termine_origine":"ambi-","catena":[{"codice":"la","nome":"Latin","termine":"ambi-","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Latin ambi- (“both”), from ambo (“both”)."},{"parola":"aparat","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"apparatus","termine_origine":"apparātus","catena":[{"codice":"la","nome":"Latin","termine":"apparātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Latin apparātus."},{"parola":"centrum","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"centre (central area of a ci