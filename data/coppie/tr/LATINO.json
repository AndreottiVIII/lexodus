{"arrivo":"tr","origine":"LATINO","origine_nome":"Latin (all varieties)","n":44,"parole":[{"parola":"-iye","pos":"suffix","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"Used to form place and country names","termine_origine":"-ia","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"-ia","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish [Term?], from Medieval Latin -ia.","origine_varieta":"la-med"},{"parola":"-izm","pos":"suffix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"-ism","termine_origine":"-ismus","catena":[{"codice":"la","nome":"Latin","termine":"-ismus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Ottoman Turkish ـیزم (-izm), from Latin -ismus.","origine_varieta":"la"},{"parola":"-sel","pos":"suffix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Suffix turning a word into an adjective.","termine_origine":"-alis","catena":[{"codice":"la","nome":"Latin","termine":"-alis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Coined from the last three letters of French universel (“universal”) during the Turkish language reform. First used in evrensel, the equivalent of the same word (1934). Ultimately derived from Latin -alis.","origine_varieta":"la"},{"parola":"abdomen","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"abdomen","termine_origine":"abdōmen","catena":[{"codice":"la","nome":"Latin","termine":"abdōmen","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From Latin abdōmen.","origine_varieta":"la"},{"parola":"ambi-","pos":"prefix","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ambi-","termine_origine":"ambi-","catena":[{"codice":"la","nome":"Latin","termine":"ambi-","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Latin ambi- (“both”), from ambo (“both”).","origine_varieta":"la"},{"parola":"aparat","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"apparatus","termine_origine":"apparātus","catena":[{"codice":"la","nome":"Latin","termine":"apparātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Latin apparātus.","origine_varieta":"la"},{"parola":"Bulgar","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Bulgarian (of or relating to Bulgaria or the Bulgarian people)","termine_origine":"Bulgarus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"Bulgarus","categoria":"non_precisato"},{"codice":"trk-pro","nome":"Proto-Turkic","termine":"*bulga-","categoria":"ereditato"}],"lontana":"trk-pro","ambiti":[],"via":"","testo":"Ultimately from Medieval Latin Bulgarus; see Bulgar above. Doublet of bulamak, which is inherited from Proto-Turkic *bulga-","origine_varieta":"la-med"},{"parola":"centrum","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"centre (central area of a city)","termine_origine":"centrum","catena":[{"codice":"la","nome":"Latin","termine":"centrum","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"From Latin centrum. Doublet of santral.","origine_varieta":"la"},{"parola":"defakto","pos":"adj","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"de facto","termine_origine":"dē factō","catena":[{"codice":"la","nome":"Latin","termine":"dē factō","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"From Latin dē factō.","origine_varieta":"la"},{"parola":"dilemma","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"dilemma","termine_origine":"dilemma","catena":[{"codice":"la","nome":"Latin","termine":"dilemma","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"δίλημμ