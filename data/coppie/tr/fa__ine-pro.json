{"arrivo":"tr","origine":"fa","origine_nome":"Persian","livello2":"ine-pro","livello2_nome":"Proto-Indo-European","n":5,"parole":[{"parola":"nam","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"reputation","termine_origine":"نام","catena":[{"codice":"fa","nome":"Persian","termine":"نام","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₁nómn̥","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Ottoman Turkish نام (nam), from Persian نام (nâm), from Proto-Indo-European *h₁nómn̥. Compare Sanskrit नामन् (nāman), Latin nomen, French nom , English name, German Name, Armenian անուն (anun)."},{"parola":"teneke","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"made of tinplate","termine_origine":"تنگه","catena":[{"codice":"fa","nome":"Persian","termine":"تنگه","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ténh₂us","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Ottoman Turkish تنكه, from Persian تنگه, from Persian تنک (tonok, “تنک”, literally “thin”), from Proto-Indo-European *ténh₂us (“thin”)."},{"parola":"tohum","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"seed (fertilized grain)","termine_origine":"تخم","catena":[{"codice":"fa","nome":"Persian","termine":"تخم","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*tewk-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"From Ottoman Turkish تخم (tuhm, tohum), from Persian تخم (toxm), from Proto-Indo-European *tewk- (“germ, seed, sprout, offspring”)."},{"parola":"vay","pos":"intj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"woe, alas!","termine_origine":"وای","catena":[{"codice":"fa","nome":"Persian","termine":"وای","categoria":"non_precisato