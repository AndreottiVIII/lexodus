{"arrivo":"tr","origine":"vec","origine_nome":"Venetan","n":23,"n_alternative":0,"parole":[{"parola":"alabora","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"capsizing","termine_origine":"albora","catena":[{"codice":"vec","nome":"Venetan","termine":"albora","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"From Ottoman Turkish آلبورا, آلبوره (alabora, albura), from Venetan albora, second-person singular imperative of alborar (standard Italian alberare (“to fit with a mast”))."},{"parola":"bandıra","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"flag","termine_origine":"bandéra","catena":[{"codice":"vec","nome":"Venetan","termine":"bandéra","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"From Ottoman Turkish باندره, باكدیره, from Venetan bandéra (Italian bandiera). Compare French bandière, Greek παντιέρα (pantiéra)."},{"parola":"baston","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cane, walking stick","termine_origine":"bastón","catena":[{"codice":"vec","nome":"Venetan","termine":"bastón","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Ottoman Turkish باستون (baston), from Venetan bastón."},{"parola":"batarya","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"battery","termine_origine":"bataria","catena":[{"codice":"vec","nome":"Venetan","termine":"bataria","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Ottoman Turkish بطاریه (batarya), from Venetan bataria."},{"parola":"berber","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"barber, hairdresser","termine_origine":"barbièr","catena":[{"codice":"vec","nome":"Venetan","termine":"barbièr","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Ottoman Turkish بربر (berber), from Venetan barbièr (Italian barbiere)."},{"parola":"damacana","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"demijohn","termine_origine":"damigiana","catena":[{"codice":"vec","nome":"Venetan","termine":"damigiana","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"dame-jeanne","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"damigiana","categoria":"non_precisato"}],"lontana":"it","ambiti":[],"via":"","testo":"From Ottoman Turkish داماجانه (damacana), from Venetan damigiana, from French dame-jeanne, from Italian damigiana."},{"parola":"fanila","pos":"noun|adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"undershirt","termine_origine":"fanela","catena":[{"codice":"vec","nome":"Venetan","termine":"fanela","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"flanella","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"flanelle","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"flannel","categoria":"non_precisato"}],"lontana":"en","ambiti":["moda"],"via":"","testo":"Inherited from Ottoman Turkish فانیله (fanila), from Venetan fanela, from Italian flanella, from French flanelle, from English flannel."},{"parola":"filo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"fleet; squadron, line of battle","termine_origine":"filo","catena":[{"codice":"vec","nome":"Venetan","termine":"filo","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"filum","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare","militare","diritto_politica"],"via":"","testo":"From Ottoman Turkish فیلو (filo, “line of battle”), from Venetan filo (“line”), from Latin filum."},{"parola":"fora","pos":"noun|intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The act of unfurling sails.","termine_origine":"fora","catena":[{"codice":"vec","nome":"Venetan","termine":"fora","categoria":"prestito"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"Borrowed from Venetan fora."},{"parola":"fırtına","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"storm, tempest","termine_origine":"fortuna","catena":[{"codice":"vec","nome":"Venetan","termine":"fortuna","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fortūna","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"φουρτούνα","traslitterazione":"fourtoúna","categoria":"non_precisato"}],"lontana":"el","ambiti":["scienza"],"via":"","testo":"From Ottoman Turkish فورطنه (furtuna, fırtuna, fırtına), from Venetan fortuna, from Latin fortūna. The Latin word meant any sort of luck, good or bad, but among sailors the word became specialized to mean a particular kind of bad luck, a storm. The immediate source may have been Greek φουρτούνα (fou"},{"parola":"gondol","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"gondola (boat)","termine_origine":"góndoła","catena":[{"codice":"vec","nome":"Venetan","termine":"góndoła","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["mare"],"via":"","testo":"From Ottoman Turkish غوندول (gondol), Venetan góndoła, probably from Byzantine Greek κοντούρα (kontoúra, “small tail”)."},{"parola":"güverte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"deck","termine_origine":"coverta","catena":[{"codice":"vec","nome":"Venetan","termine":"coverta","categoria":"prestito"}],"lontana":"vec","ambiti":["mare","finanza","scienza"],"via":"","testo":"Inherited from Ottoman Turkish كوكرته (güğerte, güverte), borrowed from Venetan coverta."},{"parola":"kalyon","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"galleon","termine_origine":"galión","catena":[{"codice":"vec","nome":"Venetan","termine":"galión","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"From Ottoman Turkish قالیون, قلیون (kalyon), from Venetan galión."},{"parola":"kanca","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"hook","termine_origine":"ganzo","catena":[{"codice":"vec","nome":"Venetan","termine":"ganzo","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*ganskyos","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Ottoman Turkish قانجه (kanca), from Venetan ganzo, from Proto-Celtic *ganskyos (“branch, twig”)."},{"parola":"karga tulumba","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"By several people and in a rough manner.","termine_origine":"carga tromba","catena":[{"codice":"vec","nome":"Venetan","termine":"carga tromba","categoria":"prestito"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Venetan carga tromba or Italian carga la tromba (“the command to furl sails”)."},{"parola":"lavta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lavta, a type of lute","termine_origine":"lauto","catena":[{"codice":"vec","nome":"Venetan","termine":"lauto","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Ottoman Turkish لاؤطه (lauta), from Venetan lauto. Doublet of ut."},{"parola":"marangoz","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"carpenter","termine_origine":"marangon","catena":[{"codice":"vec","nome":"Venetan","termine":"marangon","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish مرانغوز, مارانغوز (marangoz, “shipwright, ship’s carpenter; carpenter, joiner”), from Venetan marangon (“carpenter”), from a Medieval Latin development of Latin mergus (“diver, loon”); see there for more."},{"parola":"mola","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rest, break, pause","termine_origine":"moła","catena":[{"codice":"vec","nome":"Venetan","termine":"moła","categoria":"non_precisato"}],"lontana":"vec","ambiti":[],"via":"","testo":"From Ottoman Turkish موله (mola), from Venetan moła, 2nd person imperative of Venetan mołar."},{"parola":"pirzola","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cutlet, chop (a cut of meat with a piece of bone attached)","termine_origine":"brisiòła","catena":[{"codice":"vec","nome":"Venetan","termine":"brisiòła","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"brisolée","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"braciola","categoria":"prestito"}],"lontana":"it","ambiti":["cucina"],"via":"","testo":"Borrowed from Venetan brisiòła. Cognate with Greek μπριζόλα (brizóla)."},{"parola":"piyasa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"market","termine_origine":"piasa","catena":[{"codice":"vec","nome":"Venetan","termine":"piasa","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"platea","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πλατεῖα","traslitterazione":"plateîa","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish پیاسه (piyasa), from Venetan piasa, from Latin platea, from Ancient Greek πλατεῖα (plateîa). Doublet of plaza."},{"parola":"salamura","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"brine, pickle, water saturated or strongly impregnated with salt, generally used for pickling","termine_origine":"salamora","catena":[{"codice":"vec","nome":"Venetan","termine":"salamora","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"salimuria","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish سالاموره (salamura, “brine”), from Venetan salamora (“brine”), ultimately from Latin salimuria (“brine, pickle”)."},{"parola":"salata","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"salad","termine_origine":"salata","catena":[{"codice":"vec","nome":"Venetan","termine":"salata","categoria":"non_precisato"}],"lontana":"vec","ambiti":["cucina"],"via":"","testo":"Inherited from Ottoman Turkish صالاته (salata), from Venetan salata. Akin to Georgian სალათა (salata), Ottoman Turkish borrowing."},{"parola":"vardiya","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"shift, workshift, a scheduled period of employment","termine_origine":"vàrdia","catena":[{"codice":"vec","nome":"Venetan","termine":"vàrdia","categoria":"non_precisato"}],"lontana":"vec","ambiti":["mare"],"via":"","testo":"Inherited from Ottoman Turkish واردیا (vardiya), from Venetan vàrdia. Also compare Italian guardia."}]}