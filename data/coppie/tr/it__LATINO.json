{"arrivo":"tr","origine":"it","origine_nome":"Italian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":32,"parole":[{"parola":"arma","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"coat of arms, an emblem specific to rulers, prominent families or individuals, organizations, or cities","termine_origine":"arma","catena":[{"codice":"it","nome":"Italian","termine":"arma","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"arma","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂(e)rmos","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["mare"],"via":"","testo":"Inherited from Ottoman Turkish آرما (arma), from Italian arma, from Late Latin arma (“weapon”), from Latin arma (“defensive arms, weapons of war, war, defense, tools”), from Proto-Indo-European *h₂(e)rmos (“fitting”). Doublet of alarm.","livello2_varieta":"la-lat"},{"parola":"arya","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aria","termine_origine":"aria","catena":[{"codice":"it","nome":"Italian","termine":"aria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"āēr","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾱ̓ήρ","categoria":"prestito"},{"codice":"grk-pro","nome":"Proto-Hellenic","termine":"*auhḗr","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂ewsér","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Italian aria, from Latin āera, Greek-type accusative of āēr, from Ancient Greek ἀήρ (aḗr, “air”).","livello2_varieta":"la"},{"parola":"bezelye","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pea","termine_origine":"pisello, bisello","catena":[{"codice":"it","nome":"Italian","termine":"pisello, bisello","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*pisellum","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πίσον","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"From Ottoman Turkish پزلیا , پزلیه, بزلیا, بزلیه (bezelye, pezelye), from Italian pisello, bisello, from Vulgar Latin *pisellum, from Latin pisum, from Ancient Greek πίσον (píson).","livello2_varieta":"la-vul"},{"parola":"bilanço","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"balance sheet","termine_origine":"bilancio","catena":[{"codice":"it","nome":"Italian","termine":"bilancio","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"*bilancia","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Ottoman Turkish بیلانچو, from Italian bilancio, from Late Latin *bilancia, from Latin bilanx.","livello2_varieta":"la-lat"},{"parola":"boci","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A type of wheelbarrow used to carry heavy burdens.","termine_origine":"poggia","catena":[{"codice":"it","nome":"Italian","termine":"poggia","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*podio","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Italian poggia, from poggiare, from Vulgar Latin *podiāre, from Latin podium.","livello2_varieta":"la-vul"},{"parola":"diva","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"diva (female celebrity)","termine_origine":"diva","catena":[{"codice":"it","nome":"Italian","termine":"diva","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dīva","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian diva (“diva, goddess”), from Latin dīva (“goddess”), female of dīvus (“divine, divine one; notably a deified mortal”). Doublet of dev.","livello2_varieta":"la"},{"parola":"fabrika","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"factory","termine_origine":"fabbrica","catena":[{"codice":"it","nome":"Italian","termine":"fabbrica","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fabrica","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish فابریقه (fabrika, “factory”), from Italian fabbrica, from Latin fabrica (“workshop”).","livello2_varieta":"la"},{"parola":"familya","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"family","termine_origine":"famiglia","catena":[{"codice":"it","nome":"Italian","termine":"famiglia","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"familia","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From Ottoman Turkish فاملیا, from Italian famiglia, from Latin familia.","livello2_varieta":"la"},{"parola":"fino","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"small, fluffy, toy-breed dogs such as poodles, Bichon Frisés or Maltese","termine_origine":"fino","catena":[{"codice":"it","nome":"Italian","termine":"fino","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fīnis","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Italian fino (“fine”), from Latin fīnis (“a boundary, limit”).","livello2_varieta":"la"},{"parola":"fiyaka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"display, ostentation","termine_origine":"fiaccola","catena":[{"codice":"it","nome":"Italian","termine":"fiaccola","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"facula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian fiaccola, from Old Italian *fiacca, from an older *facchia, from Latin facula.","livello2_varieta":"la"},{"parola":"fiyasko","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"fiasco (failure)","termine_origine":"fiasco","catena":[{"codice":"it","nome":"Italian","termine":"fiasco","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"flasco","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*flaska","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*flaskǭ","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*plek-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Ottoman Turkish [script needed] (fiyasko), from Italian fiasco, from Late Latin flasco, flasca (“bottle, container”), from Frankish *flaska (“bottle, flask”), from Proto-Germanic *flaskǭ (“bottle”), from Proto-Germanic *flehtaną (“to plait”), from Proto-Indo-European *plek- (“to weave, braid”).","livello2_varieta":"la-lat"},{"parola":"fırkateyn","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; nodo incerto nell'albero","significato":"frigate","termine_origine":"fregata","catena":[{"codice":"it","nome":"Italian","termine":"fregata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aphractus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἄφρακτος","categoria":"prestito"}],"lontana":"grc","ambiti":["mare"],"via":"","testo":"Inherited from Ottoman Turkish فرقتین (fırkateyn), borrowed from Italian fregata, possibly from Latin aphractus, borrowed from Ancient Greek ἄφρακτος (áphraktos).","livello2_varieta":"la"},{"parola":"kanto","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a show performed by female artists, usually with singing and dancing, before a play in Tuluat theatres","termine_origine":"canto","catena":[{"codice":"it","nome":"Italian","termine":"canto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cantus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian canto, from Latin cantus. Doublet of şan.","livello2_varieta":"la"},{"parola":"karantina","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"quarantine","termine_origine":"quarantina","catena":[{"codice":"it","nome":"Italian","termine":"quarantina","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"quadrāgintā","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From Ottoman Turkish قرانتینه (karantina), from Italian quarantina, from Latin quadrāgintā (“forty”).","livello2_varieta":"la"},{"parola":"kola","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"laundry starch, used to starch clothes etc.","termine_origine":"colla","catena":[{"codice":"it","nome":"Italian","termine":"colla","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"colla","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κόλλα","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish قولا (kola), from Italian colla (“glue”), from Vulgar Latin colla, from Ancient Greek κόλλα (kólla, “glue”)","livello2_varieta":"la-vul"},{"parola":"komposto","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"compote","termine_origine":"composto","catena":[{"codice":"it","nome":"Italian","termine":"composto","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"compositus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian composto, from Latin compositus.","livello2_varieta":"la"},{"parola":"konsulto","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"consultation","termine_origine":"consulto","catena":[{"codice":"it","nome":"Italian","termine":"consulto","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cōnsultō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Ottoman Turkish قونسولتو (konsolto), from Italian consulto, from Latin cōnsultō.","livello2_varieta":"la"},{"parola":"lira","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"lira (currency of Turkey)","termine_origine":"lira","catena":[{"codice":"it","nome":"Italian","termine":"lira","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"lībra","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"Inherited from Ottoman Turkish لیره, لیرا, from Italian lira, from Latin lībra.","livello2_varieta":"la"},{"parola":"maestro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"maestro, a composer","termine_origine":"maestro","catena":[{"codice":"it","nome":"Italian","termine":"maestro","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"magister","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*méǵh₂s","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian maestro, from Latin magister, from Proto-Indo-European *méǵh₂s. Doublet of master.","livello2_varieta":"la"},{"parola":"maçuna","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"derrick, shear legs, sheers, any device that is used for lifting and moving large objects","termine_origine":"mancina","catena":[{"codice":"it","nome":"Italian","termine":"mancina","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"machina","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"μαχανά","categoria":"non_precisato"}],"lontana":"grc","ambiti":["mare"],"via":"","testo":"Inherited from Ottoman Turkish ماچونه (maçuna, “derrick”), from Italian mancina (“derrick”), from Latin machina (“engine, device, mill”), ultimately from Ancient Greek μαχανά (makhaná). Doublet of makine (“machine”).","livello2_varieta":"la"},{"parola":"opera","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"opera","termine_origine":"opera","catena":[{"codice":"it","nome":"Italian","termine":"opera","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"opera","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"From Ottoman Turkish اوپهرا, اوپارا, اوپرا, اوپره (opera), from Italian opera, from Latin opera.","livello2_varieta":"la"},{"parola":"pala","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"machete","termine_origine":"pala","catena":[{"codice":"it","nome":"Italian","termine":"pala","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pala","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pala, from Latin pāla (“broad blade”).","livello2_varieta":"la"},{"parola":"palanga","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"block and tackle, polyspast, muffle, a system of two or more pulleys used to provide tension and lift heavy loads","termine_origine":"paranco","catena":[{"codice":"it","nome":"Italian","termine":"paranco","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"phalanga","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Ottoman Turkish پلانقه (palanka), from Italian paranco, ultimately from Latin phalanga. Doublet of palanka.","livello2_varieta":"la"},{"parola":"piyata","pos":"noun|adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"kind of flat and large plate, similar to a platter","termine_origine":"piatto","catena":[{"codice":"it","nome":"Italian","termine":"piatto","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*plattus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πλατύς","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"Inherited from Ottoman Turkish پیاطه (piyata, “dish”), from Italian piatto (“dish”), from Vulgar Latin *plattus, ultimately from Ancient Greek πλατύς (platús, “broad, flat”).","livello2_varieta":"la-vul"},{"parola":"poliçe","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bill of exchange, promissory note, a document saying that someone owes a specific amount of money to someone else","termine_origine":"polizza","catena":[{"codice":"it","nome":"Italian","termine":"polizza","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"apodissa","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"*ἀπόδειξα","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["finanza","diritto_politica"],"via":"","testo":"Inherited from Ottoman Turkish پولیچه (poliça, “bill of exchange”), from Italian polizza (“policy”), from Medieval Latin apodissa (“receipt for money”), from Byzantine Greek *ἀπόδειξα (*apódeixa), ultimately from Ancient Greek ἀπόδειξις (apódeixis, “proof”).","livello2_varieta":"la-med"},{"parola":"pusula","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"compass (navigational compass)","termine_origine":"bussola","catena":[{"codice":"it","nome":"Italian","termine":"bussola","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"buxis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πυξίς","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Ottoman Turkish پوصوله (pusula), from Italian bùssola (“compass”), derived from Latin buxis (“box”), from Ancient Greek πυξίς (puxís, “box”). Spread in the 14th century after the invention of compasses being boxed.","livello2_varieta":"la"},{"parola":"racon","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a traditional code of conduct or unwritten rule, especially within criminal or street culture","termine_origine":"ragione","catena":[{"codice":"it","nome":"Italian","termine":"ragione","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ratio","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian ragione (“reason”), from Latin ratio (“reason”)","livello2_varieta":"la"},{"parola":"ringa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"herring","termine_origine":"aringa","catena":[{"codice":"it","nome":"Italian","termine":"aringa","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"harengus","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*hāring","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"From Ottoman Turkish رینغه, from Italian aringa, from Medieval Latin harengus, from Proto-West Germanic *hāring.","livello2_varieta":"la-med"},{"parola":"senato","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"senate","termine_origine":"senato","catena":[{"codice":"it","nome":"Italian","termine":"senato","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"senātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian senato, from Latin senātus.","livello2_varieta":"la"},{"parola":"sigorta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"insurance (indemnity)","termine_origine":"sicurtà","catena":[{"codice":"it","nome":"Italian","termine":"sicurtà","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"securitas","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"From Ottoman Turkish سیغورطه (sigorta, siğorta), from Italian sicurtà (“insurance”), from Latin securitas (“safety”), from securus. Cognate with English security.","livello2_varieta":"la"},{"parola":"tavla","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tavla","termine_origine":"tavola","catena":[{"codice":"it","nome":"Italian","termine":"tavola","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tabula","categoria":"non_precisato"}],"lontana":"la","ambiti":["sport"],"via":"","testo":"Inherited from Ottoman Turkish طبله (tabla), تاوله (tavla), from Italian tavola, from Latin tabula. Doublet of tablo.","livello2_varieta":"la"},{"parola":"çimento","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cement","termine_origine":"cemento","catena":[{"codice":"it","nome":"Italian","termine":"cemento","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"caementum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Ottoman Turkish چمنتو (çemento), from Italian cemento.","livello2_varieta":"la"}]}