{"arrivo":"sk","origine":"gmh","origine_nome":"Middle High German","n":22,"parole":[{"parola":"archa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Ark (the ship built by Noah)","termine_origine":"archa","catena":[{"codice":"gmh","nome":"Middle High German","termine":"archa","categoria":"prestito"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Borrowed from Middle High German archa."},{"parola":"bažant","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pheasant","termine_origine":"vasant","catena":[{"codice":"gmh","nome":"Middle High German","termine":"vasant","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"fasant","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"phasianus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"φασιανός","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Derived from Middle High German vasant, from Old French fasant, from Latin phasianus, from Ancient Greek φασιανός (phasianós)."},{"parola":"birmovka","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"the ritual of the Catholic sacrament of confirmation","termine_origine":"firmen","catena":[{"codice":"gmh","nome":"Middle High German","termine":"firmen","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"firmo","categoria":"non_precisato"}],"lontana":"la","ambiti":["religione"],"via":"","testo":"From birmovať + -ovka. The verb birmovať (“to confirm”) is derived from Middle High German firmen, which comes from the Latin firmo (“to strenghten, reinforce”)."},{"parola":"calta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bun or piece of bread long in shape","termine_origine":"zëlte","catena":[{"codice":"gmh","nome":"Middle High German","termine":"zëlte","categoria":"prestito"}],"lontana":"gmh","ambiti":["cucina"],"via":"","testo":"Borrowed from Middle High German zëlte."},{"parola":"cech","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"guild","termine_origine":"zëch","catena":[{"codice":"gmh","nome":"Middle High German","termine":"zëch","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Derived from Middle High German zëch(e); see modern German Zeche."},{"parola":"cmar","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"buttermilk","termine_origine":"smër","catena":[{"codice":"gmh","nome":"Middle High German","termine":"smër","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Inherited from Old Slovak cmar, from Middle High German smër, whence German Schmer. Cognate with Pannonian Rusyn цмар (cmar)."},{"parola":"dratva","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"twine (strong thread)","termine_origine":"drāt","catena":[{"codice":"gmh","nome":"Middle High German","termine":"drāt","categoria":"prestito"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Borrowed from Middle High German drāt (“wire, thread”). First attested in the 17th century. Cognate with Polish dratwa, drut."},{"parola":"fúrik","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"wheelbarrow","termine_origine":"vuore","catena":[{"codice":"gmh","nome":"Middle High German","termine":"vuore","categoria":"non_precisato"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Inherited from Old Slovak fúrik, a diminutive of fúr (“transporting wagon”), a variant spelling of fúra, which was derived from Middle High German vuore (cf. German Fuhre). Cognate with Pannonian Rusyn фурик (furik)."},{"parola":"hák","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hook","termine_origine":"hāken","catena":[{"codice":"gmh","nome":"Middle High German","termine":"hāken","categoria":"prestito"}],"lontana":"gmh","ambiti":[],"via":"","testo":"Borrowed from Middle High German hāken, from Old High German hāko (“hook”); cognate with German Haken and English hook."},{"parola":"kamzík","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chamois","termine_origine":"gamize","catena":[{"codice":"gmh","nome":"Middle High German","termine":"gamize","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"camox","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"camox","categoria":"prestito"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Old Slovak kamzík. First attested in the 17th century."},{"parola":"kapusta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cabbage","termine_origine":"kappust,kappūs,kappuz","catena":[{"codice":"gmh","nome":"Middle High German","termine":"kappust,kappūs,kappuz","categoria":"prestito"},{"codice":"roa-pro","nome":"Proto-Romance","termine":"*caputia","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"caput","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Middle High German kappust, kappūs, kappuz, cf. German Kappes, Kappus (“cabbage”), from Proto-Romance *caputia, from Latin caput (“head”). First attested in the 15th century."},{"parola":"kláštor","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"monastery, convent","termine_origine":"klōster","catena":[{"codice":"gmh","nome":"Middle High German","termine":"klōster","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*clōstrum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["religione"],"via":"","testo":"Borrowed from Middle High German klōster, cf. German Kloster, from Vulgar Latin *clōstrum (“enclosed (area)”)."},{"parola":"kmín","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"thief