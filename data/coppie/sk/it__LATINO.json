{"arrivo":"sk","origine":"it","origine_nome":"Italian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":7,"parole":[{"parola":"balkón","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"balcony","termine_origine":"balcone","catena":[{"codice":"it","nome":"Italian","termine":"balcone","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"balcō","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*balkō","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*balkô","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["arte"],"via":"","testo":"Borrowed from Italian balcone.","livello2_varieta":"la-med"},{"parola":"bašta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bastion","termine_origine":"bastia","catena":[{"codice":"it","nome":"Italian","termine":"bastia","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bastīre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*bastijan","categoria":"prestito"}],"lontana":"frk","ambiti":[],"via":"","testo":"Borrowed from Italian bastia.","livello2_varieta":"la-vul"},{"parola":"detto","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ditto (aforesaid, also, likewise, same, too etc.)","termine_origine":"detto","catena":[{"codice":"it","nome":"Italian","termine":"detto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dictum","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian detto. First attested in the 20th century.","livello2_varieta":"la"},{"parola":"finále","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"final (sports)","termine_origine":"finale","catena":[{"codice":"it","nome":"Italian","termine":"finale","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"finalis","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Derived from Italian finale (“end”), from Late Latin finalis, from Latin finis.","livello2_varieta":"la-lat"},{"parola":"kupola","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cupola","termine_origine":"cupola","catena":[{"codice":"it","nome":"Italian","termine":"cupola","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cupula","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Derived from Italian cupola, from Latin cupula (“little tub”); from Latin cupa, cuppa (“cup”); named for its resemblance to a cup turned over.","livello2_varieta":"la"},{"parola":"nula","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"zero (cardinal for 0)","termine_origine":"nulla","catena":[{"codice":"it","nome":"Italian","termine":"nulla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nūlla","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian nulla, from Latin nūlla. First attested in the 18th century.","livello2_varieta":"la"},{"parola":"zázvor","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ginger","termine_origine":"zenzero","catena":[{"codice":"it","nome":"Italian","termine":"zenzero","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"gingiber","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ζιγγίβερις","categoria":"prestito"},{"codice":"pra-sau","nome":"Sauraseni Prakrit","termine":"𑀲𑀺𑀁𑀕𑀺𑀯𑁂𑀭","categoria":"non_precisato"},{"codice":"oty","nome":"Old Tamil","termine":"𑀇𑀜𑁆𑀘𑀺𑀯𑁂𑀭𑁆","categoria":"prestito"}],"lontana":"oty","ambiti":["cucina"],"via":"","testo":"Derived from Italian zenzero, from Ancient Greek ζιγγίβερις (zingíberis), from Sanskrit शृङ्गवेर (śṛṅgavera), from a Dravidian language, compare Tamil இஞ்சிவேர் (iñcivēr) from இஞ்சி (