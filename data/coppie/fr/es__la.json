isato","incerta":"no","significato":"small roll of dough containing fragrant ingredients baked in order to perfume the air","termine_origine":"pastilla","catena":[{"codice":"es","nome":"Spanish","termine":"pastilla","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pastellum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish pastilla (“small roll of fragrant dough”), from Latin pastellum (“dough, paste”), a diminutive form of pasta (“dough, paste”). Doublet of pastel."},{"parola":"rancio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the soft, mellow quality acquired by brandy as it is aged","termine_origine":"rancio","catena":[{"codice":"es","nome":"Spanish","termine":"rancio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rancidus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish rancio. Doublet of rance."},{"parola":"sol","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"a Spanish-American gold or silver coin, now the main currency unit of Peru (also new sol), or a coin of this value","termine_origine":"sol","catena":[{"codice":"es","nome":"Spanish","termine":"sol","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sol","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish sol (“sun”), itself from Latin sol."},{"parola":"transhumer","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to move livestock according to transhumance","termine_origine":"trashumar","catena":[{"codice":"es","nome":"Spanish","termine":"trashumar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish trashumar, derived Latin trāns (“across, beyond”) + humus (“ground”)."}]}