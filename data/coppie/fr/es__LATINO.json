{"arrivo":"fr","origine":"es","origine_nome":"Spanish","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":26,"parole":[{"parola":"arroyo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"arroyo","termine_origine":"arroyo","catena":[{"codice":"es","nome":"Spanish","termine":"arroyo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"arrugia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish arroyo.","livello2_varieta":"la"},{"parola":"berne","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"a piece of fabric, particularly wool","termine_origine":"bernia","catena":[{"codice":"es","nome":"Spanish","termine":"bernia","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Hibernia","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish bernia, possibly as a shortening from Latin Hibernia (“Ireland”) where this fabric was made.","livello2_varieta":"la"},{"parola":"busquer","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"to seek, prowl; filch, busk","termine_origine":"buscar","catena":[{"codice":"es","nome":"Spanish","termine":"buscar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*buscum","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*busk","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*buskaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Spanish buscar, from Old Spanish buscar, boscar (“to seek, collect wood”), from Vulgar Latin *buscum (“wood”), from Frankish *busk (“wood”), from Proto-Germanic *buskaz (“wood, bush”). Doublet of bois and bûche.","livello2_varieta":"la-vul"},{"parola":"calebasse","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calabash","termine_origine":"calabaza","catena":[{"codice":"es","nome":"Spanish","termine":"calabaza","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*calapaccia","categoria":"ereditato"},{"codice":"qsb-ibe","nome":"Paleo-Hispanic","termine":"","categoria":"prestito"}],"lontana":"qsb-ibe","ambiti":["cucina"],"via":"","testo":"Borrowed from Spanish calabaza (“pumpkin, gourd”).","livello2_varieta":"la-vul"},{"parola":"castillan","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Castilian (language)","termine_origine":"castellano","catena":[{"codice":"es","nome":"Spanish","termine":"castellano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"castellanus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Middle French Castelan, borrowed from Spanish castellano, from Latin castellanus. Doublet of châtelain, the native French word, and castellan.","livello2_varieta":"la"},{"parola":"caudillo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"caudillo","termine_origine":"caudillo","catena":[{"codice":"es","nome":"Spanish","termine":"caudillo","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"capitellum","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Spanish caudillo, from Late Latin capitellum. Doublet of cadeau, cadet, and chapiteau.","livello2_varieta":"la-lat"},{"parola":"cigare","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cigar (rolled bundle of tobacco made for smoking)","termine_origine":"cigarro","catena":[{"codice":"es","nome":"Spanish","termine":"cigarro","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cicār(r)a","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish cigarro.","livello2_varieta":"la-vul"},{"parola":"cochenille","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"cochineal (insect & pigment)","termine_origine":"cochinilla","catena":[{"codice":"es","nome":"Spanish","termine":"cochinilla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"coccinus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κόκκινος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Middle French cochenille, cossenille, probably borrowed from Spanish cochinilla, itself probably a diminutive of cochino. Other proposed etymologies, such as Latin coccinus through the intermediate of Italian cocciniglia, or Ancient Greek κόκκινος (kókkinos) through a Spanish intermed","livello2_varieta":"la"},{"parola":"estrade","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"platform, podium","termine_origine":"estrado","catena":[{"codice":"es","nome":"Spanish","termine":"estrado","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"strātum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish estrado, from Latin strātum. Doublet of stratum.","livello2_varieta":"la"},{"parola":"falcata","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A falcata; an Iberian single-edged curved sword.","termine_origine":"falcata","catena":[{"codice":"es","nome":"Spanish","termine":"falcata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"falcātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish falcata, from Latin falcātus.","livello2_varieta":"la"},{"parola":"gamelle","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mess tin, mess kit, dixie","termine_origine":"gamella","catena":[{"codice":"es","nome":"Spanish","termine":"gamella","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"camella","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish gamella, from Latin camella.","livello2_varieta":"la"},{"parola":"hombre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a kind of card game from Spain","termine_origine":"hombre","catena":[{"codice":"es","nome":"Spanish","termine":"hombre","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"hominem","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*hemō","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ǵʰmṓ","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Spanish hombre.","livello2_varieta":"la"},{"parola":"jade","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"jade","termine_origine":"piedra de ijada","catena":[{"codice":"es","nome":"Spanish","termine":"piedra de ijada","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*iliata","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Rebracketing of l'éjade (“jade”), from Spanish piedra de ijada (“flank stone”), via Vulgar Latin *iliata from Latin ilia (“flank”) (jade was thought to cure pains in the side).","livello2_varieta":"la-vul"},{"parola":"macho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"One who is excessively or aggressively masculine or misogynistic; a chauvinist","termine_origine":"macho","catena":[{"codice":"es","nome":"Spanish","termine":"macho","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"masculus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish macho, from Latin masculus. Doublet of mâle. :* c. 1952 :* c. 1962","livello2_varieta":"la"},{"parola":"major","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"the highest non-commissioned officer rank: sergeant major, “major”","termine_origine":"mayor","catena":[{"codice":"es","nome":"Spanish","termine":"mayor","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"maior","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*majjōs","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*méǵyōs","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["militare"],"via":"","testo":"From Middle French major, from Spanish mayor, from Latin maior. Doublet of maire, majeur, and mayeur. The use for a non-commissioned officer in the French army (since 1972) is a short form of adjudant-major or sergent-major.","livello2_varieta":"la"},{"parola":"mater","pos":"verb","n_etimologia":2,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; perhaps; modificatore <unc> nel legame; modello unc/uncertain","significato":"to ogle, to check out, to watch (e.g. an attractive person)","termine_origine":"mata","catena":[{"codice":"es","nome":"Spanish","termine":"mata","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"matta","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Uncertain, perhaps from Spanish mata (“bush”).","livello2_varieta":"la-lat"},{"parola":"Mercedes","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Mercedes (car manufactured by Mercedes-Benz)","termine_origine":"Mercedes","catena":[{"codice":"es","nome":"Spanish","termine":"Mercedes","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mercēs","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*merks","categoria":"ereditato"}],"lontana":"itc-pro","ambiti":[],"via":"","testo":"Borrowed from Spanish Mercedes.","livello2_varieta":"la"},{"parola":"morion","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"morion, a kind of helmet","termine_origine":"morrión","catena":[{"codice":"es","nome":"Spanish","termine":"morrión","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*murrum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish morrión, from morra (“upper part of the head”), from morro (“muzzle, snout”), from Vulgar Latin *murrum (“muzzle, snout”). Related to moraine (“an amassment of rocks on a glacier”) and morailles (“barnacle, twitch”).","livello2_varieta":"la-vul"},{"parola":"moustique","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mosquito","termine_origine":"mosquito","catena":[{"codice":"es","nome":"Spanish","termine":"mosquito","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"musca","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish mosquito, diminutive of mosca, from Latin musca, whence also the French doublet mouche (“a fly”). The metathesis of /k/ and /t/ might have been due to influence of tique (“a tick”).","livello2_varieta":"la"},{"parola":"pagne","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"loincloth","termine_origine":"paño","catena":[{"codice":"es","nome":"Spanish","termine":"paño","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pannus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish paño, from Latin pannus. Doublet of pan.","livello2_varieta":"la"},{"parola":"palabre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"convoluted discussion","termine_origine":"palabra","catena":[{"codice":"es","nome":"Spanish","termine":"palabra","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"parabola","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish palabra, from Latin parabola. Doublet of parole and parabole.","livello2_varieta":"la"},{"parola":"palmite","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"heart of palm","termine_origine":"palmito","catena":[{"codice":"es","nome":"Spanish","termine":"palmito","categoria":"calco"},{"codice":"la","nome":"Latin","termine":"palma","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From palme + -ite. Calque of Spanish palmito, from palma + -ito, from Latin palma.","livello2_varieta":"la"},{"parola":"pastille","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"small roll of dough containing fragrant ingredients baked in order to perfume the air","termine_origine":"pastilla","catena":[{"codice":"es","nome":"Spanish","termine":"pastilla","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pastellum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish pastilla (“small roll of fragrant dough”), from Latin pastellum (“dough, paste”), a diminutive form of pasta (“dough, paste”). Doublet of pastel.","livello2_varieta":"la"},{"parola":"rancio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the soft, mellow quality acquired by brandy as it is aged","termine_origine":"rancio","catena":[{"codice":"es","nome":"Spanish","termine":"rancio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rancidus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish rancio. Doublet of rance.","livello2_varieta":"la"},{"parola":"sol","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"a Spanish-American gold or silver coin, now the main currency unit of Peru (also new sol), or a coin of this value","termine_origine":"sol","catena":[{"codice":"es","nome":"Spanish","termine":"sol","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sol","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish sol (“sun”), itself from Latin sol.","livello2_varieta":"la"},{"parola":"transhumer","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to move livestock according to transhumance","termine_origine":"trashumar","catena":[{"codice":"es","nome":"Spanish","termine":"trashumar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish trashumar, derived Latin trāns (“across, beyond”) + humus (“ground”).","livello2_varieta":"la"}]}