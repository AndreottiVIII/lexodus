{"arrivo":"fr","origine":"br","origine_nome":"Breton","n":27,"n_alternative":1,"parole":[{"parola":"aber","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a ria, especially one in Brittany","termine_origine":"aber","catena":[{"codice":"br","nome":"Breton","termine":"aber","categoria":"prestito"}],"lontana":"br","ambiti":["scienza"],"via":"","testo":"Borrowed from Breton aber."},{"parola":"bagad","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bagad","termine_origine":"","catena":[{"codice":"br","nome":"Breton","termine":"","categoria":"non_precisato"}],"lontana":"br","ambiti":[],"via":"","testo":"From Breton."},{"parola":"baragouin","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"gibberish (unintelligible speech or writing)","termine_origine":"","catena":[{"codice":"br","nome":"Breton","termine":"","categoria":"non_precisato"}],"lontana":"br","ambiti":[],"via":"","testo":"Of debated origin, but probably of Breton origin, from bara (“bread”) + gwin (“wine”). The contemptuous word dates back to the Middle Ages, first attested in 1396, the year of the marriage of John VI, Duke of Brittany, with Joan of France. Compare Spanish barahúnda, Asturian baragaña, Portuguese bar"},{"parola":"bernique","pos":"noun|intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"limpet","termine_origine":"brennig","catena":[{"codice":"br","nome":"Breton","termine":"brennig","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton brennig."},{"parola":"bigouden","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a traditional head-dress made of lace from the Pays Bigouden in south west Brittany.","termine_origine":"bigoudenn","catena":[{"codice":"br","nome":"Breton","termine":"bigoudenn","categoria":"prestito"}],"lontana":"br","ambiti":["moda"],"via":"","testo":"Borrowed from Breton bigoudenn."},{"parola":"bijou","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a piece of jewelry","termine_origine":"bizoù","catena":[{"codice":"br","nome":"Breton","termine":"bizoù","categoria":"prestito"}],"lontana":"br","ambiti":["moda"],"via":"","testo":"Borrowed from Breton bizoù, bizou (“ring”), from biz (“finger”)."},{"parola":"bilig","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A wide, flat stone used especially for cooking crêpes.","termine_origine":"bilig","catena":[{"codice":"br","nome":"Breton","termine":"bilig","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton bilig."},{"parola":"biniou","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"biniou, Breton bagpipes","termine_origine":"binioù","catena":[{"codice":"br","nome":"Breton","termine":"binioù","categoria":"prestito"}],"lontana":"br","ambiti":["musica"],"via":"","testo":"Borrowed from Breton binioù, plural of béni."},{"parola":"bogue","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"chestnut burr","termine_origine":"bolc'h","catena":[{"codice":"br","nome":"Breton","termine":"bolc'h","categoria":"non_precisato"}],"lontana":"br","ambiti":[],"via":"","testo":"Originally from a western dialect, possibly from Breton bolc'h (“chestnut burr, flaxseed husk”)."},{"parola":"boëtte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bait used for fishing at sea","termine_origine":"boued","catena":[{"codice":"br","nome":"Breton","termine":"boued","categoria":"prestito"},{"codice":"cel-bry-pro","nome":"Proto-Brythonic","termine":"*buɨd","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*beitom","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gʷeyh₃tom","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["mare","scienza"],"via":"","testo":"Borrowed from Breton boued, from Middle Breton boet, from Old Breton boit-ol-ion, from Proto-Brythonic *buɨd, from Proto-Celtic *beitom, from Proto-Indo-European *gʷeyh₃tom, from *gʷeyh₃-."},{"parola":"chouchen","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of mead popular in Brittany","termine_origine":"chouchenn","catena":[{"codice":"br","nome":"Breton","termine":"chouchenn","categoria":"prestito"}],"lontana":"br","ambiti":["cucina"],"via":"","testo":"Borrowed from Breton chouchenn."},{"parola":"cotriade","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a kind of fish stew from Brittany","termine_origine":"kaoteriad","catena":[{"codice":"br","nome":"Breton","termine":"kaoteriad","categoria":"non_precisato"}],"lontana":"br","ambiti":["cucina"],"via":"","testo":"From Breton kaoteriad, which comes from kaoter (“pot”) + -ad."},{"parola":"dolmen","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"dolmen (tomb consisting of a capstone supported by two or more upright stones)","termine_origine":"","catena":[{"codice":"br","nome":"Breton","termine":"","categoria":"non_precisato"},{"codice":"kw","nome":"Cornish","termine":"tolmen","categoria":"non_precisato"}],"lontana":"kw","ambiti":[],"via":"","testo":"First attested as dolmin in 1796. One theory states that it is incorrectly fabricated from Breton taol (“table”) + maen (“stone”) (the correct compound would be *taolvaen, not **daolmaen). An alternative theory states the term derives from Cornish tolmen instead, also a compound of toll (“hole”) + m"},{"parola":"farz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"","termine_origine":"","catena":[{"codice":"br","nome":"Breton","termine":"","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton [Term?]"},{"parola":"galerne","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a cold, humid northwesterly wind that affects the west of France","termine_origine":"gwalarn","catena":[{"codice":"br","nome":"Breton","termine":"gwalarn","categoria":"non_precisato"}],"lontana":"br","ambiti":[],"via":"","testo":"From Breton gwalarn"},{"parola":"gallo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Gallo","termine_origine":"gall","catena":[{"codice":"br","nome":"Breton","termine":"gall","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"gallus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Breton gall (“a Gaul or a foreigner”), from being a language found in eastern Brittany of the non-Celts, from Latin gallus."},{"parola":"gouine","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Unknown; Possibly","significato":"lesbian, dyke","termine_origine":"gouin","catena":[{"codice":"br","nome":"Breton","termine":"gouin","categoria":"prestito"},{"codice":"cel-bry-pro","nome":"Proto-Brythonic","termine":"*gwėɣin","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"vāgīna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Unknown. Possibly borrowed from Breton gouin, from Middle Breton gouhin, from Proto-Brythonic *gwėɣin (“sheath”), itself borrowed from Latin vāgīna (“vagina”); in which case, a doublet of gaine (“sheath”) and vagin (“vagina”)."},{"parola":"goéland","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gull, herring gull","termine_origine":"gouelan","catena":[{"codice":"br","nome":"Breton","termine":"gouelan","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton gouelan."},{"parola":"grègue","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"coffee pot","termine_origine":"greg","catena":[{"codice":"br","nome":"Breton","termine":"greg","categoria":"prestito"}],"lontana":"br","ambiti":["cucina"],"via":"","testo":"Perhaps from Breton greg (“coffee pot”)."},{"parola":"gwerz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gwerz","termine_origine":"gwerz","catena":[{"codice":"br","nome":"Breton","termine":"gwerz","categoria":"prestito"}],"lontana":"br","ambiti":["musica"],"via":"","testo":"Borrowed from Breton gwerz."},{"parola":"kouign-amann","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kouign-amann","termine_origine":"","catena":[{"codice":"br","nome":"Breton","termine":"","categoria":"prestito"}],"lontana":"br","ambiti":["cucina"],"via":"","testo":"Borrowed from Breton, from kouign (“cake”) + amann (“butter”)."},{"parola":"menhir","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"menhir","termine_origine":"maen-hir","catena":[{"codice":"br","nome":"Breton","termine":"maen-hir","categoria":"prestito"}],"lontana":"br","ambiti":["scienza"],"via":"","testo":"Borrowed from Breton maen-hir, from maen (“stone”) + hir (“tall”). Compare Cornish men hir, and Welsh maen hir."},{"parola":"morue","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cod","termine_origine":"mor","catena":[{"codice":"br","nome":"Breton","termine":"mor","categoria":"non_precisato"}],"lontana":"br","ambiti":[],"via":"","testo":"From Old French morlue, a compound of Breton mor (“sea”) + Old French lus (“pike”). Cognate with the specific name in Gadus morhua. Likewise, cognate with English milwell (an old word spelled many ways before English spelling was standardized)."},{"parola":"plouc","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hick, country bumpkin, yokel","termine_origine":"plouk","catena":[{"codice":"br","nome":"Breton","termine":"plouk","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton plouk, from Breton ploue. First attested in c. 1880s."},{"parola":"startijenn","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"strength or energy","termine_origine":"startijenn","catena":[{"codice":"br","nome":"Breton","termine":"startijenn","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton startijenn."},{"parola":"Tanguy","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"an adult man who lives with his parents, similar to Italian mammone.","termine_origine":"Tangi","catena":[{"codice":"br","nome":"Breton","termine":"Tangi","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","testo":"Borrowed from Breton Tangi, from tan (“fire”) + ki (“dog”)."},{"parola":"mine","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"appearance, physical aspect; expression","termine_origine":"min","catena":[{"codice":"br","nome":"Breton","termine":"min","categoria":"prestito"}],"lontana":"br","ambiti":[],"via":"","alternative":[{"codice":"br","nome":"Breton","termine":"min","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"mina","categoria":"non_precisato"}],"testo":"Borrowed from Breton min (“beak, muzzle”) (from Proto-Celtic *meinis, in the sense of \"red\"), or from Italian mina, from Latin miniō (“to redden”)."}]}