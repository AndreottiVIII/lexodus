{"arrivo":"fr","origine":"nl","origine_nome":"Dutch","n":80,"n_alternative":1,"parole":[{"parola":"affaler","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to lower, let down","termine_origine":"afhalen","catena":[{"codice":"nl","nome":"Dutch","termine":"afhalen","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from Dutch afhalen (“to pick up”) or afvallen (“to fall off”)."},{"parola":"arquebuse","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"arquebus","termine_origine":"haakbus","catena":[{"codice":"nl","nome":"Dutch","termine":"haakbus","categoria":"prestito"}],"lontana":"nl","ambiti":["militare","scienza","diritto_politica"],"via":"","testo":"Borrowed from Dutch haakbus."},{"parola":"avoir le cul dans le beurre","pos":"verb","n_etimologia":1,"categoria":"calco","incerta":"sì","motivo_incerta":"Probably","significato":"to have it easy, to be rolling in money, to be rolling in it (to be extremely well-off financially thanks to one's birt…","termine_origine":"met zijn gat in de boter vallen","catena":[{"codice":"nl","nome":"Dutch","termine":"met zijn gat in de boter vallen","categoria":"calco"}],"lontana":"nl","ambiti":[],"via":"","testo":"Probably derived from a calque of Dutch met zijn gat in de boter vallen. Literally, “to have the butt in the butter”. Compare also English land with one's bum in the butter."},{"parola":"avoir le gros cou","pos":"verb","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"to be arrogant, haughty, boastful","termine_origine":"dikkenek","catena":[{"codice":"nl","nome":"Dutch","termine":"dikkenek","categoria":"calco"}],"lontana":"nl","ambiti":[],"via":"","testo":"Calque of Dutch dikkenek. Literally, “to have a thick neck”."},{"parola":"batik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"batik","termine_origine":"batik","catena":[{"codice":"nl","nome":"Dutch","termine":"batik","categoria":"prestito"},{"codice":"jv","nome":"Javanese","termine":"bathik","categoria":"non_precisato"}],"lontana":"jv","ambiti":[],"via":"","testo":"Borrowed from Dutch batik, from Javanese bathik."},{"parola":"berme","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"berm","termine_origine":"berm","catena":[{"codice":"nl","nome":"Dutch","termine":"berm","categoria":"prestito"}],"lontana":"nl","ambiti":["cucina","scienza"],"via":"","testo":"From Dutch berm."},{"parola":"blague","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pouch, especially for tobacco","termine_origine":"balg","catena":[{"codice":"nl","nome":"Dutch","termine":"balg","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"18th century, from Dutch balg. The sense “joke” (ca. 1800) from the notion of something puffed up, hence vain, fanciful."},{"parola":"bleime","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"an inflammation of a horse's hoof","termine_origine":"blein","catena":[{"codice":"nl","nome":"Dutch","termine":"blein","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from Dutch blein, from Middle Dutch bleine. Cognate with English blain."},{"parola":"bâbord","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"port (left-hand side of a vessel)","termine_origine":"bakboord","catena":[{"codice":"nl","nome":"Dutch","termine":"bakboord","categoria":"non_precisato"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"From Dutch bakboord (from bak (“rear”) + boord (“board”)), because the pilot was formerly located on the starboard and turned his back to the other side."},{"parola":"bélier","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"ram (sheep)","termine_origine":"","catena":[{"codice":"nl","nome":"Dutch","termine":"","categoria":"non_precisato"}],"