{"arrivo":"fr","origine":"hi","origine_nome":"Hindi","n":11,"parole":[{"parola":"Bishnoï","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Bishnoi","termine_origine":"बिश्नोई","catena":[{"codice":"hi","nome":"Hindi","termine":"बिश्नोई","categoria":"non_precisato"}],"lontana":"hi","ambiti":["religione"],"via":"","testo":"From Hindi बिश्नोई (biśnoī)."},{"parola":"cauri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cowrie, money cowry","termine_origine":"कौड़ी","catena":[{"codice":"hi","nome":"Hindi","termine":"कौड़ी","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"कपर्द","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"cowry","categoria":"prestito"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Hindi कौड़ी (kauṛī, “cowry”), from Sanskrit कपर्द (kaparda, “cowry”); also from English cowry."},{"parola":"châle","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shawl","termine_origine":"शाल","catena":[{"codice":"hi","nome":"Hindi","termine":"शाल","categoria":"prestito"}],"lontana":"hi","ambiti":[],"via":"","testo":"Borrowed from Hindustani (Hindi शाल (śāl) / Urdu شال (śāl)), from Classical Persian شال (šāl). Doublet of sari through Sanskrit."},{"parola":"gavial","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gharial","termine_origine":"घड़ियाल","catena":[{"codice":"hi","nome":"Hindi","termine":"घड़ियाल","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"घण्टिक","categoria":"ereditato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Borrowed from Hindi घड़ियाल (ghaṛiyāl, “alligator, crocodile”)."},{"parola":"Harijan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Harijan","termine_origine":"हरिजन","catena":[{"codice":"hi","nome":"Hindi","termine":"हरिजन","categoria":"prestito"}],"lontana":"hi","ambiti":[],"via":"","testo":"Borrowed from Hindi हरिजन (harijan, literally “Children of God”). Coined by Narsinh Mehta, a Gujarati Bhakti poet Narsinh Mehta in the 15th century and popularized by Mahatma Gandhi as an alternative to the term Dalit."},{"parola":"hindouité","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"Hindutva","termine_origine":"हिंदुत्व","catena":[{"codice":"hi","nome":"Hindi","termine":"हिंदुत्व","categoria":"calco"},{"codice":"bn","nome":"Bengali","termine":"হিন্দুত্ব","categoria":"calco"}],"lontana":"bn","ambiti":["diritto_politica"],"via":"","testo":"Calque of Hindi हिंदुत्व (hindutva) / Bengali হিন্দুত্ব (hindutto, literally “Hinduness”): hindou + -ité."},{"parola":"ispaghul","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ispaghula","termine_origine":"इसबगोल","catena":[{"codice":"hi","nome":"Hindi","termine":"इसबगोल","categoria":"non_precisato"}],"lontana":"hi","ambiti":[],"via":"","testo":"From Hindi इसबगोल (isabgol), of the same meaning."},{"parola":"maharaja","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"maharaja","termine_origine":"महाराजा","catena":[{"codice":"hi","nome":"Hindi","termine":"महाराजा","categoria":"non_precisato"}],"lontana":"hi","ambiti":["diritto_politica"],"via":"","testo":"From Hindi महाराजा (mahārājā)."},{"parola":"nilgaut","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"nilgai","termine_origine":"नीलगाय","catena":[{"codice":"hi","nome":"Hindi","termine":"नीलगाय","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"نیلیگاو","categoria":"prestito"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Hindi नीलगाय (nīlgāy) or Persian نیلیگاو (nili-gâv). Compare also dialectal Hindi गो (go, “cow”) which may explain the ending -gaut."},{"parola":"radja","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"the Hindu princely title rajah, in various meanings, yet often rendered as king","termine_origine":"राजा","catena":[{"codice":"hi","nome":"Hindi","termine":"राजा","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"राज","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"From Hindi राजा (rājā), from Sanskrit राज (rāja), cognate with Latin rex, etc."},{"parola":"sanskrit","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the Sanskrit language","termine_origine":"संस्कृत","catena":[{"codice":"hi","nome":"Hindi","termine":"संस्कृत","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"सं॒स्कृ॒त","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"From Hindi संस्कृत (sanskŕt), from Sanskrit सं॒स्कृ॒त (saṃskṛtá)."}]}