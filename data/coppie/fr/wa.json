{"arrivo":"fr","origine":"wa","origine_nome":"Walloon","n":9,"n_alternative":0,"parole":[{"parola":"baraki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a poorly educated individual, usually a dirty one with poor clothing tastes; a chav","termine_origine":"barakî","catena":[{"codice":"wa","nome":"Walloon","termine":"barakî","categoria":"prestito"}],"lontana":"wa","ambiti":[],"via":"","testo":"Borrowed from Walloon barakî, which literally means \"one who lives in a baraque\"."},{"parola":"biesse","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dummy, nitwit, nincompoop","termine_origine":"biesse","catena":[{"codice":"wa","nome":"Walloon","termine":"biesse","categoria":"prestito"}],"lontana":"wa","ambiti":[],"via":"","testo":"Borrowed from Walloon biesse."},{"parola":"brader","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to sell at cut-price, to sell in a sale","termine_origine":"","catena":[{"codice":"wa","nome":"Walloon","termine":"","categoria":"non_precisato"},{"codice":"pcd","nome":"Picard","termine":"","categoria":"non_precisato"},{"codice":"dum","nome":"Middle Dutch","termine":"braden","categoria":"non_precisato"}],"lontana":"dum","ambiti":[],"via":"","testo":"From Walloon or Picard, from Middle Dutch braden (“to roast”)."},{"parola":"estaminet","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"restaurant room where smoking is allowed","termine_origine":"estaminé","catena":[{"codice":"wa","nome":"Walloon","termine":"estaminé","categoria":"prestito"}],"lontana":"wa","ambiti":[],"via":"","testo":"Borrowed from Walloon estaminé (“a small café”), from stamon (“a post to which cows are tied next to a manger”). Compare Walloon staminée (“manger”)."},{"parola":"fagne","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"marshland; fen","termine_origine":"fagne","catena":[{"codice":"wa","no