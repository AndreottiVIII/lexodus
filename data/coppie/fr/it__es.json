{"arrivo":"fr","origine":"it","origine_nome":"Italian","livello2":"es","livello2_nome":"Spanish","n":14,"parole":[{"parola":"altesse","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"highness, Highness (title of respect)","termine_origine":"altezza","catena":[{"codice":"it","nome":"Italian","termine":"altezza","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"alteza","categoria":"prestito"}],"lontana":"es","ambiti":[],"via":"","testo":"Borrowed from Italian altezza or, less convincingly, from Spanish alteza. Doublet of hautesse, the inherited French equivalent."},{"parola":"appartement","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"apartment, flat","termine_origine":"appartamento","catena":[{"codice":"it","nome":"Italian","termine":"appartamento","categoria":"prestito"},{"codice":"es","nome":"Spanish","termine":"apartamiento","categoria":"non_precisato"}],"lontana":"es","ambiti":[],"via":"","testo":"Borrowed from Italian appartamento, from Spanish apartamiento."},{"parola":"baroque","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"baroque (all senses)","termine_origine":"barocco","catena":[{"codice":"it","nome":"Italian","termine":"barocco","categoria":"non_precisato"},{"codice":"es","nome":"Spanish","termine":"barrueco","categoria":"non_precisato"},{"codice":"pt","nome":"Portuguese","termine":"barroco","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"verrūca","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Middle French baroque, originally denoting a pearl of irregular shape, from Italian barocco, Spanish barrueco, or Portuguese barroco, all possibly from Latin verrūca (“wart”)."},{"parola":"basta","pos":"intj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"enough, stop, basta","termine_origine":"basta","catena":[{"codice":"