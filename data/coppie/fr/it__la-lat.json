incerta":"no","significato":"panache","termine_origine":"pennacchio","catena":[{"codice":"it","nome":"Italian","termine":"pennacchio","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"pinnāculum","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Inherited from Middle French pennache (“plume of feathers”), borrowed from Italian pennacchio, from Late Latin pinnāculum. Doublet of pinacle."},{"parola":"postiche","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"toupee, hairpiece, wig","termine_origine":"posticcio","catena":[{"codice":"it","nome":"Italian","termine":"posticcio","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"appositīcius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Italian posticcio, from Late Latin appositīcius, from Latin appōnō (“put or place near”)."},{"parola":"virtuose","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"virtuoso","termine_origine":"virtuoso","catena":[{"codice":"it","nome":"Italian","termine":"virtuoso","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"virtuōsus","categoria":"latinismo_dotto"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Italian virtuoso. Doublet of vertueux."}]}