{"arrivo":"fr","origine":"oc","origine_nome":"Occitan","livello2":"la-vul","livello2_nome":"Vulgar Latin","n":11,"parole":[{"parola":"bouléguer","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to move","termine_origine":"bolegar","catena":[{"codice":"oc","nome":"Occitan","termine":"bolegar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bullico","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan bolegar, which inherited it from Vulgar Latin *bullicāre. Doublet of bouger."},{"parola":"cabri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kid (young goat)","termine_origine":"cabrit","catena":[{"codice":"oc","nome":"Occitan","termine":"cabrit","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"capritus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan cabrit (“(goat) kid”), from Vulgar Latin capritus (“billy goat”). Doublet of chevri. Compare Spanish cabrito."},{"parola":"cagnotte","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pool, pot (of money, for distribution)","termine_origine":"cagnoto","catena":[{"codice":"oc","nome":"Occitan","termine":"cagnoto","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Occitan cagnoto, canhòta, cagn, cagno, cagni, from Vulgar Latin *cania, from Latin canis."},{"parola":"carnassier","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"carnivorous","termine_origine":"carnacier","catena":[{"codice":"oc","nome":"Occitan","termine":"carnacier","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*carnacea","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan carnacier or Provençal carnaza, from Vulgar Latin *carnacea, from Latin carnem (“meat”)."},{"parola":"emparer","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to seize, get hold of","termine_origine":"emparar","catena":[{"codice":"oc","nome":"Occitan","termine":"emparar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*imparāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan emparar, from Vulgar Latin *imparāre (the native form would be *emperer). Compare Italian imparare (“to learn”)."},{"parola":"esquinter","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"to damage, ruin, or wear out, especially through use or misuse","termine_origine":"esquintar","catena":[{"codice":"oc","nome":"Occitan","termine":"esquintar","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Occitan esquintar, from Old Occitan esquintar, probably from Vulgar Latin *exquintare (“divide into five”), from Latin ex- + quintus."},{"parola":"jas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"sheepfold","termine_origine":"jatz","catena":[{"codice":"oc","nome":"Occitan","termine":"jatz","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*jacium","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Occitan jatz, from Vulgar Latin *jacium, from jacēre, jaceō. Compare gésir (“to lie, to be buried”) and gîte (“lodging”)."},{"parola":"muge","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mullet (fish)","termine_origine":"muge","catena":[{"codice":"oc","nome":"Occitan","termine":"muge","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*mūgō","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan muge, from Vulgar Latin *mūgō (cf. Italian muggine), a noun based on Latin mūgil (“mullet”)."},{"parola":"panicaut","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"eryngo, sea holly (of genus Eryngium)","termine_origine":"panicaut","catena":[{"codice":"oc","nome":"Occitan","termine":"panicaut","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*panecaldus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan panicaut, from Vulgar Latin *panecaldus, alteration of Gaulish Latin *panecardus, from panis + cardus."},{"parola":"pastis","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pastis","termine_origine":"pastis","catena":[{"codice":"oc","nome":"Occitan","termine":"pastis","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*pastīcius","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan pastis or Old Occitan pastis, pastitz, from Vulgar Latin *pastīcius, from Late Latin pasta. Doublet of pastiche, which was taken from Italian pasticcio. Compare also pâtisser."},{"parola":"racler","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to scrape (off), to scratch","termine_origine":"rasclar","catena":[{"codice":"oc","nome":"Occitan","termine":"rasclar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Occitan rasclar, from Vulgar Latin *rasclare, from Latin rasculum, from rasus (“razor”). Doublet of râler. Compare also Italian raschiare."}]}