"Latin","termine":"crēditum","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"Borrowed from Italian credito, from Latin crēditum."},{"parola":"dessiner","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to draw, to sketch","termine_origine":"disegnare","catena":[{"codice":"it","nome":"Italian","termine":"disegnare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"designo","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Middle French desseigner, borrowed from Italian disegnare, from Latin designāre. Doublet of désigner."},{"parola":"diane","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"reveille","termine_origine":"diana","catena":[{"codice":"it","nome":"Italian","termine":"diana","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"Diana","categoria":"non_precisato"}],"lontana":"la","ambiti":["militare","diritto_politica"],"via":"","testo":"From Italian diana, from Latin Diana."},{"parola":"dito","pos":"noun|adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ditto","termine_origine":"ditto","catena":[{"codice":"it","nome":"Italian","termine":"ditto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dicere","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"Borrowed from Italian ditto, a variant of detto (past participle of dire (“to say”)), from Latin dicere."},{"parola":"diva","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a diva","termine_origine":"","catena":[{"codice":"it","nome":"Italian","termine":"","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian, from Latin, the feminine form of dīvus (“divine one; deified mortal”)."},{"parola":"dom","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"title of respect given to certain monks and other religious figures","termine_origine":"don","catena":[{"codice":"it","nome":"Italian","termine":"don","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dominus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowing from Italian don or older dom, from Latin dominus (“master”). Cognate with English don."},{"parola":"dôme","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"cathedral of a town or city, especially in Italy or Germany","termine_origine":"duomo","catena":[{"codice":"it","nome":"Italian","termine":"duomo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"domus (ecclesiae)","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"οἶκος τῆς ἐκκλησίας","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Middle French domme, dome, borrowed from Italian duomo, from Latin domus (ecclesiae) (literally “house (of the church)”), a calque of Ancient Greek οἶκος τῆς ἐκκλησίας (oîkos tês ekklēsías)."},{"parola":"escale","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"port of call","termine_origine":"scala","catena":[{"codice":"it","nome":"Italian","termine":"scala","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"scāla","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian scala, from Latin scāla. Doublet of échelle, which was inherited."},{"parola":"esplanade","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"esplanade, plaza, square, piazza","termine_origine":"spianata","catena":[{"codice":"it","nome":"Italian","termine":"spianata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"explānātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian spianata with influx from Spanish explanada, both from Latin explānātus."},{"parola":"estouffade","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"estouffade","termine_origine":"stufata","catena":[{"codice":"it","nome":"Italian","termine":"stufata","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"extufo","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"τύφος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Italian stufata (“stew”), from Latin extufare, from Ancient Greek τύφος (túphos, “steam”). Compare Italian stufato, Greek στιφάδο (stifádo)."},{"parola":"flageolet","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"A type of small light green kidney-shaped bean, common in France.","termine_origine":"fagiolo","catena":[{"codice":"it","nome":"Italian","termine":"fagiolo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"phaseolus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"φάσηλος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian fagiolo (“bean”), from Latin phaseolus (“bean”), diminutive form of phasēlus, from Ancient Greek φάσηλος (phásēlos, “bean”)."},{"parola":"flemme","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"laziness","termine_origine":"flemma","catena":[{"codice":"it","nome":"Italian","termine":"flemma","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"phlegma","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian flemma, from Latin phlegma (“phlegm”), one of the four bodily humours, thought to cause a sluggish and unemotional nature. First attested in the late 1700s. Doublet of flegme."},{"parola":"fonte","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"holster (on saddle)","termine_origine":"fonda","catena":[{"codice":"it","nome":"Italian","termine":"fonda","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"funda","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian fonda (“purse”), from Latin funda (“leather pocket, sling”)."},{"parola":"fougue","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"enthusiasm, ardour","termine_origine":"foga","catena":[{"codice":"it","nome":"Italian","termine":"foga","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"fuga","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Middle French (16th century), from Italian foga, from Latin fuga. Doublet of fugue."},{"parola":"fruste","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rough, uncouth, coarse","termine_origine":"frusto","catena":[{"codice":"it","nome":"Italian","termine":"frusto","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"frustum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian frusto (“morsel”), from Latin frustum."},{"parola":"fugue","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fugue","termine_origine":"fuga","catena":[{"codice":"it","nome":"Italian","termine":"fuga","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fuga","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Ca. 1600, borrowed in the musical sense from Italian fuga, itself a borrowing from Latin fuga. Doublet of fougue (from the inherited Italian cognate). The sense “flight” (18th c.) may be a new borrowing from the Italian."},{"parola":"grotte","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cave (a large, naturally occurring cavity formed underground)","termine_origine":"grotta","catena":[{"codice":"it","nome":"Italian","termine":"grotta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"crypta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian grotta, from Latin crypta. Doublet of crypte."},{"parola":"incarnat","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"carnation","termine_origine":"incarnato","catena":[{"codice":"it","nome":"Italian","termine":"incarnato","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"incarnātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian incarnato, from Latin incarnātus. Doublet of incarné. By surface analysis, incarner + -at."},{"parola":"infanteriste","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"foot soldier, infantryman","termine_origine":"infanteria","catena":[{"codice":"it","nome":"Italian","termine":"infanteria","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"īnfāns","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From infanterie (“infantry”) + -iste, from Italian infanteria, from infante, fante (“a knave, footman, foot soldier”), from Latin īnfāns (“infant”); an exact cognate of Dutch infanterist and German Infanterist."},{"parola":"lento","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"slowly; lento","termine_origine":"lento","catena":[{"codice":"it","nome":"Italian","termine":"lento","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"lentus","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"","categoria":"ereditato"}],"lontana":"itc-pro","ambiti":["musica"],"via":"","testo":"Borrowed from Italian lento. Doublet of lent."},{"parola":"ligue","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"league (alliance, group)","termine_origine":"lega","catena":[{"codice":"it","nome":"Italian","termine":"lega","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"ligō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Middle French ligue, from Italian lega, from the verb legare, from Latin ligō (“to tie”)."},{"parola":"lisser","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"to smooth","termine_origine":"liscio","catena":[{"codice":"it","nome":"Italian","termine":"liscio","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"lixāre","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Probably a borrowing from Italian liscio (“smooth, polished”). Other theories include a crossing of Latin lixāre (presumably related to lixa (“lye”)) and allīsus (“crushed against”). See also Spanish and Portuguese liso, Catalan llis, Italian liscio."},{"parola":"maestro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"maestro","termine_origine":"maestro","catena":[{"codice":"it","nome":"Italian","termine":"maestro","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"magister","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian maestro, from Latin magistrum. Doublet of magister, borrowed from Latin, maître, inherited from Latin, and master, borrowed from English."},{"parola":"manque","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"only used in à la manque","termine_origine":"manco","catena":[{"codice":"it","nome":"Italian","termine":"manco","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mancus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian manco, from Latin mancus."},{"parola":"maquette","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"model, mock-up","termine_origine":"macchietta","catena":[{"codice":"it","nome":"Italian","termine":"macchietta","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"macula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian macchietta (“speck, little spot”), diminutive of macchia (“spot”), ultimately from Latin macula (“spot, stain”)."},{"parola":"mezzanine","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mezzanine; entresol","termine_origine":"mezzanino","catena":[{"codice":"it","nome":"Italian","termine":"mezzanino","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mediānus","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*médʰyos","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["arte"],"via":"","testo":"PIE word  *médʰyos Borrowed from Italian mezzanino, from mezzano (“(adjective) middle; (noun) go-between”) + -ino (diminutive suffix). Mezzano is derived from Latin mediānus (“central, middle”, adjective), from medius (“mid, middle”) (ultimately from Proto-Indo-European *médʰyos (“middle”)) + -ānus "},{"parola":"minestrone","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"minestrone (thick Italian vegetable soup)","termine_origine":"minestrone","catena":[{"codice":"it","nome":"Italian","termine":"minestrone","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ministrō","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Directly from Italian minestrone, from minestra (“soup”, ultimately from Latin ministrō) + -one (augmentative suffix)."},{"parola":"mire","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aim (action of aiming)","termine_origine":"mira","catena":[{"codice":"it","nome":"Italian","termine":"mira","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mīrō","categoria":"non_precisato"}],"lontana":"la","ambiti":["militare","scienza","diritto_politica"],"via":"","testo":"Borrowed from Italian mira, from Latin mīrō (“to wonder at”)."},{"parola":"napolitain","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Neapolitan (of, from or relating to the city of Naples, capital and largest city of Campania, Italy, or the surrounding…","termine_origine":"napoletano","catena":[{"codice":"it","nome":"Italian","termine":"napoletano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"neāpolītānus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"Νεάπολις","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian napoletano, from Latin neāpolītānus, from Neāpolis, from Ancient Greek Νεάπολις (Neápolis, literally “new city”) (whence Naples)."},{"parola":"nielle","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"niello","termine_origine":"niello","catena":[{"codice":"it","nome":"Italian","termine":"niello","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nigellus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Often considered a borrowing from Italian niello (from Latin nigellus), but may also reflect a deverbal of nieller, inherited from the same Latin source, perhaps nevertheless influenced in its spelling by Italian."},{"parola":"nocher","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ferryman","termine_origine":"nocchiero","catena":[{"codice":"it","nome":"Italian","termine":"nocchiero","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nauclērus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ναύκληρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Italian nocchiero, from Latin nauclērus, itself borrowed from Ancient Greek ναύκληρος (naúklēros)."},{"parola":"nonce","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"nuncio","termine_origine":"nunzio","catena":[{"codice":"it","nome":"Italian","termine":"nunzio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nuntius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian nunzio (with phonetic adaptations), itself borrowed from Latin nuntius (“messenger”)."},{"parola":"opéra","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"opera","termine_origine":"opera","catena":[{"codice":"it","nome":"Italian","termine":"opera","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"opera","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian opera, from Latin opera. Doublet of œuvre and opus."},{"parola":"oratorio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"oratorio","termine_origine":"oratorio","catena":[{"codice":"it","nome":"Italian","termine":"oratorio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ōrātōrius","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":["musica"],"via":"","testo":"Borrowed from Italian oratorio. Doublet of oratoire."},{"parola":"ortolan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ortolan bunting","termine_origine":"ortolano","catena":[{"codice":"it","nome":"Italian","termine":"ortolano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"hortulānus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian ortolano, from Latin hortulānus (“gardener”). Doublet of hortelain, found in regional usage."},{"parola":"paillasse","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"clown, buffoon","termine_origine":"pagliaccio","catena":[{"codice":"it","nome":"Italian","termine":"pagliaccio","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"palea","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian pagliaccio, from paglia (“straw”), from Latin palea."},{"parola":"Palermitain","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Palermitan (native or inhabitant of the city of Palermo, Sicily, Italy) (usually male)","termine_origine":"palermitano","catena":[{"codice":"it","nome":"Italian","termine":"palermitano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Panormitānus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian palermitano, from Latin Panormitānus, from Panormus + -itānus."},{"parola":"palermitain","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Palermitan (of, from or relating to the city of Palermo, Sicily, Italy)","termine_origine":"palermitano","catena":[{"codice":"it","nome":"Italian","termine":"palermitano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Panormitānus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian palermitano, from Latin Panormitānus, from Panormus + -itānus."},{"parola":"para-","pos":"prefix","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"para- (“guarding against”)","termine_origine":"para-","catena":[{"codice":"it","nome":"Italian","termine":"para-","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"parō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Via Italian para-, from parare, from Latin parō (“to shield”)."},{"parola":"pastel","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"woad","termine_origine":"pastello","catena":[{"codice":"it","nome":"Italian","termine":"pastello","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pastellum","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina","scienza","arte"],"via":"","testo":"From Italian pastello (“pastel”), from Medieval Latin pastellum (“dough, paste”), from Latin pasta (“dough, paste”), ultimately from Ancient Greek παστός (pastós, “dough, paste”). Doublet of pastille."},{"parola":"patine","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"patina, an oxidation like on bronze or similar effect","termine_origine":"patina","catena":[{"codice":"it","nome":"Italian","termine":"patina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"patina","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian patina, itself from Latin patina (“plate, pan”)."},{"parola":"pergola","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pergola","termine_origine":"pergola","catena":[{"codice":"it","nome":"Italian","termine":"pergola","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pergula","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Italian pergola."},{"parola":"piston","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"piston","termine_origine":"pistone","catena":[{"codice":"it","nome":"Italian","termine":"pistone","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pistō","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"16th century in the sense of \"pestle\", borrowed from Italian pistone (15th century), from Latin pistō (“to pound”), from the root of pīnsō (“to crush”)."},{"parola":"polenta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"polenta","termine_origine":"polenta","catena":[{"codice":"it","nome":"Italian","termine":"polenta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"polenta","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian polenta."},{"parola":"pommade","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ointment (a thick viscous preparation for application to the skin, often containing medication)","termine_origine":"pomata","catena":[{"codice":"it","nome":"Italian","termine":"pomata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pōmum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pomata, from pomo (“apple”), as such ointments were originally made from apples, from Latin pōmum."},{"parola":"porcelaine","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cowrie, a mollusk of the family Cypraeidae, or its translucent shell","termine_origine":"","catena":[{"codice":"it","nome":"Italian","termine":"","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"porcus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old French (1298 AD) pourcelaine (“cowrie, cockle, or similar univalve seashell; the polished material of these shells”). By metaphorical extension, also fine china, which had a similar appearance. From Italian (13th century, in Marco Polo) porcellana (“cowrie; china; vagina”). From porcella (“"},{"parola":"pécore","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a small farm animal (not necessarily a sheep)","termine_origine":"pecora","catena":[{"codice":"it","nome":"Italian","termine":"pecora","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pecus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian pecora, from Latin pecus."},{"parola":"pédale","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pedal (of bicycle, car etc.)","termine_origine":"pedale","catena":[{"codice":"it","nome":"Italian","termine":"pedale","categoria":"prestito"},{"codice":"la","nom