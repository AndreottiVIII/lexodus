{"arrivo":"fr","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"gmw-pro","livello2_nome":"Proto-West Germanic","n":6,"parole":[{"parola":"baron","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"baron, lord, noble landowner","termine_origine":"baro","catena":[{"codice":"la","nome":"Latin","termine":"baro","categoria":"ereditato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*barō","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*barô","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰerH-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["diritto_politica"],"via":"","testo":"Inherited from Middle French baron, from Old French baron, from Latin barōnem.","origine_varieta":"la"},{"parola":"bigre","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"a forest ranger who sought out swarms of bees in the forest, tended to them, and gathered their honey and wax","termine_origine":"bigrus","catena":[{"codice":"la","nome":"Latin","termine":"bigrus","categoria":"ereditato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*bijakaʀjō","categoria":"non_precisato"},{"codice":"ang","nome":"Old English","termine":"bēocere","categoria":"non_precisato"}],"lontana":"ang","ambiti":[],"via":"","testo":"From Middle French bigre, from Old French bigre, from Latin bigrus, bigarus, from Proto-West Germanic *bijakaʀjō (“beekeeper”), possibly via Old English bēocere (“beekeeper”).","origine_varieta":"la"},{"parola":"chemise","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"shirt (that opens in the front)","termine_origine":"camisia","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"camisia","categoria":"ereditato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*hamiþi","categoria":"prestito"}],"lontana":"gmw-pro","amb