":"prestito"}],"lontana":"pt","ambiti":[],"via":"","alternative":[{"codice":"pt","nome":"Portuguese","termine":"chicotear","categoria":"prestito"},{"codice":"nah","nome":"Nahuatl","termine":"xicohtli","categoria":"prestito"}],"testo":"Borrowed from Portuguese chicotear or chicotar, which itself is from the noun chicote, probably borrowed from either French chicot or Nahuatl xicohtli, equivalent to chicotte + -er."},{"parola":"masser","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably; modificatore <unc> nel legame","significato":"to massage","termine_origine":"amassar","catena":[{"codice":"pt","nome":"Portuguese","termine":"amassar","categoria":"prestito"}],"lontana":"pt","ambiti":[],"via":"","alternative":[{"codice":"ar","nome":"Arabic","termine":"مَسَّ","traslitterazione":"massa","categoria":"prestito"},{"codice":"pt","nome":"Portuguese","termine":"amassar","categoria":"prestito"}],"testo":"Probably borrowed around the end of the 18th century from Arabic مَسَّ (massa, “feel, touch”). An alternative possibility is that it was borrowed from Portuguese amassar."},{"parola":"sombrer","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably; perhaps; or from","significato":"to sink","termine_origine":"soçobrar","catena":[{"codice":"pt","nome":"Portuguese","termine":"soçobrar","categoria":"non_precisato"}],"lontana":"pt","ambiti":[],"via":"","alternative":[{"codice":"pt","nome":"Portuguese","termine":"soçobrar","categoria":"non_precisato"},{"codice":"es","nome":"Spanish","termine":"zozobrar","categoria":"non_precisato"},{"codice":"osp","nome":"Old Spanish","termine":"sozobrar","categoria":"non_precisato"},{"codice":"roa-oca","nome":"Old Catalan","termine":"sotsobrar","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"sub","categoria":"non_precisato"}],"testo":"From a Middle French sou