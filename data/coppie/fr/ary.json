{"arrivo":"fr","origine":"ary","origine_nome":"Moroccan Arabic","n":18,"parole":[{"parola":"bendir","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bendir","termine_origine":"بندير","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"بندير","categoria":"prestito"}],"lontana":"ary","ambiti":["musica"],"via":"","testo":"Borrowed from Moroccan Arabic بندير (bandīr)."},{"parola":"bézef","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"(not) much, a lot","termine_origine":"بالزاف","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"بالزاف","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"جزاف","categoria":"non_precisato"},{"codice":"fa-cls","nome":"Classical Persian","termine":"گَزَاف","categoria":"non_precisato"}],"lontana":"fa-cls","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic بالزاف (bizzāf), from Arabic بِالْجُزَاف (bi-l-juzāf), ultimately from Classical Persian گَزَاف (gazāf, “extravagant, excessive, exorbitant”); cognate with Italian bizzeffe."},{"parola":"Chleuh","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a Chleuh","termine_origine":"شلوح","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"شلوح","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic شلوح (šlūḥ)."},{"parola":"chleuh","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Tashelhit; one of the Berber languages","termine_origine":"شلوح","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"شلوح","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic شلوح (šlūḥ), plural of شلح (šilḥ). Moroccan /u/ may have an [ø]-like quality in certain positions. Among the French military in northern Africa (Bataillon d’Afrique), it came to mean “one who cannot speak French or even Arabic”. It was later applied to German-speakers i"},{"parola":"claoui","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"testicle","termine_origine":"قلوة","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"قلوة","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic قلاوي (qlāwi, “testicles”)."},{"parola":"diffa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"feast, banquet (especially for a wedding)","termine_origine":"ضِيفَة","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"ضِيفَة","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic ضِيفَة (ḍīfa)."},{"parola":"doum","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gingerbread tree (Hyphaene thebaica); doum palm","termine_origine":"دوم","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"دوم","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic دوم (dūm)."},{"parola":"ferrane","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"oven","termine_origine":"فران","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"فران","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic فران (farrān)."},{"parola":"fqih","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fqih, faqih","termine_origine":"فقيه","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"فقيه","categoria":"prestito"}],"lontana":"ary","ambiti":["religione"],"via":"","testo":"Borrowed from Moroccan Arabic فقيه (fqīh)."},{"parola":"hebs","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"prison, can","termine_origine":"حبس","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"حبس","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حَبْس","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic حبس (ḥabs), from Arabic حَبْس (ḥabs)."},{"parola":"jdid","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"new","termine_origine":"جديد","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"جديد","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"جَدِيد","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic جديد (jdīd), from Arabic جَدِيد (jadīd)."},{"parola":"khoya","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"brother; male friend","termine_origine":"خويا","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"خويا","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic خويا (ḵūya, “my brother”), ultimately from أخ (ʔaḵḵ, “brother”) + ـي (-i, -ya, “my”)."},{"parola":"mellah","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Moroccan ghetto (area inhabited by Jews)","termine_origine":"ملاح","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"ملاح","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic ملاح (mallāḥ, “saline area”)."},{"parola":"seum","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"frustration, regret","termine_origine":"سم","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"سم","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic سم (summ, samm, “venom, poison, jealousy”)."},{"parola":"taboune","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"vagina","termine_origine":"طبون","catena":[{"codice":"ary","nome":"Moroccan Arabic","termine":"طبون","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Moroccan Arabic طبون (