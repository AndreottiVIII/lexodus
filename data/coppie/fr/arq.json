ategoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic, from Arabic عِرْق (ʕirq)."},{"parola":"flouse","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dosh, dough, bread","termine_origine":"","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"","categoria":"prestito"},{"codice":"ary","nome":"Moroccan Arabic","termine":"","categoria":"prestito"}],"lontana":"ary","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic or Moroccan Arabic فلوس (flūs, “money”)."},{"parola":"gandoura","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gandoura","termine_origine":"","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"قَنْدُورَة","traslitterazione":"qandūra","categoria":"non_precisato"}],"lontana":"ar","ambiti":["moda"],"via":"","testo":"Borrowed from Algerian Arabic, from Arabic قَنْدُورَة (qandūra)."},{"parola":"goum","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"In North Africa, a squadron of the French army made up of native soldiers.","termine_origine":"","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"","categoria":"non_precisato"},{"codice":"ary","nome":"Moroccan Arabic","termine":"ݣُوم","traslitterazione":"gūm","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"قَوْم","traslitterazione":"qawm","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Algerian Arabic, Moroccan Arabic ݣُوم (gūm), from Arabic قَوْم (qawm, “tribe, people”)."},{"parola":"gourbi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gourbi","termine_origine":"قربي","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"قربي","categoria":"prestito"}],"lontana":"arq","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic قربي, from the root ق ر ب (q 