ي","categoria":"prestito"}],"lontana":"arq","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic حركي (ḥarkī), from حركة (ḥarka, “war party, movement”) (standard Arabic حركة (ḥaraka, “war party, movement”))."},{"parola":"harki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Harki","termine_origine":"حَرْكِي","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"حَرْكِي","categoria":"prestito"}],"lontana":"arq","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic حَرْكِي (ḥarkī, “harki”), from Algerian Arabic حركة (ḥarka), from Standard Arabic حَرَكَة (ḥaraka, “movement”)."},{"parola":"harraga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Maghrebi clandestine emigrant trying to reach Europe, particularly through dangerous means.","termine_origine":"حراقة","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"حراقة","categoria":"prestito"}],"lontana":"arq","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic حراقة (ḥarrāga, “burner”). Comes from their habit of burning their identity papers."},{"parola":"kho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"brother, bro","termine_origine":"خو","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"خو","categoria":"prestito"}],"lontana":"arq","ambiti":[],"via":"","testo":"From Algerian Arabic خو (“brother”)."},{"parola":"kif","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kif","termine_origine":"كيف","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"كيف","categoria":"prestito"},{"codice":"ary","nome":"Moroccan Arabic","termine":"كيف","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"كَيْف","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic كيف (kīf) or Moroccan Arabic كيف (kīf), from Arabic كَيْف (kayf, “opiate”)."},{"parola":"kif-kif","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"same, alike","termine_origine":"كيف كيف","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"كيف كيف","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"كَيْفَ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"At first in soldiers’ slang among the Armée d’Afrique. From common Algerian Arabic كيف كيف (kīf kīf, “the same; in the same way”), from كيف (kīf, “how; like”), itself from Arabic كَيْفَ (kayfa)."},{"parola":"macache","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"none, nothing","termine_origine":"ماكاش","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"ماكاش","categoria":"prestito"}],"lontana":"arq","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic ماكاش (“there isn't any, there aren't any”)."},{"parola":"merguez","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"merguez","termine_origine":"مرقاز","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"مرقاز","categoria":"prestito"}],"lontana":"arq","ambiti":["cucina"],"via":"","testo":"Borrowed from Algerian Arabic مرقاز (margāz)."},{"parola":"niquer","pos":"verb","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"to fuck, shag, screw","termine_origine":"نيك","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"نيك","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"ناكَ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic نيك (nīk), imperfect stem of ناك (nāk), from Arabic ناكَ (nāka). This is the accepted etymology; a theoretically possible derivation from unrelated Dutch neuken is unlikely both on phonetic grounds and because the vulgar use of this word was originally restricted to the"},{"parola":"razzia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"raid, foray","termine_origine":"غَزِيَّة","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"غَزِيَّة","categoria":"prestito"}],"lontana":"arq","ambiti":["militare","diritto_politica"],"via":"","testo":"From earlier razia (1830), gazia (1808), borrowed from Algerian Arabic غَزِيَّة (ḡaziya), classical Arabic غَزْوَة (ḡazwa, “raid, military campaign”). Compare Portuguese gazia."},{"parola":"raï","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"raï (form of music originating from Algeria)","termine_origine":"راي","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"راي","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"رَأْي","categoria":"non_precisato"}],"lontana":"ar","ambiti":["musica"],"via":"","testo":"Borrowed from Algerian Arabic راي (rāy, “opinion”), from Arabic رَأْي (raʔy, “opinion”)."},{"parola":"toubib","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"medic, doc","termine_origine":"طبيب","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"طبيب","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"طَبِيب","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From 19th-century military slang, borrowed from Algerian Arabic طبيب (ṭbīb), from Arabic طَبِيب (ṭabīb, “doctor”)."},{"parola":"zbeul","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"disorder, shambles","termine_origine":"زبل","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"زبل","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"زِبْل","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic زبل (zbal), from Arabic زِبْل (zibl)."},{"parola":"zlabia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jalebi","termine_origine":"زلابية","catena":[{"codice":"arq","nome":"Algerian Arabic","termine":"زلابية","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"زَلَابِيَّة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Algerian Arabic زلابية (zlābiyya), from Arabic زَلَابِيَّة (zalābiyya)."}]}