{"arrivo":"lt","origine":"be","origine_nome":"Belarusian","livello2":"pl","livello2_nome":"Polish","n":5,"parole":[{"parola":"alyva","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"olive tree (Olea europaea)","termine_origine":"аліва","catena":[{"codice":"be","nome":"Belarusian","termine":"аліва","categoria":"prestito"},{"codice":"pl","nome":"Polish","termine":"oliwa","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Belarusian аліва (aliva) or Polish oliwa; ultimately from Latin olīva (“olive”)."},{"parola":"bagočius","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rich man","termine_origine":"багач","catena":[{"codice":"be","nome":"Belarusian","termine":"багач","categoria":"prestito"},{"codice":"pl","nome":"Polish","termine":"bogacz","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*bogačь","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Belarusian багач (bahač) or Polish bogacz, ultimately derived from Proto-Slavic *bogačь."},{"parola":"dėkoti","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to thank","termine_origine":"дзя́ка","catena":[{"codice":"be","nome":"Belarusian","termine":"дзя́ка","categoria":"prestito"},{"codice":"pl","nome":"Polish","termine":"dzięka","categoria":"non_precisato"}],"lontana":"pl","ambiti":[],"via":"","testo":"Verbal formation from dėkà (“thanks”), itself borrowed from Belarusian дзя́ка (dzjáka), itself borrowed from Polish dzięka (“thanks, gratitude”)."},{"parola":"kaminas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chimney","termine_origine":"ко́мін","catena":[{"codice":"be","nome":"Belarusian","termine":"ко́мін","categoria":"prestito"},{"codice":"pl","nome":"Polish","termine":"komin","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Belarusian ко́мін (