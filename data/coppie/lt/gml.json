{"arrivo":"lt","origine":"gml","origine_nome":"Middle Low German","n":6,"parole":[{"parola":"budelis","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"executioner","termine_origine":"bodel","catena":[{"codice":"gml","nome":"Middle Low German","termine":"bodel","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*budilaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Middle Low German bodel, from Proto-Germanic *budilaz."},{"parola":"gatvė","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"street","termine_origine":"gāte","catena":[{"codice":"gml","nome":"Middle Low German","termine":"gāte","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*gatwǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Middle Low German gāte + -vė, from Proto-Germanic *gatwǭ (“street, passage”). Compare Latvian gate, gatva, gatve."},{"parola":"kryklė","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bullace (Prunus domestica ssp. insititia)","termine_origine":"krike","catena":[{"codice":"gml","nome":"Middle Low German","termine":"krike","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Krickente","categoria":"prestito"}],"lontana":"de","ambiti":["cucina"],"via":"","testo":"The cherry from former krýkė, from Middle Low German krike, see German Krieche for more. The duck, after the call of the teal described as krlik, the common teal called in German Krickente and the garganey in German Knäkente."},{"parola":"persikas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"peach","termine_origine":"persik","catena":[{"codice":"gml","nome":"Middle Low German","termine":"persik","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"persicum","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"From Middle Low German përsik (whence Middle High German pfërsich, German Pfersich), from Latin persicum, possibly via Russian пе́рсик (pérsik)."},{"parola":"rūmas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"palace, chamber","termine_origine":"rūm","catena":[{"codice":"gml","nome":"Middle Low German","termine":"rūm","categoria":"prestito"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*rūm","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"Borrowed from Middle Low German rūm (“space, room”) (whence also Latvian rūme (“space, room”)), from Proto-West Germanic *rūm (“room, open space”)."},{"parola":"šachta","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"mine","termine_origine":"schacht","catena":[{"codice":"gml","nome":"Middle Low German","termine":"schacht","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"ша́хта","categoria":"prestito"}],"lontana":"ru","ambiti":[],"via":"","testo":"From Middle Low German schacht, most likely via Russian ша́хта (šáxta)."}]}