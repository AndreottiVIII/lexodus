{"arrivo":"lt","origine":"pl","origine_nome":"Polish","n":79,"n_alternative":5,"parole":[{"parola":"abazas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"crowd, throng, herd","termine_origine":"obóz","catena":[{"codice":"pl","nome":"Polish","termine":"obóz","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish obóz (“camp, outdoor event”)."},{"parola":"abičajus","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"custom, manner","termine_origine":"obyczaj","catena":[{"codice":"pl","nome":"Polish","termine":"obyczaj","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish obyczaj."},{"parola":"actas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"vinegar","termine_origine":"ocet","catena":[{"codice":"pl","nome":"Polish","termine":"ocet","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish ocet."},{"parola":"advernykas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"doorman, porter, door guard","termine_origine":"odźwiernik","catena":[{"codice":"pl","nome":"Polish","termine":"odźwiernik","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish odźwiernik. Taken by folk etymology to be derived from adverija (“doorway”), which is a loanword from Belarusian and only distantly related."},{"parola":"advokas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jail, prison","termine_origine":"odwach","catena":[{"codice":"pl","nome":"Polish","termine":"odwach","categoria":"prestito"},{"codice":"de","nome":"German","termine":"Hauptwache","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Borrowed from Polish odwach, from German Hauptwache."},{"parola":"agrastas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gooseberry (a thorny bush, Ribes uva-crispa, or its fruit)","termine_origine":"agrest","catena":[{"codice":"pl","nome":"Polish","termine":"agrest","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish agrest (“gooseberry”), in turn borrowed from Italian agresto (“sour grape, verjuice”)."},{"parola":"agurkas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cucumber (plant or its fruit)","termine_origine":"ogórek","catena":[{"codice":"pl","nome":"Polish","termine":"ogórek","categoria":"prestito"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἀγγούριον","traslitterazione":"angoúrion","categoria":"non_precisato"}],"lontana":"gkm","ambiti":["cucina"],"via":"","testo":"Borrowed from Polish ogórek, ultimately from Byzantine Greek ἀγγούριον (angoúrion, “small cucumber”)."},{"parola":"aidukas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"servant, personal attendant","termine_origine":"ajduk","catena":[{"codice":"pl","nome":"Polish","termine":"ajduk","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish ajduk, the same source as eidukas (“soldier”)."},{"parola":"akcentas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"accent (i.e. how someone speaks)","termine_origine":"akcent","catena":[{"codice":"pl","nome":"Polish","termine":"akcent","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":""},{"parola":"aliejus","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"oil (plant-based fat frequently used in cooking or unctions)","termine_origine":"olej","catena":[{"codice":"pl","nome":"Polish","termine":"olej","categoria":"prestito"},{"codice":"be","nome":"Belarusian","termine":"алей","traslitterazione":"aljej","categoria":"prestito"}],"lontana":"be","ambiti":[],"via":"","testo":"Borrowed from Polish olej or Belarusian алей (aljej, “oil”), ultimately from Latin oleum (“olive oil”)."},{"parola":"apaštalas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"apostle","termine_origine":"apostoł","catena":[{"codice":"pl","nome":"Polish","termine":"apostoł","categoria":"prestito"},{"codice":"cs","nome":"Czech","termine":"apoštol","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"apostolus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀπόστολος","traslitterazione":"apóstolos","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"Borrowed from Polish apostoł (with possible influence from Czech apoštol given the -š- instead of -s-), from Latin apostolus, from Ancient Greek ἀπόστολος (apóstolos, “one sent forth, apostle”)."},{"parola":"arbata","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tea plant","termine_origine":"herbata","catena":[{"codice":"pl","nome":"Polish","termine":"herbata","categoria":"prestito"}],"lontana":"pl","ambiti":["cucina"],"via":"","testo":"Borrowed from Polish herbata (“tea”). Compare Belarusian гарбата (harbata)."},{"parola":"artimas","pos":"adj|noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"nearby, close","termine_origine":"bliźni","catena":[{"codice":"pl","nome":"Polish","termine":"bliźni","categoria":"calco"}],"lontana":"pl","ambiti":[],"via":"","testo":"From arti̇̀ (“nearby”, adverb) + -imas. The noun is a nominalization of the adjective, while also a calque of Polish bliźni."},{"parola":"bajoras","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"boyar","termine_origine":"bojar","catena":[{"codice":"pl","nome":"Polish","termine":"bojar","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"боя́ре","traslitterazione":"bojáre","categoria":"non_precisato"}],"lontana":"ru","ambiti":["diritto_politica"],"via":"","testo":"Borrowed from Polish bojar, from Russian боя́ре (bojáre), plural of боя́рин (bojárin)."},{"parola":"bokštas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tower","termine_origine":"baszta","catena":[{"codice":"pl","nome":"Polish","termine":"baszta","categoria":"non_precisato"}],"lontana":"pl","ambiti":["sport"],"via":"","testo":"Derived from Polish baszta with epenthesis. Cognate with English bastion."},{"parola":"braškė","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; Possibly","significato":"strawberry, garden strawberry (Fragaria × ananassa)","termine_origine":"moroszka","catena":[{"codice":"pl","nome":"Polish","termine":"moroszka","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"морошка","traslitterazione":"moroška","categoria":"prestito"}],"lontana":"ru","ambiti":[],"via":"","testo":"Uncertain. Possibly from Polish moroszka (“cloudberry”), if not directly from Russian морошка (moroška), Or, less likely, from braškėti (“break, fall apart”)"},{"parola":"bulvė","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"potato (plant or tuber)","termine_origine":"bulwa","catena":[{"codice":"pl","nome":"Polish","termine":"bulwa","categoria":"prestito"}],"lontana":"pl","ambiti":["cucina"],"via":"","testo":"Borrowed from Polish bulwa (“tuber”). Compare also Latvian buļvas, Belarusian бу́льба (búlʹba)."},{"parola":"cinamonas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cinnamon","termine_origine":"cynamon","catena":[{"codice":"pl","nome":"Polish","termine":"cynamon","categoria":"prestito"}],"lontana":"pl","ambiti":["cucina"],"via":"","testo":"Borrowed from Polish cynamon (“cinnamon”)."},{"parola":"citrina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lemon","termine_origine":"cytryna","catena":[{"codice":"pl","nome":"Polish","termine":"cytryna","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"citrus","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Polish cytryna, ultimately from Latin citrus."},{"parola":"cukierka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"candy, sweet","termine_origine":"cukierek","catena":[{"codice":"pl","nome":"Polish","termine":"cukierek","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Probably borrowed from Polish cukierek. Cognate to Samogitian sokierka."},{"parola":"cukrus","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sugar","termine_origine":"cukier","catena":[{"codice":"pl","nome":"Polish","termine":"cukier","categoria":"prestito"},{"codice":"gmh","nome":"Middle High German","termine":"zucker","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"zucchero","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"سُكَّر","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"škl","traslitterazione":"šakar","categoria":"prestito"},{"codice":"pgd","nome":"Gandhari","termine":"𐨭𐨐𐨪","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"शर्क॑रा","categoria":"ereditato"},{"codice":"inc-pro","nome":"Proto-Indo-Aryan","termine":"*śárkaraH","categoria":"ereditato"},{"codice":"iir-pro","nome":"Proto-Indo-Iranian","termine":"*ćárkaraH","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ḱorkeh₂","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Polish cukier (“sugar”), ultimately from German Zucker. Cognate with Latvian cukurs, which was directly borrowed from German."},{"parola":"egzaminas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"exam, examination","termine_origine":"egzamin","catena":[{"codice":"pl","nome":"Polish","termine":"egzamin","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"exāmen","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Polish egzamin, from Latin exāmen. Compare Russian экза́мен (ekzámen)."},{"parola":"egzistuoti","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"to exist","termine_origine":"egzystować","catena":[{"codice":"pl","nome":"Polish","termine":"egzystować","categoria":"non_precisato"}],"lontana":"pl","ambiti":[],"via":"","testo":"Latin exsistō + -uoti, possibly influenced by Polish egzystować."},{"parola":"eidukas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"soldier, infantryman, artilleryman","termine_origine":"ajduk","catena":[{"codice":"pl","nome":"Polish","termine":"ajduk","categoria":"prestito"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Polish ajduk, the same source as aidukas (“servant”)."},{"parola":"fotkė","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"photo","termine_origine":"fotka","catena":[{"codice":"pl","nome":"Polish","termine":"fotka","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"фо́тка","traslitterazione":"fótka","categoria":"prestito"}],"lontana":"ru","ambiti":[],"via":"","testo":"Possibly borrowed from Polish fotka and/or Russian фо́тка (fótka)."},{"parola":"grietinėlė","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"sì","motivo_incerta":"Possibly","significato":"cream, sweet cream (oily part of milk)","termine_origine":"śmietanka","catena":[{"codice":"pl","nome":"Polish","termine":"śmietanka","categoria":"calco"}],"lontana":"pl","ambiti":["cucina"],"via":"","testo":"grietinė + -ėlė, possibly as a calque of Polish śmietanka."},{"parola":"guma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gum","termine_origine":"guma","catena":[{"codice":"pl","nome":"Polish","termine":"guma","categoria":"prestito"}],"lont