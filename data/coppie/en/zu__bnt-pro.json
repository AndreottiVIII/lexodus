{"arrivo":"en","origine":"zu","origine_nome":"Zulu","livello2":"bnt-pro","livello2_nome":"Proto-Bantu","n":8,"parole":[{"parola":"impala","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"An African antelope, Aepyceros melampus, noted for its leaping ability; the male has ridged, curved horns.","termine_origine":"ímpala","catena":[{"codice":"zu","nome":"Zulu","termine":"ímpala","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mpàdá","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu ímpala, from Proto-Bantu *mpàdá."},{"parola":"inkosi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A chief (particularly Zulu).","termine_origine":"ínkôsi","catena":[{"codice":"zu","nome":"Zulu","termine":"ínkôsi","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*nkócì","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu ínkôsi (“chief, king”), from Proto-Bantu *nkócì (“lion”). Doublet of kgosi."},{"parola":"inyanga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"In Zulu communities, a traditional doctor or healer","termine_origine":"ínyanga","catena":[{"codice":"zu","nome":"Zulu","termine":"ínyanga","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mʊ̀gàngà","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Zulu ínyanga, from Proto-Bantu *mʊ̀gàngà. Doublet of mganga and ngaka."},{"parola":"mamba","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Any of various venomous snakes of the genus Dendroaspis, native to Africa, that live in trees.","termine_origine":"ímâmba","catena":[{"codice":"zu","nome":"Zulu","termine":"ímâmba","categoria":"non_precisato"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mbámbà","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Derived from Zulu ímâmba, from Proto-Bantu *mbámbà."},{"parola":"muti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Traditional African medicine.","termine_origine":"úmuthí","catena":[{"codice":"zu","nome":"Zulu","termine":"úmuthí","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mʊ̀tɪ́","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu úmuthí (“shrub, tree, medicine”), from Proto-Bantu *mʊ̀tɪ́."},{"parola":"sangoma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"A (usually female) traditional healer or herbalist, or witch doctor.","termine_origine":"isángoma","catena":[{"codice":"zu","nome":"Zulu","termine":"isángoma","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*ngòmà","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu isángoma (“diviner, witch doctor, sangoma”), possibly from i- + sa- (prefix meaning ‘of’) + íngoma (“dance song performed at a festival; hymn”). The English word is cognate with Afrikaans sangoma, Swazi sángoma."},{"parola":"tshwala","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional African beer made from sorghum.","termine_origine":"útshwalá","catena":[{"codice":"zu","nome":"Zulu","termine":"útshwalá","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*bʊ̀jàdʊ́á","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu útshwalá, from Proto-Bantu *bʊ̀jàdʊ́á."},{"parola":"umlungu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A white person.","termine_origine":"uḿlungu","catena":[{"codice":"zu","nome":"Zulu","termine":"uḿlungu","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*m