{"arrivo":"en","origine":"xcb","origine_nome":"Cumbric","n":10,"n_alternative":0,"parole":[{"parola":"bumfit","pos":"num","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Fifteen in Cumbrian sheep counting.","termine_origine":"*pǝmtheg","catena":[{"codice":"xcb","nome":"Cumbric","termine":"*pǝmtheg","categoria":"non_precisato"}],"lontana":"xcb","ambiti":[],"via":"","testo":"From Cumbric *pǝmtheg (compare Welsh pymtheg), eventually from Cumbric *pımp (“five”) + *deg (“ten”)."},{"parola":"cad","pos":"verb","n_etimologia":2,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; Possibly; modello unc/uncertain","significato":"to mat or felt together","termine_origine":"","catena":[{"codice":"xcb","nome":"Cumbric","termine":"","categoria":"non_precisato"}],"lontana":"xcb","ambiti":[],"via":"","testo":"Uncertain. Ferguson (1875) thought this to be of Celtic origin; possibly from a Cumbric equivalent to Welsh cydio (“to join, couple”)."},{"parola":"carr","pos":"noun","n_etimologia":3,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"Rock.","termine_origine":"*carreg","catena":[{"codice":"xcb","nome":"Cumbric","termine":"*carreg","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kh₂er-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Northumbrian Old English carr; possibly adopted from a Cumbric *carreg, ultimately from Proto-Indo-European *kh₂er- (“hard”)."},{"parola":"coble","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A small flat-bottomed fishing boat suitable for launching from a beach, found on the north-east coast of England and in…","termine_origine":"","catena":[{"codice":"xcb","nome":"Cumbric","termine":"","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"caupulus","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"From Middle English coble, from the Cumbric equivalent of Welsh ceubal (“skiff”); ultimately from Latin caupulus."},{"parola":"currick","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"A pile of rocks used as a landmark; a cairn.","termine_origine":"*carreg","catena":[{"codice":"xcb","nome":"Cumbric","termine":"*carreg","categoria":"prestito"},{"codice":"sga","nome":"Old Irish","termine":"crúach","categoria":"prestito"}],"lontana":"sga","ambiti":[],"via":"","testo":"Possibly from Cumbric *carreg (“stone”) or Old Irish crúach (“stack, pile”)."},{"parola":"dick","pos":"num","n_etimologia":4,"categoria":"prestito","incerta":"no","significato":"Ten, in Cumbrian sheep counting.","termine_origine":"*deg","catena":[{"codice":"xcb","nome":"Cumbric","termine":"*deg","categoria":"prestito"},{"codice":"cel-bry-pro","nome":"Proto-Brythonic","termine":"*deg","categoria":"ereditato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*dekam","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*déḱm̥","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Cumbric *deg, from Proto-Brythonic *deg. Cognate with Welsh deg."},{"parola":"dovera","pos":"num","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"nine in Cumbrian sheep counting","termine_origine":"","catena":[{"codice":"xcb","nome":"Cumbric","termine":"","categoria":"non_precisato"},{"codice":"cel-bry-pro","nome":"Proto-Brythonic","termine":"*naw","categoria":"non_precisato"}],"lontana":"cel-bry-pro","ambiti":[],"via":"","testo":"From Cumbric numerals, from an assumed Proto-Brythonic *naw (“nine”). For the initial consonant compare Lithuanian devyni and Proto-Slavic *devętь (“nine”)."},{"parola":"lough","pos":"noun","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"lake, pool","termine_origine":"*luch","catena":[{"codice":"xcb","nome":"Cumbric","termine":"*luch","categoria":"non_precisato"},{"codice":"cel-bry-pro","nome":"Proto-Brythonic","termine":"*lux","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*lokus","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Middle English lough, logh, luh, borrowed from Cumbric *luch, derived from Proto-Brythonic *lux, from Proto-Celtic *lokus (“lake, pool”)."},{"parola":"mether","pos":"num","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Four in the old counting system of Northern England.","termine_origine":"","catena":[{"codice":"xcb","nome":"Cumbric","termine":"","categoria":"non_precisato"}],"lontana":"xcb","ambiti":[],"via":"","testo":"From Cumbric numerals; compare Welsh mhedwar, the nasal mutation of pedwar (“four”)."},{"parola":"yan-a-dick","pos":"num","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"eleven in Cumbrian sheep counting","termine_origine":"*ün gwar ðeg","catena":[{"codice":"xcb","nome":"Cumbric","termine":"*ün gwar ðeg","categoria":"non_precisato"}],"lontana":"xcb","ambiti":[],"via":"","testo":"From Cumbric *ün gwar ðeg (literally “one over ten”). Compare Welsh un ar ddeg."}]}