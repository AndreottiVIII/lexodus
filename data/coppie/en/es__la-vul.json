{"arrivo":"en","origine":"es","origine_nome":"Spanish","livello2":"la-vul","livello2_nome":"Vulgar Latin","n":17,"parole":[{"parola":"abuelo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Hispanic grandfather.","termine_origine":"abuelo","catena":[{"codice":"es","nome":"Spanish","termine":"abuelo","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*aviolum","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish abuelo."},{"parola":"bonanza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A rich mine or vein of silver or gold.","termine_origine":"bonanza","catena":[{"codice":"es","nome":"Spanish","termine":"bonanza","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bonacia","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"μᾰλᾰκῐ́ᾱ","categoria":"prestito"}],"lontana":"grc","ambiti":["finanza"],"via":"","testo":"Borrowed from Spanish bonanza (“dead calm, fair weather, good luck, rich lode”), from Vulgar Latin *bonacia (“lull, dead calm”), in turn from Latin malacia (“calm sea”), influenced by bonus (“good”) under the false impression that initial mal- is a derivate of malus (“bad”)."},{"parola":"calabaza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A burr gherkin.","termine_origine":"calabaza","catena":[{"codice":"es","nome":"Spanish","termine":"calabaza","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*calapaccia","categoria":"ereditato"},{"codice":"qsb-ibe","nome":"Paleo-Hispanic","termine":"","categoria":"prestito"}],"lontana":"qsb-ibe","ambiti":["cucina"],"via":"","testo":"Borrowed from Spanish calabaza."},{"parola":"cecina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Salted, dried meat.","termine_origine":"cecina","catena":[{"codice":"es","nome":"Spanish","termine":"cec