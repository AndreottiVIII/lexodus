{"arrivo":"en","origine":"tpi","origine_nome":"Tok Pisin","n":12,"parole":[{"parola":"aibika","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The flowering plant Abelmoschus manihot.","termine_origine":"aibika","catena":[{"codice":"tpi","nome":"Tok Pisin","termine":"aibika","categoria":"prestito"},{"codice":"ksd","nome":"Tolai","termine":"ibika","categoria":"non_precisato"}],"lontana":"ksd","ambiti":[],"via":"","testo":"From Tok Pisin aibika, from Tolai ibika."},{"parola":"bagarap","pos":"adj|verb|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"broken down; broken; wrecked; messed up","termine_origine":"bagarap","catena":[{"codice":"tpi","nome":"Tok Pisin","termine":"bagarap","categoria":"prestito"},{"codice":"en","nome":"English","termine":"bugger up","categoria":"ereditato"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from Tok Pisin bagarap, from English bugger up."},{"parola":"bus kanaka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"An uncivilized person; a person who follows a traditional rather than a modern lifestyle.","termine_origine":"bus kanaka","catena":[{"codice":"tpi","nome":"Tok Pisin","termine":"bus kanaka","categoria":"prestito"}],"lontana":"tpi","ambiti":[],"via":"","testo":"Borrowed from Tok Pisin bus kanaka."},{"parola":"didiman","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A male worker in the department of agriculture.","termine_origine":"didiman","catena":[{"codice":"tpi","nome":"Tok Pisin","termine":"didiman","categoria":"non_precisato"}],"lontana":"tpi","ambiti":[],"via":"","testo":"From Tok Pisin didiman."},{"parola":"garamut","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A type of slit drum make in Papua New Guinea.","termine_origine":"garamut","catena":[{"codice":"tpi","nome":"Tok Pisin","termine":"garamut","categoria":"prestito"}],"lontana":"tpi","am