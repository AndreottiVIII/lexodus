{"arrivo":"en","origine":"zu","origine_nome":"Zulu","n":52,"parole":[{"parola":"amapiano","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A house music subgenre that emerged in South Africa, often incorporating jazz piano and lounge music.","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"prestito"}],"lontana":"zu","ambiti":["musica"],"via":"","testo":"Borrowed from Zulu [Term?] (literally “the pianos”)."},{"parola":"amasi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sour milk","termine_origine":"ī́si","catena":[{"codice":"zu","nome":"Zulu","termine":"ī́si","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu amási."},{"parola":"chisa nyama","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A barbecue or braai.","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu [Term?]."},{"parola":"gogo","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"Grandmother; elderly woman.","termine_origine":"úgógo","catena":[{"codice":"zu","nome":"Zulu","termine":"úgógo","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu úgógo."},{"parola":"gqom","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A minimalistic style of house music from South Africa.","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"prestito"}],"lontana":"zu","ambiti":["musica"],"via":"","testo":"Derived from an onomatopoeic combination of click consonants from the Zulu language, representing the sound of a drum."},{"parola":"green mamba","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Dendroaspis angusticeps, a venomous snake native to Africa, the common mamb