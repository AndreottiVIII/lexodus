}],"lontana":"zu","ambiti":["musica"],"via":"","testo":"From Zulu -khwéla (“get up”)."},{"parola":"laduma","pos":"intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"goal! (cheer when a goal is scored in football)","termine_origine":"laduma","catena":[{"codice":"zu","nome":"Zulu","termine":"laduma","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu laduma, literally \"it thunders\"."},{"parola":"maas","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"sour milk","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu."},{"parola":"madumbi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a yam","termine_origine":"madumbe","catena":[{"codice":"zu","nome":"Zulu","termine":"madumbe","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu madumbe."},{"parola":"mafufunyana","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"In Zulu and Xhosa culture, a mental disorder in which the sufferer is believed to have been possessed by evil spirits,…","termine_origine":"amafufunyane,amafufunyana","catena":[{"codice":"zu","nome":"Zulu","termine":"amafufunyane,amafufunyana","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu amafufunyane,amafufunyana."},{"parola":"magosha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"whore","termine_origine":"umagosha","catena":[{"codice":"zu","nome":"Zulu","termine":"umagosha","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu umagosha."},{"parola":"mahewu","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A sour beverage from Africa, made from cornmeal.","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"non_precisato"}],"lontana":"zu","ambiti":["cucina"],"via":"","testo":"From Zulu."},{"parola":"mamba","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Any of various venomous snakes of the genus Dendroaspis, native to Africa, that live in trees.","termine_origine":"ímâmba","catena":[{"codice":"zu","nome":"Zulu","termine":"ímâmba","categoria":"non_precisato"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mbámbà","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Derived from Zulu ímâmba, from Proto-Bantu *mbámbà."},{"parola":"maskanda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A style of Zulu folk music, normally played solo.","termine_origine":"umaskanda","catena":[{"codice":"zu","nome":"Zulu","termine":"umaskanda","categoria":"prestito"},{"codice":"af","nome":"Afrikaans","termine":"musikant","categoria":"non_precisato"}],"lontana":"af","ambiti":["musica"],"via":"","testo":"From Zulu umaskanda, from Afrikaans musikant (“musician”)."},{"parola":"mbaqanga","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A style of South African music, with rural Zulu roots and a jazz influence, that originated in the 1960s.","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"Zulu"},{"parola":"mbube","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A style of a cappella choral music originating among the Zulus of South Africa.","termine_origine":"imbube","catena":[{"codice":"zu","nome":"Zulu","termine":"imbube","categoria":"non_precisato"}],"lontana":"zu","ambiti":["musica"],"via":"","testo":"From Zulu imbube (“lion”) (uyimbube (“you are a lion”))."},{"parola":"moocha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A loincloth made from animals' tails or strips of skin; part of the traditional dress of Zulu males.","termine_origine":"unmutsha","catena":[{"codice":"zu","nome":"Zulu","termine":"unmutsha","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu unmutsha."},{"parola":"muti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Traditional African medicine.","termine_origine":"úmuthí","catena":[{"codice":"zu","nome":"Zulu","termine":"úmuthí","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mʊ̀tɪ́","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu úmuthí (“shrub, tree, medicine”), from Proto-Bantu *mʊ̀tɪ́."},{"parola":"nagana","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A disease of vertebrates in southern Africa, characterised by swelling and lethargy and caused by trypanosomes transmit…","termine_origine":"ulunakane","catena":[{"codice":"zu","nome":"Zulu","termine":"ulunakane","categoria":"prestito"}],"lontana":"zu","ambiti":["scienza"],"via":"","testo":"Borrowed from Zulu ulunakane, unakane."},{"parola":"Nguni","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"The group of Southern African peoples comprising the Zulu, Xhosa, Swazi, Mpondo and Ndebele nations.","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu noun stem as in umNguni (“member of Nguni people”), isiNguni (“Nguni language group”)."},{"parola":"pekkie","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A black person.","termine_origine":"uḿpheki","catena":[{"codice":"zu","nome":"Zulu","termine":"uḿpheki","categoria":"non_precisato"},{"codice":"af","nome":"Afrikaans","termine":"pik","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"pik","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"Several theories exist. * From Zulu uḿpheki (“cook”). * From Afrikaans pik (“pitch (black material)”), from Dutch pik, pek (“pitch (black material)”). * From piccanin, a form of pickaninny (“black child”)."},{"parola":"puku","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A medium-sized antelope found in Central Africa (Kobus vardonii).","termine_origine":"mpuku","catena":[{"codice":"zu","nome":"Zulu","termine":"mpuku","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu mpuku."},{"parola":"sakabula","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Long-tailed widowbird (Euplectes progne), a bird native to southern Africa.","termine_origine":"isakabuli","catena":[{"codice":"zu","nome":"Zulu","termine":"isakabuli","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu isakabuli."},{"parola":"sangoma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"A (usually female) traditional healer or herbalist, or witch doctor.","termine_origine":"isángoma","catena":[{"codice":"zu","nome":"Zulu","termine":"isángoma","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*ngòmà","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu isángoma (“diviner, witch doctor, sangoma”), possibly from i- + sa- (prefix meaning ‘of’) + íngoma (“dance song performed at a festival; hymn”). The English word is cognate with Afrikaans sangoma, Swazi sángoma."},{"parola":"skabenga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A gangster or thug.","termine_origine":"isígebéngu","catena":[{"codice":"zu","nome":"Zulu","termine":"isígebéngu","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu isígebéngu (“bandit, criminal, gangster”)."},{"parola":"Swazi","pos":"noun|adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A person from Swaziland/Eswatini or of Swazi/Swati descent originally migrating from Central Africa.","termine_origine":"iSwazi","catena":[{"codice":"zu","nome":"Zulu","termine":"iSwazi","categoria":"non_precisato"},{"codice":"ss","nome":"Swazi","termine":"liSwati","categoria":"non_precisato"}],"lontana":"ss","ambiti":[],"via":"","testo":"From Zulu iSwazi, after the name of an early chief, Mswati. The alternative forms come from Swazi liSwati."},{"parola":"Thembu","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A member of a certain South African tribe that speak Xhosa and live in Thembuland.","termine_origine":"umThembu","catena":[{"codice":"zu","nome":"Zulu","termine":"umThembu","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu umThembu (“a Thembu”)."},{"parola":"tokoloshe","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"In Zulu mythology, a mischievous dwarf-like spirit man that can become invisible by drinking water or swallowing a ston…","termine_origine":"","catena":[{"codice":"zu","nome":"Zulu","termine":"","categoria":"prestito"}],"lontana":"zu","ambiti":["scienza"],"via":"","testo":"Borrowed from Zulu [Term?]. Compare Afrikaans tokkelossie."},{"parola":"tshwala","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional African beer made from sorghum.","termine_origine":"útshwalá","catena":[{"codice":"zu","nome":"Zulu","termine":"útshwalá","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*bʊ̀jàdʊ́á","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu útshwalá, from Proto-Bantu *bʊ̀jàdʊ́á."},{"parola":"umfundisi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A teacher, priest, or missionary.","termine_origine":"umfundisi","catena":[{"codice":"zu","nome":"Zulu","termine":"umfundisi","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu umfundisi."},{"parola":"umlungu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A white person.","termine_origine":"uḿlungu","catena":[{"codice":"zu","nome":"Zulu","termine":"uḿlungu","categoria":"prestito"},{"codice":"bnt-pro","nome":"Proto-Bantu","termine":"*mʊ̀jʊ́ngʊ̀","categoria":"ereditato"}],"lontana":"bnt-pro","ambiti":[],"via":"","testo":"Borrowed from Zulu uḿlungu."},{"parola":"umzimbeet","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Millettia grandis, a species of flowering legume tree native to South Africa.","termine_origine":"umSimbithwa","catena":[{"codice":"zu","nome":"Zulu","termine":"umSimbithwa","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu umSimbithwa. Compare Afrikaans omsambeet, omzambeet, oesambiet."},{"parola":"umZulu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Zulu person.","termine_origine":"uḿZulu","catena":[{"codice":"zu","nome":"Zulu","termine":"uḿZulu","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu uḿZulu."},{"parola":"vuvuzela","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A trumpet-shaped horn, now usually plastic, that produces a loud buzzing sound.","termine_origine":"vuvuzela","catena":[{"codice":"zu","nome":"Zulu","termine":"vuvuzela","categoria":"prestito"}],"lontana":"zu","ambiti":["musica","sport"],"via":"","testo":"Borrowed from Zulu vuvuzela (“to make a vu vu noise”), from the /vuː/ sound the horns make."},{"parola":"yebo","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yes","termine_origine":"yebo","catena":[{"codice":"zu","nome":"Zulu","termine":"yebo","categoria":"prestito"}],"lontana":"zu","ambiti":[],"via":"","testo":"Borrowed from Zulu yebo."},{"parola":"zama-zama","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A person who works illegally in abandoned mineshafts in order to retrieve metals or minerals.","termine_origine":"-zama","catena":[{"codice":"zu","nome":"Zulu","termine":"-zama","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"From Zulu -zama, stem of ukuzama (“to try, strive, make an attempt to obtain something”)."},{"parola":"Zulu","pos":"noun|adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A member of an African ethnic group living mainly in the KwaZulu-Natal Province in eastern South Africa.","termine_origine":"uḿZulu","catena":[{"codice":"zu","nome":"Zulu","termine":"uḿZulu","categoria":"non_precisato"}],"lontana":"zu","ambiti":[],"via":"","testo":"Derived from Zulu uḿZulu."}]}