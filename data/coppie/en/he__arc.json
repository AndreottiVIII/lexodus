{"arrivo":"en","origine":"he","origine_nome":"Hebrew","livello2":"arc","livello2_nome":"Aramaic","n":8,"parole":[{"parola":"Amora","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Any of the Jewish scholars of about 200 to 500 CE who orally transmitted the teachings of the Mishna.","termine_origine":"אָמוֹרָא","catena":[{"codice":"he","nome":"Hebrew","termine":"אָמוֹרָא","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"","categoria":"non_precisato"}],"lontana":"arc","ambiti":["religione"],"via":"","testo":"From Hebrew אָמוֹרָא (āmorā), from Aramaic."},{"parola":"chavrusa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A partner with whom one studies Talmud and other topics in Judaism; by extension, any study partner.","termine_origine":"חברותא","catena":[{"codice":"he","nome":"Hebrew","termine":"חברותא","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"חברותא","categoria":"non_precisato"}],"lontana":"arc","ambiti":["religione"],"via":"","testo":"From the Ashkenazic pronunciation of Hebrew חברותא (khavrúta), from Aramaic חברותא (ħavrutaʔ)."},{"parola":"drash","pos":"noun|verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"An exegesis.","termine_origine":"","catena":[{"codice":"he","nome":"Hebrew","termine":"","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"דְּרַשׁ","categoria":"prestito"}],"lontana":"arc","ambiti":["religione"],"via":"","testo":"Borrowed from Hebrew or Aramaic דְּרַשׁ."},{"parola":"kaddish","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Jewish prayer of praise to God recited during services, and specifically when mourning the death of a close relative.","termine_origine":"קַדִּישׁ","catena":[{"codice":"he","nome":"Hebrew","termine":"קַדִּישׁ","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"קַדִּישׁ","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"קַדִּישׁים","categoria":"prestito"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"Borrowed from Hebrew קַדִּישׁ (kadish, “kaddish”), from Aramaic קַדִּישׁ (qaddīš, “holy; holy person”). Doublet of kiddush. The plural form kaddishim is borrowed from Hebrew קַדִּישׁים (kadishim)."},{"parola":"Sabora","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Any of the leading Jewish rabbis who completed the revision of the Babylonian Talmud in the 6th century C.E.","termine_origine":"סָבוֹרָא","catena":[{"codice":"he","nome":"Hebrew","termine":"סָבוֹרָא","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"","categoria":"non_precisato"}],"lontana":"arc","ambiti":[],"via":"","testo":"From Hebrew סָבוֹרָא (sāḇorā), from Aramaic."},{"parola":"Tanna","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"Any of the rabbinic sages whose views are recorded in the Mishna, from approximately 10–220 CE.","termine_origine":"תַּנָּא","catena":[{"codice":"he","nome":"Hebrew","termine":"תַּנָּא","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"","categoria":"non_precisato"}],"lontana":"arc","ambiti":[],"via":"","testo":"From Hebrew תַּנָּא (tannā), from Aramaic."},{"parola":"Ushpizin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"the seven guests who spiritually visit the sukkah during Sukkot.","termine_origine":"אושפיזין","catena":[{"codice":"he","nome":"Hebrew","termine":"אושפיזין","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"אוּשְׁפִּיזָּא","categoria":"non_precisato"},{"codice":"ira","nome":"Iranian","termine":"","categoria":"non_precisato"}],"lontana":"ira","ambiti":["religione"],"via":"","testo":"From Hebrew אושפיזין, from Aramaic אוּשְׁפִּיזָּא (ʾušpīzzā). Ultimately of Iranian origin, related to Persian سپنج (“guest”)."},{"parola":"zuz","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"An ancient Hebrew silver coin, one quarter of a shekel.","termine_origine":"זוּז","catena":[{"codice":"he","nome":"Hebrew","termine":"זוּז","categoria":"non_precisato"},{"codice":"arc","nome":"Aramaic","termine":"זוּזָא","categoria":"non_precisato"}],"lontana":"arc","ambiti":[],"via":"","testo":"From Hebrew זוּז (zūz), from Aramaic זוּזָא (zūzā)."}]}