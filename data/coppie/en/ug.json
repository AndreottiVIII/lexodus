{"arrivo":"en","origine":"ug","origine_nome":"Uyghur","n":8,"n_alternative":0,"parole":[{"parola":"Chagatai","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Of or relating to the Chagatai people or language.","termine_origine":"چاغاتاي","termine_origine_traslitterazione":"chaghatay","catena":[{"codice":"ug","nome":"Uyghur","termine":"چاغاتاي","traslitterazione":"chaghatay","categoria":"non_precisato"},{"codice":"chg","nome":"Chagatai","termine":"چغتای","traslitterazione":"čaġatay","categoria":"non_precisato"},{"codice":"xng","nome":"Middle Mongol","termine":"ᠴᠠᠭᠠᠲᠠᠶ","traslitterazione":"čaɣatay","categoria":"non_precisato"}],"lontana":"xng","ambiti":[],"via":"","testo":"Transliteration of Russian Чагата́й (Čagatáj), from Uyghur چاغاتاي (chaghatay), from Chagatai چغتای (čaġatay), from Middle Mongol ᠴᠠᠭᠠᠲᠠᠶ (čaɣatay)."},{"parola":"khushtar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A bowed stringed instrument from the Uyghur Region of China, having four strings in four courses.","termine_origine":"خۇشتار","termine_origine_traslitterazione":"xushtar","catena":[{"codice":"ug","nome":"Uyghur","termine":"خۇشتار","traslitterazione":"xushtar","categoria":"prestito"}],"lontana":"ug","ambiti":["musica"],"via":"","testo":"Borrowed from Uyghur خۇشتار (xushtar)."},{"parola":"laghman","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Central Asian dish of pulled noodles, meat and vegetables.","termine_origine":"لەڭمەن","termine_origine_traslitterazione":"lengmen","catena":[{"codice":"ug","nome":"Uyghur","termine":"لەڭمەن","traslitterazione":"lengmen","categoria":"prestito"},{"codice":"zh","nome":"Chinese","termine":"拉麵","traslitterazione":"lāmiàn","categoria":"non_precisato"}],"lontana":"zh","ambiti":["cucina"],"via":"","testo":"From Uyghur لەڭمەن (lengmen, “lengmen”), from Chinese 拉麵 /拉面 (lāmiàn). Doublet of lamian, ramen, and ramyeon."},{"parola":"meshrep","pos":"n