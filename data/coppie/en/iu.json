ola":"kunik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Synonym of Eskimo kiss.","termine_origine":"kunik","catena":[{"codice":"iu","nome":"Inuktitut","termine":"kunik","categoria":"prestito"}],"lontana":"iu","ambiti":[],"via":"","testo":"Borrowed from Inuktitut kunik."},{"parola":"muktuk","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"The skin and blubber of a whale, traditionally used as food by the Inuit.","termine_origine":"","catena":[{"codice":"iu","nome":"Inuktitut","termine":"","categoria":"non_precisato"},{"codice":"ik","nome":"Inupiaq","termine":"maktak","categoria":"non_precisato"}],"lontana":"ik","ambiti":["cucina"],"via":"","testo":"From Inuktitut (Inuvialuktun) ᒪᖅᑕᖅ (maqtaq) and Inupiaq maktak (“whaleskin with attached blubber”). Spelling influenced by English muck and tuck."},{"parola":"nanook","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A polar bear.","termine_origine":"ᓇᓄᖅ","termine_origine_traslitterazione":"nanoq","catena":[{"codice":"iu","nome":"Inuktitut","termine":"ᓇᓄᖅ","traslitterazione":"nanoq","categoria":"prestito"}],"lontana":"iu","ambiti":[],"via":"","testo":"Borrowed from Inuktitut ᓇᓄᖅ (nanoq, “polar bear”)."},{"parola":"Nunavimmiut","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A person from Nunavik.","termine_origine":"Nunavimmiut","catena":[{"codice":"iu","nome":"Inuktitut","termine":"Nunavimmiut","categoria":"prestito"}],"lontana":"iu","ambiti":[],"via":"","testo":"Borrowed from Inuktitut Nunavimmiut."},{"parola":"Nunavummiuq","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A person from Nunavut.","termine_origine":"ᓄᓇᕗᒻᒥᐅᖅ","termine_origine_traslitterazione":"nonafommioq","catena":[{"codice":"iu","nome":"Inuktitut","termine":"ᓄᓇᕗᒻᒥᐅᖅ","traslitterazione":"nonafommioq","categoria":"non_precisato"}],"lontana":"iu","ambiti":[],"via":"","testo"