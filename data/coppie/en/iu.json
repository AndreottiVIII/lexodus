ral Aboriginal peoples of coastal Arctic Canada, Alaska, and Greenland.","termine_origine":"ᐃᓄᐃᑦ","termine_origine_traslitterazione":"inoit","catena":[{"codice":"iu","nome":"Inuktitut","termine":"ᐃᓄᐃᑦ","traslitterazione":"inoit","categoria":"prestito"},{"codice":"esx-inu-pro","nome":"Proto-Inuit","termine":"*inuɣ","categoria":"non_precisato"}],"lontana":"esx-inu-pro","ambiti":[],"via":"","testo":"First attested 1755–65. From Inuktitut ᐃᓄᐃᑦ (inoit, “the people”), singular ᐃᓄᒃ (inok, “person”), from Proto-Inuit *inuɣ."},{"parola":"Inuk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of one of the several indigenous peoples from the Arctic who descended from the Thule.","termine_origine":"ᐃᓄᒃ","termine_origine_traslitterazione":"inok","catena":[{"codice":"iu","nome":"Inuktitut","termine":"ᐃᓄᒃ","traslitterazione":"inok","categoria":"prestito"}],"lontana":"iu","ambiti":[],"via":"","testo":"Borrowed from Inuktitut ᐃᓄᒃ (inok, “person”)."},{"parola":"inukshuk","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A structure of piled stones, used as a landmark and traditionally constructed by the Inuit, often resembling a humanoid…","termine_origine":"ᐃᓄᒃᓱᒃ","termine_origine_traslitterazione":"inoksok","catena":[{"codice":"iu","nome":"Inuktitut","termine":"ᐃᓄᒃᓱᒃ","traslitterazione":"inoksok","categoria":"non_precisato"}],"lontana":"iu","ambiti":[],"via":"","testo":"From Inuktitut ᐃᓄᒃᓱᒃ (inoksok, “in the likeness of a human”)."},{"parola":"Iqalungmiut","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"One or more inhabitants of Iqaluit (formerly Frobisher Bay).","termine_origine":"","catena":[{"codice":"iu","nome":"Inuktitut","termine":"","categoria":"prestito"}],"lontana":"iu","ambiti":[],"via":"","testo":"Borrowed from Inuktitut [Term?]."},{"parola":"kamik","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A mukluk.","termine_