{"arrivo":"en","origine":"tn","origine_nome":"Tswana","n":34,"n_alternative":3,"parole":[{"parola":"borele","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"A black rhinoceros (Diceros bicornis).","termine_origine":"bodile","catena":[{"codice":"tn","nome":"Tswana","termine":"bodile","categoria":"non_precisato"}],"lontana":"tn","ambiti":[],"via":"","testo":"Probably from Tswana bodile (“black rhinoceros”)."},{"parola":"kaama","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The hartebeest.","termine_origine":"kgama","catena":[{"codice":"tn","nome":"Tswana","termine":"kgama","categoria":"prestito"}],"lontana":"tn","ambiti":[],"via":"","testo":"Borrowed from Tswana kgama."},{"parola":"keitloa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A variety of the black rhinoceros.","termine_origine":"","catena":[{"codice":"tn","nome":"Tswana","termine":"","categoria":"prestito"}],"lontana":"tn","ambiti":[],"via":"","testo":"Borrowed from Tswana [Term?]."},{"parola":"Kgalagadi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of a Tswana people chiefly living in the Kalahari Desert.","termine_origine":"Kgalagadi","catena":[{"codice":"tn","nome":"Tswana","termine":"Kgalagadi","categoria":"prestito"}],"lontana":"tn","ambiti":[],"via":"","testo":"Unadapted borrowing from Tswana Kgalagadi (literally “a large, dry area”), from kgala (“become dry”) + -gadi (“large”). Doublet of Kalahari."},{"parola":"kgosana","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"In Tswana society, the head of a kgotla or ward.","termine_origine":"kgosana","catena":[{"codice":"tn","nome":"Tswana","termine":"kgosana","categoria":"prestito"}],"lontana":"tn","ambiti":[],"via":"","testo":"From Tswana kgosana."},{"parola":"kgosi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","si