{"arrivo":"en","origine":"tl","origine_nome":"Tagalog","livello2":"ms","livello2_nome":"Malay","n":5,"parole":[{"parola":"bibingka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A rice cake made using rice flour, sugar and coconut milk and wrapped in banana leaves.","termine_origine":"bibingka","catena":[{"codice":"tl","nome":"Tagalog","termine":"bibingka","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"bingka","categoria":"non_precisato"}],"lontana":"ms","ambiti":["cucina"],"via":"","testo":"From Tagalog bibingka, from Malay bingka (“cake made of rice flour, coconut milk, eggs and palm sugar”), as in Malay kuih bingka. See also Indonesian kue bingka, Macanese bebinca."},{"parola":"bunso","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The youngest child in a family.","termine_origine":"bunso","catena":[{"codice":"tl","nome":"Tagalog","termine":"bunso","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"bongsu","categoria":"prestito"},{"codice":"poz-pro","nome":"Proto-Malayo-Polynesian","termine":"*buŋsu","categoria":"non_precisato"}],"lontana":"poz-pro","ambiti":[],"via":"","testo":"Borrowed from Tagalog bunso, from earlier bungso, an early borrowing from Malay bongsu (“lastborn”), ultimately from Proto-Malayo-Polynesian *buŋsu."},{"parola":"kalis","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Filipino sword akin to the kris.","termine_origine":"kalis","catena":[{"codice":"tl","nome":"Tagalog","termine":"kalis","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"keris","categoria":"non_precisato"},{"codice":"kaw","nome":"Old Javanese","termine":"kĕris, kris","categoria":"non_precisato"}],"lontana":"kaw","ambiti":["militare"],"via":"","testo":"Borrowed from Tagalog kalis, from Malay keris, from Old Javanese kĕris, kris Doublet of kris."},{"parola":"kawali","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"frying pan","termine_origine":"kawali","catena":[{"codice":"tl","nome":"Tagalog","termine":"kawali","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"kuali","categoria":"non_precisato"},{"codice":"ta","nome":"Tamil","termine":"குவளை","categoria":"non_precisato"}],"lontana":"ta","ambiti":[],"via":"","testo":"Borrowed from Tagalog kawali, from Malay kuali, from Tamil குவளை (kuvaḷai, “wide-mouthed vessel; cup”)."},{"parola":"santol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A tropical Asian tree (Sandoricum koetjape).","termine_origine":"santol","catena":[{"codice":"tl","nome":"Tagalog","termine":"santol","categoria":"prestito"},{"codice":"ms","nome":"Malay","termine":"sentul","categoria":"non_precisato"}],"lontana":"ms","ambiti":["cucina"],"via":"","testo":"Borrowed from Tagalog santol, likely from Malay sentul. Compare Pangasinan pantol."}]}