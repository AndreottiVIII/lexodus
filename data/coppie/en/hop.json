{"arrivo":"en","origine":"hop","origine_nome":"Hopi","n":12,"parole":[{"parola":"Bahanna","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Synonym of white (“European American”).","termine_origine":"","catena":[{"codice":"hop","nome":"Hopi","termine":"","categoria":"prestito"}],"lontana":"hop","ambiti":[],"via":"","testo":"Borrowed from Hopi."},{"parola":"Hisatsinom","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The ancestors of the Hopi people.","termine_origine":"Hisatsinom","catena":[{"codice":"hop","nome":"Hopi","termine":"Hisatsinom","categoria":"prestito"}],"lontana":"hop","ambiti":[],"via":"","testo":"Unadapted borrowing from Hopi Hisatsinom. Literally Ancient People."},{"parola":"Hopi","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A member of a particular tribe of North American natives.","termine_origine":"hopi","catena":[{"codice":"hop","nome":"Hopi","termine":"hopi","categoria":"non_precisato"}],"lontana":"hop","ambiti":[],"via":"","testo":"From Hopi hopi (“Hopi, good in every respect, be wise or knowing”) (as in Hopituu sinom \"Hopi people\"). Popularized by J. Walter Fewkes as a replacement for the previously used and offensive name Moqui which sounds like Hopi mooki dies, be dead."},{"parola":"kachina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A vaguely ancestral anthropomorphic spirit being, associated with clouds and rain or personifying the power in the sun,…","termine_origine":"katsina","catena":[{"codice":"hop","nome":"Hopi","termine":"katsina","categoria":"prestito"}],"lontana":"hop","ambiti":[],"via":"","testo":"Borrowed from Hopi katsina."},{"parola":"kiva","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A ceremonial underground chamber in a Pueblo village.","termine_origine":"kíva","catena":[{"codice":"hop","nome":"Hopi","termine":"kíva","categoria":"prestito"}],"lontana":"hop","ambiti":[],"via":"","testo":"Borrowed from Hopi kíva."},{"parola":"Moqui","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Hopi","termine_origine":"mookwi","catena":[{"codice":"hop","nome":"Hopi","termine":"mookwi","categoria":"non_precisato"}],"lontana":"hop","ambiti":[],"via":"","testo":"From Hopi mookwi. According to a Walpi chief and other older Hopi consulted in the 1940's, the name is the original self-designation of the Hopi móókwi. Similar names have been borrowed into neighboring languages, e.g. Zuni muukwi, Southern Paiute mo·q·wi-, Isleta Southern Tiwa buxíde, Acoma Keres m"},{"parola":"paho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A sacred prayer stick in the Hopi religion.","termine_origine":"","catena":[{"codice":"hop","nome":"Hopi","termine":"","categoria":"prestito"}],"lontana":"hop","ambiti":["religione"],"via":"","testo":"Borrowed from Hopi."},{"parola":"piki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A paper-thin, dry, rolled bread made by the Hopi with nixtamalized blue corn meal.","termine_origine":"","catena":[{"codice":"hop","nome":"Hopi","termine":"","categoria":"prestito"}],"lontana":"hop","ambiti":["cucina"],"via":"","testo":"Borrowed from Hopi."},{"parola":"powaqa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Synonym of two-heart (sorcerer).","termine_origine":"powaqa","catena":[{"codice":"hop","nome":"Hopi","termine":"powaqa","categoria":"prestito"}],"lontana":"hop","ambiti":[],"via":"","testo":"Unadapted borrowing from Hopi powaqa."},{"parola":"sipapu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A small hole or indentation in the floor of a kiva, symbolizing the portal through which the ancient ancestors emerged…","termine_origine":"","catena":[{"codice":"hop","nome":"Hopi","termine":"","categoria":"prestito"}],"lontana":"hop","ambiti":["arte"],"via":"","testo":"Borrowed from Hopi."},{"parola":"Tavasuh","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Synonym of Navajo.","termine_origine":"tusavuhta","catena":[{"codice":"hop","nome":"Hopi","termine":"tusavuhta","categoria":"prestito"}],"lontana":"hop","ambiti":[],"via":"","testo":"Borrowed from Hopi tusavuhta, from a term meaning \"head pounders\", referring to the historical practice of killing captured enemies by beating them with a club."},{"parola":"two-heart","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"sorcerer, witch","termine_origine":"powaqa","catena":[{"codice":"hop","nome":"Hopi","termine":"powaqa","categoria":"calco"}],"lontana":"hop","ambiti":[],"via":"","testo":"Calque of Hopi powaqa."}]}