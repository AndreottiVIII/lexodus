{"arrivo":"en","origine":"roa","origine_nome":"Romance","n":5,"parole":[{"parola":"Miranda","pos":"noun|verb","n_etimologia":2,"categoria":"non_precisato","incerta":"no","significato":"A Miranda warning.","termine_origine":"","catena":[{"codice":"roa","nome":"Romance","termine":"","categoria":"non_precisato"},{"codice":"es","nome":"Spanish","termine":"","categoria":"non_precisato"},{"codice":"pt","nome":"Portuguese","termine":"","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"","categoria":"non_precisato"}],"lontana":"it","ambiti":["diritto_politica"],"via":"","testo":"From the Romance (Spanish, Portuguese, Italian habitational surname) Miranda. The common noun and verb are after the case Miranda v. Arizona, 384 U.S. 436 (1966), after Ernesto Miranda."},{"parola":"moonito","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Synonym of moonmoon.","termine_origine":"","catena":[{"codice":"roa","nome":"Romance","termine":"","categoria":"non_precisato"}],"lontana":"roa","ambiti":[],"via":"","testo":"From moon + -ito. From Romance -ito."},{"parola":"planification","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"The process of planning.","termine_origine":"","catena":[{"codice":"roa","nome":"Romance","termine":"","categoria":"non_precisato"}],"lontana":"roa","ambiti":[],"via":"","testo":"Affixed plan + -ification. Formed in imitation of a Romance language; compare French planification, Spanish planificación. Compare also the similarly formed planify."},{"parola":"planify","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to plan","termine_origine":"","catena":[{"codice":"roa","nome":"Romance","termine":"","categoria":"prestito"},{"codice":"ca","nome":"Catalan","termine":"planificar","categoria":"prestito"},{"codice":"fr","nome":"French","termine":"planifier","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"pianificare","cat