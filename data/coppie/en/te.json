codice":"te","nome":"Telugu","termine":"పులిహోర","categoria":"prestito"}],"lontana":"te","ambiti":[],"via":"","testo":"From Telugu పులిహోర (pulihōra)."},{"parola":"Reddy","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of a Telugu caste, mostly from Andhra Pradesh and Telangana.","termine_origine":"రెడ్డి","catena":[{"codice":"te","nome":"Telugu","termine":"రెడ్డి","categoria":"prestito"}],"lontana":"te","ambiti":[],"via":"","testo":"Borrowed from Telugu రెడ్డి (reḍḍi)."},{"parola":"Telugu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of the Telugu ethnic group.","termine_origine":"తెలుగు","catena":[{"codice":"te","nome":"Telugu","termine":"తెలుగు","categoria":"prestito"}],"lontana":"te","ambiti":[],"via":"","testo":"Borrowed from Telugu తెలుగు (telugu)."},{"parola":"yaasa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a regional dialect or accent of Telugu.","termine_origine":"యాస","catena":[{"codice":"te","nome":"Telugu","termine":"యాస","categoria":"prestito"}],"lontana":"te","ambiti":[],"via":"","testo":"Borrowed from Telugu యాస (yāsa)."}]}