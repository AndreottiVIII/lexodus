{"arrivo":"en","origine":"mn","origine_nome":"Mongolian","n":30,"parole":[{"parola":"aimag","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A kind of administrative subdivision in Mongolia, Russia, and the Inner Mongolia region of China.","termine_origine":"аймаг","catena":[{"codice":"mn","nome":"Mongolian","termine":"аймаг","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"Borrowed from Mongolian аймаг (ajmag)."},{"parola":"arad","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A nomadic herder.","termine_origine":"ард","catena":[{"codice":"mn","nome":"Mongolian","termine":"ард","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"Borrowed from Mongolian ард (ard, “people”)/ᠠᠷᠠᠳ (arad)."},{"parola":"Bankhar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A working dog of a breed found in Mongolia, with similar characteristics to the Tibetan Mastiff, usually used by nomadi…","termine_origine":"банхар","catena":[{"codice":"mn","nome":"Mongolian","termine":"банхар","categoria":"prestito"}],"lontana":"mn","ambiti":["agricoltura"],"via":"","testo":"Borrowed from Mongolian банхар (banxar)."},{"parola":"boortsog","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A food made from fried dough, usually shaped into triangles or spheres, found in the cuisines of Central Asia, Idel-Ura…","termine_origine":"боорцог","catena":[{"codice":"mn","nome":"Mongolian","termine":"боорцог","categoria":"prestito"},{"codice":"kk","nome":"Kazakh","termine":"бауырсақ","categoria":"prestito"}],"lontana":"kk","ambiti":["cucina"],"via":"","testo":"Borrowed from Mongolian боорцог (boorcog) and Kazakh бауырсақ (bawırsaq)."},{"parola":"buuz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Mongolian steamed dumpling filled with meat.","termine_origine":"бууз","catena":[{"codice":"mn","nome":"