logia":1,"categoria":"prestito","incerta":"no","significato":"A Mongolian leader under Genghis Khan.","termine_origine":"зайсан","catena":[{"codice":"mn","nome":"Mongolian","termine":"зайсан","categoria":"prestito"},{"codice":"xwo","nome":"Written Oirat","termine":"ᠴᠠᠶᡅᠰᠠᡊ","categoria":"non_precisato"},{"codice":"cmn","nome":"Mandarin","termine":"宰相","categoria":"non_precisato"}],"lontana":"cmn","ambiti":[],"via":"","testo":"Borrowed from Mongolian зайсан (zajsan), Classical Mongolian ᠵᠠᠶᠢᠰᠠᠩ (ǰayisang) and Written Oirat ᠴᠠᠶᡅᠰᠠᡊ (zaᠶisang), themselves from Mandarin 宰相 (zǎixiàng, “grand chancellor”)."}]}