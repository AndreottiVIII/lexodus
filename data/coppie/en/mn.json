to"}],"lontana":"mn","ambiti":[],"via":"","testo":"Borrowed from Mongolian гэр (ger)/ᠭᠡᠷ (ger)."},{"parola":"khadag","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Mongolian khata (ceremonial scarf).","termine_origine":"хадаг","catena":[{"codice":"mn","nome":"Mongolian","termine":"хадаг","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"From Mongolian хадаг (xadag)/ᠬᠠᠳᠠᠭ (qadaɣ). Doublet of khata."},{"parola":"khoormog","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Mongolian drink","termine_origine":"хоормог","catena":[{"codice":"mn","nome":"Mongolian","termine":"хоормог","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"From Mongolian хоормог (xoormog)."},{"parola":"Khorchin","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of the Mongolians in Inner Mongolia, China.","termine_origine":"Хорчин","catena":[{"codice":"mn","nome":"Mongolian","termine":"Хорчин","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"Borrowed from Mongolian Хорчин (Xorčin)."},{"parola":"khorkhog","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Mongolian dish of meat cooked in a container with hot stones and water.","termine_origine":"","catena":[{"codice":"mn","nome":"Mongolian","termine":"","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"From Mongolian [Term?]."},{"parola":"khural","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"parliament or national congress in Mongolia; also in Buryatia, Kalmykia or Tyva (in Russia)","termine_origine":"хурал","catena":[{"codice":"mn","nome":"Mongolian","termine":"хурал","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"From Mongolian хурал (xural) or ᠬᠤᠷᠠᠯ (qural)."},{"parola":"khuushuur","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Mongolian dish of fried dumplings filled with minced meat and seasoning.","termine_origine":"хуушуур","catena":[{"codice":"mn","nome":"Mongolian","termine":"хуушуур","categoria":"prestito"},{"codice":"zh","nome":"Chinese","termine":"火烧儿","categoria":"non_precisato"}],"lontana":"zh","ambiti":[],"via":"","testo":"Borrowed from Mongolian хуушуур (xuušuur)/ᠬᠤᠤᠱᠤᠤᠷ (quušuur), Chinese 火烧儿 (hǔoshāor)."},{"parola":"kurultai","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A political and military council of ancient Mongol and Turkic chiefs and khans.","termine_origine":"хуралдай","catena":[{"codice":"mn","nome":"Mongolian","termine":"хуралдай","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"курулта́й","categoria":"prestito"}],"lontana":"ru","ambiti":["scienza"],"via":"","testo":"Borrowed from Mongolian хуралдай (xuraldaj) via Russian курулта́й (kurultáj)."},{"parola":"morin khuur","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional Mongolian bowed stringed instrument.","termine_origine":"морин хуур","catena":[{"codice":"mn","nome":"Mongolian","termine":"морин хуур","categoria":"prestito"}],"lontana":"mn","ambiti":[],"via":"","testo":"Borrowed from Mongolian морин хуур (morin xuur)."},{"parola":"myriarchy","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"A government of 10,000 people.","termine_origine":"түмэн","catena":[{"codice":"mn","nome":"Mongolian","termine":"түмэн","categoria":"calco"}],"lontana":"mn","ambiti":["militare","diritto_politica"],"via":"","testo":"From myriarch + -y, after the pattern of heptarchy etc.; see myriarch for more. As a military unit, Calque of Mongolian түмэн (tümen)."},{"parola":"möngö","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A former subdivision of Mongolian currency, equal to one hundredth of a tugrik (tögrög).","termine_origine":"мөнгө","catena":[{"codice":"mn","nome":"Mongolian","termine":"мөнгө","categoria":"prestito"}],"lontana":"mn","ambiti":["finanza"],"via":"","testo":"Borrowed from Mongolian мөнгө (möngö)."},{"parola":"ovoo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A shamanistic cairn found in Mongolia, usually made from rocks or wood and found on or around mountains.","termine_origine":"овоо","catena":[{"codice":"mn","nome":"Mongolian","termine":"овоо","categoria":"prestito"}],"lontana":"mn","ambiti":["religione"],"via":"","testo":"Borrowed from Mongolian овоо (ovoo, “heap”)."},{"parola":"shagai","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"An ankle bone of a sheep or goat used in traditional Mongolian games and divination practices as a die.","termine_origine":"шагай","catena":[{"codice":"mn","nome":"Mongolian","termine":"шагай","categoria":"prestito"}],"lontana":"mn","ambiti":["sport"],"via":"","testo":"Borrowed from Mongolian шагай (šagaj)."},{"parola":"sum","pos":"noun","n_etimologia":4,"categoria":"prestito","incerta":"no","significato":"A type of administrative district used in China, Mongolia, and Russia. In Mongolia, a sum is smaller than a province. I…","termine_origine":"сум","catena":[{"codice":"mn","nome":"Mongolian","termine":"сум","categoria":"prestito"},{"codice":"mnc","nome":"Manchu","termine":"ᠨᡳᡵᡠ","categoria":"non_precisato"},{"codice":"xgn-pro","nome":"Proto-Mongolic","termine":"*sumun","categoria":"non_precisato"}],"lontana":"xgn-pro","ambiti":[],"via":"","testo":"From Mongolian сум (sum), from Manchu ᠨᡳᡵᡠ (niru, “a large arrow, militia company, district”). Ultimately from Proto-Mongolic *sumun (“arrow”)."},{"parola":"takh","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Synonym of Przewalski's horse.","termine_origine":"тахь","catena":[{"codice":"mn","nome":"Mongolian","termine":"тахь","categoria":"non_precisato"}],"lontana":"mn","ambiti":[],"via":"","testo":"From Khalkha