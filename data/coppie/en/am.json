{"arrivo":"en","origine":"am","origine_nome":"Amharic","n":42,"parole":[{"parola":"abish","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fenugreek seeds","termine_origine":"አብሽ","catena":[{"codice":"am","nome":"Amharic","termine":"አብሽ","categoria":"prestito"}],"lontana":"am","ambiti":[],"via":"","testo":"Borrowed from Amharic አብሽ."},{"parola":"absit","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"A portion of fermenting dough diluted to a paste with water and then cooked.","termine_origine":"አብሲት","catena":[{"codice":"am","nome":"Amharic","termine":"አብሲት","categoria":"prestito"}],"lontana":"am","ambiti":[],"via":"","testo":"Borrowed from Amharic አብሲት (ʾäbsit, “proofing dough”)."},{"parola":"abuna","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The Patriarch, or head of the Abyssinian Church.","termine_origine":"አቡነ","catena":[{"codice":"am","nome":"Amharic","termine":"አቡነ","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"أَبُونَا","categoria":"non_precisato"}],"lontana":"ar","ambiti":["religione"],"via":"","testo":"From Amharic አቡነ (ʾäbunä), Arabic أَبُونَا (ʔabūnā, “our father”)."},{"parola":"amba","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A characteristic landform in Ethiopia: a steep-sided, flat-topped mountain, often the site of a settlement.","termine_origine":"ዐምባ","catena":[{"codice":"am","nome":"Amharic","termine":"ዐምባ","categoria":"prestito"}],"lontana":"am","ambiti":[],"via":"","testo":"Borrowed from Amharic ዐምባ (ʿämba)."},{"parola":"ashkoko","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The hyrax.","termine_origine":"አሽኮኮ","catena":[{"codice":"am","nome":"Amharic","termine":"አሽኮኮ","categoria":"prestito"}],"lontana":"am","ambiti":[],"via":"","testo":"Borrowed from Amharic አሽኮኮ (ʾäškoko)."},{"parola":"awaze","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A spicy sauce or paste, made with chili peppers and usually reddish in colour, used in Ethiopian and Eritrean cuisine.","termine_origine":"አዋዜ","catena":[{"codice":"am","nome":"Amharic","termine":"አዋዜ","categoria":"prestito"}],"lontana":"am","ambiti":[],"via":"","testo":"From Amharic አዋዜ (ʾäwaze)."},{"parola":"azmari","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"An entertainer who sings and plays traditional string instruments of the Ethiopian highlands.","termine_origine":"አዝማሪ","catena":[{"codice":"am","nome":"Amharic","termine":"አዝማሪ","categoria":"prestito"}],"lontana":"am","ambiti":["musica"],"via":"","testo":"Borrowed from Amharic አዝማሪ (ʾäzmari)."},{"parola":"begena","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A type of lyre of Ethiopian and Eritrean origin with a rectangular soundbox and ten strings, which is played with a ple…","termine_origine":"በገና","catena":[{"codice":"am","nome":"Amharic","termine":"በገና","categoria":"prestito"}],"lontana":"am","ambiti":[],"via":"","testo":"Borrowed from Amharic በገና (bägäna)."},{"parola":"beisa","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A species of antelope from East Africa (Oryx beisa, East African oryx)","termine_origine":"","catena":[{"codice":"am","nome":"Amharic","termine":"","categoria":"non_precisato"}],"lontana":"am","ambiti":[],"via":"","testo":"From Amharic [script needed] (be'zā, \"oryx\")."},{"parola":"berbere","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A spice mixture, usually consisting of chili peppers, garlic, ginger, basil, and other spices, which is used in Ethiopi…","termine_origine":"በርበሬ","catena":[{"codice":"am","nome":"Amharic","termine":"በርበሬ","categoria":"prestito"},{"codice":"ti","nome":"Tigrinya","termine":"በርበረ","categoria":"prestito"}],"lontana":"ti","ambiti":[],"via":"","testo":"From Amharic በርበሬ (bä