{"arrivo":"en","origine":"ne","origine_nome":"Nepali","n":35,"parole":[{"parola":"ainselu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Synonym of Molucca berry","termine_origine":"ऐंसेलु","catena":[{"codice":"ne","nome":"Nepali","termine":"ऐंसेलु","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali ऐंसेलु (a͠iselu)."},{"parola":"anchal","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"any administrative zone of Nepal","termine_origine":"अञ्चल","catena":[{"codice":"ne","nome":"Nepali","termine":"अञ्चल","categoria":"non_precisato"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali अञ्चल (añcal)."},{"parola":"arbajo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A kind of traditional four-stringed lute originating from Nepal.","termine_origine":"आरबाजो","catena":[{"codice":"ne","nome":"Nepali","termine":"आरबाजो","categoria":"prestito"}],"lontana":"ne","ambiti":["musica"],"via":"","testo":"From Nepali आरबाजो (ārabājo)."},{"parola":"argeli","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Himalayan shrub, Edgeworthia gardneri.","termine_origine":"अर्गेली","catena":[{"codice":"ne","nome":"Nepali","termine":"अर्गेली","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali अर्गेली (argelī)"},{"parola":"chhurpi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional cheese of Nepal and Tibet.","termine_origine":"छुर्पी","catena":[{"codice":"ne","nome":"Nepali","termine":"छुर्पी","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali छुर्पी (churpī)."},{"parola":"chiura","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A kind of beaten rice commonly eaten in Nepal.","termine_origine":"चिउरा","catena":[{"codice":"ne","nome":"Nepali","termine":"चिउरा","categoria":"prestito"}],"lontana":"ne","ambiti":["cucina"],"via":"","testo":"From Nepali चिउरा (ciurā)."},{"parola":"chiuri","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Himalayan tree, Diploknema butyracea.","termine_origine":"चिउरी","catena":[{"codice":"ne","nome":"Nepali","termine":"चिउरी","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali चिउरी (ciurī)."},{"parola":"dhindo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Nepalese staple, similar to polenta, made from maize flour and water.","termine_origine":"ढिँडो","catena":[{"codice":"ne","nome":"Nepali","termine":"ढिँडो","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali ढिँडो (ḍhĩḍo)."},{"parola":"gaupalika","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A rural municipality of Nepal.","termine_origine":"गाउँपालिका","catena":[{"codice":"ne","nome":"Nepali","termine":"गाउँपालिका","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali गाउँपालिका (gāũpālikā)"},{"parola":"gogan","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Saurauia napaulensis, a type of flowering plant found in the Himalayas","termine_origine":"गोगन","catena":[{"codice":"ne","nome":"Nepali","termine":"गोगन","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali गोगन (gogan)."},{"parola":"goral","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A type of Asian ungulate ruminant, now defined as any of the four species of the genus Naemorhedus.","termine_origine":"घोरल","catena":[{"codice":"ne","nome":"Nepali","termine":"घोरल","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From an eastern Indian word for the Himalayan goral. Likely an early borrowing from Nepali घोरल (ghoral, “Himalayan goral”) or a related language."},{"parola":"gudpak","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A cake-like Nepali sweet made with coconut and nuts.","termine_origine":"गुदपाक","catena":[{"codice":"ne","nome":"Nepali","termine":"गुदपाक","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali गुदपाक (gudapāk)."},{"parola":"Gurkha","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A member of the dominant ethnic group in Nepal, with a Himalayan diaspora.","termine_origine":"गोर्खा","catena":[{"codice":"ne","nome":"Nepali","termine":"गोर्खा","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"गोरक्ष","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"From Nepali गोर्खा (gorkhā, “inhabitant of Gorkha”), from गोरखा (gorakhā)/गोर्खा (gorkhā, “Gorkha District”), from Sanskrit गोरक्ष (gorakṣa, “cowherd”) an epithet of the patron deity Gorakhnath, from गो (go, “cow”) + रक्ष् (rakṣ, “protect”)."},{"parola":"jharal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The Himalayan tahr, Hemitragus jemlahicus ( <= Capra jemlaica).","termine_origine":"झारल","catena":[{"codice":"ne","nome":"Nepali","termine":"झारल","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali झारल (jhāral)."},{"parola":"Khas","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The inhabitants of the medieval Khas Kingdom.","termine_origine":"खस","catena":[{"codice":"ne","nome":"Nepali","termine":"खस","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"खश","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Borrowed from Nepali खस (khas), from Sanskrit खश (khaśa). Doublet of Khasa."},{"parola":"kinema","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"A Nepali dish of fermented soybean, resembling natto.","termine_origine":"किनेमा","catena":[{"codice":"ne","nome":"Nepali","termine":"किनेमा","categoria":"prestito"},{"codice":"lif","nome":"Limbu","termine":"","categoria":"non_precisato"}],"lontana":"lif","ambiti":["cucina"],"via":"","testo":"Borrowed from Nepali किनेमा (kinemā, literally “fermented flavour”), from Limbu [script needed] (ki, “fermented”) + [script needed] (nambaa, “flavor”)."},{"parola":"koklass","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A pheasant of India and China, with a long central crest and two lateral crests on the head.","termine_origine":"फोक्रास","catena":[{"codice":"ne","nome":"Nepali","termine":"फोक्रास","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali फोक्रास (phokrās)."},{"parola":"Kshetri","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a warrior and ruling class in Nepali society of Khas people","termine_origine":"क्षेत्री","catena":[{"codice":"ne","nome":"Nepali","termine":"क्षेत्री","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"क्षत्रिय","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"From Nepali क्षेत्री (kṣetrī), from Sanskrit क्षत्रिय (kṣatriya, “protector of gentle people”), from क्षत्र (kṣatra, “rule, dominion, authority”). Cognate with Old Persian 𐎧𐏁𐎠𐎹𐎰𐎡𐎹 (x-š-a-y-θ-i-y /⁠xšāyaθiya⁠/, “emperor”), from which is derived Persian شاه (šâh)."},{"parola":"kukri","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A curved Nepalese knife used especially by Gurkha fighters; many variants exist, but all share recurve as a common them…","termine_origine":"खुकुरी","catena":[{"codice":"ne","nome":"Nepali","termine":"खुकुरी","categoria":"non_precisato"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali खुकुरी (khukurī)."},{"parola":"kutki","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Picrorhiza kurroa, a medicinal herb of the Himalayas.","termine_origine":"कुटकी","catena":[{"codice":"ne","nome":"Nepali","termine":"कुटकी","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali कुटकी (kuṭkī)"},{"parola":"madal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A type of drum used in Nepalese folk music.","termine_origine":"मादल","catena":[{"codice":"ne","nome":"Nepali","termine":"मादल","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali मादल (mādal)."},{"parola":"Magar","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A member of a particular ethnic group from Nepal and northern India.","termine_origine":"मगर","catena":[{"codice":"ne","nome":"Nepali","termine":"मगर","categoria":"non_precisato"},{"codice":"mgp","nome":"Eastern Magar","termine":"","categoria":"non_precisato"}],"lontana":"mgp","ambiti":[],"via":"","testo":"From Nepali मगर (magar), from the name in Eastern Magar."},{"parola":"mamira","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional herbal medicine for eye disease etc., derived from the plant Coptis teeta or from Thalictrum foliosum.","termine_origine":"ममिरा","catena":[{"codice":"ne","nome":"Nepali","termine":"ममिरा","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali ममिरा (mamirā)."},{"parola":"pucras","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A bird, the koklass.","termine_origine":"फोक्रास","catena":[{"codice":"ne","nome":"Nepali","termine":"फोक्रास","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali फोक्रास (phokrās)."},{"parola":"pustakari","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A Nepali form of candy made from molasses, cooked with ghee and milk and topped with coconut, dates, or nuts.","termine_origine":"पुष्टकारी","catena":[{"codice":"ne","nome":"Nepali","termine":"पुष्टकारी","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali पुष्टकारी (puṣṭakārī)."},{"parola":"raksi","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A traditional distilled alcoholic beverage in Nepal and Tibet, usually homemade from kodo millet or rice.","termine_origine":"रक्सी","catena":[{"codice":"ne","nome":"Nepali","termine":"रक्सी","categoria":"prestito"}],"lontana":"ne","ambiti":["cucina"],"via":"","testo":"Borrowed from Nepali रक्सी (raksī)."},{"parola":"ropani","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A unit of area equal to 5476 square feet or roughly 0.126 acres.","termine_origine":"रोपनी","catena":[{"codice":"ne","nome":"Nepali","termine":"रोपनी","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali रोपनी (ropanī)."},{"parola":"sunpati","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dwarf rhododendron (Rhododendron anthopogon).","termine_origine":"सुनपाति","catena":[{"codice":"ne","nome":"Nepali","termine":"सुनपाति","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali सुनपाति (sunapāti)."},{"parola":"tahr","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Any of three genera of large Asian ungulates belonging to the subfamily Caprinae (goat-antelopes).","termine_origine":"थार","catena":[{"codice":"ne","nome":"Nepali","termine":"थार","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali थार (thār), from थारल (thāral)."},{"parola":"terai","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"A belt of marshy land, which lies between the foothills of the Himalayas and the plains.","termine_origine":"तराइ","catena":[{"codice":"ne","nome":"Nepali","termine":"तराइ","categoria":"prestito"},{"codice":"inc-hnd","nome":"Hindustani","termine":"","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"तराई","categoria":"prestito"},{"codice":"ur","nome":"Urdu","termine":"ترائی","categoria":"prestito"},{"codice":"pra","nome":"Prakrit","termine":"*तलघट्टिका-","categoria":"non_precisato"},{"codice":"inc-pro","nome":"Proto-Indo-Aryan","termine":"*taras","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"तल","categoria":"non_precisato"},{"codice":"fa-cls","nome":"Classical Persian","termine":"تر","categoria":"non_precisato"}],"lontana":"fa-cls","ambiti":[],"via":"","testo":"Borrowed from Nepali तराइ (tarāi) and/or Hindustani (Hindi तराई (tarāī) / Urdu ترائی (tarāī, “marsh, foothills”)), from Prakrit *तलघट्टिका- (*talaghaṭṭikā-), ultimately derived from Proto-Indo-Aryan *taras (“plain, plateau”), possibly related to Sanskrit तल (tala, “level”); cognate to Nepali तराइ (t"},{"parola":"timur","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rattan pepper","termine_origine":"तिमुर","catena":[{"codice":"ne","nome":"Nepali","termine":"तिमुर","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali तिमुर (timura)."},{"parola":"urva","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A crab-eating mongoose (Urva urva, syn. Herpestes urva).","termine_origine":"","catena":[{"codice":"ne","nome":"Nepali","termine":"","categoria":"non_precisato"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali [Term?]."},{"parola":"wah","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"The red panda.","termine_origine":"वाँ दोन्काँ","catena":[{"codice":"ne","nome":"Nepali","termine":"वाँ दोन्काँ","categoria":"non_precisato"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali वाँ दोन्काँ (wā̃ donkā̃)."},{"parola":"weh","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"A red panda.","termine_origine":"वह् दोन्क","catena":[{"codice":"ne","nome":"Nepali","termine":"वह् दोन्क","categoria":"non_precisato"}],"lontana":"ne","ambiti":[],"via":"","testo":"From Nepali वह् दोन्क (wah donka)."},{"parola":"yuhina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Any of several birds of the genus Yuhina: the Old World babblers.","termine_origine":"युहिना","catena":[{"codice":"ne","nome":"Nepali","termine":"युहिना","categoria":"prestito"}],"lontana":"ne","ambiti":[],"via":"","testo":"Borrowed from Nepali युहिना (yuhinā)."}]}