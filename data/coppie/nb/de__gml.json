{"arrivo":"nb","origine":"de","origine_nome":"German","livello2":"gml","livello2_nome":"Middle Low German","n":6,"parole":[{"parola":"anklage","pos":"noun|verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"an accusation","termine_origine":"Anklage","catena":[{"codice":"de","nome":"German","termine":"Anklage","categoria":"non_precisato"},{"codice":"gml","nome":"Middle Low German","termine":"anklagen","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"anklagen","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"an- + klage; from German Anklage (noun), and from Middle Low German anklagen and German anklagen (verb)"},{"parola":"bearbeide","pos":"verb","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"to adapt, edit","termine_origine":"bearbeiten","catena":[{"codice":"de","nome":"German","termine":"bearbeiten","categoria":"calco"},{"codice":"gml","nome":"Middle Low German","termine":"","categoria":"non_precisato"}],"lontana":"gml","ambiti":["finanza","musica","agricoltura"],"via":"","testo":"From be- + arbeide (“work”), literally “work on”. Calque of German bearbeiten (although both components of the Norwegian variant are from Middle Low German)"},{"parola":"forveksle","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to confuse (someone/something for someone/something else)","termine_origine":"verwechseln","catena":[{"codice":"de","nome":"German","termine":"verwechseln","categoria":"non_precisato"},{"codice":"gml","nome":"Middle Low German","termine":"vorwesselen","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"for- + veksle, from German verwechseln and Middle Low German vorwesselen"},{"parola":"røste","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to roast, calcine; to heat ore or minerals in air in order to remove sulphur or other impurities.","termine_origine":"rösten","catena"