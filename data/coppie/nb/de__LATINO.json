ermine":"Mangel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"mancare","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From German Mangel (“lack, deficiency”), from mangeln (“to lack”), from Old High German mangolōn, from Latin mancare.","livello2_varieta":"la"},{"parola":"marmor","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"marble (type of limestone)","termine_origine":"Marmor","catena":[{"codice":"de","nome":"German","termine":"Marmor","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"marmor","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"μάρμαρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"Borrowed from German Marmor, from Latin marmor, from Ancient Greek μάρμαρος (mármaros, “marble, crystalline rock”).","livello2_varieta":"la"},{"parola":"moll","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a minor scale (having intervals of a semitone between the second and third degrees, and (usually) the fifth and sixth,…","termine_origine":"Moll","catena":[{"codice":"de","nome":"German","termine":"Moll","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"molle","categoria":"non_precisato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*moldus","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ml̥dus","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["musica"],"via":"","testo":"From German Moll (“minor”), from Medieval Latin molle, of Latin mollis (“soft”), from earlier *molduis, from Proto-Italic *moldus, from Proto-Indo-European *ml̥dus (“soft, weak”), from Proto-Indo-European *(s)meld- (“soft, weak, tender”). Cognate with English moll, Icelandic moll, Czech moll, Hungar","livello2_varieta":"la-med"},{"parola":"musikalier","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"notes","termine_origine":"Musikalien","catena":[{"codice":"de","nome":"German","termine":"Musikalien","categoria":"calco"},{"codice":"la-med","nome":"Medieval Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Calque of German Musikalien pl, from Medieval Latin adjective musicalis (“musical”).","livello2_varieta":"la-med"},{"parola":"negere","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to deny, reject, negate or disavow the existence, validity, or importance of something","termine_origine":"negieren","catena":[{"codice":"de","nome":"German","termine":"negieren","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"negāre","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from German negieren (“to negate, deny”), from Latin negāre (“to deny, say no”). Compare negasjon (“negation”). Compare Danish negere, Swedish negera, Dutch negeren, German negieren and English negate (“to deny, negate”).","livello2_varieta":"la"},{"parola":"parafin","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"paraffin or kerosene","termine_origine":"Paraffin","catena":[{"codice":"de","nome":"German","termine":"Paraffin","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"parum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From German Paraffin, from Latin parum affinis.","livello2_varieta":"la"},{"parola":"pinje","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"stone pine, Pinus pinea","termine_origine":"Pinie","catena":[{"codice":"de","nome":"German","termine":"Pinie","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"pinea","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From German Pinie, from Late Latin pinea, Latin pineus, from pinus.","livello2_vari