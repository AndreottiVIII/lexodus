el","catena":[{"codice":"de","nome":"German","termine":"Spektakel","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"spectaculum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Via German Spektakel from Latin spectaculum","livello2_varieta":"la"},{"parola":"student","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a student (at university or college)","termine_origine":"Student","catena":[{"codice":"de","nome":"German","termine":"Student","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"studēns","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from German Student, from Latin studēns.","livello2_varieta":"la"},{"parola":"tangent","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tangent","termine_origine":"Tangente","catena":[{"codice":"de","nome":"German","termine":"Tangente","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tangēns","categoria":"non_precisato"}],"lontana":"la","ambiti":["musica","scienza"],"via":"","testo":"From German Tangente, Tangens, ultimately from Latin tangēns.","livello2_varieta":"la"},{"parola":"tektonisk","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tectonic (chiefly geology)","termine_origine":"tektonisch","catena":[{"codice":"de","nome":"German","termine":"tektonisch","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tectonicus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"τεκτονικός","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"From German tektonisch, from Latin tectonicus and Ancient Greek τεκτονικός (tektonikós, “pertaining to building”).","livello2_varieta":"la"},{"parola":"ters","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a third","termine_origine":"Terz","catena":[{"