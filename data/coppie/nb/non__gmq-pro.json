_origine":"jarfr","catena":[{"codice":"non","nome":"Old Norse","termine":"jarfr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛖᚱᚨᚠᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*erfaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse jarfr, from Proto-Norse ᛖᚱᚨᚠᚨᛉ (erafaʀ), from Proto-Germanic *erfaz. Cognate with Swedish järv, Faroese jarvur."},{"parola":"løk","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"an onion","termine_origine":"laukr","catena":[{"codice":"non","nome":"Old Norse","termine":"laukr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛚᚨᚢᚲᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*laukaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["cucina"],"via":"","testo":"From Old Norse laukr, from Proto-Norse ᛚᚨᚢᚲᚨᛉ (laukaʀ), from Proto-Germanic *laukaz."},{"parola":"morr","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"chopped or ground offal from a slaughtered animal","termine_origine":"mǫrr","catena":[{"codice":"non","nome":"Old Norse","termine":"mǫrr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*marhwa-","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*marhwaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*merk-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Old Norse mǫrr (“fat, tallow”), from Proto-Norse *marhwa- (“tallow, suet”), from Proto-Germanic *marhwaz (“tallow, suet”), ultimately from Proto-Indo-European *merk- (“to decay”). Compare Norwegian Nynorsk morr (“chopped offal; offal sausage”), Faroese mørur and Icelandic mör (“suet”)"},{"parola":"rev","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","signifi