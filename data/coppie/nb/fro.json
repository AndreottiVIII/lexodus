{"arrivo":"nb","origine":"fro","origine_nome":"Old French","n":20,"parole":[{"parola":"admiral","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"an admiral (a naval officer of the highest rank; the commander of a country's naval forces)","termine_origine":"admiral","catena":[{"codice":"fro","nome":"Old French","termine":"admiral","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"admirālis","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["mare","militare","scienza","diritto_politica"],"via":"","testo":"From Old French admiral, from Medieval Latin admiralis, from Arabic أَمِير (ʔamīr, “commander”) + -alis (“-al”) under influence from admīrārī (“to admire, to respect”)."},{"parola":"arrest","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"arrest, custody, detention","termine_origine":"arester","catena":[{"codice":"fro","nome":"Old French","termine":"arester","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"From Old French arester."},{"parola":"arrestere","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to arrest","termine_origine":"arester","catena":[{"codice":"fro","nome":"Old French","termine":"arester","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"From Old French arester, arrester."},{"parola":"biff","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a steak (slice of beef)","termine_origine":"boef","catena":[{"codice":"fro","nome":"Old French","termine":"boef","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"beef","categoria":"non_precisato"}],"lontana":"en","ambiti":["cucina"],"via":"","testo":"From Old French boef, via English beef."},{"parola":"bøye","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a buoy","termine_origine":"boye","catena":[{"codice":"fro","nom