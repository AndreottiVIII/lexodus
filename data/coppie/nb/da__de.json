{"arrivo":"nb","origine":"da","origine_nome":"Danish","livello2":"de","livello2_nome":"German","n":16,"parole":[{"parola":"a","pos":"intj","n_etimologia":8,"categoria":"non_precisato","incerta":"no","significato":"expression of surprise or horror","termine_origine":"ah","catena":[{"codice":"da","nome":"Danish","termine":"ah","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"ach","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Danish ah (“oh”), likely from German ach (“oh”), from Middle High German ach, from Old High German ah. Also see ah and akk."},{"parola":"anledning","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"opportunity, occasion","termine_origine":"anledning","catena":[{"codice":"da","nome":"Danish","termine":"anledning","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Anleitung","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Danish anledning, from anlede, from German Anleitung, anleiten (“guide”). By surface analysis, anlede + -ning"},{"parola":"anta","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to assume, presume","termine_origine":"antage","catena":[{"codice":"da","nome":"Danish","termine":"antage","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"annehmen","categoria":"calco"}],"lontana":"de","ambiti":[],"via":"","testo":"an- + ta; from Danish antage. Calque of German annehmen."},{"parola":"av og til","pos":"adv","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"at times, from time to time, now and then, occasionally, off and on, sometimes","termine_origine":"af og til","catena":[{"codice":"da","nome":"Danish","termine":"af og til","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"ab und zu","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Literally, “off and to”. Inherited from Danish af og til, a calque of German ab und zu. Compare Swedish av och till, Dutch af en toe."},{"parola":"bed","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a bed (for plants)","termine_origine":"bed","catena":[{"codice":"da","nome":"Danish","termine":"bed","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Beet","categoria":"non_precisato"}],"lontana":"de","ambiti":["finanza","agricoltura"],"via":"","testo":"From Danish bed, from German Beet."},{"parola":"feire","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to celebrate","termine_origine":"fejre","catena":[{"codice":"da","nome":"Danish","termine":"fejre","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"feiern","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"feriari","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Danish fejre, from German feiern, ultimately from Latin feriari."},{"parola":"gruve","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a mine","termine_origine":"grube","catena":[{"codice":"da","nome":"Danish","termine":"grube","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"Grube","categoria":"non_precisato"},{"codice":"no","nome":"Norwegian","termine":"","categoria":"non_precisato"},{"codice":"sv","nome":"Swedish","termine":"gruva","categoria":"non_precisato"}],"lontana":"sv","ambiti":["finanza"],"via":"","testo":"Inherited from Danish grube, from German Grube, which see. The form with -v- is an artificial (puristic) adaptation to the related verb grave (“to dig”), likely inspired by dialectal Norwegian gruve, gruva, a variant of the doublet grue (“fireplace, firepit”), and/or by Swedish gruva."},{"parola":"kjøtteter","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"carnivore","termine_origine":"kødæder","catena":[{"codice":"da","nome":"Danish","termine":"kødæder","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"Fleischfresser","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"carnivorus","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"From kjøtt (“meat”) + eter (“eater”). Structurally inherited from Danish kødæder, itself (at least in the scientific sense and possibly after German Fleischfresser) calqued on Latin carnivorus."},{"parola":"påfallende","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"conspicuous","termine_origine":"påfaldende","catena":[{"codice":"da","nome":"Danish","termine":"påfaldende","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"auffallend","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Danish påfaldende, from German auffallend."},{"parola":"regelmessig","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"regular","termine_origine":"regelmæssig","catena":[{"codice":"da","nome":"Danish","termine":"regelmæssig","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"regelmäßig","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Danish regelmæssig, from German regelmäßig. Equivalent to regel + -messig."},{"parola":"skuespiller","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"actor","termine_origine":"skuespiller","catena":[{"codice":"da","nome":"Danish","termine":"skuespiller","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"Schauspieler","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Inherited from Danish skuespiller, a calque of German Schauspieler. By surface analysis, skue (“view, sight”) + spiller (“player”)."},{"parola":"sløyfe","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a loop","termine_origine":"sløjfe","catena":[{"codice":"da","nome":"Danish","termine":"sløjfe","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"Schleife","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*slaupijā","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"Inherited from Danish sløjfe, from German Schleife, Schlaufe (older also Schläufe), from Middle High German slöufe, from Proto-West Germanic *slaupijā."},{"parola":"splitter","pos":"adv","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"completely, entirely","termine_origine":"splitter-","catena":[{"codice":"da","nome":"Danish","termine":"splitter-","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"splitter-","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"From Danish splitter- and German splitter- (inseparable in both languages)."},{"parola":"stanse","pos":"verb","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"to die-cut, punch, impress, emboss","termine_origine":"stanse","catena":[{"codice":"da","nome":"Danish","termine":"stanse","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"stanzen","categoria":"non_precisato"}],"lontana":"de","ambiti":[],"via":"","testo":"Inherited from Danish stanse, from German stanzen."},{"parola":"tauverk","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ropes (e.g. all those used on a given ship)","termine_origine":"tovværk","catena":[{"codice":"da","nome":"Danish","termine":"tovværk","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"Tauwerk","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"touwwerk","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"From tau + verk. Structurally inherited from Danish tovværk, itself likely influenced by German Tauwerk and/or Dutch touwwerk. (Note that German Tau, Dutch touw are false cognates of Norwegian tau.)"},{"parola":"tresnitt","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a woodcut","termine_origine":"træsnit","catena":[{"codice":"da","nome":"Danish","termine":"træsnit","categoria":"ereditato"},{"codice":"de","nome":"German","termine":"Holzschnitt","categoria":"non_precisato"}],"lontana":"de","ambiti":["arte"],"via":"","testo":"From tre (“wood”) + snitt; from Danish træsnit, after German Holzschnitt."}]}