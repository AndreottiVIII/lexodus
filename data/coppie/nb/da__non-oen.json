{"arrivo":"nb","origine":"da","origine_nome":"Danish","livello2":"non-oen","livello2_nome":"Old East Norse","n":9,"parole":[{"parola":"bro","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"bridge","termine_origine":"bro","catena":[{"codice":"da","nome":"Danish","termine":"bro","categoria":"non_precisato"},{"codice":"non-oen","nome":"Old East Norse","termine":"brō","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*brōwō","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Danish bro, from Old Danish bro, from Old East Norse brō, from Proto-Germanic *brōwō (“bridge; brow”), possibly from Proto-Indo-European *bʰruH- (“beam; bridge”), which may be the same root as *h₃bʰrúHs (“(eye)brow”), whence brun. Close cognate with Swedish bro. Compare also Norwegian bru (“bri"},{"parola":"bud","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a bid or offer (to buy)","termine_origine":"boð","catena":[{"codice":"da","nome":"Danish","termine":"boð","categoria":"non_precisato"},{"codice":"non-oen","nome":"Old East Norse","termine":"buð","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*budą","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Danish boð, from Old Danish buth, from Old East Norse buð, from Proto-Germanic *budą."},{"parola":"eder","pos":"pron","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"accusative second-person pronoun, plural or in deferent speech (accusative of I)","termine_origine":"eder","catena":[{"codice":"da","nome":"Danish","termine":"eder","categoria":"non_precisato"},{"codice":"non-oen","nome":"Old East Norse","termine":"iðʀ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*izwiz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Danish eder, from Old Danish idher, from Old East Norse iðʀ, from Proto-Germanic *izwiz. Cognate with Swedish eder, er, Norwegian Nynorsk øder, ør, and Icelandic yður."},{"parola":"fedme","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"obesity","termine_origine":"fedme","catena":[{"codice":"da","nome":"Danish","termine":"fedme","categoria":"ereditato"},{"codice":"non-oen","nome":"Old East Norse","termine":"*fæitmi","categoria":"ereditato"}],"lontana":"non-oen","ambiti":["scienza"],"via":"","testo":"From Danish fedme, from Old Danish fedmæ, from Old East Norse *fæitmi. Compare Swedish fetma."},{"parola":"høy","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"high, tall","termine_origine":"høj","catena":[{"codice":"da","nome":"Danish","termine":"høj","categoria":"ereditato"},{"codice":"non-oen","nome":"Old East Norse","termine":"*haugʀ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*hauhaz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kewk-","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Danish høj, from Old East Norse *haugʀ, from Proto-Germanic *hauhaz, from Proto-Indo-European *kewk-, a suffixed form of *kew-."},{"parola":"I","pos":"pron","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"ye: a second-person plural nominative pronoun","termine_origine":"I","catena":[{"codice":"da","nome":"Danish","termine":"I","categoria":"ereditato"},{"codice":"non-oen","nome":"Old East Norse","termine":"*īʀ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*jūz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Danish I, from Old East Norse *īʀ, from Proto-Germanic *jūz. Cognate with Swedish ni, Norwegian Nynorsk de, Faroese tær, and Icelandic þér."},{"parola":"jer","pos":"pron","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"second person plural objective case – you, yourselves","termine_origine":"jer","catena":[{"codice":"da","nome":"Danish","termine":"jer","categoria":"non_precisato"},{"codice":"non-oen","nome":"Old East Norse","termine":"iðʀ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*izwiz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Danish jer, from older eder, from Old Danish idher, from Old East Norse iðʀ, from Proto-Germanic *izwiz. Cognate with Swedish eder, er, Norwegian Nynorsk øder, ør, and Icelandic yður."},{"parola":"synke","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to sink","termine_origine":"synke","catena":[{"codice":"da","nome":"Danish","termine":"synke","categoria":"ereditato"},{"codice":"non-oen","nome":"Old East Norse","termine":"*sinkwa","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*sinkwaną","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Danish synke, from Old Danish siunkæ, from Old East Norse *sinkwa, from Proto-Germanic *sinkwaną, cognate with Swedish sjunka, English sink, German sinken, Dutch zinken, Gothic 𐍃𐌹𐌲𐌵𐌰𐌽 (sigqan)."},{"parola":"sødme","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"sweetness","termine_origine":"sødme","catena":[{"codice":"da","nome":"Danish","termine":"sødme","categoria":"ereditato"},{"codice":"non-oen","nome":"Old East Norse","termine":"*sœtmi","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*swōtmô","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Danish sødme, from Old Danish søtmæ, from Old East Norse *sœtmi, *sǿtmi, from Proto-Germanic *swōtmô; compare søt. Cognate to Swedish sötma."}]}