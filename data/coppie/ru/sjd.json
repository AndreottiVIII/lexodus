ato":"a shaman of the Sami people","termine_origine":"но̄ййт","termine_origine_traslitterazione":"nōjjt","catena":[{"codice":"sjd","nome":"Kildin Sami","termine":"но̄ййт","traslitterazione":"nōjjt","categoria":"prestito"}],"lontana":"sjd","ambiti":[],"via":"","testo":"Borrowed from Kildin Sami но̄ййт (nōjjt)."},{"parola":"пульк","traslitterazione":"pulʹk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of болок (bolok)","termine_origine":"пуӆӆьк","termine_origine_traslitterazione":"pul̥l̥’k","catena":[{"codice":"sjd","nome":"Kildin Sami","termine":"пуӆӆьк","traslitterazione":"pul̥l̥’k","categoria":"prestito"}],"lontana":"sjd","ambiti":[],"via":"","testo":"Borrowed from Kildin Sami пуӆӆьк (pul̥l̥’k). Doublet of болок, болк (bolok, bolk)."},{"parola":"тундра","traslitterazione":"túndra","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tundra","termine_origine":"тӯндар","termine_origine_traslitterazione":"tūndar","catena":[{"codice":"sjd","nome":"Kildin Sami","termine":"тӯндар","traslitterazione":"tūndar","categoria":"prestito"},{"codice":"smi-pro","nome":"Proto-Samic","termine":"*tuontër","categoria":"ereditato"}],"lontana":"smi-pro","ambiti":[],"via":"","testo":"Borrowed from Kildin Sami тӯндрэ (tūndre), the accusative/genitive form of тӯндар (tūndar)."}]}