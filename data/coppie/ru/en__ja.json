{"arrivo":"ru","origine":"en","origine_nome":"English","livello2":"ja","livello2_nome":"Japanese","n":5,"parole":[{"parola":"додзё","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dojo (training facility, usually led by one or more sensei; a hall or room used for such training)","termine_origine":"dojo","catena":[{"codice":"en","nome":"English","termine":"dojo","categoria":"prestito"},{"codice":"ja","nome":"Japanese","termine":"道場","categoria":"non_precisato"},{"codice":"ltc","nome":"Middle Chinese","termine":"","categoria":"non_precisato"}],"lontana":"ltc","ambiti":["sport"],"via":"","testo":"Borrowed from English dojo, from Japanese 道場 (dōjō), from Middle Chinese 道場 (MC dawX drjang). Doublet of топчан (topčan, “trestle bed”)."},{"parola":"косплей","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cosplay","termine_origine":"cosplay","catena":[{"codice":"en","nome":"English","termine":"cosplay","categoria":"prestito"},{"codice":"ja","nome":"Japanese","termine":"コスプレ","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"costume play","categoria":"non_precisato"}],"lontana":"en","ambiti":[],"via":"","testo":"Borrowed from English cosplay, from Japanese コスプレ (kosupure), from English costume play."},{"parola":"покемон","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"The Pokémon franchise","termine_origine":"Pokémon","catena":[{"codice":"en","nome":"English","termine":"Pokémon","categoria":"prestito"},{"codice":"ja","nome":"Japanese","termine":"ポケモン","categoria":"non_precisato"}],"lontana":"ja","ambiti":[],"via":"","testo":"Borrowed from English Pokémon, ultimately from Japanese ポケモン (pokemon)."},{"parola":"суши","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sushi","termine_origine":"sushi","catena":[{"codice":"en","nome":"English","termine":"sushi","categoria":"prestito"},{"codice":"ja","nome":"Japanese","termine":"寿司","categoria":"non_precisato"}],"lontana":"ja","ambiti":[],"via":"","testo":"Borrowed through English sushi from Japanese 寿司 (sushi, “sushi (sour rice)”), ultimately from archaic conjugation 酸し (sushi, “sour, vinegared”) of modern adjective 酸い (sui, “sour, vinegared”). The sense of \"kimbap\" was due to a mistake that wrongly assumes that Korean kimbap looks like sushi."},{"parola":"хентай","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hentai","termine_origine":"hentai","catena":[{"codice":"en","nome":"English","termine":"hentai","categoria":"prestito"},{"codice":"ja","nome":"Japanese","termine":"","categoria":"prestito"}],"lontana":"ja","ambiti":[],"via":"","testo":"Borrowed from English hentai, and this a pseudo-Japonism derived from Japanese 変態(へんたい) (hentai); see that entry for more."}]}