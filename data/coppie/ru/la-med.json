{"arrivo":"ru","origine":"la-med","origine_nome":"Medieval Latin","n":22,"parole":[{"parola":"амбра","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"ambergris","termine_origine":"ambra","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"ambra","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"عَنْبَر","categoria":"non_precisato"},{"codice":"pal","nome":"Middle Persian","termine":"ʾmbl","categoria":"non_precisato"}],"lontana":"pal","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin ambra, from Arabic عَنْبَر (ʕanbar), from Middle Persian ʾmbl (ambar, “ambergris”)."},{"parola":"ассимиляция","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"assimilation","termine_origine":"assimilatio","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"assimilatio","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Derived from Medieval Latin assimilatio."},{"parola":"валериана","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"valerian (a plant of the genus Valeriana)","termine_origine":"valeriāna","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"valeriāna","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin valeriāna; see English valerian for further etymology."},{"parola":"виллан","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"villein","termine_origine":"villanus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"villanus","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin villanus."},{"parola":"галерея","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"gallery","termine_origine":"galeria","catena":[{"codice":"la-med","nome":"Medie