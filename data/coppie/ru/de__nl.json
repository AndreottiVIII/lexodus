man Trense of the same meaning which has been borrowed from the Dutch trense (“rope, bridle”) in the sixteenth century when they were connected to the Spanish trenza (“plait”), which is perhaps a blend of Old Spanish treça (“plait”), a borrowing from Old French treça (“plait”) – whi"},{"parola":"форель","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"trout","termine_origine":"Forelle","catena":[{"codice":"de","nome":"German","termine":"Forelle","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"forel","categoria":"non_precisato"},{"codice":"goh","nome":"Old High German","termine":"forhana","categoria":"non_precisato"}],"lontana":"goh","ambiti":[],"via":"","testo":"From German Forelle, possibly through Dutch forel. Ultimately from Old High German forhana."},{"parola":"ювелир","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jeweler, jeweller (a person whose job is making, repairing or selling jewelry)","termine_origine":"Juwelier","catena":[{"codice":"de","nome":"German","termine":"Juwelier","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"juwelier","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from German Juwelier or Dutch juwelier."},{"parola":"яхта","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yacht (slick and light ship)","termine_origine":"Jacht","catena":[{"codice":"de","nome":"German","termine":"Jacht","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"jacht","categoria":"prestito"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from German Jacht or Dutch jacht."}]}