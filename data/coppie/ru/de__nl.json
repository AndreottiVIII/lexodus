_origine":"Magazin","catena":[{"codice":"de","nome":"German","termine":"Magazin","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"magazijn","categoria":"prestito"},{"codice":"frm","nome":"Middle French","termine":"magasin","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"magazzino","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"مَخَازِن","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"magazyn","categoria":"non_precisato"}],"lontana":"pl","ambiti":["militare"],"via":"","testo":"Borrowed from German Magazin or Dutch magazijn, from Middle French magasin (“warehouse, store”), from Italian magazzino (“storehouse”), from Arabic مَخَازِن (maḵāzin, “storerooms, storehouses”). The informal stress variant мага́зин (magázin) is possibly via Polish magazyn. (ammunition clip or chambe"},{"parola":"мопс","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pug (small breed of dog)","termine_origine":"Mops","catena":[{"codice":"de","nome":"German","termine":"Mops","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"mops","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from German Mops or Dutch mops."},{"parola":"плакат","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"poster, placard, bill","termine_origine":"Plakat","catena":[{"codice":"de","nome":"German","termine":"Plakat","categoria":"non_precisato"},{"codice":"nl","nome":"Dutch","termine":"plakkaat","categoria":"non_precisato"},{"codice":"fr","nome":"French","termine":"placard","categoria":"non_precisato"}],"lontana":"fr","ambiti":[],"via":"","testo":"Borrowed in 1704 via German Plakat, from Dutch plakkaat, from French placard."},{"parola":"ракета","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rocket (vehicle propelled by a rocket engine)","termine_origine":"Rakete","catena":[{"codice":"de","no