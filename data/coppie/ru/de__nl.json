{"arrivo":"ru","origine":"de","origine_nome":"German","livello2":"nl","livello2_nome":"Dutch","n":21,"parole":[{"parola":"банка","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"sandbank, shoal","termine_origine":"Bank","catena":[{"codice":"de","nome":"German","termine":"Bank","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"bank","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from German Bank or Dutch bank. Doublet of банк (bank)."},{"parola":"боцман","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"boatswain (the officer (or warrant officer) in charge of sails, rigging, anchors, cables etc. and all work on deck of a…","termine_origine":"Bootsmann","catena":[{"codice":"de","nome":"German","termine":"Bootsmann","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"bootsman","categoria":"non_precisato"}],"lontana":"nl","ambiti":["mare"],"via":"","testo":"Borrowed from German Bootsmann or Dutch bootsman."},{"parola":"буксир","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain","significato":"tug, tugboat, towboat","termine_origine":"Bugsierer","catena":[{"codice":"de","nome":"German","termine":"Bugsierer","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"boegseren","categoria":"non_precisato"},{"codice":"pt","nome":"Portuguese","termine":"puxar","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pulso","categoria":"non_precisato"}],"lontana":"la","ambiti":["mare"],"via":"","testo":"First attested in 1712. Borrowed from German Bugsierer, from bugsieren, from Dutch boegseren, from Portuguese puxar, from Latin pulsāre. Unrelated to Russian бу́кса (búksa). The relation with буксова́ть (buksovátʹ) is uncertain."},{"parola":"вахмистр","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"wachtmeister (a non-commissioned officer (NCO))","termine_origine":"Wachtmeister","catena":[{"codice":"de","nome":"German","termine":"Wachtmeister","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"wachtmeester","categoria":"prestito"},{"codice":"pl","nome":"Polish","termine":"wachmistrz","categoria":"prestito"}],"lontana":"pl","ambiti":["militare","diritto_politica"],"via":"","testo":"Borrowed from German Wachtmeister or Dutch wachtmeester, possibly via Polish wachmistrz."},{"parola":"галстук","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"necktie, tie","termine_origine":"Halstuch","catena":[{"codice":"de","nome":"German","termine":"Halstuch","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"halsdoek","categoria":"non_precisato"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from German Halstuch (“neckerchief”) or Dutch halsdoek (“neckerchief”). The second component of the term is the same as in фа́ртук (fártuk)."},{"parola":"гарпун","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"harpoon","termine_origine":"Harpune","catena":[{"codice":"de","nome":"German","termine":"Harpune","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"harpoen","categoria":"non_precisato"}],"lontana":"nl","ambiti":["mare","militare"],"via":"","testo":"First attested in 1772. Borrowed from German Harpune, from Dutch harpoen."},{"parola":"кабель","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cable","termine_origine":"Kabel","catena":[{"codice":"de","nome":"German","termine":"Kabel","categoria":"prestito"},{"codice":"nl","nome":"Dutch","termine":"kabel","categoria":"prestito"}],"lontana":"nl","ambiti":[],"via":"","testo":"Borrowed from German Kabel or Dutch kabel."},{"parola":"какаду","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cockatoo (a bird)","termine_origine":"Kakadu","catena":[{"codice":"de","nome":"German","termine":"K