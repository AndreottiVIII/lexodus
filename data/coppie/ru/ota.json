nome":"Ottoman Turkish","termine":"طوربه","traslitterazione":"torba","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish طوربه (torba)."},{"parola":"фарфор","traslitterazione":"farfór","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"porcelain, china","termine_origine":"فغفوری","termine_origine_traslitterazione":"fağfûrî","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فغفوری","traslitterazione":"fağfûrî","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"فغفوری","traslitterazione":"faġfuri","categoria":"non_precisato"},{"codice":"sog","nome":"Sogdian","termine":"𐼱𐼲𐼾𐼰𐼴𐽀","traslitterazione":"βɣpʾwr","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰeh₂g-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish فغفوری (fağfûrî, “Chinese [porcelain]”), from Persian فغفوری (faġfuri, “Chinese [porcelain]”), from فغفور (faġfur, “emperor of China”) + ـی (-i), from Sogdian 𐼱𐼲𐼾𐼰𐼴𐽀 (βɣpʾwr /⁠βaγpūr⁠/); see it for more. Ultimately from Proto-Indo-European *bʰeh₂g-."},{"parola":"фата","traslitterazione":"fatá","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bridal veil","termine_origine":"فوطه","termine_origine_traslitterazione":"<i class=\"Latn mention\" lang=\"tr\">futa</i>","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فوطه","traslitterazione":"<i class=\"Latn mention\" lang=\"tr\">futa</i>","categoria":"non_precisato"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"From Old East Slavic фата (fata), фота (fota), from Ottoman Turkish فوطه (futa)."},{"parola":"фес","traslitterazione":"fes","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fes (a Turkish hat in the shape of a truncated cone)","termine_origine":"فس","termine_origine_traslitterazione":"fes","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فس","traslitterazione":"fes","categoria":"prestito"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"Borrowed from Ottoman Turkish فس (fes)."},{"parola":"фисташка","traslitterazione":"fistáška","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"pistachio (nut)","termine_origine":"فستق","termine_origine_traslitterazione":"fıstık","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فستق","traslitterazione":"fıstık","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"فُسْتُق","traslitterazione":"fıstık","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"pstk'","traslitterazione":"pistag","categoria":"prestito"},{"codice":"peo","nome":"Old Persian","termine":"*pistaka","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"","categoria":"ereditato"}],"lontana":"ira-pro","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish فستق (fıstık) (modern Turkish fıstık), from Persian فستق (fostoq, fostaq), from Arabic فِسْتَق (fistaq), of Iranian origin (compare Middle Persian pstk' (pistag)). The ending is influenced by French pistache and the diminutive suffix -ка (-ka). Cognate with English pist"},{"parola":"фитиль","traslitterazione":"fitílʹ","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"wick","termine_origine":"فتیل","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فتیل","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"فَتِيل","traslitterazione":"fatīl","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Inherited from Middle Russian фитиль, фетиль, ѳитиль, ѳетиль (fitilʹ, fetilʹ, fitilʹ, fetilʹ) (att. since 1610s in R. James' dictionary, also likely related pl. ветили in 1597), borrowed – probably in the context of firearms and artillery technology, where it displaced indigenous жагра (žagra, “tind"},{"parola":"халва","traslitterazione":"xalvá","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"halva","termine_origine":"حلوا","termine_origine_traslitterazione":"halva, helva","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حلوا","traslitterazione":"halva, helva","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حَلْوَى","traslitterazione":"ḥalwā","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish حلوا (halva, helva), from Arabic حَلْوَى (ḥalwā)."},{"parola":"ханжа","traslitterazione":"xanžá","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bigot, hypocrite, Pharisee","termine_origine":"حاجی","termine_origine_traslitterazione":"<i class=\"Latn mention\" lang=\"tr\">hacı</i>","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حاجی","traslitterazione":"<i class=\"Latn mention\" lang=\"tr\">hacı</i>","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"From Ottoman Turkish حاجی (hacı, “Kaaba pilgrim”). Compare typologically свято́ша (svjatóša) (< свято́й (svjatój)), English bigot (akin to god)."},{"parola":"ходжа","traslitterazione":"xodžá","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hodja (a Muslim schoolmaster)","termine_origine":"خواجه","termine_origine_traslitterazione":"hoca","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"خواجه","traslitterazione":"hoca","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"خواجه","traslitterazione":"xwāja","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"उपाध्याय","traslitterazione":"upādhyāya","categoria":"non_precisato"}],"lontana":"sa","ambiti":["religione"],"via":"","testo":"Borrowed from Ottoman Turkish خواجه (hoca), from Classical Persian خواجه (xwāja), ultimately from Sanskrit उपा