ntana":"ota","ambiti":[],"via":"","testo":"From Ottoman Turkish پاشالق (paşalık)."},{"parola":"пиала","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"piyāla, a small bowl","termine_origine":"پیاله","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"پیاله","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"پیاله","categoria":"non_precisato"}],"lontana":"fa","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish پیاله (piyâle), from Persian پیاله (piyâle); compare to Ancient Greek φιάλη (phiálē)."},{"parola":"райя","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rayah, the non-Muslim population in the Ottoman Empire","termine_origine":"رعایا","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"رعایا","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"رَعِيَّة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish رعایا (reaya), from Arabic رَعِيَّة (raʕiyya, “citizens, flock”)."},{"parola":"рахат-лукум","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Turkish delight, rahat lokum, lokum","termine_origine":"راحت لوقوم","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"راحت لوقوم","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"رَاحَة الْحُلْقُوم","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish راحت لوقوم (rahat lokum), vulgar form of راحت الحلقوم (râhatü'l-hulkûm), itself from Arabic رَاحَة الْحُلْقُوم (rāḥat al-ḥulqūm)."},{"parola":"ревень","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rhubarb","termine_origine":"راوند","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"راوند","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"ریوند","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish راوند (ravent), from Persian راوند (râvand)."},{"parola":"сундук","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trunk, chest, coffer, strongbox","termine_origine":"صندوق","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"صندوق","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"صَنْدُوق","categoria":"prestito"},{"codice":"arc","nome":"Aramaic","termine":"צנדוק","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"σῠνθήκη","categoria":"prestito"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish صندوق (sandık)."},{"parola":"торба","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sack, bag, bindle (carried over one's shoulder, especially by a hobo or an itinerant worker)","termine_origine":"طوربه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"طوربه","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish طوربه (torba)."},{"parola":"фарфор","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"porcelain, china","termine_origine":"فغفوری","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فغفوری","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"فغفوری","categoria":"non_precisato"},{"codice":"sog","nome":"Sogdian","termine":"𐼱𐼲𐼾𐼰𐼴𐽀","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰeh₂g-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish فغفوری (fağfûrî, “Chinese [porcelain]”), from Persian فغفوری (faġfuri, “Chinese [porcelain]”), from فغفور (faġfur, “emperor of China”) + ـی (-i), from Sogdian 𐼱𐼲𐼾𐼰𐼴𐽀 (βɣpʾwr /⁠βaγpūr⁠/); see it for more. Ultimately from Proto-Indo-European *bʰeh₂g-."},{"parola":"фата","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bridal veil","termine_origine":"فوطه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فوطه","categoria":"non_precisato"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"From Old East Slavic фата (fata), фота (fota), from Ottoman Turkish فوطه (futa)."},{"parola":"фес","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fes (a Turkish hat in the shape of a truncated cone)","termine_origine":"فس","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فس","categoria":"prestito"}],"lontana":"ota","ambiti":["moda"],"via":"","testo":"Borrowed from Ottoman Turkish فس (fes)."},{"parola":"фисташка","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"pistachio (nut)","termine_origine":"فستق","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فستق","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"فُسْتُق","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"pstk'","categoria":"prestito"},{"codice":"peo","nome":"Old Persian","termine":"*pistaka","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"","categoria":"ereditato"}],"lontana":"ira-pro","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish فستق (fıstık) (modern Turkish fıstık), from Persian فستق (fostoq, fostaq), from Arabic فِسْتَق (fistaq), of Iranian origin (compare Middle Persian pstk' (pistag)). The ending is influenced by French pistache and the diminutive suffix -ка (-ka). Cognate with English pist"},{"parola":"фитиль","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably","significato":"wick","termine_origine":"فتیل","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"فتیل","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"فَتِيل","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Inherited from Middle Russian фитиль, фетиль, ѳитиль, ѳетиль (fitilʹ, fetilʹ, fitilʹ, fetilʹ) (att. since 1610s in R. James' dictionary, also likely related pl. ветили in 1597), borrowed – probably in the context of firearms and artillery technology, where it displaced indigenous жагра (žagra, “tind"},{"parola":"халва","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"halva","termine_origine":"حلوا","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حلوا","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"حَلْوَى","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish حلوا (halva, helva), from Arabic حَلْوَى (ḥalwā)."},{"parola":"ханжа","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bigot, hypocrite, Pharisee","termine_origine":"حاجی","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"حاجی","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"From Ottoman Turkish حاجی (hacı, “Kaaba pilgrim”). Compare typologically свято́ша (svjatóša) (< свято́й (svjatój)), English bigot (akin to god)."},{"parola":"ходжа","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hodja (a Muslim schoolmaster)","termine_origine":"خواجه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"خواجه","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"خواجه","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"उपाध्याय","categoria":"non_precisato"}],"lontana":"sa","ambiti":["religione"],"via":"","testo":"Borrowed from Ottoman Turkish خواجه (hoca), from Classical Persian خواجه (xwāja), ultimately from Sanskrit उपाध्याय (upādhyāya)."},{"parola":"хурма","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"persimmon (fruit)","termine_origine":"خرما","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"خرما","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"خُرْمَا","categoria":"non_precisato"}],"lontana":"fa-cls","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish خرما (hurmâ), from Classical Persian خُرْمَا (xurmā, “date (fruit)”))."},{"parola":"чай","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tea (in all senses: the drink, the plant, the dried leaves, or tea-drinking)","termine_origine":"چای","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چای","categoria":"prestito"},{"codice":"zh","nome":"Chinese","termine":"茶","categoria":"non_precisato"}],"lontana":"zh","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish چای (çay), from Chinese 茶 (chá). The “tip” sense derives from the expression дава́ть на чай (davátʹ na čaj) / дать на чай (datʹ na čaj) (literally, “to give [some money] for tea”)."},{"parola":"чалить","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Uncertain; Possibly; modello unc/uncertain","significato":"to bind, to moor","termine_origine":"چالمق","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چالمق","categoria":"prestito"},{"codice":"trk","nome":"Turkic","termine":"","categoria":"prestito"}],"lontana":"trk","ambiti":[],"via":"","testo":"Uncertain, first attested from 1771, likely from Ottoman Turkish چالمق (çalmak, “to warp”) or a Turkic cognate of it. The noun чал (čal, “rope”) is rare and possibly deverbal. There is also ча́лка (čálka, “rope”)."},{"parola":"чатлах","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pussy, cunt, twat","termine_origine":"چاتلاق","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چاتلاق","categoria":"prestito"},{"codice":"hy","nome":"Armenian","termine":"չաթլախ","categoria":"non_precisato"}],"lontana":"hy","ambiti":[],"via":"","testo":"From Ottoman Turkish چاتلاق (çatlak). The use of this term in Armenia was influenced by Armenian չաթլախ (čʻatʻlax), which also comes from the same Ottoman Turkish word."},{"parola":"чинар","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"plane (deciduous tree, Platanus)","termine_origine":"چِنَار","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چِنَار","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"چِنَار","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"cynʾl","categoria":"ereditato"}],"lontana":"pal","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish چِنَار (çınâr), borrowed from Classical Persian چِنَار (činār), from Middle Persian cynʾl (/⁠činār⁠/)."},{"parola":"чинара","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"plane (deciduous tree, Platanus)","termine_origine":"چِنَار","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چِنَار","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"چِنَار","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"cynʾl","categoria":"ereditato"}],"lontana":"pal","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish چِنَار (çınâr), borrowed from Classical Persian چِنَار (činār), from Middle Persian cynʾl (/⁠činār⁠/)."},{"parola":"чума","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"plague, pestilence","termine_origine":"چوما","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چوما","categoria":"prestito"},{"codice":"ro","nome":"Romanian","termine":"ciumă","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cȳma","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"κῦμᾰ","categoria":"prestito"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"Ultimately from Romanian ciumă."},{"parola":"шайка","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"saic, a kind of small boat of up to twelve cannons heavily used in the Black Sea, Tisa, Danube and Sava; similar to the…","termine_origine":"شایقه","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"شایقه","categoria":"prestito"},{"codice":"bg","nome":"Bulgarian","termine":"ша́йка","categoria":"non_precisato"}],"lontana":"bg","ambiti":["mare"],"via":"","testo":"Borrowed from Ottoman Turkish شایقه (şayka), from Bulgarian ша́йка (šájka, “saic”). Doublet of ча́йка (čájka)."},{"parola":"шафран","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"saffron","termine_origine":"صفران","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"صفران","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"زَعْفَرَان","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish صفران (Turkish şafran), from Arabic زَعْفَرَان (zaʕfarān)."},{"parola":"шербет","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sherbet, sorbet (frozen fruit juice)","termine_origine":"شربت","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"شربت","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"شَرْبَت","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"شَرْبَة","categoria":"prestito"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"Borrowed from Ottoman Turkish شربت (şerbet), borrowed from Classical Persian شَرْبَت (šarbat), borrowed from Arabic شَرْبَة (šarba), from شَرِبَ (šariba)."},{"parola":"шишак","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"chichak, lobster-tailed pot helmet, zischägge (a conical helmet, often with cheekpieces and a neck guard, used in Musli…","termine_origine":"چیچك","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"چیچك","categoria":"non_precisato"}],"lontana":"ota","ambiti":["militare"],"via":"","testo":"Ultimately from Ottoman Turkish چیچك (çiçek, literally “flower”), perhaps through the intermediary of Polish szyszak or Hungarian sisak."},{"parola":"янычар","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"janissary (former Turkish soldier)","termine_origine":"یڭیچری","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"یڭیچری","categoria":"prestito"},{"codice":"uk","nome":"Ukrainian","termine":"янича́р","categoria":"prestito"}],"lontana":"uk","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish یڭیچری (yeniçeri), from یڭی (yeni, “new”) + چری (çeri, “soldier”). Per Vasmer, presence of -ы- points to a borrowing through Ukrainian янича́р (janyčár)."},{"parola":"ятаган","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yataghan (type of sword)","termine_origine":"یتاغان⁩","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"یتاغان⁩","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish یتاغان (yatağan)."}]}