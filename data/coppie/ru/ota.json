{"arrivo":"ru","origine":"ota","origine_nome":"Ottoman Turkish","n":62,"parole":[{"parola":"аба","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aba, a coarse woven cloth","termine_origine":"عبا","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"عبا","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"عَبَاءَة","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish عبا (abâ) (Turkish aba), from Arabic عَبَاءَة (ʕabāʔa)."},{"parola":"абдал","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Abdal (a sect of Persian monks)","termine_origine":"ابدال","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"ابدال","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish ابدال (abdal, aptal, “pauper, Dervish”), whence Turkish aptal (“idiot”); see for more."},{"parola":"абдест","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abdest, wudu (Islamic procedure of ablution)","termine_origine":"آبدست","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"آبدست","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"آبدست","categoria":"non_precisato"}],"lontana":"fa-cls","ambiti":["religione"],"via":"","testo":"Borrowed from Ottoman Turkish آبدست (âbdest), from Classical Persian آبدست (ābdast)."},{"parola":"аршин","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"arshin","termine_origine":"آرشون / آرشین","catena":[{"codice":"ota","nome":"Ottoman Turkish","termine":"آرشون / آرشین","categoria":"prestito"}],"lontana":"ota","ambiti":[],"via":"","testo":"Borrowed from Ottoman Turkish آرشون / آرشین (arşın) (Turkish arşın)."},{"parola":"баклава","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"baklava (dessert)","termine_origine":"باقلوا","catena":[{"codice":"ota"