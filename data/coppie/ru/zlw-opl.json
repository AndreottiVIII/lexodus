,{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*rād","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*rēdaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Old East Slavic ра́да (ráda), from Old Polish rada, from Old Czech rada, from Middle High German rāt, from Old High German rāt, from Proto-West Germanic *rād, from Proto-Germanic *rēdaz."},{"parola":"смертельный","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"mortal, deadly, lethal, fatal","termine_origine":"śmiertelny","catena":[{"codice":"zlw-opl","nome":"Old Polish","termine":"śmiertelny","categoria":"prestito"},{"codice":"zle-ort","nome":"Old Ruthenian","termine":"смерте́льный","categoria":"prestito"},{"codice":"zlw-ocs","nome":"Old Czech","termine":"smrtelný","categoria":"non_precisato"}],"lontana":"zlw-ocs","ambiti":[],"via":"","testo":"Borrowed from Old Polish śmiertelny, probably via Old Ruthenian смерте́льный (smertélʹnyj), ultimately from Old Czech smrtedlný."},{"parola":"цинга","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; perhaps; modello unc/uncertain","significato":"scurvy (deficiency of vitamin C)","termine_origine":"dzięgna","catena":[{"codice":"zlw-opl","nome":"Old Polish","termine":"dzięgna","categoria":"non_precisato"}],"lontana":"zlw-opl","ambiti":["scienza"],"via":"","testo":"Inherited from Middle Russian цынга (cynga), цѣнга (cěnga), both att. 1608, further origin uncertain. Perhaps from rare Old Polish dzięgna (“stomatitis”) (att. in 15th-16th cc.)."},{"parola":"школа","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"school","termine_origine":"szkoła","catena":[{"codice":"zlw-opl","nome":"Old Polish","termine":"szkoła","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"schola","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"σχολή","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Inherited from Old East Slavic школа (škola), from Old Polish szkoła (“school”), ultimately from Latin schola, from Ancient Greek σχολή (skholḗ)."}]}