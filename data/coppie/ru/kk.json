{"arrivo":"ru","origine":"kk","origine_nome":"Kazakh","n":18,"n_alternative":0,"parole":[{"parola":"аким","traslitterazione":"akím","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"akim, a leader of a local administration in Kazakhstan or Kyrgyzstan","termine_origine":"әкім","termine_origine_traslitterazione":"äkim","catena":[{"codice":"kk","nome":"Kazakh","termine":"әкім","traslitterazione":"äkim","categoria":"prestito"},{"codice":"ky","nome":"Kyrgyz","termine":"аким","traslitterazione":"akim","categoria":"prestito"}],"lontana":"ky","ambiti":[],"via":"","testo":"Borrowed from Kazakh әкім (äkim) or Kyrgyz аким (akim)."},{"parola":"апайка","traslitterazione":"apájka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A (generally Turkic-speaking or Asian and typically older or married) woman","termine_origine":"апай","termine_origine_traslitterazione":"apay","catena":[{"codice":"kk","nome":"Kazakh","termine":"апай","traslitterazione":"apay","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from a Turkic language, such as Kazakh апай (apay), with addition of -ка (-ka)."},{"parola":"бархан","traslitterazione":"barxán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"barchan, sand dune (formed by the wind into a crescent shape)","termine_origine":"барқан","termine_origine_traslitterazione":"barqan","catena":[{"codice":"kk","nome":"Kazakh","termine":"барқан","traslitterazione":"barqan","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh барқан (barqan, “sand dune”)."},{"parola":"домбра","traslitterazione":"dombrá","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dombra (long-necked lute of Turkic or Central Asian origin)","termine_origine":"домбыра","termine_origine_traslitterazione":"dombıra","catena":[{"codice":"kk","nome":"Kazakh","termine":"домбыра","traslitterazione":"dombıra","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"دنب بره","traslitterazione":"donb-e barre","categoria":"non_precisato"}],"lontana":"fa","ambiti":["musica"],"via":"","testo":"Borrowed from Kazakh домбыра (dombıra), from Persian دنب بره (donb-e barre, literally “lamb's tail”). Related to Ottoman Turkish طنبوره (tanbura/tambura), Turkish tambura, Romanian tambură, Arabic طُنْبُور (ṭunbūr), etc. Doublet of до́мра (dómra) and танбу́р (tanbúr)."},{"parola":"елбасы","traslitterazione":"jelbasý","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"title of a head of state in Kazakhstan","termine_origine":"елбасы","termine_origine_traslitterazione":"elbası","catena":[{"codice":"kk","nome":"Kazakh","termine":"елбасы","traslitterazione":"elbası","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh елбасы (elbası)."},{"parola":"жуз","traslitterazione":"žuz","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"zhuz, horde, a Kazakh clan or tribal division","termine_origine":"жүз","termine_origine_traslitterazione":"jüz","catena":[{"codice":"kk","nome":"Kazakh","termine":"жүз","traslitterazione":"jüz","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh жүз (jüz)."},{"parola":"изень","traslitterazione":"izénʹ","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Bassia prostrata","termine_origine":"изен","termine_origine_traslitterazione":"ıyzen","catena":[{"codice":"kk","nome":"Kazakh","termine":"изен","traslitterazione":"ıyzen","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh изен (ıyzen)."},{"parola":"казах","traslitterazione":"kazáx","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"Kazakh (person)","termine_origine":"қазақ","termine_origine_traslitterazione":"qazaq","catena":[{"codice":"kk","nome":"Kazakh","termine":"қазақ","traslitterazione":"qazaq","categoria":"non_precisato"},{"codice":"otk","nome":"Old Turkic","termine":"𐰴𐰔𐰍𐰴","traslitterazione":"qazǧaq","categoria":"non_precisato"},{"codice":"trk-pro","nome":"Proto-Turkic","termine":"*kaŕ-","categoria":"non_precisato"}],"lontana":"trk-pro","ambiti":[],"via":"","testo":"From Kazakh қазақ (qazaq), from Old Turkic 𐰴𐰔𐰍𐰴 (qazǧaq, “profiteer”), from 𐰴𐰔𐰍𐰣𐰢𐰴 (qazǧanmaq, “to acquire”), from 𐰴𐰔𐰢𐰴 (qazmaq, “to dig out”), from Proto-Turkic *kaŕ-. Doublet of каза́к (kazák, “Cossack”). Russian [x] possibly reflects the Kazakh allaphony of the phoneme /q/ to [χ], i.e. қазақ /qaz"},{"parola":"канар","traslitterazione":"kanár","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a large bag in which cotton is collected","termine_origine":"қанар","termine_origine_traslitterazione":"qanar","catena":[{"codice":"kk","nome":"Kazakh","termine":"қанар","traslitterazione":"qanar","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"کنار","traslitterazione":"kanâr","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"Borrowed from Kazakh қанар (qanar) (Uzbek qanor), from Persian کنار (kanâr, “side, edge, border”) apparently because the sack was to the side of man, or the sacks were at the border of the field, during reaping."},{"parola":"лобия","traslitterazione":"lóbija","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cowpea (Vigna unguiculata)","termine_origine":"лобия","termine_origine_traslitterazione":"lobıya","catena":[{"codice":"kk","nome":"Kazakh","termine":"лобия","traslitterazione":"lobıya","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"لوبیا","traslitterazione":"lôbiyâ","categoria":"non_precisato"}],"lontana":"fa","ambiti":[],"via":"","testo":"1920s, from Kazakh лобия (lobıya), from Persian لوبیا (lôbiyâ)."},{"parola":"мамбет","traslitterazione":"mambét","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a rural Kazakh person, perceived to be uneducated.","termine_origine":"Мәмбет","termine_origine_traslitterazione":"Mämbet","catena":[{"codice":"kk","nome":"Kazakh","termine":"Мәмбет","traslitterazione":"Mämbet","categoria":"prestito"},{"codice":"ar","nome":"Arabic","termine":"مُحَمَّد","traslitterazione":"muḥammad","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Kazakh Мәмбет (Mämbet), a popular name among Kazakh men, which is also used in Kazakh slang to refer to a country bumpkin or yokel; ultimately Arabic مُحَمَّد (muḥammad). Sense 5 was most likely brought to Yakutia from soldiers returning from the Soviet Army."},{"parola":"маш","traslitterazione":"maš","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mung bean (Vigna radiata)","termine_origine":"мәш","termine_origine_traslitterazione":"mäš","catena":[{"codice":"kk","nome":"Kazakh","termine":"мәш","traslitterazione":"mäš","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"ماش","traslitterazione":"mâš","categoria":"non_precisato"}],"lontana":"fa","ambiti":["cucina"],"via":"","testo":"1920s, from Kazakh мәш (mäš), from Persian ماش (mâš)"},{"parola":"такыр","traslitterazione":"takýr","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"takyr","termine_origine":"тақыр","termine_origine_traslitterazione":"taqır","catena":[{"codice":"kk","nome":"Kazakh","termine":"тақыр","traslitterazione":"taqır","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh тақыр (taqır) and other Turkic languages."},{"parola":"тенге","traslitterazione":"tɛngé","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tenge (currency of Kazakhstan)","termine_origine":"теңге","termine_origine_traslitterazione":"teŋge","catena":[{"codice":"kk","nome":"Kazakh","termine":"теңге","traslitterazione":"teŋge","categoria":"prestito"}],"lontana":"kk","ambiti":["finanza"],"via":"","testo":"Borrowed from Kazakh теңге (teŋge)."},{"parola":"тоскать","traslitterazione":"tóskatʹ","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to pot, put a child on the potty","termine_origine":"тосу","termine_origine_traslitterazione":"tosuw","catena":[{"codice":"kk","nome":"Kazakh","termine":"тосу","traslitterazione":"tosuw","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh тосу (tosuw, “to pot a child”)."},{"parola":"тушканчик","traslitterazione":"tuškánčik","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"jerboa (small rodent)","termine_origine":"тышқан","termine_origine_traslitterazione":"tıšqan","catena":[{"codice":"kk","nome":"Kazakh","termine":"тышқан","traslitterazione":"tıšqan","categoria":"non_precisato"},{"codice":"trk-pro","nome":"Proto-Turkic","termine":"*sïčgan","categoria":"non_precisato"}],"lontana":"trk-pro","ambiti":[],"via":"","testo":"Attested at least since 1780s, akin to later attested Russian тушкан (tuškan), from Kazakh тышқан (tıšqan, “mouse”), from Proto-Turkic *sïčgan."},{"parola":"ушкан","traslitterazione":"uškán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of за́яц (zájac): hare","termine_origine":"тышқан","termine_origine_traslitterazione":"tıšqan","catena":[{"codice":"kk","nome":"Kazakh","termine":"тышқан","traslitterazione":"tıšqan","categoria":"prestito"}],"lontana":"kk","ambiti":[],"via":"","testo":"Borrowed from Kazakh тышқан (tıšqan, “mouse”), influenced by Russian у́хо (úxo, “ear”). By surface analysis, from у́шко́ (úškó, diminutive of у́хо (úxo, “ear”)) + -ан (-an). Doublet of тушка́нчик (tuškánčik)."},{"parola":"шельпек","traslitterazione":"šelpék","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shelpek (Central Asian flatbread)","termine_origine":"шелпек","termine_origine_traslitterazione":"šelpek","catena":[{"codice":"kk","nome":"Kazakh","termine":"шелпек","traslitterazione":"šelpek","categoria":"prestito"}],"lontana":"kk","ambiti":["cucina"],"via":"","testo":"Borrowed from Kazakh шелпек (šelpek)"}]}