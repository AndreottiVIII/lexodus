{"arrivo":"ru","origine":"yi","origine_nome":"Yiddish","n":21,"n_alternative":0,"parole":[{"parola":"аид","traslitterazione":"aíd","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Yid, Jew","termine_origine":"אַ ייִד","termine_origine_traslitterazione":"a yid","catena":[{"codice":"yi","nome":"Yiddish","termine":"אַ ייִד","traslitterazione":"a yid","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"Borrowed from Yiddish אַ ייִד (a yid, “a Jew”)."},{"parola":"аидыше","traslitterazione":"aídyše","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Jewish","termine_origine":"אַ ייִדישע","termine_origine_traslitterazione":"a yidishe","catena":[{"codice":"yi","nome":"Yiddish","termine":"אַ ייִדישע","traslitterazione":"a yidishe","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"Borrowed from Yiddish אַ ייִדישע (a yidishe, “a Jewish”)."},{"parola":"гой","traslitterazione":"goj","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Goy, gentile, non-Jew.","termine_origine":"גוי","termine_origine_traslitterazione":"goy","catena":[{"codice":"yi","nome":"Yiddish","termine":"גוי","traslitterazione":"goy","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"גּוֹי","traslitterazione":"góy","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish גוי (goy, “gentile”), from Hebrew גּוֹי (góy, “nation”)."},{"parola":"дрек","traslitterazione":"drɛk","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dreck, shit, crap","termine_origine":"דרעק","termine_origine_traslitterazione":"drek","catena":[{"codice":"yi","nome":"Yiddish","termine":"דרעק","traslitterazione":"drek","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*þrakjaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Yiddish דרעק (drek), ulti