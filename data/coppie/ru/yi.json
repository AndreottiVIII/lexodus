igine":"","catena":[{"codice":"yi","nome":"Yiddish","termine":"","categoria":"prestito"},{"codice":"ro","nome":"Romanian","termine":"chifteluțe","categoria":"non_precisato"},{"codice":"ota","nome":"Ottoman Turkish","termine":"كوفته","traslitterazione":"köfte","categoria":"non_precisato"},{"codice":"fa","nome":"Persian","termine":"کوفته","traslitterazione":"kufte","categoria":"non_precisato"}],"lontana":"fa","ambiti":["cucina"],"via":"","testo":"Via Yiddish from Romanian chifteluțe, plural of chifteluță, derivative of chiftea, from Ottoman Turkish كوفته (köfte), from Persian کوفته (kufte)."},{"parola":"треф","traslitterazione":"tref","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"treyf","termine_origine":"טרייף","termine_origine_traslitterazione":"treyf","catena":[{"codice":"yi","nome":"Yiddish","termine":"טרייף","traslitterazione":"treyf","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"טְרֵפָה","traslitterazione":"trefá","categoria":"non_precisato"}],"lontana":"he","ambiti":["religione"],"via":"","testo":"From Yiddish טרייף (treyf), from Hebrew טְרֵפָה (trefá). Doublet of трефа (trefa) of newer origin, with same sense."},{"parola":"форшмак","traslitterazione":"foršmák","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"vorschmack (a dish made of minced meat, onion, water, anchovies and/or herring)","termine_origine":"פֿאָרשמאַק","termine_origine_traslitterazione":"forshmak","catena":[{"codice":"yi","nome":"Yiddish","termine":"פֿאָרשמאַק","traslitterazione":"forshmak","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"Borrowed from Yiddish פֿאָרשמאַק (forshmak)"},{"parola":"хохма","traslitterazione":"xóxma","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"joke, anecdote (funny or amusing story)","termine_origine":"חכמה","termine_origine_traslitterazione":"khokhme","catena":[{"codice":"yi","nome":"Yiddish","termine":"חכמה","traslitterazione":"khokhme","categoria":"prestito"},{"codice":"he","nome":"Hebrew","termine":"חוכמה","traslitterazione":"khokhmá","categoria":"non_precisato"}],"lontana":"he","ambiti":[],"via":"","testo":"Borrowed from Yiddish חכמה (khokhme, “wit”), from Hebrew חוכמה (khokhmá, “wisdom”). A well-known folk etymology relates the noun to хохотать (xoxotatʹ, “to laugh”). Seems to originate from Odessan dialect, and from there spread around during the 20th century."},{"parola":"чмо","traslitterazione":"čmo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jerk, schmuck, schmoe, scoundrel, an unpleasant or detestable person, or a person without morals","termine_origine":"שמאָק","termine_origine_traslitterazione":"shmok","catena":[{"codice":"yi","nome":"Yiddish","termine":"שמאָק","traslitterazione":"shmok","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"Borrowed from Yiddish שמאָק (shmok, “penis”)."},{"parola":"шнобель","traslitterazione":"šnóbelʹ","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"schnozzle, conk, honker, schnoz, snoot (human nose)","termine_origine":"שנאָבל","termine_origine_traslitterazione":"shnobl","catena":[{"codice":"yi","nome":"Yiddish","termine":"שנאָבל","traslitterazione":"shnobl","categoria":"prestito"}],"lontana":"yi","ambiti":[],"via":"","testo":"Borrowed from Yiddish שנאָבל (shnobl, “beak, nose”), compare German Schnabel (“beak”)."},{"parola":"шухер","traslitterazione":"šúxer","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"police raid, (house) search","termine_origine":"זוכער","termine_origine_traslitterazione":"zukher","catena":[{"codice":"yi","nome":"Yiddish","termine":"זוכער","traslitterazione":"zukher","categoria":"prestito"},{"codice":"uk","nome":"Ukrainian","termine":"шукати","traslitterazione":"šukaty","categoria":"non_precisato"},{"codice":"pl","nome":"Polish","termine":"szukać","categoria":"non_precisato"}],"lontana":"pl","ambiti":[],"via":"","testo":"Borrowed from Yiddish זוכער (zukher, “searcher”). Perhaps morphologically also influenced by Ukrainian шукати (šukaty), Polish szukać, both meaning \"to search\"."}]}