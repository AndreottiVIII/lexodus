{"arrivo":"ru","origine":"fr","origine_nome":"French","livello2":"la-vul","livello2_nome":"Vulgar Latin","n":9,"parole":[{"parola":"авантюра","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gamble (risky, uncertain and occasionally successful event or action)","termine_origine":"aventure","catena":[{"codice":"fr","nome":"French","termine":"aventure","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*adventūra","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from French aventure, from Vulgar Latin *adventūra."},{"parola":"аккорд","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"chord","termine_origine":"accord","catena":[{"codice":"fr","nome":"French","termine":"accord","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*accordāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["musica"],"via":"","testo":"Borrowed from French accord. Further from Vulgar Latin *accordāre, from ac- + Latin cor (see concordō)."},{"parola":"барьер","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"barrier (structure that bars passage)","termine_origine":"barrière","catena":[{"codice":"fr","nome":"French","termine":"barrière","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*barra","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["sport"],"via":"","testo":"Borrowed from French barrière f. Omitting several steps, from Vulgar Latin *barra."},{"parola":"бокаж","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"bocage","termine_origine":"bocage","catena":[{"codice":"fr","nome":"French","termine":"bocage","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*boscāticum","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*busk","categoria":"non_precisat