},{"parola":"спекуляция","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"speculation","termine_origine":"speculātiō","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"speculātiō","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Ultimately from Late Latin speculātiō."},{"parola":"фонтан","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"fountain","termine_origine":"fontāna","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"fontāna","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Late Latin fontāna, further from Latin fons. Compare natively formed Bulgarian водоскок (vodoskok), Polish wodotrysk."}]}