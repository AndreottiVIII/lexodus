{"arrivo":"ru","origine":"it","origine_nome":"Italian","livello2":"la","livello2_nome":"Latin","n":22,"parole":[{"parola":"ария","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aria","termine_origine":"aria","catena":[{"codice":"it","nome":"Italian","termine":"aria","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"āēr","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ᾱ̓ήρ","categoria":"prestito"},{"codice":"grk-pro","nome":"Proto-Hellenic","termine":"*auhḗr","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*h₂ewsér","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["musica"],"via":"","testo":"Borrowed from Italian aria."},{"parola":"валюта","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"currency (money or other item used to facilitate transactions)","termine_origine":"valuta","catena":[{"codice":"it","nome":"Italian","termine":"valuta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"valeō","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza"],"via":"","testo":"Borrowed from Italian valuta (“currency”), from Latin valeō (“to be worth”)."},{"parola":"вермишель","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"vermicelli","termine_origine":"vermicelli","catena":[{"codice":"it","nome":"Italian","termine":"vermicelli","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vermis","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Italian vermicelli (“little worms”), from verme (“worm”), from Latin vermis (“worm”). Via PIE cognate with Old East Slavic вермие (vermije), English worm."},{"parola":"дива","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"diva","termine_origine":"diva","catena":[{"codice":"it","nome":"Italian","termine":"diva","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dīva","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian diva (“diva, goddess”), from Latin dīva (“goddess”), feminine of dīvus (“divine, divine one; notably a deified mortal”)."},{"parola":"дуче","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"duce (nickname for Mussolini)","termine_origine":"duce","catena":[{"codice":"it","nome":"Italian","termine":"duce","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dux","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dewk-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Italian duce (“leader”). Further from Latin dux (akin to dūcō), whence also дож (dož) and дюк (djuk). Ultimately from Proto-Indo-European *dewk-, whence also the second component of ге́рцог (gércog)."},{"parola":"инкассатор","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"money collector, collection agent, cash messenger","termine_origine":"incassare","catena":[{"codice":"it","nome":"Italian","termine":"incassare","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capsa","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian incassare (“to collect cash, put in a box”). Omitting several steps, from Latin capsa."},{"parola":"казино","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"casino","termine_origine":"casino","catena":[{"codice":"it","nome":"Italian","termine":"casino","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"casa","categoria":"non_precisato"}],"lontana":"la","ambiti":["sport"],"via":"fr","testo":"Borrowed from Italian casino via French. Further from Latin casa."},{"parola":"камфора","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"camphor","termine_origine":"canfora","catena":[{"codice":"it","nome":"Italian","termine":"canfora","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"camphora","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"كَافُور","categoria":"non_precisato"}],"lontana":"ar","ambiti":["scienza"],"via":"","testo":"Possibly via Italian canfora, from Latin camphora, from Arabic كَافُور (kāfūr)."},{"parola":"каналья","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rogue, rascal","termine_origine":"canaglia","catena":[{"codice":"it","nome":"Italian","termine":"canaglia","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"canis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian canaglia. Further from Latin canis."},{"parola":"кане-корсо","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Cane Corso (Italian dog breed)","termine_origine":"cane corso","catena":[{"codice":"it","nome":"Italian","termine":"cane corso","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cohors","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Italian cane corso (literally “Corsican dog”), with adjective corso being more likely derived from Latin cohors (“farmyard; enclosure”)."},{"parola":"касса","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pay desk, cash desk, checkout","termine_origine":"cassa","catena":[{"codice":"it","nome":"Italian","termine":"cassa","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capsa","categoria":"non_precisato"}],"lontana":"la","ambiti":["diritto_politica"],"via":"","testo":"Borrowed from Italian cassa, from Latin capsa. Doublet of ка́псула (kápsula), ка́псюль (kápsjulʹ), кассе́та (kasséta), and шасси́ (šassí)."},{"parola":"крещендо","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cr