{"arrivo":"ru","origine":"de","origine_nome":"German","livello2":"la","livello2_nome":"Latin","n":83,"parole":[{"parola":"аборт","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"abortion","termine_origine":"Abort","catena":[{"codice":"de","nome":"German","termine":"Abort","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"abortiō","categoria":"non_precisato"},{"codice":"en","nome":"English","termine":"abort","categoria":"prestito"}],"lontana":"en","ambiti":["scienza","informatica"],"via":"","testo":"From German Abort, itself derived from Latin abortiō. In the computing sense: from English abort."},{"parola":"акация","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"acacia (shrub or tree)","termine_origine":"Akazie","catena":[{"codice":"de","nome":"German","termine":"Akazie","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"acacia","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀκακία","categoria":"non_precisato"}],"lontana":"grc","ambiti":["scienza"],"via":"","testo":"Borrowed from German Akazie, from Latin acacia, from Ancient Greek ἀκακία (akakía)."},{"parola":"аквамарин","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aquamarine","termine_origine":"Aquamarin","catena":[{"codice":"de","nome":"German","termine":"Aquamarin","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aqua marīna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from German Aquamarin, from Latin aqua marīna (“sea water”)."},{"parola":"антиквар","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"antiquarian","termine_origine":"Antiquar","catena":[{"codice":"de","nome":"German","termine":"Antiquar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"antiquarius","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from German Antiquar, from Latin antiquarius."},{"parola":"антрацит","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"anthracite (form of carbon)","termine_origine":"Anthrazit","catena":[{"codice":"de","nome":"German","termine":"Anthrazit","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"anthracītis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἀνθρακῖτις","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From German Anthrazit, from Latin anthracītis, from Ancient Greek ἀνθρακῖτις (anthrakîtis)."},{"parola":"артефакт","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"artifact (archaeological object)","termine_origine":"Artefakt","catena":[{"codice":"de","nome":"German","termine":"Artefakt","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ars","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from German Artefakt. Further from Latin ars + Latin factus."},{"parola":"артикул","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"article, item, commodity","termine_origine":"Artikel","catena":[{"codice":"de","nome":"German","termine":"Artikel","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"articulus","categoria":"non_precisato"}],"lontana":"la","ambiti":["diritto_politica"],"via":"","testo":"Borrowed from German Artikel, from Latin articulus; attested 1704. Displaced the earlier form арты́кул (artýkul), which was borrowed from Polish artykuł. Doublet of арти́кль (artíklʹ)."},{"parola":"асиндетон","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"asyndeton","termine_origine":"Asyndeton","catena":[{"codice":"de","nome":"German","termine":"Asyndeton","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"asyndeton","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","t