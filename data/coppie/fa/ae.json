{"arrivo":"fa","origine":"ae","origine_nome":"Avestan","n":22,"n_alternative":3,"parole":[{"parola":"آژیر","traslitterazione":"āžīr","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"alert, alarm","termine_origine":"","catena":[{"codice":"ae","nome":"Avestan","termine":"","categoria":"prestito"}],"lontana":"ae","ambiti":["scienza"],"via":"","testo":"Borrowed from Avestan, etymologically related to زیرک (zīrak, “clever”) and چیره (čēra, “dominant, victorious”)."},{"parola":"اشم وهو","traslitterazione":"ašem vohu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Ashem Vohu, one of the four great Avestan mantras","termine_origine":"𐬀𐬴𐬆𐬨 𐬬𐬊𐬵𐬏","termine_origine_traslitterazione":"aṣ̌əm vohū","catena":[{"codice":"ae","nome":"Avestan","termine":"𐬀𐬴𐬆𐬨 𐬬𐬊𐬵𐬏","traslitterazione":"aṣ̌əm vohū","categoria":"prestito"}],"lontana":"ae","ambiti":["religione"],"via":"","testo":"Borrowed from Avestan 𐬀𐬴𐬆𐬨 𐬬𐬊𐬵𐬏 (aṣ̌əm vohū)."},{"parola":"اندیشه نیک، گفتار نیک، کردار نیک","traslitterazione":"andēša-yi nēk","pos":"phrase","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"Good thoughts, Good words, Good deeds; a phrase that represents the three pillars of Zoroastrian Faith","termine_origine":"𐬵𐬎𐬨𐬀𐬙𐬀 𐬵𐬏𐬑𐬙𐬀 𐬵𐬬𐬀𐬭𐬱𐬙𐬀","termine_origine_traslitterazione":"humata hūxta hvaršta","catena":[{"codice":"ae","nome":"Avestan","termine":"𐬵𐬎𐬨𐬀𐬙𐬀 𐬵𐬏𐬑𐬙𐬀 𐬵𐬬𐬀𐬭𐬱𐬙𐬀","traslitterazione":"humata hūxta hvaršta","categoria":"calco"}],"lontana":"ae","ambiti":[],"via":"","testo":"Calque of Avestan 𐬵𐬎𐬨𐬀𐬙𐬀 𐬵𐬏𐬑𐬙𐬀 𐬵𐬬𐬀𐬭𐬱𐬙𐬀 (humata hūxta hvaršta)."},{"parola":"اهورا","traslitterazione":"ahurâ","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Ahura","termine_origine":"𐬀𐬵𐬎𐬭𐬀","termine_origine_traslitterazione":"ahura","catena":[{"codice":"ae","nome":"Avestan","termine":"𐬀𐬵𐬎𐬭𐬀","traslitterazione":"ahura","categoria":"non_precisato"}],"lontana":"ae","ambiti":[],"via":"","testo":"From Avestan 𐬀𐬵𐬎𐬭𐬀 (ahu