{"arrivo":"fa","origine":"inc-hnd","origine_nome":"Hindustani","n":33,"n_alternative":3,"parole":[{"parola":"آلو","traslitterazione":"âlu","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"potato","termine_origine":"","catena":[{"codice":"inc-hnd","nome":"Hindustani","termine":"","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"आलू","traslitterazione":"ālū","categoria":"prestito"},{"codice":"ur","nome":"Urdu","termine":"آلو","traslitterazione":"ālū","categoria":"prestito"},{"codice":"sa","nome":"Sanskrit","termine":"आलु","traslitterazione":"ālu","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Borrowed from Hindustani (Hindi आलू (ālū), Urdu آلو (ālū)), from Sanskrit आलु (ālu), आलुक (āluka). Doublet of Persian کچالو (kačālū)."},{"parola":"آم","traslitterazione":"ām","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mango","termine_origine":"","catena":[{"codice":"inc-hnd","nome":"Hindustani","termine":"","categoria":"prestito"}],"lontana":"inc-hnd","ambiti":["cucina"],"via":"","testo":"Borrowed from Hindustani आम / آم (ām)."},{"parola":"انگریزی","traslitterazione":"angrēzī","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"synonym of انگلیسی (inglīsī, “English, British”)","termine_origine":"","catena":[{"codice":"inc-hnd","nome":"Hindustani","termine":"","categoria":"prestito"}],"lontana":"inc-hnd","ambiti":[],"via":"","testo":"Borrowed from Hindustani اَن٘گْریزِی / अंग्रेज़ी (aṅgrezī). By surface analysis, انگریز (angrēz, “English (person)”) + ـی (-ī, suffix forming adjectives)."},{"parola":"بارسات","traslitterazione":"bârsât","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"monsoon, rainy season in India","termine_origine":"","catena":[{"codice":"inc-hnd","nome":"Hindustani","termine":"","categoria":"prestito"},{"codice":"hi","nome":"Hindi","termine":"बरसात","traslitterazione":"barsāt","ca