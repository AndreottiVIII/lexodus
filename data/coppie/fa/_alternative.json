-pro","nome":"Proto-Indo-European","termine":"*upó","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*werh₁-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*welh₁-","categoria":"non_precisato"}]},{"parola":"باک","traslitterazione":"bāk","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Unknown; alternatively","significato":"dread, fear","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"From Middle Persian [Term?] (/⁠wāk⁠/), [Term?] (/⁠wāg⁠/), further etymology unknown. Alternatively, from Proto-Iranian *bā(ia)-ka-, from Proto-Iranian *baiH- (“to fear”), from Proto-Indo-European *bʰeyh₂- (“to fear, be afraid”). Compare Old Armenian վախեմ (vaxem).","alternative":[{"codice":"pal","nome":"Middle Persian","termine":"","categoria":"non_precisato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"*baiH-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰeyh₂-","categoria":"non_precisato"}]},{"parola":"برم","traslitterazione":"barm","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"alternatively","significato":"memory","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"From Middle Persian wlm (warm), from Proto-Iranian [Term?], ultimately from Proto-Indo-European *wer- (“to heed, be wary, watch, guard”). Cognates include Ancient Greek ὁράω (horáō, “to see, watch”), Latin vereor (“to revere, fear”), and Old English warnian (“to warn, be wary”). Alternatively from P","alternative":[{"codice":"pal","nome":"Middle Persian","termine":"wlm","traslitterazione":"warm","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*wer-","categoria":"non_precisato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"*warH-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*welh₁-","categoria":"non_precisato"}]},{"parola":"بلبل","traslitterazione":"bolbol","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Unclear; or from","significato":"nightingale","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"From Proto-Indo-European *balbal- (“babbling, unclear speech”) (compare Latin balbus (“stammering”)), or from Arabic بُلْبُل (bulbul), both derivations of ultimate onomatopoeic origin.","alternative":[{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*balbal-","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"بُلْبُل","traslitterazione":"bulbul","categoria":"non_precisato"}]},{"parola":"بلیت","traslitterazione":"belit","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"ticket","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"From French billet, either directly with a spelling pronunciation or through Russian билет (bilet).","alternative":[{"codice":"fr","nome":"French","termine":"billet","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"билет","traslitterazione":"bilet","categoria":"non_precisato"}]},{"parola":"تخش","traslitterazione":"taxš","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"or from","significato":"arrow","termine_origine":"","catena":[],"lontana":null,"ambiti":["militare"],"via":"","testo":"From تخشیدن (taxšīdan /taxšidan, “to sit on the first place”) (see Etymology 2), or from Old Persian *taxšah (“arrow”), from Proto-Iranian *taxša (“bow”), from Proto-Indo-European *tekʷ- (“to run”).","alternative":[{"codice":"peo","nome":"Old Persian","termine":"*taxšah","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"*taxša","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*tekʷ-","categoria":"non_precisato"}]},{"parola":"تراـ","traslitterazione":"tarâ-","pos":"prefix","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"more than one origin proposed","significato":"trans-","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Learned borrowing from Avestan 𐬙𐬀𐬭𐬋 (tarō) by the 2nd APLL as a phono-semantic matching of English trans- and such other suffixes. Also compare Middle Persian [Book Pahlavi needed] (LCDr' /⁠tar⁠/), Manichaean Middle Persian 𐫤𐫡 (tr /⁠tar⁠/).","alternative":[{"codice":"ae","nome":"Avestan","termine":"𐬙𐬀𐬭𐬋","traslitterazione":"tarō","categoria":"prestito"},{"codice":"en","nome":"English","termine":"trans-","categoria":"calco"}]},{"parola":"ترخون","traslitterazione":"tarxun","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"tarragon","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Borrowed from Arabic طَرْخُون (ṭarḵūn), from Ancient Greek δρακόντιον (drakóntion, “edder-wort”). Or from another Iranian language and derived from the cognate to Persian تلخ (talx, “bitter”), compare Dari ترخ, طرخ (tarx, terx), ترخه, طرخه (tarxa, terxa, “any Artemisia”), Pashto ترخه f (tarxa, terxa","alternative":[{"codice":"ar","nome":"Arabic","termine":"طَرْخُون","traslitterazione":"ṭarḵūn","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"δρακόντιον","traslitterazione":"drakóntion","categoria":"non_precisato"},{"codice":"ira","nome":"Iranian","termine":"","categoria":"prestito"}]},{"parola":"تن","traslitterazione":"tan","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"a tonne / metric ton","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Borrowed from French tonne (in Iran) or from English ton (in Dari).","alternative":[{"codice":"fr","nome":"French","termine":"tonne","categoria":"prestito"},{"codice":"en","nome":"English","termine":"ton","categoria":"prestito"}]},{"parola":"تک","traslitterazione":"tak","pos":"adj","n_etimologia":2,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from","significato":"solo, single","termine_origine":"","catena":[],"lontana":null,"ambiti":["sport"],"via":"","testo":"From Ottoman Turkish تك (tek, “single”), from Proto-Turkic *tēk. Or from Middle Iranian. Compare Middle Persian tʾk (tāg, “item, unit; alone, single”), Persian تا (tâ, “item, unit; plait, fold, ply”).","alternative":[{"codice":"ota","nome":"Ottoman Turkish","termine":"تك","traslitterazione":"tek","categoria":"non_precisato"},{"codice":"trk-pro","nome":"Proto-Turkic","termine":"*tēk","categoria":"non_precisato"},{"codice":"ira-mid","nome":"Middle Iranian","termine":"","categoria":"non_precisato"},{"codice":"pal","nome":"Middle Persian","termine":"tʾk","traslitterazione":"tāg","categoria":"non_precisato"}]},{"parola":"تیغ","traslitterazione":"tēġ","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; or from; either","significato":"blade, razor","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Possibly either borrowed from Parthian 𐫤𐫏𐫃 (tyg /⁠tēγ⁠/, “blade; sword, lance”); or from Middle Persian [script needed] (tyh /⁠tēx⁠/, “sharp edge, ridge; ray”). Akin to Old Armenian տէգ (tēg), an Iranian borrowing.","alternative":[{"codice":"xpr","nome":"Parthian","termine":"𐫤𐫏𐫃","traslitterazione":"tyg","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"","traslitterazione":"tyh","categoria":"prestito"}]},{"parola":"جخش","traslitterazione":"jaxš","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"either","significato":"goitre","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"From either Parthian [script needed] (yxš /⁠yaxš⁠/, “a class of demon”) or Sogdian [script needed] (ykš /⁠yakš⁠/, “fiend, devil, Yaksha, ghost”), cognate with Sanskrit यक्ष (yakṣa).","alternative":[{"codice":"xpr","nome":"Parthian","termine":"","traslitterazione":"yxš","categoria":"non_precisato"},{"codice":"sog","nome":"Sogdian","termine":"","traslitterazione":"ykš","categoria":"non_precisato"}]},{"parola":"جر","traslitterazione":"jar","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably; alternatively","significato":"cleft, fissure","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Probably from Middle Iranian, ultimately from Proto-Indo-European *ǵʰoh₁ro- (“gap, empty space”). Alternatively from Turkic (compare Turkish yar).","alternative":[{"codice":"ira-mid","nome":"Middle Iranian","termine":"","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ǵʰoh₁ro-","categoria":"ereditato"},{"codice":"trk","nome":"Turkic","termine":"","categoria":"prestito"}]},{"parola":"جرمنی","traslitterazione":"jarmanī","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"more than one origin proposed","significato":"of or relating to Germany","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Borrowed from Hindustani جرمنی / जर्मनी (jarmanī), from English Germany.","alternative":[{"codice":"hi","nome":"Hindi","termine":"जर्मनी","traslitterazione":"jarmanī","categoria":"prestito"},{"codice":"ur","nome":"Urdu","termine":"جرمنی","categoria":"prestito"}]},{"parola":"جزیه","traslitterazione":"jizya","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"jizya (a per capita tax levied on a section of an Islamic state's non-Muslim citizens, who meet certain criteria)","termine_origine":"","catena":[],"lontana":null,"ambiti":["finanza","religione"],"via":"","testo":"Borrowed from Arabic جِزْيَة (jizya), from Middle Persian 𐭢𐭦𐭩𐭲𐭪𐭩 (gzytky /⁠gazīdag⁠/), 𐭢𐭦𐭩𐭲 (gzyt /⁠gazīd⁠/, “poll tax”), or from Arabic ج ز ي (j z y); compare جَزَى (jazā, “to repay”). At least a semantic loan from Middle Persian. Compare the inherited گزیت (gazit).","alternative":[{"codice":"ar","nome":"Arabic","termine":"جِزْيَة","traslitterazione":"jizya","categoria":"prestito"},{"codice":"pal","nome":"Middle Persian","termine":"𐭢𐭦𐭩𐭲𐭪𐭩","traslitterazione":"gzytky","categoria":"non_precisato"}]},{"parola":"جوال","traslitterazione":"juvâl","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"disputed; perhaps; alternatively","significato":"large sack","termine_origine":"","catena":[],"lontana":null,"ambiti":["moda"],"via":"","testo":"From Middle Persian [Book Pahlavi needed] (ywbʾl), [Book Pahlavi needed] (jwbʾl), [Book Pahlavi needed] (jwʾl). The last two have been alternatively read as [Book Pahlavi needed] (gwbʾl), [Book Pahlavi needed] (gwʾl). Its further origin is disputed. Perhaps from Old Iranian *yawa-barθra-, a compound","alternative":[{"codice":"pal","nome":"Middle Persian","termine":"","traslitterazione":"ywbʾl","categoria":"ereditato"},{"codice":"ira-old","nome":"Old Iranian","termine":"","categoria":"non_precisato"}]},{"parola":"دارچین","traslitterazione":"dārčīn","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"more than one origin proposed","significato":"cinnamon","termine_origine":"","catena":[],"lontana":null,"ambiti":["cucina"],"via":"","testo":"From Middle Persian *dār-ī-čēnīg (literally “Chinese tree”), ultimately a combination of Old Persian 𐎭𐎠𐎽𐎢𐎺 (d-a-ru-u-v, “tree”) + Sanskrit चीन (cīna, “China”) + -𐎡𐎣 (-i-k, adjectival suffix, from Proto-Indo-Iranian *-ikas). Note also from the same source are Jewish Babylonian Aramaic דַּרְצִינִי (da","alternative":[{"codice":"peo","nome":"Old Persian","termine":"𐎭𐎠𐎽𐎢𐎺","traslitterazione":"d-a-ru-u-v","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"चीन","traslitterazione":"cīna","categoria":"non_precisato"}]},{"parola":"درد","traslitterazione":"dard","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"either","significato":"pain","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"From Middle Persian dlt' (dard, “pain”), from Proto-Iranian *dar-ta- (“torn, burning, pain”), from Proto-Iranian *darH- (“to have pain”), from either Proto-Indo-European *der- (“to tear, split”) or Proto-Indo-European *delh₁- (“to split, suffer, be in pain”), the latter which Cheung considers to be ","alternative":[{"codice":"pal","nome":"Middle Persian","termine":"dlt'","traslitterazione":"dard","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"*dar-ta-","categoria":"ereditato"},{"codice":"ira-pro","nome":"Proto-Iranian","termine":"*darH-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*der-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*delh₁-","categoria":"non_precisato"}]},{"parola":"دستور","traslitterazione":"dastūr","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"alternatively","significato":"command, order","termine_origine":"","catena":[],"lontana":null,"ambiti":["religione","scienza","diritto_politica"],"via":"","testo":"Multiple origins have been proposed: * Inherited from Proto-Iranian *dasta-bara-, from Proto-Indo-Iranian *ȷ́ʰástas (“hand”) + Proto-Indo-European *bʰer- (“to bear, carry”). * Alternatively, inherited from Proto-Iranian *danh- (“to teach, instruct”), from Proto-Indo-European *dens- (“to become skill","alternative":[{"codice":"ira-pro","nome":"Proto-Iranian","termine":"*dasta-bara-","categoria":"ereditato"},{"codice":"iir-pro","nome":"Proto-Indo-Iranian","termine":"*ȷ́ʰástas","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-Europe