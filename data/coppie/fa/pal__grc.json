{"arrivo":"fa","origine":"pal","origine_nome":"Middle Persian","livello2":"grc","livello2_nome":"Ancient Greek","n":17,"parole":[{"parola":"آبنوس","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ebony","termine_origine":"𐫀𐫛𐫗𐫇𐫘","catena":[{"codice":"pal","nome":"Middle Persian","termine":"𐫀𐫛𐫗𐫇𐫘","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἔβενος","categoria":"non_precisato"},{"codice":"egy","nome":"Egyptian","termine":"hbnj","categoria":"non_precisato"}],"lontana":"egy","ambiti":[],"via":"","testo":"Inherited from Middle Persian 𐫀𐫛𐫗𐫇𐫘 (ʾpnws /⁠abnūs⁠/), from Ancient Greek ἔβενος (ébenos), from Egyptian hbnj (“ebony”). U13:n-Z4:M3"},{"parola":"بربری","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"Berber","termine_origine":"𐬠𐬀𐬭𐬠𐬀𐬭𐬍𐬔","catena":[{"codice":"pal","nome":"Middle Persian","termine":"𐬠𐬀𐬭𐬠𐬀𐬭𐬍𐬔","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"βᾰ́ρβᾰρος","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"بَرْبَرِيّ","categoria":"calco"}],"lontana":"ar","ambiti":[],"via":"","testo":"Inherited from Middle Persian 𐬠𐬀𐬭𐬠𐬀𐬭𐬍𐬔 (barbarīg, “barbarian; African”), ultimately from Ancient Greek βᾰ́ρβᾰρος (bắrbăros). Equivalent to بربر (barbar, “Barbary”) + ی (-i). For the sense \"Berber\", presumably a semantic loan from Arabic بَرْبَرِيّ (barbariyy)."},{"parola":"بربط","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"barbat (a type of lute)","termine_origine":"","catena":[{"codice":"pal","nome":"Middle Persian","termine":"","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"βάρβιτος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["musica"],"via":"","testo":"Inherited from Middle Persian [Book Pahlavi needed] (blbwt' /⁠barbut⁠/, “lyre”), from Ancient Greek βάρβιτος (bárbitos)."},{"parola":"تنبور","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":