sau","nome":"Sauraseni Prakrit","termine":"𑀪𑀺𑀓𑁆𑀔𑀸𑀬𑀭","traslitterazione":"bhikkhāyara","categoria":"non_precisato"},{"codice":"sa","nome":"Sanskrit","termine":"भिक्षाचर","traslitterazione":"bhikṣācara","categoria":"non_precisato"}],"lontana":"sa","ambiti":[],"via":"","testo":"Unknown, in Modern Standard Arabic use from Egyptian Arabic extended from the name one of the tribes of Doms in Egypt. Attested in al-Jāḥiẓ (ᛦ 868) as the occupation of a Baṣran, in the form كَجَار (kajār) or كَچَار (kačār) (without ʔiʕjām): possibly clipped from Sauraseni Prakrit 𑀪𑀺𑀓𑁆𑀔𑀸𑀬𑀭 (bhikkhāy"},{"parola":"فراولة","traslitterazione":"farāwla","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"strawberry, strawberries","termine_origine":"فراولة","termine_origine_traslitterazione":"farawla","catena":[{"codice":"arz","nome":"Egyptian Arabic","termine":"فراولة","traslitterazione":"farawla","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"fragola","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*frāgula","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Learned borrowing from Egyptian Arabic فراولة (farawla), borrowed from Italian fravola (a variant of fragola), from Vulgar Latin *frāgula, from Latin frāga + -ula."},{"parola":"قمبري","traslitterazione":"gambariyy","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shrimp, crayfish, prawn, crustacean","termine_origine":"جمبري","termine_origine_traslitterazione":"gambari","catena":[{"codice":"arz","nome":"Egyptian Arabic","termine":"جمبري","traslitterazione":"gambari","categoria":"prestito"},{"codice":"it","nome":"Italian","termine":"gamberi","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cammarus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κάμμαρος","traslitterazione":"kámmaros","categoria":"prestito"},{"codice":"qsb-grc","nome":"Pre-Greek","termine":"","categoria":"non_precisato"}],"lontana":"qsb-grc","ambiti":[],"via":"","testo":"Borrowed from Egyptian Arabic جمبري (gambari)."},{"parola":"مشملة","traslitterazione":"mušmula","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"medlar, azarole, loquat and what looks like it of fruits and fruit-trees","termine_origine":"","catena":[{"codice":"arz","nome":"Egyptian Arabic","termine":"","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"مشمله","traslitterazione":"muşmula","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"μούσμουλο","traslitterazione":"moúsmoulo","categoria":"non_precisato"}],"lontana":"el","ambiti":["cucina"],"via":"","testo":"Originally Egyptian Arabic, from Ottoman Turkish مشمله (muşmula), from Greek μούσμουλο (moúsmoulo)."},{"parola":"هويس","traslitterazione":"hawīs","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lock of water, sluice","termine_origine":"","catena":[{"codice":"arz","nome":"Egyptian Arabic","termine":"","categoria":"prestito"},{"codice":"ota","nome":"Ottoman Turkish","termine":"حوض","traslitterazione":"havız","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"حَوْض","traslitterazione":"ḥawḍ","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Originally Egyptian Arabic, from Ottoman Turkish حوض (havız), from Arabic حَوْض (ḥawḍ)."},{"parola":"يا جميل","traslitterazione":"yā gamīl","pos":"intj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A term of endearment, heavily associated with the Egyptian dialect and thereby mimicked in other dialects.","termine_origine":"يَا جَمِيل","termine_origine_traslitterazione":"yā gamīl","catena":[{"codice":"arz","nome":"Egyptian Arabic","termine":"يَا جَمِيل","traslitterazione":"yā gamīl","categoria":"prestito"}],"lontana":"arz","ambiti":[],"via":"","testo":"From Egyptian Arabic يَا جَمِيل (yā gamīl)."}]}