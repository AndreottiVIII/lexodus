rmine_origine":"gestr","catena":[{"codice":"non","nome":"Old Norse","termine":"gestr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᚷᚨᛊᛏᛁᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*gastiz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gʰóstis","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Norse gestr, from Proto-Norse *ᚷᚨᛊᛏᛁᛉ (gastiz), from Proto-Germanic *gastiz, from Proto-Indo-European *gʰóstis."},{"parola":"gretta","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to make a face","termine_origine":"gretta","catena":[{"codice":"non","nome":"Old Norse","termine":"gretta","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*grantjan","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*granatjaną","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse gretta, from Proto-Norse *grantjan, from Proto-Germanic *granatjaną, related to Proto-Germanic *granjōną."},{"parola":"gísl","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"hostage","termine_origine":"gísl","catena":[{"codice":"non","nome":"Old Norse","termine":"gísl","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᚷᛁᛊᛚᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*gīslaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse gísl, from Proto-Norse *ᚷᛁᛊᛚᚨᛉ (*gislaʀ) (attested in proper name ᚨᛊᚢᚷᛁᛊᚨᛚᚨᛊ (asugisalas)), from Proto-Germanic *gīslaz."},{"parola":"hafur","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"buck (a male goat, a he-goat)","termine_origine":"hafr","catena":[{"codice":"non","nome":"Old Norse","termine":"hafr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᚺᛡᛒᛟᚱᚢᛗᛦ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*hafraz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse hafr, from Proto-Germanic *hafraz, from Proto-Indo-European *kápros."},{"parola":"horn","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"horn (of an animal)","termine_origine":"horn","catena":[{"codice":"non","nome":"Old Norse","termine":"horn","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᚺᛟᚱᚾᚨ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*hurną","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ḱerh₂-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["musica"],"via":"","testo":"From Old Norse horn, from Proto-Norse ᚺᛟᚱᚾᚨ (horna), from Proto-Germanic *hurną, from Proto-Indo-European *ḱerh₂-."},{"parola":"innan","pos":"adv","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"inside, on the inside, within","termine_origine":"innan","catena":[{"codice":"non","nome":"Old Norse","termine":"innan","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛁᚾᚨᚾᚨ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*innanē","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse innan, from Proto-Norse ᛁᚾᚨᚾᚨ (inana), from Proto-Germanic *innanē."},{"parola":"jarl","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"jarl","termine_origine":"jarl","catena":[{"codice":"non","nome":"Old Norse","termine":"jarl","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛖᚱᛁᛚᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*erlaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":["diritto_politica"],"via":"","testo":"From Old Norse jarl, from Proto-Norse ᛖᚱᛁᛚᚨᛉ (erilaʀ), from Proto-Germanic *erlaz, akin to Old English eorl (English earl)."},{"parola":"karl","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"man (male human)","termine_origine":"karl","catena":[{"codice":"non","nome":"Old Norse","termine":"karl","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᚲᚨᚱᛁᛚᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*karilaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["sport"],"via":"","testo":"Inherited from Old Norse karl, from Proto-Norse *ᚲᚨᚱᛁᛚᚨᛉ (*karilaʀ), from Proto-Germanic *karilaz. Being West Norse, Icelandic senses have overall developed analogously to East Norse cognate Swedish karl (“(manly) man; husband”), compared to East Norse cognate Danish karl (“farmhand”)."},{"parola":"kok","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"perhaps","significato":"pharynx, throat","termine_origine":"kok","catena":[{"codice":"non","nome":"Old Norse","termine":"kok","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*kuka","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*keukǭ","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["scienza"],"via":"","testo":"From Old Norse kok (“throat”), from Proto-Norse *kuka, ultimately from Proto-Germanic *keukǭ (compare Proto-West Germanic *keukā). Perhaps ultimately related to *kewwaną (“to chew”)."},{"parola":"laukur","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"onion, leek, garlic","termine_origine":"laukr","catena":[{"codice":"non","nome":"Old Norse","termine":"laukr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛚᚨᚢᚲᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*laukaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["cucina"],"via":"","testo":"From Old Norse laukr, from Proto-Norse ᛚᚨᚢᚲᚨᛉ (laukaʀ), from Proto-Germanic *laukaz. Cognate with English leek, from Middle English, from Old English lēac (“a garden herb, leek, onion, garlic”), Danish løg, Swedish lök (“onion”), German Lauch (“leek, allium”) and Bulgarian лук (luk, “onion”)."},{"parola":"ljúfur","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"dear, beloved","termine_origine":"ljúfr","catena":[{"codice":"non","nome":"Old Norse","termine":"ljúfr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛚᛖᚢᛒᚨᛉ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*leubaz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*lewbʰ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Norse ljúfr, from Proto-Norse ᛚᛖᚢᛒᚨᛉ (leubaʀ), from Proto-Germanic *leubaz, from Proto-Indo-European *lewbʰ- (“to like; love”)."},{"parola":"lón","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"perhaps","significato":"lagoon","termine_origine":"lón","catena":[{"codice":"non","nome":"Old Norse","termine":"lón","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*lewk-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["cucina"],"via":"","testo":"From Old Norse lón f (“calm section of a river, lagoon”), from Proto-Norse *luhnō (“inlet, sea loch”). Cognate with Norwegian Nynorsk lon, Persian [script needed] (lón, “seaside meadow”). Perhaps derived from ló (“clearing, meadow”). Ultimately part of the family of terms derived from Proto-Indo-Eur"},{"parola":"nokkur","pos":"pron","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"some","termine_origine":"nǫkkurr","catena":[{"codice":"non","nome":"Old Norse","termine":"nǫkkurr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᚾᛁ ᚹᚨᛁᛏ ᛖᚲ ᚺᚹᚨᚱᛃᚨᛉ","categoria":"ereditato"}],"lontana":"gmq-pro","ambiti":[],"via":"","testo":"From Old Norse nǫkkurr, from earlier nakkvarr, from Proto-Norse *ᚾᛁ ᚹᚨᛁᛏ ᛖᚲ ᚺᚹᚨᚱᛃᚨᛉ (*ni wait ek hwarjaʀ, literally “not-know-I-who”)."},{"parola":"refur","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"fox (Vulpes), especially the arctic fox (Vulpes lagopus), which is native to Iceland","termine_origine":"refr","catena":[{"codice":"non","nome":"Old Norse","termine":"refr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*rebaʀ","categoria":"non_precisato"},{"codice":"iir-pro","nome":"Proto-Indo-Iranian","termine":"*Hrawpāćás","categoria":"non_precisato"}],"lontana":"iir-pro","ambiti":[],"via":"","testo":"From Old Norse refr, from Proto-Norse *rebaʀ, ultimately borrowed from Proto-Indo-Iranian *Hrawpāćás (“fox, jackal”), through some intermediaries."},{"parola":"rún","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"rune","termine_origine":"rún","catena":[{"codice":"non","nome":"Old Norse","termine":"rún","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᚱᚢᚾᛟ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*rūnō","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse rún (“secret; rune”), from Proto-Norse ᚱᚢᚾᛟ (runo, acc. sing.), from Proto-Germanic *rūnō."},{"parola":"silfur","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"silver","termine_origine":"silfr","catena":[{"codice":"non","nome":"Old Norse","termine":"silfr","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᛊᛁᛚᛒᚱᚨ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*silubrą","categoria":"ereditato"},{"codice":"qfa-sub","nome":"substrate","termine":"","categoria":"prestito"}],"lontana":"qfa-sub","ambiti":[],"via":"","testo":"Inherited from Old Norse silfr, from Proto-Norse *ᛊᛁᛚᛒᚱᚨ (*silbra), from Proto-Germanic *silubrą."},{"parola":"skáli","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"hut, shed","termine_origine":"skáli","catena":[{"codice":"non","nome":"Old Norse","termine":"skáli","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*skawalan-","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)kewH-","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Norse skáli (“barn, drinking hall”), from Proto-Norse *skawalan-, cognate with Norwegian Bokmål skåle (“shed”). May ultimately be from Proto-Indo-European *(s)kewH-."},{"parola":"stakka","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to stack","termine_origine":"","catena":[{"codice":"non","nome":"Old Norse","termine":"","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᛊᛏᚨᚲᚲᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*stakkaz","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse, related to the noun stakkr (“stack”), from Proto-Norse *ᛊᛏᚨᚲᚲᚨᛉ (*stakkaʀ), from Proto-Germanic *stakkaz (“haystack”)."},{"parola":"steinn","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"stone, rock","termine_origine":"steinn","catena":[{"codice":"non","nome":"Old Norse","termine":"steinn","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛊᛏᚨᛁᚾᚨᛉ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*stainaz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*steyh₂-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"From Old Norse steinn (“stone”), from Proto-Norse ᛊᛏᚨᛁᚾᚨᛉ (stainaʀ), from Proto-Germanic *stainaz (“stone”). Cognate with English stone, German Stein, Dutch steen, Danish sten, Norwegian Bokmål sten, Norwegian Nynorsk stein, Swedish sten, Faroese steinur, West Frisian stien, Low German Steen. Ultima"},{"parola":"systir","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"sister","termine_origine":"systir","catena":[{"codice":"non","nome":"Old Norse","termine":"systir","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"ᛊᚹᛖᛊᛏᚨᚱ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*swestēr","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*swésōr","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Norse systir, from Proto-Norse ᛊᚹᛖᛊᛏᚨᚱ (swestar), from Proto-Germanic *swestēr, from Proto-Indo-European *swésōr."},{"parola":"væla","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"to cry, to wail","termine_origine":"væla","catena":[{"codice":"non","nome":"Old Norse","termine":"væla","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᚹᚨᛁ","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wai","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Norse væla, whence also probably English wail, from væ (“woe”), from Proto-Norse *ᚹᚨᛁ (*wai), from Proto-Germanic *wai (“alas! woe!”)."},{"parola":"vél","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"machine","termine_origine":"vél","catena":[{"codice":"non","nome":"Old Norse","termine":"vél","categoria":"ereditato"},{"codice":"gmq-pro","nome":"Proto-Norse","termine":"*ᚹᛖᛚᚨ","categoria":"ereditato"}],"lontana":"gmq-pro","ambiti":[],"via":"","testo":"From Old Norse vél, from Proto-Germanic *wīlą (“craft, deceit”), from Prot