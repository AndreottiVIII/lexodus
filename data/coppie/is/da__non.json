{"arrivo":"is","origine":"da","origine_nome":"Danish","livello2":"non","livello2_nome":"Old Norse","n":10,"parole":[{"parola":"bleia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"diaper, nappy","termine_origine":"ble","catena":[{"codice":"da","nome":"Danish","termine":"ble","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"blæja","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Danish ble, from Old Norse blæja (whence also the inherited Icelandic blæja)."},{"parola":"gella","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cod tongue (the fleshy muscle under the jaw of a fish, esp. a cod; an Icelandic delicacy; equivalent to Basque cococha)","termine_origine":"gælle","catena":[{"codice":"da","nome":"Danish","termine":"gælle","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"gjǫlnar","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Borrowed from Danish gælle (“gill; certain parts removed from a herring before it is processed”), from Old Norse gjǫlnar."},{"parola":"ger","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yeast","termine_origine":"gær","catena":[{"codice":"da","nome":"Danish","termine":"gær","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"gerð","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*garwidō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Danish gær, from Old Norse gerð, from Proto-Germanic *garwidō."},{"parola":"kar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tub","termine_origine":"kar","catena":[{"codice":"da","nome":"Danish","termine":"kar","categoria":"prestito"},{"codice":"non","nome":"Old Norse","termine":"ker","categoria":"non_precisato"}],"lontana":"non","ambiti":[],"via":"","testo":"Bo