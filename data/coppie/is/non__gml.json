"stofa","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"a living room","termine_origine":"stofa","catena":[{"codice":"non","nome":"Old Norse","termine":"stofa","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"stōve","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*stubu","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"From Old Norse stofa, stufa, borrowed from Middle Low German stōve, stūve, Old Saxon *stova, *stuva, from Proto-West Germanic *stubu."},{"parola":"stoppa","pos":"verb","n_etimologia":2,"categoria":"ereditato","incerta":"no","significato":"to stuff","termine_origine":"stoppa","catena":[{"codice":"non","nome":"Old Norse","termine":"stoppa","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"stoppen","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*stoppōn","categoria":"non_precisato"}],"lontana":"gmw-pro","ambiti":[],"via":"","testo":"From Old Norse stoppa, borrowed Middle Low German stoppen, from Old Saxon *stoppon, from Proto-West Germanic *stoppōn."},{"parola":"tafl","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"chess","termine_origine":"tafl","catena":[{"codice":"non","nome":"Old Norse","termine":"tafl","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"taffel","categoria":"non_precisato"},{"codice":"gmw-pro","nome":"Proto-West Germanic","termine":"*tabulā","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"tabula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Norse tafl (“a board”), from Middle Low German taffel, tavele, from Old Saxon tafla, from Proto-West Germanic *tabulā, from Latin tabula (“a tablet; a board or plank”). Doublet of tabla, tafla, tefla, töfl."},{"parola":"treyja","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"sweater, jumper","termine_origine":"treyja","catena":[{"codice":"non","nome":"Old Norse","termine":"treyja","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"troye","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"From Old Norse treyja, from Middle Low German troye, troie."},{"parola":"tunna","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"barrel, cask, tun","termine_origine":"tunna","catena":[{"codice":"non","nome":"Old Norse","termine":"tunna","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"tunne","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"tunna","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"From Old Norse tunna or Middle Low German tunne, both from Medieval Latin tunna (“wine barrel”)."},{"parola":"tæra","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to corrode","termine_origine":"tæra","catena":[{"codice":"non","nome":"Old Norse","termine":"tæra","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"tēren","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"From Old Norse tæra, a borrowing from Middle Low German tēren, from Old Saxon terian (“to tear”). Compare Norwegian Nynorsk tæra Swedish tära, Dutch teren, German zehren."},{"parola":"velkominn","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"welcome","termine_origine":"velkominn","catena":[{"codice":"non","nome":"Old Norse","termine":"velkominn","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"wolkomen","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"From Old Norse velkominn, from Middle Low German wolkomen, willekomen (“welcome”), past participle of Middle Low German willekomen (“to welcome”). Analyzable as vel (“well”) + kominn (“come”). Cognate with English welcome, Danish velkommen."},{"parola":"voga","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to dare (to do something)","termine_origine":"vága","catena":[{"codice":"non","nome":"Old Norse","termine":"vága","categoria":"ereditato"},{"codice":"gml","nome":"Middle Low German","termine":"wagen","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"From Old Norse vága, from Middle Low German wagen."}]}