}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Danish kæde, from Middle Low German kede, kedene, from Latin catēna."},{"parola":"kleina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of fried sweet bread made of dough similar to that of a doughnut; same as Danish klejne, Swedish klenät, klena","termine_origine":"klejne","catena":[{"codice":"da","nome":"Danish","termine":"klejne","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"kleinet","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"Attested since the 19th century. Borrowed from Danish klejne, from Middle Low German kleinet, klēnet, from klein, klēn (“small”)."},{"parola":"krani","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tap, faucet","termine_origine":"kran","catena":[{"codice":"da","nome":"Danish","termine":"kran","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"kran","categoria":"non_precisato"}],"lontana":"gml","ambiti":[],"via":"","testo":"Borrowed from Danish kran, from Middle Low German kran."},{"parola":"lúta","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"lute","termine_origine":"lut","catena":[{"codice":"da","nome":"Danish","termine":"lut","categoria":"prestito"},{"codice":"gml","nome":"Middle Low German","termine":"lute","categoria":"non_precisato"},{"codice":"it","nome":"Italian","termine":"liuto","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"عود","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"First attested in the 17th century. Borrowed from Danish lut, from Middle Low German lute, from Italian liuto, from Arabic اَلْعُود (al-ʕūd, “wood”)."},{"parola":"melding","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"message, notice","termine_origine":"melding","catena":[{"codice":"da","nome":"Danish","termin