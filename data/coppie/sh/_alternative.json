ll borrowed from Ottoman Turkish.","alternative":[{"codice":"ota","nome":"Ottoman Turkish","termine":"بهانه","categoria":"prestito"},{"codice":"fa","nome":"Persian","termine":"بهانه","categoria":"non_precisato"}]},{"parola":"mrziti","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"either","significato":"to hate","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Either inherited from Proto-Slavic *mьrzěti, or mrz- + -iti, from Proto-Slavic *mьrzъkъ.","alternative":[{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*mьrzěti","categoria":"ereditato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*mьrzъkъ","categoria":"non_precisato"}]},{"parola":"narječje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"dialect cluster","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Likely borrowed from Czech nářečí or from Russian наречие (narečije).","alternative":[{"codice":"cs","nome":"Czech","termine":"nářečí","categoria":"prestito"},{"codice":"ru","nome":"Russian","termine":"наречие","categoria":"non_precisato"}]},{"parola":"nerast","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"alternatively","significato":"boar","termine_origine":"","catena":[],"lontana":null,"ambiti":[],"via":"","testo":"Inherited from Proto-Slavic *kъnorzъ. Cognate with Bulgarian нерез (nerez), Russian кно́роз (knóroz), Polish kiernoz. Alternatively from Proto-Slavic *nerstъ.","alternative":[{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*kъnorzъ","categoria":"ereditato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*nerstъ","categoria":"ereditato"}]},{"parola":"palačinka","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"pancake, crêpe","termine_origine":"","catena":[],"lontana":null,"ambiti":["cucina"],"via":"","testo":"Borrowed 