 Slavonic","termine":"выспрьнъ","categoria":"prestito"}],"lontana":"cu","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic выспрьнъ (vysprĭnŭ), from выспрь (vysprĭ). Compare Russian вы́спренный (výsprennyj)."},{"parola":"žitije","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hagiography","termine_origine":"житиѥ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"житиѥ","categoria":"prestito"}],"lontana":"cu","ambiti":["religione"],"via":"","testo":"Borrowed from Old Church Slavonic житиѥ (žitije, “life”)."},{"parola":"баштина","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"heritage","termine_origine":"","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"Derived from earlier form bašta (\"father\"), which is itself a borrowing from Old Church Slavonic. Compare *batę and *batja. Cognates include Bulgarian баща́ (baštá, “father”), Russian ба́тя (bátja), ба́тько (bátʹko), Old Czech baťa (“brother”) and Serbo-Croatian dialectal forms báća and bata (“broth"},{"parola":"бискуп","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bishop (church official)","termine_origine":"бискоупъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"бискоупъ","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"episcopus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ἐπίσκοπος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["religione"],"via":"","testo":"From Old Church Slavonic бискоупъ (biskupŭ), from Latin episcopus (“overseer”), from Ancient Greek ἐπίσκοπος (epískopos, “overseer”), from ἐπισκοπέω (episkopéō, “to watch over”), from ἐπί (epí, “over”) + σκοπέω (skopéō, “to examine”)."},{"parola":"блести","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to blather, to talk foolishly","termine_origine":"блѧсти","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"блѧсти","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*blęsti","categoria":"non_precisato"},{"codice":"ine-bsl-pro","nome":"Proto-Balto-Slavic","termine":"*blend-","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰlendʰ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Church Slavonic блѧсти (blęsti), from Proto-Slavic *blęsti (“talk nonsense, err”), from Proto-Balto-Slavic *blend-, from Proto-Indo-European *bʰlendʰ-."},{"parola":"буки","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"buky","termine_origine":"боукꙑ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"боукꙑ","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"From Old Church Slavonic боукꙑ (buky, “letter”). Akin to буква."},{"parola":"двери","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"door, doors, entrance","termine_origine":"двьри","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"двьри","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*dvьrь","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dʰwer-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Old Church Slavonic двьри (dvĭri), from Proto-Slavic *dvьrь, from Proto-Indo-European *dʰwer-."},{"parola":"кандило","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A vigil lamp; a cresset, usually hanging and richly decorated, containing a floating wick fed by oil, which is placed b…","termine_origine":"канъдило","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"канъдило","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"κανδήλη","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"candela","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic канъдило (kanŭdilo), from Ancient Greek κανδήλη (kandḗlē), from Latin candela (“candle”)."},{"parola":"ковчег","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"case","termine_origine":"ковьчегъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"ковьчегъ","categoria":"prestito"},{"codice":"xng","nome":"Middle Mongol","termine":"ᠬᠠᠤᠷᠴᠠᠭ","categoria":"non_precisato"},{"codice":"trk","nome":"Turkic","termine":"","categoria":"non_precisato"}],"lontana":"trk","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic ковьчегъ (kovĭčegŭ) from Middle Mongol ᠬᠠᠤᠷᠴᠠᠭ (qaurčaɣ) presumably through a Turkic language. Compare Mongolian хуурцаг (xuurcag)."},{"parola":"крстјанин","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"follower of the Bosnian Church","termine_origine":"крьстиꙗнинъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"крьстиꙗнинъ","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"From Old Church Slavonic крьстиꙗнинъ (krĭstijaninŭ). By surface analysis, кр̏ст + -јанин."},{"parola":"миротворац","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"peacemaker, pacifier","termine_origine":"миротворьць","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"миротворьць","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"Derived from Old Church Slavonic миротворьць (mirotvorĭcĭ). By surface analysis, мир + -о- + творити + -ац."},{"parola":"нужда","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"need","termine_origine":"ноужда","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"ноужда","categoria":"non_precisato"},{"codice":"ru","nome":"Russian","termine":"нужда","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*nuďa","categoria":"ereditato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"From Old Church Slavonic ноужда (nužda), likely via Russian нужда (nužda), from Proto-Slavic *nuďa."},{"parola":"општаство","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"community, society, union","termine_origine":"обьщьство","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"обьщьство","categoria":"prestito"}],"lontana":"cu","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic обьщьство (obĭštĭstvo); see о̏пштӣ (“common”) and -аство. Cognates include Bulgarian общество́ (obštestvó), Macedonian општество (opštestvo) and Russian о́бщество (óbščestvo)."},{"parola":"писме","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"letter (letter of the alphabet), grapheme","termine_origine":"писмѧ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"писмѧ","categoria":"prestito"}],"lontana":"cu","ambiti":[],"via":"","testo":"Learned borrowing from Old Church Slavonic писмѧ (pismę). This word was in common currency until the early 1800s, when it was displaced in its role by слово."},{"parola":"поп","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"priest (usually Catholic or Orthodox)","termine_origine":"попъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"попъ","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πάπας","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Old Church Slavonic попъ (popŭ), from Ancient Greek πάπας (pápas), variant of πάππας (páppas, “daddy, papa”)."},{"parola":"превоз","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"conveyance, transport, transportation","termine_origine":"прѣвозъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"прѣвозъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pervozъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic прѣвозъ (prěvozŭ) from Proto-Slavic *pervozъ."},{"parola":"пријевоз","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"conveyance, transport, transportation","termine_origine":"прѣвозъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"прѣвозъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pervozъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic прѣвозъ (prěvozŭ) from Proto-Slavic *pervozъ."},{"parola":"пријепис","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"copy, transcript","termine_origine":"прѣписъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"прѣписъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*perpisъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic прѣписъ (prěpisŭ), from Proto-Slavic *perpisъ."},{"parola":"пријесан","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"raw (of food)","termine_origine":"прѣснъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"прѣснъ","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*prěsnъ","categoria":"non_precisato"},{"codice":"ine-bsl-pro","nome":"Proto-Balto-Slavic","termine":"*prḗˀskas","categoria":"non_precisato"}],"lontana":"ine-bsl-pro","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic прѣснъ (prěsnŭ), Proto-Slavic *prěsnъ, from Proto-Balto-Slavic *prḗˀskas."},{"parola":"пријетити","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to threaten, menace","termine_origine":"прѣтити","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"прѣтити","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*pertiti","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic прѣтити (prětiti), Proto-Slavic *pertiti."},{"parola":"сабласно","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"eerily","termine_origine":"съблазно","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"съблазно","categoria":"prestito"}],"lontana":"cu","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic съблазно (sŭblazno)."},{"parola":"сабор","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"assembly","termine_origine":"съборъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"съборъ","categoria":"non_precisato"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*sъborъ","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":["diritto_politica"],"via":"","testo":"From Old Church Slavonic съборъ (sŭborŭ), from Proto-Slavic *sъborъ."},{"parola":"савест","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"conscience","termine_origine":"съвѣсть","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"съвѣсть","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"From Old Church Slavonic съвѣсть (sŭvěstĭ)."},{"parola":"савјест","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"conscience","termine_origine":"съвѣсть","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"съвѣсть","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"From Old Church Slavonic съвѣсть (sŭvěstĭ)."},{"parola":"свештеник","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"priest","termine_origine":"свѧщеникъ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"свѧщеникъ","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"A Church Slavonicism: borrowed from Old Church Slavonic свѧщеникъ (svęštenikŭ)."},{"parola":"сујета","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ego; vanity","termine_origine":"соуета","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"соуета","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"From Old Church Slavonic соуета (sujeta)."},{"parola":"тржаство","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ceremony, solemnity","termine_origine":"тръжьство","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"тръжьство","categoria":"prestito"}],"lontana":"cu","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic тръжьство (trŭžĭstvo), from тръгъ (trŭgŭ, “market, square”) + -ьство (-ĭstvo). By surface analysis, трг + -аство."},{"parola":"тријеба","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"need","termine_origine":"трѣба","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"трѣба","categoria":"prestito"},{"codice":"sla-pro","nome":"Proto-Slavic","termine":"*terba","categoria":"non_precisato"}],"lontana":"sla-pro","ambiti":[],"via":"","testo":"Borrowed from Old Church Slavonic трѣба (trěba), from Proto-Slavic *terba. Displaced the Old East Slavic inherited form тереба (tereba)."},{"parola":"ђ","pos":"character","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"The sixth letter of the Serbo-Croatian alphabet, written in the Cyrillic script.","termine_origine":"ꙉ","catena":[{"codice":"cu","nome":"Old Church Slavonic","termine":"ꙉ","categoria":"non_precisato"}],"lontana":"cu","ambiti":[],"via":"","testo":"Derived from Old Church Slavonic ꙉ (ǵ)."}]}