{"arrivo":"pt","origine":"osp","origine_nome":"Old Spanish","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":12,"parole":[{"parola":"alcançar","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to reach","termine_origine":"alcalçar","catena":[{"codice":"osp","nome":"Old Spanish","termine":"alcalçar","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*incalcio","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Old Galician-Portuguese alcançar, acalçar, from Old Spanish alcalçar, acalçar, from Vulgar Latin *incalciāre, from Latin calx (“chalk, finish line”).","livello2_varieta":"la-vul"},{"parola":"amarrotar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to make (cloth) creased and wrinkled","termine_origine":"","catena":[{"codice":"osp","nome":"Old Spanish","termine":"","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"manus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Spanish marrotar, presumably from Latin manus (“hand”) + ruptus (“torn”).","livello2_varieta":"la"},{"parola":"donaire","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gracefulness, elegance","termine_origine":"donaire","catena":[{"codice":"osp","nome":"Old Spanish","termine":"donaire","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"dōnārius","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese donaire, borrowed from Old Spanish donaire, from Late Latin dōnārius, from Latin dōnārium.","livello2_varieta":"la-lat"},{"parola":"gozar","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to enjoy","termine_origine":"gozar","catena":[{"codice":"osp","nome":"Old Spanish","termine":"gozar","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"gaudium","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Galician-Portuguese gozar, from Old Spanish gozar, from Latin gaudium (“joy”). Compare Galician and Spanish gozar.","livello2_varieta":"la"},{"parola":"gozo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"joy, enjoyment","termine_origine":"gozo","catena":[{"codice":"osp","nome":"Old Spanish","termine":"gozo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gaudium","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Spanish gozo (compare modern Spanish gozo), from Latin gaudium. Displaced Old Galician-Portuguese goyo, goivo. Doublet of gáudio and goivo.","livello2_varieta":"la"},{"parola":"leviano","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"flighty, thoughtless","termine_origine":"leviano","catena":[{"codice":"osp","nome":"Old Spanish","termine":"leviano","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*levianus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Old Spanish leviano (cf. modern Spanish liviano), from Vulgar Latin *levianus. Old Portuguese had the inherited form livão, showing a native treatment of intervocalic Latin /n/. Compare Galician livián.","livello2_varieta":"la-vul"},{"parola":"pescoço","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"neck (part of body)","termine_origine":"pescoço","catena":[{"codice":"osp","nome":"Old Spanish","termine":"pescoço","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"post","categoria":"non_precisato"},{"codice":"osp","nome":"Old Spanish","termine":"coço","categoria":"non_precisato"}],"lontana":"osp","ambiti":[],"via":"","testo":"From Old Galician-Portuguese pescoço, from Old Spanish pescoço (Modern Spanish pescuezo), from *poscoço, from Latin post + Old Spanish coço.","livello2_varieta":"la"},{"parola":"prenda","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"gift, present","termine_origine":"pendra","catena":[{"codice":"osp","nome":"Old Spanish","termine":"pendra","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"pignora","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Galician-Portuguese prenda, borrowed from Old Spanish pendra, peñdra, from Latin pignora.","livello2_varieta":"la"},{"parola":"sangrar","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to draw blood (by pricking or opening a vein)","termine_origine":"sangrar","catena":[{"codice":"osp","nome":"Old Spanish","termine":"sangrar","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"sanguinō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese sangrar, borrowed from Old Spanish sangrar, from Latin sanguināre (“to bleed”) from sanguis (“blood”).","livello2_varieta":"la"},{"parola":"sobejo","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Probably; modello unc/uncertain","significato":"remaining, leftover","termine_origine":"sobejo","catena":[{"codice":"osp","nome":"Old Spanish","termine":"sobejo","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*superculum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese sobejo, probably from Old Spanish sobejo, from Vulgar Latin *superculum.","livello2_varieta":"la-vul"},{"parola":"universidade","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; nodo incerto nell'albero","significato":"university","termine_origine":"universidat","catena":[{"codice":"osp","nome":"Old Spanish","termine":"universidat","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"ūniversitās","categoria":"latinismo_dotto"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese universidade, possibly borrowed from Old Spanish universidat, a learned borrowing from Medieval Latin ūniversitās, from Latin ūniversus + -tas.","livello2_varieta":"la-med"},{"parola":"vilancete","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"villancico (traditional Spanish or Portuguese folk song)","termine_origine":"villancete","catena":[{"codice":"osp","nome":"Old Spanish","termine":"villancete","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"vīllānus","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["musica","arte"],"via":"","testo":"Borrowed from Old Spanish villancete, from villano (“peasant”), from Medieval Latin vīllānus (“villager”), whence also Portuguese vilão.","livello2_varieta":"la-med"}]}