{"arrivo":"pt","origine":"la-lat","origine_nome":"Late Latin","livello2":"frk","livello2_nome":"Frankish","n":5,"parole":[{"parola":"burgo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"burg (fortified town in medieval Europe)","termine_origine":"burgus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"burgus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*burg","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*burgz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰerǵʰ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese burgo, from Late Latin burgus, from Vulgar Latin *burgus, borrowed from Frankish *burg (“fortified city”), from Proto-Germanic *burgz (“fortified city”), from Proto-Indo-European *bʰerǵʰ- (“high”)."},{"parola":"emboscar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to ambush (to lie in wait for, or to attack)","termine_origine":"imboscō","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"imboscō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*busk","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*buskaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin imboscāre, from Frankish *busk (“bush”), from Proto-Germanic *buskaz (“bush, thicket”)."},{"parola":"frasco","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bottle (for medicine, perfume)","termine_origine":"flascō","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"flascō","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*flaska","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*flaskǭ","categoria":"non_precisato"}