{"arrivo":"pt","origine":"roa-oca","origine_nome":"Old Catalan","n":10,"parole":[{"parola":"amainar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Of uncertain origin; modello unc/uncertain","significato":"to abate (to lessen in force)","termine_origine":"amainar","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"amainar","categoria":"prestito"}],"lontana":"roa-oca","ambiti":[],"via":"","testo":"Borrowed from Old Catalan amainar, of uncertain origin (See the Catalan amainar entry for extensive proposals)."},{"parola":"caixa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"box","termine_origine":"caixa","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"caixa","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capsa","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*kapsos","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kapyéti","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["musica"],"via":"","testo":"From Old Galician-Portuguese caixa, borrowed from Old Catalan caixa, from Latin capsa. Compare Sicilian caxa, Spanish caja."},{"parola":"carreta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; nodo incerto nell'albero","significato":"cart (small, open, wheeled vehicle)","termine_origine":"carreta","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"carreta","categoria":"prestito"}],"lontana":"roa-oca","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese carreta, possibly borrowed from Old Catalan carreta, from carro + -eta."},{"parola":"catalão","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Catalan","termine_origine":"catalan","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"catalan","categoria":"prestito"}],"lontana":"roa-oca","ambiti":[],"via":"","testo":