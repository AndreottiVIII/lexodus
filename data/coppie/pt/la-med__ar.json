{"arrivo":"pt","origine":"la-med","origine_nome":"Medieval Latin","livello2":"ar","livello2_nome":"Arabic","n":11,"parole":[{"parola":"alcana","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"alkanet (Alkanna tinctoria, a plant whose root is used as a red dye)","termine_origine":"alcanna","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"alcanna","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"حناء","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin alcanna, from Arabic الحِنَّاء (al-ḥinnāʔ)."},{"parola":"algarismo","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"place (numeric: the column counting a certain quantity)","termine_origine":"algorismus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"algorismus","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin algorismus, a transliteration of the Arabic form of the name of the Persian mathematician al-Khwārizmī. Doublet of algoritmo. Cognate with Spanish guarismo."},{"parola":"almirante","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"admiral (all senses)","termine_origine":"amiratus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"amiratus","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"ال","categoria":"non_precisato"},{"codice":"gkm","nome":"Byzantine Greek","termine":"ἀμιράς","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"أَمِير","categoria":"non_precisato"}],"lontana":"ar","ambiti":[],"via":"","testo":"From Old Galician-Portuguese almirante, from Medieval Latin amiratus under influence from -ante and Arabic ال (al-, “the, of the”), from Byzantine Greek ἀμιράς (amirás), from Arabic أَمِير (ʔamīr, “commander”). See Spanish almirante, French amiral, and English admiral."},{"parola":"antimónio","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"antimony (chemical element)","termine_origine":"antimonium","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"antimonium","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"إِثْمِد","categoria":"prestito"},{"codice":"cop","nome":"Coptic","termine":"ⲉⲥⲑⲏⲙ","categoria":"prestito"},{"codice":"grc","nome":"Ancient Greek","termine":"στίμμι","categoria":"non_precisato"},{"codice":"egy","nome":"Egyptian","termine":"sdm","categoria":"non_precisato"}],"lontana":"egy","ambiti":["scienza"],"via":"","testo":"Learned borrowing from Medieval Latin antimonium."},{"parola":"azul","pos":"adj|noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"blue","termine_origine":"lazulum","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"lazulum","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"لََازُوَرْد","categoria":"prestito"},{"codice":"fa-cls","nome":"Classical Persian","termine":"لَاجَوَرْد","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ǵʰelh₃-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Old Galician-Portuguese azur (“blue”), a learned borrowing from Medieval Latin lazulum, borrowed from Arabic لََازُوَرْد (laāzuward). Doublet of azur, from French. Compare with Galician azul (“blue”), Spanish azul (“blue”), French azur (“azure”), Italian azzurro (“blue”) and English a"},{"parola":"cifra","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"number","termine_origine":"cifra","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"cifra","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"صِفْر","categoria":"non_precisato"}],"lontana":"ar","ambiti":["musica"],"via":"","testo":"Borrowed from Medieval Latin cifra (“zero, numeral”), from Arabic صِفْر (ṣifr, “zero, empty, nothing”). Doublet of zero."},{"parola":"dura-máter","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"dura mater (outermost layer of the meninges)","termine_origine":"dūra māter 􂀿cerebrī􂁀","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"dūra māter 􂀿cerebrī􂁀","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"أُمّ الدِّمَاغ الصَفِيقَة","categoria":"non_precisato"}],"lontana":"ar","ambiti":["scienza"],"via":"","testo":"Borrowed from Medieval Latin dūra māter [cerebrī] (literally “hard mother [of the brain]”), loan translation of Arabic أُمّ الدِّمَاغ الصَفِيقَة (ʔumm ad-dimāḡ aṣ-ṣafīqa, literally “thick mother of the brain, matrix of the brain”)."},{"parola":"escaque","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"square (on a chessboard)","termine_origine":"scaccum","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"scaccum","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"شَاه","categoria":"non_precisato"}],"lontana":"ar","ambiti":["sport","diritto_politica"],"via":"","testo":"Borrowed from Medieval Latin scaccum, from Arabic شَاه (šāh, “shah; king in chess”)."},{"parola":"nuca","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"nape (back part of the neck)","termine_origine":"nucha","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"nucha","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"نُخَاع","categoria":"non_precisato"}],"lontana":"ar","ambiti":["scienza"],"via":"","testo":"Borrowed from Medieval Latin nucha, from Arabic نُخَاع (nuḵāʕ)."},{"parola":"safena","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"saphenous vein","termine_origine":"saphena","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"saphena","categoria":"latinismo_dotto"},{"codice":"ar","nome":"Arabic","termine":"صَافِن","categoria":"non_precisato"},{"codice":"he","nome":"Hebrew","termine":"צֹפֵן","categoria":"non_precisato"}],"lontana":"he","ambiti":["scienza"],"via":"","testo":"From Medieval Latin saphena, from Arabic صَافِن (ṣāfin), from Hebrew צֹפֵן (ṣōfēn, “hiding”)."},{"parola":"tamarindo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"tamarind (Tamarindus indica, a tropical tree)","termine_origine":"tamarindus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"tamarindus","categoria":"non_precisato"},{"codice":"ar","nome":"Arabic","termine":"تَمْر هِنْدِيّ","categoria":"non_precisato"}],"lontana":"ar","ambiti":["cucina"],"via":"","testo":"From Medieval Latin tamarindus, from Arabic تَمْر هِنْدِيّ (tamr hindiyy)."}]}