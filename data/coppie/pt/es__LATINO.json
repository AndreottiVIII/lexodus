{"arrivo":"pt","origine":"es","origine_nome":"Spanish","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":69,"parole":[{"parola":"-ez","pos":"suffix","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"-ness (appended to adjectives to form nouns meaning \"the state of ...\", \"the quality of ...\", or \"the measure of ...\")","termine_origine":"-ez","catena":[{"codice":"es","nome":"Spanish","termine":"-ez","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"-ities","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Likely borrowed from Spanish -ez, from Latin -itiem. Doublet of -ice.","livello2_varieta":"la"},{"parola":"-ilho","pos":"suffix","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"forms names of things that share some characteristic with the suffixed word, often carrying a diminutive or belittling…","termine_origine":"-illo","catena":[{"codice":"es","nome":"Spanish","termine":"-illo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"-ellus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish -illo, from Latin -ellus. Doublet of -elo.","livello2_varieta":"la"},{"parola":"aguarrás","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"turpentine","termine_origine":"aguarrás","catena":[{"codice":"es","nome":"Spanish","termine":"aguarrás","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aqua rāsis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish aguarrás, perhaps from Latin aqua rāsis (“pitch water”).","livello2_varieta":"la"},{"parola":"alentar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to encourage","termine_origine":"alentar","catena":[{"codice":"es","nome":"Spanish","termine":"alentar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alēnitāre","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish alentar, from Vulgar Latin *alēnitāre, a metathetic variant of *an(h)ēlitāre, from anhēlitus (“breathe”) + -āre.","livello2_varieta":"la-vul"},{"parola":"antanho","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"yore (time long past)","termine_origine":"antaño","catena":[{"codice":"es","nome":"Spanish","termine":"antaño","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ante annum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish antaño, from Latin ante annum.","livello2_varieta":"la"},{"parola":"apaziguar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to appease","termine_origine":"apaciguar","catena":[{"codice":"es","nome":"Spanish","termine":"apaciguar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pacifico","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish apaciguar, from Latin pācificāre (“to pacify; to make peace”). Doublet of pacificar.","livello2_varieta":"la"},{"parola":"arrojar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to throw (cause an object to move rapidly through the air)","termine_origine":"arrojar","catena":[{"codice":"es","nome":"Spanish","termine":"arrojar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rotō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish arrojar, from Latin rotāre.","livello2_varieta":"la"},{"parola":"atril","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bookstand (stand for holding books open)","termine_origine":"atril","catena":[{"codice":"es","nome":"Spanish","termine":"atril","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"lectorile","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Spanish atril, from earlier latril, from Late Latin lectorile, from Latin lēctor (“reader”). Doublet of leitoril.","livello2_varieta":"la-lat"},{"parola":"austral","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"austral (short-lived Argentinian currency)","termine_origine":"austral","catena":[{"codice":"es","nome":"Spanish","termine":"austral","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"austrālis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish austral, from Latin austrālis.","livello2_varieta":"la"},{"parola":"beetria","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A medieval town that enjoyed the right to elect its lords.","termine_origine":"behetría","catena":[{"codice":"es","nome":"Spanish","termine":"behetría","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"benefactoria","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["scienza"],"via":"","testo":"Borrowed from Spanish behetría, from Late Latin benefactoria, from benefactor.","livello2_varieta":"la-lat"},{"parola":"birra","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"temper tantrum, hissy fit","termine_origine":"birria","catena":[{"codice":"es","nome":"Spanish","termine":"birria","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*verrea","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish birria, from Vulgar Latin *verrea, from verres (“boar”).","livello2_varieta":"la-vul"},{"parola":"bobo","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"silly, stupid","termine_origine":"bobo","catena":[{"codice":"es","nome":"Spanish","termine":"bobo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"balbus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish bobo, from Latin balbus.","livello2_varieta":"la"},{"parola":"bonança","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calm (weather condition)","termine_origine":"bonanza","catena":[{"codice":"es","nome":"Spanish","termine":"bonanza","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bonacia","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"μᾰλᾰκῐ́ᾱ","categoria":"prestito"}],"lontana":"grc","ambiti":["mare"],"via":"","testo":"Borrowed from Spanish bonanza.","livello2_varieta":"la-vul"},{"parola":"bonina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"daisy","termine_origine":"bonina","catena":[{"codice":"es","nome":"Spanish","termine":"bonina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bonus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish bonina, from Latin bonus.","livello2_varieta":"la"},{"parola":"borbulhar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to bubble (to rise up in bubbles)","termine_origine":"borbollar","catena":[{"codice":"es","nome":"Spanish","termine":"borbollar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bulbulliāre","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish borbollar.","livello2_varieta":"la-vul"},{"parola":"botija","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hot water bottle","termine_origine":"botija","catena":[{"codice":"es","nome":"Spanish","termine":"botija","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"butticula","categoria":"ereditato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Spanish botija (“jug”). Doublet of botelha.","livello2_varieta":"la-lat"},{"parola":"bueno","pos":"intj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"all right; okay; fine","termine_origine":"bueno","catena":[{"codice":"es","nome":"Spanish","termine":"bueno","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bonus","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*dwenos","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dewh₂-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Spanish bueno. Doublet of bom.","livello2_varieta":"la"},{"parola":"cabildo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A local government council in some Spanish-speaking communities.","termine_origine":"cabildo","catena":[{"codice":"es","nome":"Spanish","termine":"cabildo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capitulum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish cabildo, from Latin capitulum.","livello2_varieta":"la"},{"parola":"castelhano","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Castilian; Spanish (Romance language spoken in Spain and much of Latin America)","termine_origine":"castellano","catena":[{"codice":"es","nome":"Spanish","termine":"castellano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Castellānus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish castellano, from Latin Castellānus < castellānus. Doublet of castelão.","livello2_varieta":"la"},{"parola":"caudal","pos":"noun|adj","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"torrent (heavy stream or flow)","termine_origine":"caudal","catena":[{"codice":"es","nome":"Spanish","termine":"caudal","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"capitālis","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Spanish caudal, from Latin capitālis (“capital; deadly”). See also the doublets cabedal and capital.","livello2_varieta":"la"},{"parola":"caudilho","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"caudillo (a military dictator, especially in Latin American)","termine_origine":"caudillo","catena":[{"codice":"es","nome":"Spanish","termine":"caudillo","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"capitellum","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["diritto_politica"],"via":"","testo":"Borrowed from Spanish caudillo, from Old Spanish cabdiello, from Late Latin capitellum, based on Latin capitem. Doublet of cabedelo, coudel, capitel, capitelo, and cadete.","livello2_varieta":"la-lat"},{"parola":"cavalheiro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gentleman","termine_origine":"caballero","catena":[{"codice":"es","nome":"Spanish","termine":"caballero","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"caballārius","categoria":"ereditato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Spanish caballero, from Late Latin caballārius. Doublet of cavaleiro.","livello2_varieta":"la-lat"},{"parola":"centelha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sparkle","termine_origine":"centella","catena":[{"codice":"es","nome":"Spanish","termine":"centella","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"scintilla","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","scienza"],"via":"","testo":"From Spanish centella, from Latin scintilla.","livello2_varieta":"la"},{"parola":"chifre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"horn, antler (bone outgrowth on the head of some mammals)","termine_origine":"chifle","catena":[{"codice":"es","nome":"Spanish","termine":"chifle","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sīfilō","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish chifle, from chiflar (“to hiss, to whistle”), from Vulgar Latin *sīfilāre, from Latin sībilāre (“to hiss, to whistle”). For sense 2, compare chifrudo and Spanish poner los cuernos.","livello2_varieta":"la-vul"},{"parola":"cigarro","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cigarette (thin roll of tobacco made for smoking)","termine_origine":"cigarro","catena":[{"codice":"es","nome":"Spanish","termine":"cigarro","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cicār(r)a","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish cigarro.","livello2_varieta":"la-vul"},{"parola":"cânhamo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hemp (any Cannabis sativa variety used grown for its fibres, oil and seeds)","termine_origine":"cáñamo","catena":[{"codice":"es","nome":"Spanish","termine":"cáñamo","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"cannabum","categoria":"ereditato"},{"codice":"grc","nome":"Ancient Greek","termine":"κάνναβις","categoria":"prestito"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Spanish cáñamo, from Old Spanish cannamo, from Late Latin cannabum, from Latin cannabis, borrowed from Ancient Greek κάνναβις (kánnabis). Doublet of canábis, cânabis, cânave, and canvas.","livello2_varieta":"la-lat"},{"parola":"cítola","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"citole (medieval stringed instrument)","termine_origine":"cítola","catena":[{"codice":"es","nome":"Spanish","termine":"cítola","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cithara","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish cítola, from Latin cithara. Doublet of guitarra, cítara, and cistre.","livello2_varieta":"la"},{"parola":"despojar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to deprive of","termine_origine":"despojar","catena":[{"codice":"es","nome":"Spanish","termine":"despojar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"despolio","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish despojar, itself from Latin dēspoliāre. Compare the inherited doublet debulhar.","livello2_varieta":"la"},{"parola":"endrômina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"deceit, ruse, trick","termine_origine":"andrómina","catena":[{"codice":"es","nome":"Spanish","termine":"andrómina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"endromis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Perhaps from Spanish andrómina, from Latin endromidem (“mantle, cloak”).","livello2_varieta":"la"},{"parola":"esteira","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mat, matting","termine_origine":"estera","catena":[{"codice":"es","nome":"Spanish","termine":"estera","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"storea","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish estera, ultimately from Latin storea. Doublet of estore, which was borrowed from the French cognate.","livello2_varieta":"la"},{"parola":"estilha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"splinter","termine_origine":"astilla","catena":[{"codice":"es","nome":"Spanish","termine":"astilla","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"astella","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish astilla, from Vulgar Latin astella, from Latin astula, variant of assula (“splinter”). Compare French attelle.","livello2_varieta":"la-vul"},{"parola":"falcata","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"falcata (ancient Iberian sword)","termine_origine":"falcata","catena":[{"codice":"es","nome":"Spanish","termine":"falcata","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"falcātus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Spanish falcata, from Latin falcātus (“sickle-shaped”). The term used in Roman sources is machaera Hispana.","livello2_varieta":"la"},{"parola":"fenecer","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to finish, end, conclude","termine_origine":"fenecer","catena":[{"codice":"es","nome":"Spanish","termine":"fenecer","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"finiō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Presumably from Spanish fenecer, itself from Latin Latin finīre with a change from the fourth conjugation to an -eç-/-ec- infixed third conjugation (resulting in a second conjugation verb in both languages).","livello2_varieta":"la"},{"parola":"frente","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"front (facing side)","termine_origine":"frente","catena":[{"codice":"es","nome":"Spanish","termine":"frente","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"frōns","categoria":"non_precisato"}],"lontana":"la","ambiti":["militare","scienza","diritto_politica"],"via":"","testo":"Borrowed from Spanish frente, from Old Spanish fruente, from Latin frontem. Doublet of fronte and front.","livello2_varieta":"la"},{"parola":"hediondo","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"heinous","termine_origine":"hediondo","catena":[{"codice":"es","nome":"Spanish","termine":"hediondo","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fētibundus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish hediondo (“stinking”), from Vulgar Latin *fētibundus, from Latin fēteō.","livello2_varieta":"la-vul"},{"parola":"hermano","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Hispanic American, chiefly an Argentinian","termine_origine":"hermano","catena":[{"codice":"es","nome":"Spanish","termine":"hermano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"germānus","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*genamen","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ǵénh₁mn̥","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Spanish hermano. Doublet of irmão and germano.","livello2_varieta":"la"},{"parola":"horripilante","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"ghastly; creepy (horrifyingly shocking)","termine_origine":"horripilar","catena":[{"codice":"es","nome":"Spanish","termine":"horripilar","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"horripilo","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Spanish horripilar, from Late Latin horripilāre. Doublet of arrepiante.","livello2_varieta":"la-lat"},{"parola":"imprensa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"the press (collective term for printed media)","termine_origine":"imprensa","catena":[{"codice":"es","nome":"Spanish","termine":"imprensa","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"impressus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Possibly borrowed from Spanish imprensa; ultimately from Latin impressus (“printed”).","livello2_varieta":"la"},{"parola":"ladrilho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tile","termine_origine":"ladrillo","catena":[{"codice":"es","nome":"Spanish","termine":"ladrillo","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*latriclus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish ladrillo, from Vulgar Latin *latriclus, from *latericulus, diminutive of Latin later.","livello2_varieta":"la-vul"},{"parola":"lhano","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"frank, sincere","termine_origine":"llano","catena":[{"codice":"es","nome":"Spanish","termine":"llano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"plānus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish llano, from Latin plānus. Doublet of plano, piano, chão, and porão.","livello2_varieta":"la"},{"parola":"lunar","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"mole, birthmark","termine_origine":"lunar","catena":[{"codice":"es","nome":"Spanish","termine":"lunar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"lūnāris","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish lunar, from Latin lūnāris.","livello2_varieta":"la"},{"parola":"manilha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shackle (U-shaped piece of metal secured with a pin or bolt)","termine_origine":"manilla","catena":[{"codice":"es","nome":"Spanish","termine":"manilla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"manicula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish manilla, from Latin manicula, from manus (“hand”).","livello2_varieta":"la"},{"parola":"medrar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to grow","termine_origine":"medrar","catena":[{"codice":"es","nome":"Spanish","termine":"medrar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"melioro","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish medrar (from earlier *mejdrar, syncopated form of mejorar), from Latin meliōrāre. Doublet of melhorar.","livello2_varieta":"la"},{"parola":"melocotão","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"peach cultivar","termine_origine":"melocotón","catena":[{"codice":"es","nome":"Spanish","termine":"melocotón","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mālum cotōnium","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish melocotón.","livello2_varieta":"la"},{"parola":"mocho","pos":"noun|adj","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Unknown; Possibly","significato":"owl, little owl","termine_origine":"mocho","catena":[{"codice":"es","nome":"Spanish","termine":"mocho","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"mutilus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Unknown. Possibly from Spanish mocho, which could be from Latin mutilus. Also see Spanish mochuelo (“little owl”). Compare Galician moucho.","livello2_varieta":"la"},{"parola":"mulato","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"mulatto","termine_origine":"mulato","catena":[{"codice":"es","nome":"Spanish","termine":"mulato","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mūlus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish mulato (“mulatto”), from mulo (“mule”), from Latin mūlus (“mule”). Perhaps an allusion to the hybrid origin of mules.","livello2_varieta":"la"},{"parola":"novilho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calf (young bull)","termine_origine":"novillo","catena":[{"codice":"es","nome":"Spanish","termine":"novillo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"novellus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish novillo.","livello2_varieta":"la"},{"parola":"olha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a stew prepared with meat, chickpeas, peas and other vegetables","termine_origine":"olla","catena":[{"codice":"es","nome":"Spanish","termine":"olla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"olla","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Spanish olla (“pot; stew”), from Latin olla (“pot; jar”).","livello2_varieta":"la"},{"parola":"olvidar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to forget","termine_origine":"olvidar","catena":[{"codice":"es","nome":"Spanish","termine":"olvidar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*oblītāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Spanish olvidar, from Vulgar Latin *oblītāre. Replaced the inherited Old Portuguese obridar.","livello2_varieta":"la-vul"},{"parola":"pago","pos":"noun","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"the place where one was born or grew up","termine_origine":"pago","catena":[{"codice":"es","nome":"Spanish","termine":"pago","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pāgus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish pago, from Latin pāgus (“district; village”).","livello2_varieta":"la"},{"parola":"palanca","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"stake (long, sharp piece of wood)","termine_origine":"palanca","catena":[{"codice":"es","nome":"Spanish","termine":"palanca","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"phalanga","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"φάλαγξ","categoria":"non_precisato"}],"lontana":"grc","ambiti":["militare","arte","diritto_politica"],"via":"","testo":"Borrowed from Spanish palanca, from Latin phalanga (“roller; pole”), from Ancient Greek φάλαγξ (phálanx, “log; phalanx”). Doublet of prancha","livello2_varieta":"la"},{"parola":"panturrilha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calf (back of the leg below the knee)","termine_origine":"pantorrilla","catena":[{"codice":"es","nome":"Spanish","termine":"pantorrilla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pantex","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Spanish pantorrilla (“calf”), from pantorra (“calf”), ultimately from Latin pantex.","livello2_varieta":"la"},{"parola":"penha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"crag (a rock, stone, cliff or outcropping)","termine_origine":"peña","catena":[{"codice":"es","nome":"Spanish","termine":"peña","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pinna","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish peña, from Latin pinna. Displaced Old Galician-Portuguese pena. Compare Galician pena.","livello2_varieta":"la"},{"parola":"pepino","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cucumber (Cucumis sativus, a vine in the gourd family)","termine_origine":"pepino","catena":[{"codice":"es","nome":"Spanish","termine":"pepino","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pepo","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Spanish pepino, from Latin pepōnem.","livello2_varieta":"la"},{"parola":"peso","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"peso (currency unit of Argentina, Chile, Mexico and the Philippines)","termine_origine":"peso","catena":[{"codice":"es","nome":"Spanish","termine":"peso","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*pēsum","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Spanish peso.","livello2_varieta":"la-vul"},{"parola":"pesquisa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"research (inquiry or examination)","termine_origine":"pesquisa","catena":[{"codice":"es","nome":"Spanish","termine":"pesquisa","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"perquīrō","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza","informatica"],"via":"","testo":"Borrowed from Spanish pesquisa (“investigation”), ultimately from Latin perquīrō (“to ask, inquire or search diligently”).","livello2_varieta":"la"},{"parola":"rebelde","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rebel (person who resists an established authority)","termine_origine":"rebelde","catena":[{"codice":"es","nome":"Spanish","termine":"rebelde","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"rebellis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish rebelde (“rebel”), itself borrowed from Latin rebellis (“waging war again; insurgent”), from rebellō (“to wage war again, to fight back”), from re- (“again, back”) + bellō (“to wage war”).","livello2_varieta":"la"},{"parola":"rodilha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a rolled up cloth or a cushion placed between the head and object to be carried","termine_origine":"rodilla","catena":[{"codice":"es","nome":"Spanish","termine":"rodilla","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"rotella","categoria":"ereditato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Spanish rodilla.","livello2_varieta":"la-lat"},{"parola":"rumar","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to head (move in a specified direction)","termine_origine":"rumbo","catena":[{"codice":"es","nome":"Spanish","termine":"rumbo","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"rhombus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ῥόμβος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["mare"],"via":"","testo":"From rumo (“course; destination”) + -ar, from Spanish rumbo (“course”), from Latin rhombus, from Ancient Greek ῥόμβος (rhómbos, “rhombus, spinning top”), from ῥέμβω (rhémbō, “to turn around”).","livello2_varieta":"la"},{"parola":"rábano","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"horseradish","termine_origine":"rábano","catena":[{"codice":"es","nome":"Spanish","termine":"rábano","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"raphanus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ῥάφανος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina","scienza"],"via":"","testo":"Probably borrowed from Spanish rábano, from Latin raphanus, from Ancient Greek ῥάφανος (rháphanos). A native variant rábão also exists, reflecting the expected loss of intervocalic Latin /n/ and showing /b/ for an original Latin /p/, a sound frequently used in borrowings to render the Ancient Greek ","livello2_varieta":"la"},{"parola":"semilha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"potato","termine_origine":"semilla","catena":[{"codice":"es","nome":"Spanish","termine":"semilla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"semen","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish semilla (“seed”), from Latin semen (“seed”), possibly from a label accompanying the first potatoes arrived in Madeira from the Canary Islands that was mistaken as identifying the name of the plant.","livello2_varieta":"la"},{"parola":"sevandija","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"maggot; parasite; worm","termine_origine":"sabandija","catena":[{"codice":"es","nome":"Spanish","termine":"sabandija","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sevandīlia","categoria":"ereditato"},{"codice":"eu","nome":"Basque","termine":"","categoria":"non_precisato"}],"lontana":"eu","ambiti":[],"via":"","testo":"From Old Galician-Portuguese sevandilha, crossed with Spanish sabandija, both from Vulgar Latin *sevandīlia, perhaps of Basque origin.","livello2_varieta":"la-vul"},{"parola":"tabla","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"metal plate; sheet metal","termine_origine":"tabla","catena":[{"codice":"es","nome":"Spanish","termine":"tabla","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tabula","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish tabla, from Latin tabula.","livello2_varieta":"la"},{"parola":"tablado","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"flooring","termine_origine":"tablado","catena":[{"codice":"es","nome":"Spanish","termine":"tablado","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tabulātum","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish tablado, from Latin tabulātum.","livello2_varieta":"la"},{"parola":"tremedal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wetland, marsh, swamp","termine_origine":"tremedal","catena":[{"codice":"es","nome":"Spanish","termine":"tremedal","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tremō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish tremedal; ultimately a derivation of Latin tremō (“to tremble, to quake”). See the Spanish term for more information.","livello2_varieta":"la"},{"parola":"ventana","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"window","termine_origine":"ventana","catena":[{"codice":"es","nome":"Spanish","termine":"ventana","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ventus","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Borrowed from Spanish ventana, from Latin ventus. Doublet of ventã (“window”) and venta (“nostril”).","livello2_varieta":"la"},{"parola":"vilancico","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"villancico (traditional Spanish or Portuguese folk song)","termine_origine":"villancico","catena":[{"codice":"es","nome":"Spanish","termine":"villancico","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"vīllānus","categoria":"non_precisato"}],"lontana":"la-med","ambiti":["musica","arte"],"via":"","testo":"Borrowed from Spanish villancico, from villano (“peasant”), from Medieval Latin vīllānus (“villager”), whence also Portuguese vilão.","livello2_varieta":"la-med"},{"parola":"vislumbrar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to glimpse","termine_origine":"vislumbrar","catena":[{"codice":"es","nome":"Spanish","termine":"vislumbrar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vix lūmināre","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish vislumbrar, from Latin vix lūmināre (“barely illuminate”).","livello2_varieta":"la"},{"parola":"vislumbre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"glimmer (a faint light)","termine_origine":"vislumbre","catena":[{"codice":"es","nome":"Spanish","termine":"vislumbre","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vix lūmināre","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Spanish vislumbre, from Latin vix lūmināre (“barely illuminate”).","livello2_varieta":"la"}]}