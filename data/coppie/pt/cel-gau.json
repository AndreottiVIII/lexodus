{"arrivo":"pt","origine":"cel-gau","origine_nome":"Gaulish","n":6,"n_alternative":3,"parole":[{"parola":"canga","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"carrying pole, milkmaid's yoke","termine_origine":"*cambica","catena":[{"codice":"cel-gau","nome":"Gaulish","termine":"*cambica","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kambos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)kh₂emb-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Gaulish *cambica \"bent log\", derivative of cambos (“twisted, crooked”), from Proto-Celtic *kambos, from Proto-Indo-European *(s)kh₂emb- (“to bend, curve”). Compare Occitan chambijo (“plough beam”)."},{"parola":"dandão","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"night terror","termine_origine":"dusius","catena":[{"codice":"cel-gau","nome":"Gaulish","termine":"dusius","categoria":"prestito"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Borrowed from Gaulish dusius."},{"parola":"ganga","pos":"noun","n_etimologia":4,"categoria":"non_precisato","incerta":"no","significato":"cangue","termine_origine":"*cambica","catena":[{"codice":"cel-gau","nome":"Gaulish","termine":"*cambica","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kambos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*(s)kh₂emb-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Gaulish *cambica \"bent log\", derivative of cambos (“twisted, crooked”), from Proto-Celtic *kambos, from Proto-Indo-European *(s)kh₂emb- (“to bend, curve”). Doublet of canga."},{"parola":"calhau","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"or from","significato":"stone, boulder","termine_origine":"caljavo","catena":[{"codice":"cel-gau",