ito","incerta":"no","significato":"mangosteen","termine_origine":"manggustan","catena":[{"codice":"ms","nome":"Malay","termine":"manggustan","categoria":"prestito"}],"lontana":"ms","ambiti":["cucina"],"via":"","testo":"Borrowed from Malay manggustan, variant of manggis."},{"parola":"meranti","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"meranti (the timber of any of various trees of the genus Shorea)","termine_origine":"meranti","catena":[{"codice":"ms","nome":"Malay","termine":"meranti","categoria":"prestito"}],"lontana":"ms","ambiti":[],"via":"","testo":"Borrowed from Malay meranti."},{"parola":"nipa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"nipa, a palm tree of the species Nypa fruticans","termine_origine":"nipah","catena":[{"codice":"ms","nome":"Malay","termine":"nipah","categoria":"prestito"}],"lontana":"ms","ambiti":[],"via":"","testo":"Borrowed from Malay nipah."},{"parola":"pires","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"perhaps","significato":"saucer (small dish)","termine_origine":"piring","catena":[{"codice":"ms","nome":"Malay","termine":"piring","categoria":"non_precisato"},{"codice":"fa-cls","nome":"Classical Persian","termine":"پرنگ","traslitterazione":"piring","categoria":"non_precisato"}],"lontana":"fa-cls","ambiti":[],"via":"","testo":"Ultimately from Malay piring (“saucer”), from Classical Persian پرنگ (piring, “copper”), perhaps originally a plural form. Compare Indonesian piring, Afrikaans piering."},{"parola":"rambutã","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"rambutan (fruit of the Nephelium lappaceum tree)","termine_origine":"rambutan","catena":[{"codice":"ms","nome":"Malay","termine":"rambutan","categoria":"prestito"}],"lontana":"ms","ambiti":["cucina"],"via":"","testo":"Borrowed from Malay rambutan."},{"parola":"ringgit","pos":"noun","n_etimologia":1,"categoria":"prestito","