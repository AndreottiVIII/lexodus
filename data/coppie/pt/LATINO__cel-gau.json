la":"légua","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"legua, Portuguese league, a traditional unit of distance, variously reckoned as 4444.4, 5555.6, or 6172.8 m","termine_origine":"leuga","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"leuga","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*lougā","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Late Latin leuga (“Gaulish league, the distance of one hour's walking”), from Gaulish, from Proto-Celtic *lougā. Cognate with Spanish and Galician legua and Catalan llegua.","origine_varieta":"la-lat"},{"parola":"mina","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"mine (place from which ore is extracted)","termine_origine":"mīna","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"mīna","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*mēnā","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*meinis","categoria":"ereditato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"From Late Latin mīna, from Gaulish *mēnā (“ore, mine”).","origine_varieta":"la-lat"},{"parola":"peça","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"piece (part of a larger whole)","termine_origine":"pettia","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"pettia","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*pettyā","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kʷezdis","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":["arte","sport"],"via":"","testo":"From Late Latin pettia, from Gaulish *pettyā, from Proto-Celtic *kʷezdis. Compare French pièce, Italian pezza, Spanish pieza, Old Irish cuit.","origine_varieta":"la-lat"},{"parola":"tranca","po