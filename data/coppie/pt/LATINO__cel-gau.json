{"arrivo":"pt","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"cel-gau","livello2_nome":"Gaulish","n":16,"parole":[{"parola":"bacia","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"basin","termine_origine":"*baccinum","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*baccinum","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"From Vulgar Latin *baccinum, from Gaulish.","origine_varieta":"la-vul"},{"parola":"barra","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"bar (solid object with uniform cross-section)","termine_origine":"*barra","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*barra","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*barros","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":["scienza","sport","diritto_politica"],"via":"","testo":"From Vulgar Latin *barra, possibly from Gaulish *barros (“the bushy end”), cognate with French barre and English bar. Doublet of bar.","origine_varieta":"la-vul"},{"parola":"batalha","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"battle (general action, fight, or encounter; a combat)","termine_origine":"battālia","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"battālia","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":["militare"],"via":"","testo":"From Old Galician-Portuguese batalla, from Late Latin battālia, variant of battuālia (“fighting and fencing exercises”), from Latin battuō (“to strike, beat”), from Gaulish.","origine_varieta":"la-lat"},{"parola":"bico","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"Anatomical structure:","termine_o