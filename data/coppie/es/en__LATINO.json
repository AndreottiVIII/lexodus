":"-an","categoria":"non_precisato"}],"lontana":"en","ambiti":["scienza"],"via":"","testo":"Borrowed from English radian, from Latin radius (“ray”) + English -an.","livello2_varieta":"la"},{"parola":"resiliente","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"resilient","termine_origine":"resilient","catena":[{"codice":"en","nome":"English","termine":"resilient","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"resiliēns","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from English resilient.","livello2_varieta":"la"},{"parola":"réflex","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"reflex (of a camera, using a mirror to reflect the image onto a viewfinder)","termine_origine":"reflex","catena":[{"codice":"en","nome":"English","termine":"reflex","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"reflexus","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Borrowed from English reflex, from Latin reflexus, past participle of reflecto. Doublet of reflejo.","livello2_varieta":"la"},{"parola":"sponsor","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"sponsor","termine_origine":"sponsor","catena":[{"codice":"en","nome":"English","termine":"sponsor","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sponsor","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Unadapted borrowing from English sponsor.","livello2_varieta":"la"},{"parola":"tespio","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Thespian","termine_origine":"thespian","catena":[{"codice":"en","nome":"English","termine":"thespian","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Thespis","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"Θέσπις","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from English thespian, from Latin Thespis, ultimately from Ancient Greek Θέσπις (Théspis).","livello2_varieta":"la"},{"parola":"tractor","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"driving","termine_origine":"tractor","catena":[{"codice":"en","nome":"English","termine":"tractor","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"tractus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from English tractor, formed from Latin tractus, perfect passive participle of trahere (“to pull”), + agent noun suffix -or.","livello2_varieta":"la"},{"parola":"utopía","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"utopia","termine_origine":"Utopia","catena":[{"codice":"en","nome":"English","termine":"Utopia","categoria":"prestito"},{"codice":"la-new","nome":"New Latin","termine":"Ūtopia","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"οὐ","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from English Utopia, from New Latin Ūtopia, coined by Sir Thomas More as the name of the fictional state central to the homonymous work Utopia, from Ancient Greek οὐ (ou, “not”) + τόπος (tópos, “place”).","livello2_varieta":"la-new"},{"parola":"versus","pos":"prep","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"versus","termine_origine":"versus","catena":[{"codice":"en","nome":"English","termine":"versus","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"versus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from English versus, from Latin versus. Doublet of verso.","livello2_varieta":"la"},{"parola":"video","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"video","termine_origine":"video","catena":[{"codice":"en","nome":"English","termine":"video","categoria":"presti