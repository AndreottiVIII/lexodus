{"arrivo":"es","origine":"en","origine_nome":"English","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":28,"parole":[{"parola":"aldehído","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"aldehyde","termine_origine":"aldehyde","catena":[{"codice":"en","nome":"English","termine":"aldehyde","categoria":"prestito"},{"codice":"la-new","nome":"New Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-new","ambiti":["scienza"],"via":"","testo":"Borrowed from English aldehyde, a contraction of New Latin alcohol dēhydrogenātum (“alcohol deprived of hydrogen”).","livello2_varieta":"la-new"},{"parola":"auditar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to audit","termine_origine":"audit","catena":[{"codice":"en","nome":"English","termine":"audit","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"audītus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from English audit, from Latin audītus (“a hearing”), from audīre (“to hear”).","livello2_varieta":"la"},{"parola":"bonus","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"bonus","termine_origine":"bonus","catena":[{"codice":"en","nome":"English","termine":"bonus","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bonus","categoria":"latinismo_dotto"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*dwenos","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dewh₂-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from English bonus, from Latin bonus. Compare the doublet bueno (“good”), inherited from the same Latin word.","livello2_varieta":"la"},{"parola":"calcio","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"calcium","termine_origine":"calcium","catena":[{"codice":"en","nome":"English","termine":"calcium","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"calx","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from English calcium, coined in 1808 by Humphry Davy, from Latin calcem (“lime”).","livello2_varieta":"la"},{"parola":"conativo","pos":"adj","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"conative","termine_origine":"conative","catena":[{"codice":"en","nome":"English","termine":"conative","categoria":"calco"},{"codice":"la","nome":"Latin","termine":"cōnor","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From conato + -ivo, on the model of English conative, ultimately from Latin cōnor.","livello2_varieta":"la"},{"parola":"conectar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to connect, connect up, link","termine_origine":"connect","catena":[{"codice":"en","nome":"English","termine":"connect","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"connectō","categoria":"non_precisato"}],"lontana":"la","ambiti":["finanza","scienza","informatica"],"via":"","testo":"Borrowed from English connect, from Latin conēctere.","livello2_varieta":"la"},{"parola":"cortisona","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cortisone","termine_origine":"cortisone","catena":[{"codice":"en","nome":"English","termine":"cortisone","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cortĭcis","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from English cortisone, abbrev. of corticosterone, from Latin cortĭcis and -sterone.","livello2_varieta":"la"},{"parola":"deporte","pos":"noun","n_etimologia":1,"categoria":"calco","incerta":"no","significato":"sport (activity)","termine_origine":"sport","catena":[{"codice":"en","nome":"English","termine":"sport","categoria":"calco"},{"codice":"la","nome":"Latin","termine":"dēportāre