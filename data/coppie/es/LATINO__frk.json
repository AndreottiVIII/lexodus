{"arrivo":"es","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"frk","livello2_nome":"Frankish","n":14,"parole":[{"parola":"alodio","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"allodium","termine_origine":"allōdium","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"allōdium","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*allaaud","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin allōdium, from Frankish *allaaud.","origine_varieta":"la-med"},{"parola":"bodrio","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"broth","termine_origine":"brodium","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"brodium","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*broþ","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bruþą","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From earlier brodio via metathesis, from Late Latin brodium, from Frankish *broþ, from Proto-Germanic *bruþą, the same root as English broth. Compare French brouet, Old French breu, Catalan brou, Piedmontese breu, Friulian brût, Sicilian brodu, Italian brodo, Portuguese brodo.","origine_varieta":"la-lat"},{"parola":"burgo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"burg","termine_origine":"burgus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"burgus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*burg","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*burgz","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*bʰerǵʰ-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin burgus, from Frankish *burg (“fortified city”), from Proto-Germanic *burgz (“fortified city”), from Proto-Indo-European *bʰerǵʰ- (“high”).","origine_varieta":"la-lat"},{"parola":"crujir","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to creak, to crack (high-pitched, sharp sound)","termine_origine":"*cruscīre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cruscīre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*krustijan","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Inherited from Old Spanish cruxir, from Vulgar Latin *cruscīre, from Frankish *krustijan. Compare Catalan cruixir, Old French croissir.","origine_varieta":"la-vul"},{"parola":"esturión","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"sturgeon","termine_origine":"sturiō","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"sturiō","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*sturjō","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*sturjô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin sturiōnem, from Frankish *sturjō, from Proto-Germanic *sturjô (“sturgeon”). Cognate with English sturgeon.","origine_varieta":"la-med"},{"parola":"gastar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to spend (money, time, resources)","termine_origine":"vasto","catena":[{"codice":"la","nome":"Latin","termine":"vasto","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*wōstijan","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"Likely inherited from Latin vastāre, with the initial consonant influenced by Frankish *wōstijan and with the resulting /ɡw/ reducing to /g/ in unstressed initial position, as also in galardón.","origine_varieta":"la"},{"parola":"guardar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to save (to store for future use)","termine_origine":"wardō","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"wardō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*wardēn","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wardāną","categoria":"ereditato"}],"lontana":"gem-pro","ambiti":["scienza","informatica"],"via":"","testo":"Inherited from Early Medieval Latin wardāre.","origine_varieta":"la-eme"},{"parola":"guerra","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"war, warfare","termine_origine":"werra","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"werra","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*werʀu","categoria":"prestito"}],"lontana":"frk","ambiti":["militare"],"via":"","testo":"Inherited from Old Spanish guerra, from Early Medieval Latin werra, borrowed from Frankish *werʀu (“confusion; quarrel”).","origine_varieta":"la-eme"},{"parola":"marco","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"frame","termine_origine":"marcus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"marcus","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*marku","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*markō","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*mórǵs","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin marcus, from Frankish *marku (“boundary, border”), from Proto-Germanic *markō.","origine_varieta":"la-med"},{"parola":"marco","pos":"noun","n_etimologia":2,"categoria":"latinismo_dotto","incerta":"no","significato":"marco, Spanish mark (a traditional unit of weight, equivalent to about 230 g)","termine_origine":"marcus","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"marcus","categoria":"latinismo_dotto"},{"codice":"frk","nome":"Frankish","termine":"*mark","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*marką","categoria":"non_precisato"},{"codice":"de","nome":"German","termine":"Mark","categoria":"non_precisato"},{"codice":"fi","nome":"Finnish","termine":"markka","categoria":"non_precisato"},{"codice":"gmq-osw","nome":"Old Swedish","termine":"mark","categoria":"non_precisato"}],"lontana":"gmq-osw","ambiti":[],"via":"","testo":"Borrowed from Medieval Latin marcus, from Frankish *mark (“mark, sign”), from Proto-Germanic *marką. As a German currency, a calque of German Mark. As a Finnish currency, a calque of Finnish markka, via Old Swedish mark. Cognate with English mark, Catalan marc, and Galician and Portuguese marco.","origine_varieta":"la-med"},{"parola":"raspar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"to file down or sand down","termine_origine":"*raspāre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*raspāre","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*hraspōn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"From Vulgar Latin *raspāre, from Frankish *hraspōn.","origine_varieta":"la-vul"},{"parola":"robar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"to rob","termine_origine":"raubō","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"raubō","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*raubōn","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*raubōną","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*Hrewp-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin raubāre.","origine_varieta":"la-lat"},{"parola":"trocar","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; Probably; modello unc/uncertain","significato":"to barter","termine_origine":"troco","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"troco","categoria":"non_precisato"},{"codice":"frk","nome":"Frankish","termine":"*trokōn","categoria":"non_precisato"}],"lontana":"frk","ambiti":[],"via":"","testo":"First used in the 14th century, from Old Spanish trocar, from Medieval Latin trocāre; further etymology uncertain (probably Frankish *trokōn). Cognate with Portuguese, Galician, Catalan, and Occitan trocar, French troquer, English truck.","origine_varieta":"la-med"},{"parola":"yelmo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"an ancient helmet that covers the head and face","termine_origine":"helmus","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"helmus","categoria":"ereditato"},{"codice":"frk","nome":"Frankish","termine":"*helm","categoria":"prestito"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*helmaz","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["militare","diritto_politica"],"via":"","testo":"Inherited from Late Latin helmus, from Frankish *helm (“helmet”).","origine_varieta":"la-lat"}]}