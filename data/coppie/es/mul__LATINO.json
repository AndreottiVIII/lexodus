{"arrivo":"es","origine":"mul","origine_nome":"Translingual","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":5,"parole":[{"parola":"cetáceo","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cetaceous","termine_origine":"Cetacea","catena":[{"codice":"mul","nome":"Translingual","termine":"Cetacea","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"cētus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κῆτος","categoria":"non_precisato"},{"codice":"mul","nome":"Translingual","termine":"-acea","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"-ācea","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From translingual Cetacea, from Latin cētus, from Ancient Greek κῆτος (kêtos, “whale, sea monster”), + translingual -acea, from Latin -ācea, neuter plural of -āceus (“resembling, -aceous”) (cognate with Spanish -áceo).","livello2_varieta":"la"},{"parola":"molusco","pos":"noun|adj","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"mollusc","termine_origine":"Mollusca","catena":[{"codice":"mul","nome":"Translingual","termine":"Mollusca","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"molluscus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Singularization of translingual Mollusca, the phylum name, from Latin molluscus (“soft”), from mollis (“soft, delicate”).","livello2_varieta":"la"},{"parola":"octópodo","pos":"adj|noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"octopod (eight-legged)","termine_origine":"Octopoda","catena":[{"codice":"mul","nome":"Translingual","termine":"Octopoda","categoria":"non_precisato"},{"codice":"la-new","nome":"New Latin","termine":"octōpoda","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ὀκτώπους","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":