{"arrivo":"es","origine":"ppl","origine_nome":"Pipil","n":18,"parole":[{"parola":"chacho","pos":"adj","n_etimologia":3,"categoria":"prestito","incerta":"no","significato":"conjoined","termine_origine":"chachahuatl","catena":[{"codice":"ppl","nome":"Pipil","termine":"chachahuatl","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Clipping of chachaguato, from Pipil chachahuatl."},{"parola":"champa","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"hovel","termine_origine":"chamapan","catena":[{"codice":"ppl","nome":"Pipil","termine":"chamapan","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil chamapan (“in the house”)."},{"parola":"chiltuca","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"black widow, especially Latrodectus mactans or Latrodectus curacaviensis","termine_origine":"","catena":[{"codice":"ppl","nome":"Pipil","termine":"","categoria":"non_precisato"}],"lontana":"ppl","ambiti":[],"via":"","testo":"From Pipil chil (“pepper”) + tukat (“spider”)."},{"parola":"chimar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to have sex; to fuck; to bang","termine_origine":"xima","catena":[{"codice":"ppl","nome":"Pipil","termine":"xima","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil xima (“scrape”)."},{"parola":"chimbolo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"molly (A fish of the genus Poecilia, particularly sphenops and gracilis.)","termine_origine":"tzimpulu","catena":[{"codice":"ppl","nome":"Pipil","termine":"tzimpulu","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil tzimpulu (“little fish”)."},{"parola":"chinto","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"menstruation","termine_origine":"chiltik","catena":[{"codice":"ppl","nome":"Pipil","termine":"chiltik","categoria":"non_precisato"}],"lontana":"ppl","ambiti":[],"via":"","testo":"From Pipil chiltik (“red”)."},{"parola":"chipagua","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"a waterlogged fruit","termine_origine":"chipawak","catena":[{"codice":"ppl","nome":"Pipil","termine":"chipawak","categoria":"non_precisato"}],"lontana":"ppl","ambiti":[],"via":"","testo":"From Pipil chipawak."},{"parola":"cuto","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"missing an arm or forearm; one-armed, or one-forearmed","termine_origine":"kutu","catena":[{"codice":"ppl","nome":"Pipil","termine":"kutu","categoria":"prestito"},{"codice":"nci","nome":"Classical Nahuatl","termine":"cotoctic","categoria":"prestito"}],"lontana":"nci","ambiti":[],"via":"","testo":"Borrowed from Pipil kutu (“short, dismembered”) cf. Pipil mākutu (“one-armed, with an arm missing”), related to Classical Nahuatl cotoctic (“dismembered”), macotoctic (“dismembered of one arm”), quechcotoctic (“decapitated”). The DRAE states it is borrowed from a Nahuatl cutuche (“cut”), but this is"},{"parola":"güegüecho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"goiter","termine_origine":"veveyotl","catena":[{"codice":"ppl","nome":"Pipil","termine":"veveyotl","categoria":"prestito"}],"lontana":"ppl","ambiti":["scienza"],"via":"","testo":"Borrowed from Pipil veveyotl (“old age”)."},{"parola":"huiste","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a small sharp piece of shattered glass","termine_origine":"witzti","catena":[{"codice":"ppl","nome":"Pipil","termine":"witzti","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil witzti (“thorn, spine”) + tet (“stone”)."},{"parola":"maquilishuat","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"pink poui; Tabebuia rosea","termine_origine":"makwil","catena":[{"codice":"ppl","nome":"Pipil","termine":"makwil","categoria":"non_precisato"},{"codice":"nci","nome":"Classical Nahuatl","termine":"macuilli","categoria":"non_precisato"}],"lontana":"nci","ambiti":[],"via":"","testo":"From Pipil makwil (“five”) + iswat (“leaf”). Compare with Classical Nahuatl macuilli (“five”) + izhuatl (“leaf”)."},{"parola":"mish","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"kitten","termine_origine":"mishtun","catena":[{"codice":"ppl","nome":"Pipil","termine":"mishtun","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil mishtun (“cat”), of onomatopoeic origin."},{"parola":"pupusa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a stuffed tortilla","termine_origine":"pupusawa","catena":[{"codice":"ppl","nome":"Pipil","termine":"pupusawa","categoria":"prestito"}],"lontana":"ppl","ambiti":["cucina"],"via":"","testo":"Borrowed from Pipil pupusawa (“swollen”). However, linguist Alan King, who has worked on Pipil Nawat, asserts this word is spurious, invented by Salvadoran linguist Pedro Geoffroy Rivas. The word is also absent from Lyle Campbell's lexicon."},{"parola":"taltuza","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"gopher","termine_origine":"tāltūsan","catena":[{"codice":"ppl","nome":"Pipil","termine":"tāltūsan","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil tāltūsan (“gopher”). Compare Classical Nahuatl tlālli (“earth, soil”) + tozan (“gopher, mole”) (compare tuza)."},{"parola":"tepelcúa","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"Dermophis mexicanus, the Mexican burrowing caecilian","termine_origine":"tepul","catena":[{"codice":"ppl","nome":"Pipil","termine":"tepul","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"The first element is probably borrowed from Pipil tepul (“penis”) + kuwat (“snake”)."},{"parola":"tetelque","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bitter","termine_origine":"tetelquic","catena":[{"codice":"ppl","nome":"Pipil","termine":"tetelquic","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil tetelquic (“rough”)."},{"parola":"tile","pos":"noun|adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"soot","termine_origine":"tlilli","catena":[{"codice":"ppl","nome":"Pipil","termine":"tlilli","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil tlilli."},{"parola":"titilgüita","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"feces from a hen","termine_origine":"titilkuitat","catena":[{"codice":"ppl","nome":"Pipil","termine":"titilkuitat","categoria":"prestito"}],"lontana":"ppl","ambiti":[],"via":"","testo":"Borrowed from Pipil titilkuitat (“black feces”)."}]}