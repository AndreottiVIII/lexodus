{"arrivo":"es","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"qsb-ibe","livello2_nome":"Paleo-Hispanic","n":7,"parole":[{"parola":"barajar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"to shuffle (to put in random order)","termine_origine":"baraliare","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"baraliare","categoria":"ereditato"},{"codice":"qsb-ibe","nome":"Paleo-Hispanic","termine":"","categoria":"non_precisato"}],"lontana":"qsb-ibe","ambiti":[],"via":"","testo":"Inherited from Old Spanish barajar (“to quarrel”), from Late Latin baraliare (“dispute, quarrel”), probably from Paleo-Hispanic. Cognate with Portuguese baralhar and Catalan barallar.","origine_varieta":"la-lat"},{"parola":"cama","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"bed","termine_origine":"cama","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cama","categoria":"ereditato"},{"codice":"qsb-ibe","nome":"Paleo-Hispanic","termine":"","categoria":"prestito"}],"lontana":"qsb-ibe","ambiti":[],"via":"","testo":"Inherited from Old Spanish cama, from Late Latin cama, possibly borrowed from Paleo-Hispanic.","origine_varieta":"la-lat"},{"parola":"cuérrago","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"riverbed","termine_origine":"corrugus","catena":[{"codice":"la","nome":"Latin","termine":"corrugus","categoria":"ereditato"},{"codice":"qsb-ibe","nome":"Paleo-Hispanic","termine":"","categoria":"non_precisato"}],"lontana":"qsb-ibe","ambiti":[],"via":"","testo":"Inherited from Latin corrugus, from Paleo-Hispanic.","origine_varieta":"la"},{"parola":"gusano","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Uncertain; Possibly; modello unc/uncertain","significato":"worm","termine_origine":"cossus","catena":[{"codice":"la","nome":"Latin","termine":"cossus","c