{"arrivo":"es","origine":"roa-oca","origine_nome":"Old Catalan","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":12,"parole":[{"parola":"angoja","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"grief; anguish","termine_origine":"angoxa","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"angoxa","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"angustia","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Spanish angoxa, itself borrowed from Old Catalan angoxa, from Latin angustiae (“tribulations, difficulties”). (/ʃ/ > /x/ is not a native outcome of /-stj-/ in Spanish.) Doublet of angustia. Compare modern Catalan angoixa.","livello2_varieta":"la"},{"parola":"cojín","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"cushion","termine_origine":"coxin","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"coxin","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*coxīnum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Probably borrowed from Old Catalan coxin~coixin (modern coixí), from Vulgar Latin *coxīnum (“cushion”), from Latin coxa (“hip”). Compare French coussin, Italian cuscino.","livello2_varieta":"la-vul"},{"parola":"congoja","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"anguish","termine_origine":"congoxa","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"congoxa","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"congustia","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Inherited from Old Spanish congoxa, from Old Catalan congoxa, from Late Latin congustia (“defile”, noun).","livello2_varieta":"la-lat"},{"parola":"escabel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"footrest; footstool","termine_origine":"escabell","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"escabell","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"scabellum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Catalan escabell, a parallel form to escambell, from Latin scabellum.","livello2_varieta":"la"},{"parola":"faena","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"task, job; duty","termine_origine":"faena","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"faena","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"facenda","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Catalan faena (“task, chore”) (modern Catalan feina), from Latin facenda (“things to do”), from faciō. Compare Portuguese faina. Doublet of hacienda.","livello2_varieta":"la"},{"parola":"molde","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"mold, cast","termine_origine":"motle","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"motle","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"modulus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Old Catalan motle with metathesis, from Latin modulus.","livello2_varieta":"la"},{"parola":"papel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"paper","termine_origine":"paper","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"paper","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"papȳrus","categoria":"latinismo_dotto"},{"codice":"grc","nome":"Ancient Greek","termine":"πάπυρος","categoria":"prestito"}],"lontana":"grc","ambiti":[],"via":"","testo":"From Old Spanish papel, from Old Catalan paper. Doublet of paper.","livello2_varieta":"la"},{"parola":"pólvora","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"modificatore <unc> nel legame","significato":"gunpowder","termine_origine":"polvora","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"polvora","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"pulvera","categoria":"ereditato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Most likely borrowed from Old Catalan polvora (first attested in Spanish c. 1350), from older polvera, from Late Latin pŭlvĕra, neuter plural based on Latin pulvis m. Compare French poudre or Old Occitan polvera, poldra, porba. Doublet of polvo < *pulvus.","livello2_varieta":"la-lat"},{"parola":"reloj","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"clock","termine_origine":"relotge","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"relotge","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"hōrologium","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"ὡρολόγιον","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Old Catalan relotge (1362) (Modern Catalan rellotge), from the older orollotge, from Latin hōrologium, from Ancient Greek ὡρολόγιον (hōrológion). The current form of the word may partly be a back-formation of relojes, plural of obsolete reloje, which better conforms with the Catalan so","livello2_varieta":"la"},{"parola":"sastre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"tailor (person who makes, repairs, or alters clothes professionally)","termine_origine":"sastre","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"sastre","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"sartor","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Spanish sastre, from Old Catalan sastre, from earlier sartre, from Latin sartor.","livello2_varieta":"la"},{"parola":"trébol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"clover","termine_origine":"trèvol","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"trèvol","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*trifolum","categoria":"ereditato"}],"lontana":"la-vul","ambiti":["sport","diritto_politica"],"via":"","testo":"Inherited from Old Spanish trebol, from Old Catalan trèvol (whence modern Catalan trèvol), from Vulgar Latin *trifulus < *trifolum, from Latin trifolium, a calque of Ancient Greek τρίφυλλον (tríphullon, “clover”). Doublet of trifolio. Cognate with English trefoil.","livello2_varieta":"la-vul"},{"parola":"vinagre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"vinegar (a sour liquid formed by the fermentation of alcohol used as a condiment or preservative)","termine_origine":"vinagre","catena":[{"codice":"roa-oca","nome":"Old Catalan","termine":"vinagre","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vīnum ācre","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Spanish vinagre, probably borrowed from Old Catalan vinagre, from Latin vīnum ācre.","livello2_varieta":"la"}]}