{"arrivo":"es","origine":"pro","origine_nome":"Old Occitan","livello2":"fro","livello2_nome":"Old French","n":7,"parole":[{"parola":"arenque","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"herring","termine_origine":"arenc","catena":[{"codice":"pro","nome":"Old Occitan","termine":"arenc","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"hareng","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"haringus","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"From Old Spanish arenque, from Old Occitan arenc or Old French hareng, from Late Latin haringus."},{"parola":"baluarte","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"bastion","termine_origine":"","catena":[{"codice":"pro","nome":"Old Occitan","termine":"","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"balouart","categoria":"non_precisato"},{"codice":"dum","nome":"Middle Dutch","termine":"bolwerc","categoria":"non_precisato"},{"codice":"gmh","nome":"Middle High German","termine":"bolwerc","categoria":"non_precisato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*bullǭ","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From Old Occitan or Old French balouart, from Middle Dutch bolwerc, from Middle High German bolwerc, from bole (“plank, beam”) (from Proto-Germanic *bullǭ) + werc (“work”). Related to English bulwark. Doublet of boulevard."},{"parola":"batalla","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"battle","termine_origine":"batalha","catena":[{"codice":"pro","nome":"Old Occitan","termine":"batalha","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"bataille","categoria":"non_precisato"},{"codice":"la-lat","nome":"Late Latin","termine":"battālia","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Inherited from Old Spanish batalla, borrowed from Old Occitan batalha, or Old French bataille, from Late Latin battālia, variant of battuālia, from Latin battuō. If inherited, the Latin term would have resulted in a Spanish *bataja instead, and even in Old Spanish writing such as the Cantar de Mio C"},{"parola":"coraje","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"anger, rage, resentment","termine_origine":"coratge","catena":[{"codice":"pro","nome":"Old Occitan","termine":"coratge","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"corage","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*corāticum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Old Spanish coraje, borrowed from Old Occitan coratge or Old French corage, from Vulgar Latin *corāticum."},{"parola":"jerga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jargon; slang","termine_origine":"gergon","catena":[{"codice":"pro","nome":"Old Occitan","termine":"gergon","categoria":"prestito"},{"codice":"fro","nome":"Old French","termine":"jargon","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"Borrowed from Old Occitan gergon, from Old French jargon (“the chattering of birds”). Ultimately of echoic origin. Compare Latin garriō (“to chatter”); English gargle, garrulous; Spanish garganta, gárgara, gargajo, jerigonza."},{"parola":"mensaje","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"message","termine_origine":"messatge","catena":[{"codice":"pro","nome":"Old Occitan","termine":"messatge","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"message","categoria":"non_precisato"},{"codice":"la-med","nome":"Medieval Latin","termine":"missāticum","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Inherited from Old Spanish mensage, borrowed from Old Occitan messatge or Old French message, both from Medieval Latin missāticum, derived from Latin mittere (“send”)."},{"parola":"romance","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Romance","termine_origine":"romans","catena":[{"codice":"pro","nome":"Old Occitan","termine":"romans","categoria":"prestito"},{"codice":"fro","nome":"Old French","termine":"romanz","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Old Occitan romans, or Old French romanz, from Vulgar Latin *romanĭce, compare Medieval Latin rōmānice, ultimately from Latin rōmānicus < rōmānus. Cognates include Old French romanz, whence the modern French noun roman (“novel”)."}]}