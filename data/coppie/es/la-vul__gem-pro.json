{"arrivo":"es","origine":"la-vul","origine_nome":"Vulgar Latin","livello2":"gem-pro","livello2_nome":"Proto-Germanic","n":6,"parole":[{"parola":"anca","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"haunch, rump","termine_origine":"*hanca","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*hanca","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*hankō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *hanca, from Proto-Germanic *hankō (related to *ankijǭ (“joint, limb”)). Cognate with English haunch."},{"parola":"bienvenido","pos":"adj|intj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"welcome","termine_origine":"*bene venītus","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*bene venītus","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*wiljakwemô","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Old Spanish bien venido, inherited from Vulgar Latin *bene venītus, presumably a calque of a Frankish term, derived from Proto-Germanic *wiljakwemô (“a welcome guest or arrival”), from which many modern Germanic forms descend, such as English welcome. By surface analysis, bien (“well”"},{"parola":"fresco","pos":"adj|noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"fresh","termine_origine":"*friscum","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*friscum","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*friskaz","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*preyskos","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["scienza","arte"],"via":"","testo":"Inherited from Vulgar Latin *friscum."},{"parola":"lezna","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"awl","termine_origine":"*alisna","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alisna","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*alasnō","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"From lesna, from alesna, from Vulgar Latin *alisna, ultimately from Proto-Germanic *alasnō; cf. *ēlō, whence English awl. Compare also Catalan alena, French alêne, Italian lesina."},{"parola":"overo","pos":"adj","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"piebald, mottled","termine_origine":"*falvārium","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*falvārium","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*falwaz","categoria":"non_precisato"}],"lontana":"gem-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *falvārium, from falvus, from Proto-Germanic *falwaz. Cognate with Portuguese fouveiro, Catalan falb, French fauve, and further German fahl, falb, English fallow. The expected Spanish spelling would be hovero, which is attested."},{"parola":"tirar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"to drop intentionally","termine_origine":"*tīrāre","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*tīrāre","categoria":"ereditato"},{"codice":"gem-pro","nome":"Proto-Germanic","termine":"*teraną","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*der-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["sport"],"via":"","testo":"Inherited from Vulgar Latin *tīrāre."}]}