{"arrivo":"es","origine":"LATINO","origine_nome":"Latin (all varieties)","livello2":"cel-gau","livello2_nome":"Gaulish","n":24,"parole":[{"parola":"abedul","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"birch","termine_origine":"*betūle","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*betūle","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*betua","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*betwiyos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gʷet-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *betūle or *betūlus, from Latin betulla, diminutive of Gaulish *betua, from Proto-Celtic *betwiyos, *betuyā (“birch”), from Proto-Indo-European *gʷet-. The prefix a- is due to the influence of abeto (“fir”). Also compare Catalan bedoll, French bouleau, Portuguese bétula, ","origine_varieta":"la-vul"},{"parola":"aloja","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"lark (bird)","termine_origine":"*alaudea","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alaudea","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*alauda","categoria":"prestito"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *alaudea, from Latin alauda. Related to alondra.","origine_varieta":"la-vul"},{"parola":"aloya","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"lark (bird)","termine_origine":"*alaudea","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*alaudea","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*alauda","categoria":"prestito"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *alaudea, from Latin alauda. Related to alondra.","origine_varieta":"la-vul"},{"parola":"arverno","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"no","significato":"Arvern","termine_origine":"Arvernus","catena":[{"codice":"la","nome":"Latin","termine":"Arvernus","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"prestito"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Borrowed from Latin Arvernus.","origine_varieta":"la"},{"parola":"beleño","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"henbane (plant)","termine_origine":"*belēnium","catena":[{"codice":"la","nome":"Latin","termine":"*belēnium","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"belenion","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Old Spanish bellinno, from Latin *belēnium, from Gaulish belenion (Pseudo-Aristotle, De plantis, 7.821); akin to Welsh bela (“henbane”), Old Irish béal (“sun”). Related to belesa.","origine_varieta":"la"},{"parola":"breña","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"perhaps","significato":"scrub, brush (thick vegetation)","termine_origine":"*brigna","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*brigna","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*brignā","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*brixs","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *brigna, perhaps from a Gaulish *brignā, from Proto-Celtic *brixs (“hill”).","origine_varieta":"la-vul"},{"parola":"cambiar","pos":"verb","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Probably","significato":"to change, to shift, to switch, to alter","termine_origine":"","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"ast","nome":"Asturian","termine":"cambiar","categoria":"prestito"},{"codice":"gl","nome":"Galician","termine":"cambiar","categoria":"prestito"},{"codice":"an","nome":"Aragonese","termine":"cambiar","categoria":"prestito"}],"lontana":"an","ambiti":[],"via":"","testo":"Inherited from Old Spanish, from Vulgar Latin or Late Latin cambiāre, from change in conjugation of cambīre, of Gaulish origin. Probably through Asturian cambiar, Galician cambiar or Aragonese cambiar, given the conservation of mb group. Compare also the probable native variant Old Spanish form came","origine_varieta":"la-vul"},{"parola":"cambium","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"cambium","termine_origine":"cambium","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cambium","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"cambion","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kambos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Late Latin cambium. Doublet of cambio.","origine_varieta":"la-lat"},{"parola":"carro","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"cart","termine_origine":"carrus","catena":[{"codice":"la","nome":"Latin","termine":"carrus","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*karros","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*karros","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ḱr̥sós","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Old Spanish carro, from Latin carrus. Distant cognate with English horse.","origine_varieta":"la"},{"parola":"comba","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"jump rope (the rope itself, not the game)","termine_origine":"cumba","catena":[{"codice":"la-med","nome":"Medieval Latin","termine":"cumba","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*cumba","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kumbā","categoria":"ereditato"},{"codice":"qfa-sub","nome":"substrate","termine":"","categoria":"prestito"}],"lontana":"qfa-sub","ambiti":[],"via":"mxi","testo":"From Medieval Latin cumba (“valley”), borrowed from Gaulish *cumba, from Proto-Celtic *kumbā. According to Coromines, the term likely passed through Asturleonese or Mozarabic because of the retention of Latin /mb/, with the expected native outcome being *coma. However, this is not universally agreed","origine_varieta":"la-med"},{"parola":"cámbium","pos":"noun","n_etimologia":1,"categoria":"latinismo_dotto","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"cambium","termine_origine":"cambium","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"cambium","categoria":"latinismo_dotto"},{"codice":"cel-gau","nome":"Gaulish","termine":"cambion","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kambos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["scienza"],"via":"","testo":"Borrowed from Late Latin cambium. Doublet of cambio.","origine_varieta":"la-lat"},{"parola":"gamuza","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly; Probably","significato":"chamois (goat-antelope)","termine_origine":"*camocia","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*camocia","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"camox","categoria":"non_precisato"},{"codice":"xrr","nome":"Raetic","termine":"","categoria":"non_precisato"},{"codice":"xlg","nome":"Ancient Ligurian","termine":"","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kem-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["moda"],"via":"","testo":"Inherited from Vulgar Latin *camocia, from Late Latin camōx, from Gaulish camox, probably from an extinct Alpine language (Raetic, Ancient Ligurian), possibly Proto-Indo-European *kem- (“without horns”). Doublet of chamuz.","origine_varieta":"la-vul"},{"parola":"gubia","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"gouge (chisel)","termine_origine":"gulbia","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"gulbia","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*gulbiā","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*gulbā","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin gulbia, gubia, from Gaulish *gulbiā, from Proto-Celtic *gulbā, *gulbīnos (“beak, bill”). See the late term for more information. Compare Middle Irish gulba (“beak”), English gouge.","origine_varieta":"la-lat"},{"parola":"landa","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"plain (a sandy plain)","termine_origine":"*landa","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*landa","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*landā","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*landā","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *landa, from Gaulish *landā, from Proto-Celtic *landā.","origine_varieta":"la-vul"},{"parola":"legua","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"legua, Spanish league (a traditional unit of distance equivalent to about 4.2 km)","termine_origine":"leuga","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"leuga","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*lougā","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Inherited from Late Latin leuga and leuca (“Gaulish league, distance of one hour's walking”), from Gaulish, from Proto-Celtic *lougā. Cognate with Galician legua, Portuguese légua, and Catalan llegua.","origine_varieta":"la-lat"},{"parola":"manto","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"shroud, cloak","termine_origine":"mantum","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"mantum","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":["scienza","moda"],"via":"","testo":"Inherited from Late Latin mantum, back-formation from mantellum, ultimately from Gaulish [Term?].","origine_varieta":"la-lat"},{"parola":"pico","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"beak (of a bird)","termine_origine":"beccus","catena":[{"codice":"la","nome":"Latin","termine":"beccus","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*bekkos","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*bekkos","categoria":"ereditato"}],"lontana":"cel-pro","ambiti":["scienza"],"via":"","testo":"Inherited from Old Spanish bico, from Latin beccus, possibly from Gaulish *bekkos, from Proto-Celtic *bekkos. It was phonetically influenced by the verb picar (“to peck”). Compare English beak.","origine_varieta":"la"},{"parola":"pieza","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"piece, part","termine_origine":"pettia","catena":[{"codice":"la-lat","nome":"Late Latin","termine":"pettia","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*pettyā","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kʷezdis","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":["sport","diritto_politica"],"via":"","testo":"Inherited from Old Spanish pieça, from Late Latin pettia, from Gaulish *pettyā, from Proto-Celtic *kʷezdis. Compare French pièce, Italian pezza, Catalan and Portuguese peça.","origine_varieta":"la-lat"},{"parola":"saya","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"skirt","termine_origine":"*sagia","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sagia","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"prestito"},{"codice":"cel","nome":"Celtic","termine":"","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*seg-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *sagia, from Latin sagum, from sagus, possibly borrowed from Gaulish *sagos, *sagom, from a Celtic language, from Proto-Indo-European *seg-. Compare Portuguese saia, French saie. Doublet of sayo.","origine_varieta":"la-vul"},{"parola":"sayo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"sì","motivo_incerta":"Possibly","significato":"smock","termine_origine":"*sagium","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*sagium","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"prestito"},{"codice":"cel","nome":"Celtic","termine":"","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*seg-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Old Spanish sayo, from Vulgar Latin *sagium, from Latin sagum, from sagus, possibly borrowed from Gaulish *sagos, *sagom, from a Celtic language, from Proto-Indo-European *seg-. Compare with Galician saio (“robe”). Doublet of saya (“skirt”).","origine_varieta":"la-vul"},{"parola":"soga","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"rope","termine_origine":"","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"non_precisato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*soucā","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*sew-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"From Vulgar Latin, Late Latin sōca, of Celtic origin, from Gaulish *soukā, ultimately from Proto-Indo-European *sew- (“to bend, to cut, to drive”), see also Sanskrit सुवति (suvati). Compare Portuguese and Asturian soga, Italian soga, French suage, Friulian soe, Romansh suga, Venetan soga.","origine_varieta":"la-vul"},{"parola":"tranca","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"thick bar of wood","termine_origine":"*taranca","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*taranca","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*tarankyos","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*terh₁-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Vulgar Latin *taranca (compare Old French taranche (“big iron pin”)), from Gaulish, from Proto-Celtic *tarankyos (“nail”) (compare Middle Irish tairnge (“iron nail”)), from Proto-Indo-European *terh₁- (“to drill, rub”).","origine_varieta":"la-vul"},{"parola":"vereda","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"path, lane","termine_origine":"verēda","catena":[{"codice":"la-eme","nome":"Early Medieval Latin","termine":"verēda","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"*werēdos","categoria":"prestito"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*uɸoreidos","categoria":"ereditato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Inherited from Early Medieval Latin verēda (“path, main road”), from Latin verēdus (“light breed of horse”), borrowed from Gaulish *werēdos, from Proto-Celtic *uɸoreidos, from *uɸo- + *reidos.","origine_varieta":"la-eme"},{"parola":"yezgo","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"dwarf elder","termine_origine":"","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"","categoria":"ereditato"},{"codice":"cel-gau","nome":"Gaulish","termine":"odocos","categoria":"non_precisato"}],"lontana":"cel-gau","ambiti":[],"via":"","testo":"Inherited from Old Spanish yedgo, from Vulgar Latin (Celto-Latin) *educus, from Gaulish odocos (influenced by or crossed with Latin ebulum).","origine_varieta":"la-vul"}]}