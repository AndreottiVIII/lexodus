{"arrivo":"es","origine":"ast","origine_nome":"Asturian","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":10,"parole":[{"parola":"bandrullo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of tripe filled with meat","termine_origine":"banduyu","catena":[{"codice":"ast","nome":"Asturian","termine":"banduyu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ventriculus","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Asturian banduyu (“stomach, belly”), from Latin ventriculus (“belly”). Doublet of ventrículo.","livello2_varieta":"la"},{"parola":"belfo","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Having thick lips","termine_origine":"belfu","catena":[{"codice":"ast","nome":"Asturian","termine":"belfu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bifidus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Maybe borrowed from Asturian belfu, from Latin bifidus. Doublet of inherited befo.","livello2_varieta":"la"},{"parola":"botillo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a cured meat dish, made from bits of pig meat stuffed inside a pig's cecum","termine_origine":"botiellu","catena":[{"codice":"ast","nome":"Asturian","termine":"botiellu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"botellus","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Asturian botiellu, from Latin botellus. For the unexpected retention of Latin /-t-/, Coromines & Pascual propose influence from botija (“vessel”) and other such words. Cognate with Asturian botiellu, Galician botelo and Portuguese butelo.","livello2_varieta":"la"},{"parola":"esquilo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"squirrel","termine_origine":"esquilu","catena":[{"codice":"ast","nome":"Asturian","termine":"esquilu","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"scuriolus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"σκίουρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Asturian esquilu, from Vulgar Latin scuriolus, diminutive of scurius, variant of Latin sciurus, from Ancient Greek σκίουρος (skíouros).","livello2_varieta":"la-vul"},{"parola":"feje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bundle, wad","termine_origine":"fexe","catena":[{"codice":"ast","nome":"Asturian","termine":"fexe","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fascis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Asturian fexe, ultimately from Latin fascis. Cognate with English fagot (“bundle of sticks bound together”). Doublet of fajo and haz.","livello2_varieta":"la"},{"parola":"fisgar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to snoop (on)","termine_origine":"fisgar","catena":[{"codice":"ast","nome":"Asturian","termine":"fisgar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fixicāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"According to Corominas borrowed from Asturian fisgar (given conservation of f-), from Vulgar Latin *fixicāre, from Latin fixus (“constant, unwavering”).","livello2_varieta":"la-vul"},{"parola":"gorullo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lump of wool","termine_origine":"gorollu","catena":[{"codice":"ast","nome":"Asturian","termine":"gorollu","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"volūclum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Asturian gorollu, from Vulgar Latin volūclum. Doublet of borujo, an inherited term.","livello2_varieta":"la-vul"},{"parola":"llera","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"pebbly or stony area","termine_origine":"llera","catena":[{"codice":"ast","nome":"Asturian","termine":"llera","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"glarea","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Perhaps borrowed from Asturian llera, from Latin glarea.","livello2_varieta":"la"},{"parola":"nalga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buttock","termine_origine":"nalga","catena":[{"codice":"ast","nome":"Asturian","termine":"nalga","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*natica","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["scienza"],"via":"","testo":"Borrowed from Asturian nalga from Vulgar Latin *natica, an adjectival term based on Latin natis (“rump, buttock”) (compare Catalan natja, Galician nádega, Italian natica, Portuguese nádega, Old French nache, English nates). The /l/ resulted from an original */ˈnad(e)ɡa/ through Asturleonese (a nativ","livello2_varieta":"la-vul"},{"parola":"pingar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to tilt; to incline","termine_origine":"pingar","catena":[{"codice":"ast","nome":"Asturian","termine":"pingar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*pendico","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Asturian pingar, from Vulgar Latin *pendicāre. Doublet of pringar.","livello2_varieta":"la-vul"}]}