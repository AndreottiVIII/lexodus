{"arrivo":"es","origine":"pt","origine_nome":"Portuguese","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":22,"parole":[{"parola":"aderno","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Hebedernia excelsa","termine_origine":"aderno","catena":[{"codice":"pt","nome":"Portuguese","termine":"aderno","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"alaternus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Portuguese aderno (“buckthorn”).","livello2_varieta":"la"},{"parola":"brincar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to jump around, leap about, bounce (to propel oneself rapidly upward)","termine_origine":"brincar","catena":[{"codice":"pt","nome":"Portuguese","termine":"brincar","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vinculum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Portuguese brincar, a verb based on Portuguese brinco, from Latin vinculum.","livello2_varieta":"la"},{"parola":"brinco","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"small jewel worn by women on their head","termine_origine":"brinco","catena":[{"codice":"pt","nome":"Portuguese","termine":"brinco","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"vinculum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Portuguese brinco, from Latin vinculum.","livello2_varieta":"la"},{"parola":"buzo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"diver (someone who dives underwater)","termine_origine":"búzio","catena":[{"codice":"pt","nome":"Portuguese","termine":"búzio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"būcinum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Portuguese búzio (“snail”), from Latin būcinu