_origine":"","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pantex","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Of Mozarabic origin, from Latin pantex (“paunch”); thus it can be seen as a dialectal variant of the inherited panza."},{"parola":"trapiche","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"press, crusher (machine)","termine_origine":"","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"trapetus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Mozarabic *trapíč, from Latin trapētum."},{"parola":"tuera","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"colocynth, bitter apple (Citrullus colocynthis)","termine_origine":"طوره","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"طوره","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"thora","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"φθορά","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Mozarabic طوره (ṭwrh /⁠tura, tuera⁠/), from Latin thora, phthora, from Ancient Greek φθορά (phthorá, “destruction, death, damage”)."},{"parola":"verdolaga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"common purslane, a plant of species Portulaca oleracea","termine_origine":"","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"portulāca","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Mozarabic *berdiláqaš, from Latin portulāca, with influence from Spanish verde and Mozarabic *yiláqa. Doublet of badulaque."}]}