{"arrivo":"es","origine":"mxi","origine_nome":"Mozarabic","livello2":"la","livello2_nome":"Latin","n":12,"parole":[{"parola":"alcornoque","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"cork oak","termine_origine":"*alqurnúq","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"*alqurnúq","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"quercus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Mozarabic *alqurnúq, from the Arabic article al- + quernus, variation of Latin quercus + Hispanic suffix -occus."},{"parola":"chinche","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bedbug","termine_origine":"*činče","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"*činče","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cimex","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Mozarabic *činče, from Latin cīmicem. Compare Old Spanish çisme."},{"parola":"chocho","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lupin beans, lupin fruit","termine_origine":"xauxu","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"xauxu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"salsus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"From Mozarabic xauxu, from Latin salsus (“salty”)."},{"parola":"chícharo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"pea","termine_origine":"*číčar(o)","catena":[{"codice":"mxi","nome":"Mozarabic","termine":"*číčar(o)","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cicer","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Mozarabic *číčar(o), from Latin cicer (“chickpea”)."},{"parola":"endibia","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"endive","termine