ice":"la-vul","nome":"Vulgar Latin","termine":"capus","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*kaput","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*kauput-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":["mare","militare","scienza","diritto_politica"],"via":"","testo":"Inherited from Vulgar Latin capus, from Latin caput, from Proto-Italic *kaput, ultimately from Proto-Indo-European *kauput-, *kaput-. Doublet of jefe and chef."},{"parola":"ceniza","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"ash (solid remains of a fire)","termine_origine":"*cinisia","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cinisia","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*kenis","categoria":"non_precisato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*ken-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Inherited from Old Spanish ceniza, from Vulgar Latin *cinisia, from Latin cinis. Compare Portuguese cinza and Romanian cenușă."},{"parola":"cinco","pos":"num|noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"five","termine_origine":"quīnque","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"quīnque","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*kʷenkʷe","categoria":"ereditato"}],"lontana":"itc-pro","ambiti":["sport"],"via":"","testo":"Inherited from Old Spanish çinco, from Vulgar Latin cīnque, from Latin quīnque. Doublet of ponche and ponzu."},{"parola":"día","pos":"noun","n_etimologia":1,"categoria":"ereditato","incerta":"no","significato":"day (any period of 24 hours)","termine_origine":"*dia","catena":[{"codice":"la-vul","nome":"Vulgar Latin","termine":"*dia","categoria":"ereditato"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*djous","categoria":"non_precisato"},{"codice":"ine-pro",