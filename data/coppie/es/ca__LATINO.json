{"arrivo":"es","origine":"ca","origine_nome":"Catalan","livello2":"LATINO","livello2_nome":"Latin (all varieties)","n":64,"parole":[{"parola":"-ote","pos":"suffix","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"forms augmentatives, i.e. words expressing greatness or size","termine_origine":"-ot","catena":[{"codice":"ca","nome":"Catalan","termine":"-ot","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"-ottus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan -ot, from Latin -ottus.","livello2_varieta":"la"},{"parola":"avante","pos":"adv","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"forward; ahead","termine_origine":"avant","catena":[{"codice":"ca","nome":"Catalan","termine":"avant","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"ab ante","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":["mare"],"via":"","testo":"Borrowed from Catalan avant, from Late Latin ab ante.","livello2_varieta":"la-lat"},{"parola":"avanzar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to advance (to make (something) happen at an earlier time or date)","termine_origine":"avançar","catena":[{"codice":"ca","nome":"Catalan","termine":"avançar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*abanteāre","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Catalan avançar, from Vulgar Latin *abanteāre, from Late Latin ab ante.","livello2_varieta":"la-vul"},{"parola":"ayustar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"to splice (rope)","termine_origine":"ajustar","catena":[{"codice":"ca","nome":"Catalan","termine":"ajustar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*iuxtāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["mare"],"via":"","testo":"P