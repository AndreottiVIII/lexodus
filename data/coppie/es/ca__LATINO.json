atalan","termine":"vogir","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*volgere","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Catalan vogir (“to spin”), from Vulgar Latin *volgere, from Latin volvere (“to turn”).","livello2_varieta":"la-vul"},{"parola":"boje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"box tree (plant of the genus Buxus)","termine_origine":"boix","catena":[{"codice":"ca","nome":"Catalan","termine":"boix","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"buxus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"πύξος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Catalan boix, from Latin buxus, from Ancient Greek πύξος (púxos). Compare the inherited regional doublet bujo.","livello2_varieta":"la"},{"parola":"bojear","pos":"verb","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"to measure the perimeter of an island","termine_origine":"vogir","catena":[{"codice":"ca","nome":"Catalan","termine":"vogir","categoria":"non_precisato"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*volgere","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"From Catalan vogir (“to spin”), from Vulgar Latin *volgere, from Latin volvere (“to turn”).","livello2_varieta":"la-vul"},{"parola":"borde","pos":"adj","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"bastard (born out of wedlock)","termine_origine":"bord","catena":[{"codice":"ca","nome":"Catalan","termine":"bord","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"burdus","categoria":"non_precisato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Catalan bord, from Late Latin burdus (“bastard”).","livello2_varieta":"la-lat"},{"parola":"borraja","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"borage (Borago officinalis)","termine_origine":"borratja","catena":[{"codice":"ca","nome":"Catalan","termine":"borratja","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"borragō","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Catalan borratja, from Latin borragō.","livello2_varieta":"la"},{"parola":"bou","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"seine fishing","termine_origine":"bou","catena":[{"codice":"ca","nome":"Catalan","termine":"bou","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bōs","categoria":"ereditato"},{"codice":"itc-sbl","nome":"Osco-Umbrian","termine":"","categoria":"prestito"},{"codice":"itc-pro","nome":"Proto-Italic","termine":"*gʷōs","categoria":"ereditato"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*gʷṓws","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Catalan bou. Doublet of buey and bife.","livello2_varieta":"la"},{"parola":"cigala","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Norway lobster (Nephrops norvegicus)","termine_origine":"cigala","catena":[{"codice":"ca","nome":"Catalan","termine":"cigala","categoria":"prestito"},{"codice":"la-eme","nome":"Early Medieval Latin","termine":"cicāla","categoria":"ereditato"}],"lontana":"la-eme","ambiti":["cucina"],"via":"","testo":"Borrowed from Catalan cigala.","livello2_varieta":"la-eme"},{"parola":"cleda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a siege tower","termine_origine":"cleda","catena":[{"codice":"ca","nome":"Catalan","termine":"cleda","categoria":"prestito"},{"codice":"la-eme","nome":"Early Medieval Latin","termine":"clēta","categoria":"non_precisato"}],"lontana":"la-eme","ambiti":["militare"],"via":"","testo":"Borrowed from Catalan cleda, from Early Medieval Latin clēta. First attested in 1396.","livello2_varieta":"la-eme"},{"parola":"cohete","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"skyrocket","termine_origine":"coet","catena":[{"codice":"ca","nome":"Catalan","termine":"coet","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"cauda","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina","militare"],"via":"","testo":"Borrowed from Catalan coet, ultimately from Latin cauda (“tail”).","livello2_varieta":"la"},{"parola":"convite","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"banquet, feast","termine_origine":"convit","catena":[{"codice":"ca","nome":"Catalan","termine":"convit","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"convitare","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Catalan convit, from Medieval Latin convitare.","livello2_varieta":"la-med"},{"parola":"cordel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"string (thin thread)","termine_origine":"cordell","catena":[{"codice":"ca","nome":"Catalan","termine":"cordell","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*cordellus","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Catalan cordell (“cord, string”), from Vulgar Latin *cordellus (“little rope, cord, string”), from Latin chorda (“rope, cord”) + -ellus (“-elle: forming diminutives”). Equivalent to corda + -el.","livello2_varieta":"la-vul"},{"parola":"desgaire","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"carelessness, slovenliness","termine_origine":"a escaire","catena":[{"codice":"ca","nome":"Catalan","termine":"a escaire","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"quādrum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan a escaire (“askew”), from escaire (“right angle”), from escairar (“to cut or set at right angles, to square”), from caire (“square”), from Latin quādrum (“square”).","livello2_varieta":"la"},{"parola":"doncel","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"squire; donzel; young nobleman","termine_origine":"donzell","catena":[{"codice":"ca","nome":"Catalan","termine":"donzell","categoria":"prestito"},{"codice":"la-med","nome":"Medieval Latin","termine":"domicellus","categoria":"non_precisato"}],"lontana":"la-med","ambiti":[],"via":"","testo":"Borrowed from Catalan donzell, from Medieval Latin domicellus or Vulgar Latin *domnicellus.","livello2_varieta":"la-med"},{"parola":"dátil","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"date (fruit of the date palm)","termine_origine":"dàtil","catena":[{"codice":"ca","nome":"Catalan","termine":"dàtil","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"dactylus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"δάκτυλος","categoria":"non_precisato"}],"lontana":"grc","ambiti":["cucina"],"via":"","testo":"Borrowed from Catalan dàtil, from Latin dactylus, from Ancient Greek δάκτυλος (dáktulos, “finger”). Doublet of dáctilo.","livello2_varieta":"la"},{"parola":"feble","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"feeble","termine_origine":"feble","catena":[{"codice":"ca","nome":"Catalan","termine":"feble","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fēbelis","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Catalan feble, from Vulgar Latin *fēbelis, from Latin flēbilis (“tearful, mournful, lamentable”).","livello2_varieta":"la-vul"},{"parola":"ferretero","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"iron","termine_origine":"ferreter","catena":[{"codice":"ca","nome":"Catalan","termine":"ferreter","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ferrum","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan ferreter, from Latin ferrum (“iron”).","livello2_varieta":"la"},{"parola":"festejar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"to celebrate","termine_origine":"festejar","catena":[{"codice":"ca","nome":"Catalan","termine":"festejar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*festizāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Probably borrowed from Catalan festejar, replacing the Old Spanish festear, both from Vulgar Latin *festizāre.","livello2_varieta":"la-vul"},{"parola":"flabiol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fluviol","termine_origine":"flabiol","catena":[{"codice":"ca","nome":"Catalan","termine":"flabiol","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*flabeolum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["musica"],"via":"","testo":"Borrowed from Catalan flabiol, fluviol, from Vulgar Latin *flabeolum, diminutive of Latin flabrum (“gust”) from flare (“to blow”). Cognate with French flageolet. First attested in the form flaviol in 1857.","livello2_varieta":"la-vul"},{"parola":"focha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"coot","termine_origine":"fotja","catena":[{"codice":"ca","nome":"Catalan","termine":"fotja","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fulica","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan fotja, ultimately from Latin fulica. Doublet of foja and fúlica.","livello2_varieta":"la"},{"parola":"foja","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"coot","termine_origine":"fotja","catena":[{"codice":"ca","nome":"Catalan","termine":"fotja","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fulica","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan fotja, ultimately from Latin fulica. Doublet of focha and fúlica.","livello2_varieta":"la"},{"parola":"fonébol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trebuchet","termine_origine":"fonèvol","catena":[{"codice":"ca","nome":"Catalan","termine":"fonèvol","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fundibulum","categoria":"non_precisato"}],"lontana":"la","ambiti":["militare"],"via":"","testo":"Borrowed from Catalan fonèvol, from Latin fundibulum.","livello2_varieta":"la"},{"parola":"gamba","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shrimp","termine_origine":"gamba","catena":[{"codice":"ca","nome":"Catalan","termine":"gamba","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"*gambarus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"κάμμαρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Catalan gamba, from Late Latin *gambarus, from Latin gammarus / cammarus (“lobster”), from Ancient Greek κάμμαρος (kámmaros). Sense 3 comes from the old 100 Chilean pesos banknote having the color of a shrimp.","livello2_varieta":"la-lat"},{"parola":"grao","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shore, strand","termine_origine":"grau","catena":[{"codice":"ca","nome":"Catalan","termine":"grau","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"gradus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan grau (“step, stair”). Doublet of grado.","livello2_varieta":"la"},{"parola":"litera","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bunk bed (piece of furniture made up of two beds stacked on top of each other)","termine_origine":"llitera","catena":[{"codice":"ca","nome":"Catalan","termine":"llitera","categoria":"prestito"},{"codice":"la-lat","nome":"Late Latin","termine":"lectuāria","categoria":"ereditato"}],"lontana":"la-lat","ambiti":[],"via":"","testo":"Borrowed from Catalan llitera, from Late Latin lectuāria, from Latin lectus (“bed”). First attested in 1600. A native Castilian outcome, for comparison, may have been *lechera.","livello2_varieta":"la-lat"},{"parola":"mero","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly","significato":"grouper (fish)","termine_origine":"nero","catena":[{"codice":"ca","nome":"Catalan","termine":"nero","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"Nerō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Possibly loaned from Catalan nero, from Latin Nerō, compared to the Roman emperor for its fierceness. Compare Old Occitan mero(n).","livello2_varieta":"la"},{"parola":"mosqueta","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"shell game","termine_origine":"mosqueta","catena":[{"codice":"ca","nome":"Catalan","termine":"mosqueta","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"muscus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan mosqueta, from Latin muscus (“moss”).","livello2_varieta":"la"},{"parola":"muelle","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"wharf, quay, pier, dock","termine_origine":"moll","catena":[{"codice":"ca","nome":"Catalan","termine":"moll","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mōles","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan moll (“mole, jetty”), from Latin mōles (“mass, mole, jetty”). Cognate with English mole (“massive structure used as a breakwater or pier”). Compare Portuguese molhe.","livello2_varieta":"la"},{"parola":"mújol","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mullet (fish), especially the grey mullet (Mugil cephalus)","termine_origine":"mújol","catena":[{"codice":"ca","nome":"Catalan","termine":"mújol","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mugil","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan mújol, from Latin mugil. Doublet of múgil.","livello2_varieta":"la"},{"parola":"nao","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a ship, a vessel","termine_origine":"nau","catena":[{"codice":"ca","nome":"Catalan","termine":"nau","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"navis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan nau, from Latin navem. Doublet of nave.","livello2_varieta":"la"},{"parola":"novel","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"novel, new","termine_origine":"novell","catena":[{"codice":"ca","nome":"Catalan","termine":"novell","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"novellus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan novell, from Latin novellus. Doublet of novillo.","livello2_varieta":"la"},{"parola":"orate","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a crazy person","termine_origine":"orat","catena":[{"codice":"ca","nome":"Catalan","termine":"orat","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"aura","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan orat, from a derivative of Latin aura, in the sense of an ill or unhealthy air or aura.","livello2_varieta":"la"},{"parola":"paella","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"paella","termine_origine":"paella","catena":[{"codice":"ca","nome":"Catalan","termine":"paella","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"patella","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan paella, from Latin patella. Doublet of padilla, paila, and puela.","livello2_varieta":"la"},{"parola":"payés","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"of or from the countryside","termine_origine":"pagès","catena":[{"codice":"ca","nome":"Catalan","termine":"pagès","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pagēnsis","categoria":"latinismo_dotto"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan pagès. Doublet of país.","livello2_varieta":"la"},{"parola":"pechina","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Possibly; Probably; perhaps","significato":"pendentive","termine_origine":"petxina","catena":[{"codice":"ca","nome":"Catalan","termine":"petxina","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"pecten","categoria":"non_precisato"}],"lontana":"la","ambiti":["arte"],"via":"","testo":"Possibly borrowed from Catalan petxina (itself probably derived ultimately from Latin pectinem) and crossed with clòtxina, or perhaps taken from a Valencian Mozarabic term.","livello2_varieta":"la"},{"parola":"pedreñal","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"petronel","termine_origine":"pedrenyal","catena":[{"codice":"ca","nome":"Catalan","termine":"pedrenyal","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"petrinus","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan pedrenyal, from pedrenya /pedreny; otherwise, directly from Latin petrinus, from petra (“stone”).","livello2_varieta":"la"},{"parola":"percha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","signific