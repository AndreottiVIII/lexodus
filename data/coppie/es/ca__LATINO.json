do-European","termine":"*swésōr","categoria":"ereditato"}],"lontana":"ine-pro","ambiti":["religione"],"via":"","testo":"Borrowed from Catalan sor, from Latin soror, from Proto-Italic *swezōr, from Proto-Indo-European *swésōr.","livello2_varieta":"la"},{"parola":"sota","pos":"noun|prep","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"jack, knave","termine_origine":"sota","catena":[{"codice":"ca","nome":"Catalan","termine":"sota","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*subta","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["sport"],"via":"","testo":"Borrowed from Catalan sota, from Vulgar Latin *subta, from Latin subtus (“below”), which is derived from Latin sub. Cognate to French sous and Italian sotto.","livello2_varieta":"la-vul"},{"parola":"trajinar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"to transport, to move","termine_origine":"traginar","catena":[{"codice":"ca","nome":"Catalan","termine":"traginar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*tragināre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Probably borrowed from Catalan traginar, from Vulgar Latin *tragināre, from *tragere, from Latin trahere (“to pull”). Compare French traîner, Italian trascinare.","livello2_varieta":"la-vul"},{"parola":"tralla","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"whip","termine_origine":"tralla","catena":[{"codice":"ca","nome":"Catalan","termine":"tralla","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*trāgla","categoria":"ereditato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Catalan tralla, from Vulgar Latin *trāgla, from Latin trāgula, from the root of traho (“to draw, drag”).","livello2_varieta":"la-vul"},{"parola":"viaje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"voyage","termine_origine":"viatge","catena":[{"codice":"ca","nome":"Catalan","termine":"viatge","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"viāticum","categoria":"ereditato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Catalan viatge, from Old Catalan viatge, from Latin viāticum, from viāticus, from via (“road, path”) + -āticus (adjective-forming suffix). Doublet of viático.","livello2_varieta":"la"},{"parola":"yayo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Unknown; perhaps","significato":"grandpa, pops","termine_origine":"iaio","catena":[{"codice":"ca","nome":"Catalan","termine":"iaio","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"avia","categoria":"non_precisato"},{"codice":"el","nome":"Greek","termine":"γιαγιά","categoria":"non_precisato"}],"lontana":"el","ambiti":[],"via":"","testo":"Unknown origin, perhaps from whimsical slang by youth. A prevailing theory, given the term's ultimate origin in Aragon and Catalan-speaking territories, is derivation from Catalan iaio (“grandpa”). It seems the first form generated was *jaja (“grandma”), from which the masculine form was derived. Th","livello2_varieta":"la"}]}