{"arrivo":"es","origine":"ast","origine_nome":"Asturian","livello2":"la-vul","livello2_nome":"Vulgar Latin","n":5,"parole":[{"parola":"esquilo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"squirrel","termine_origine":"esquilu","catena":[{"codice":"ast","nome":"Asturian","termine":"esquilu","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"scuriolus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"σκίουρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Asturian esquilu, from Vulgar Latin scuriolus, diminutive of scurius, variant of Latin sciurus, from Ancient Greek σκίουρος (skíouros)."},{"parola":"fisgar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to snoop (on)","termine_origine":"fisgar","catena":[{"codice":"ast","nome":"Asturian","termine":"fisgar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fixicāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"According to Corominas borrowed from Asturian fisgar (given conservation of f-), from Vulgar Latin *fixicāre, from Latin fixus (“constant, unwavering”)."},{"parola":"gorullo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lump of wool","termine_origine":"gorollu","catena":[{"codice":"ast","nome":"Asturian","termine":"gorollu","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"volūclum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Asturian gorollu, from Vulgar Latin volūclum. Doublet of borujo, an inherited term."},{"parola":"nalga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buttock","termine_origine":"nalga","catena":[{"codice":"ast","nome":"Asturian","termine":"nalga","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","t