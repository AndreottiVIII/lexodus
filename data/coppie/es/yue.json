ito","incerta":"no","significato":"douchi","termine_origine":"","catena":[{"codice":"yue","nome":"Cantonese","termine":"","categoria":"prestito"}],"lontana":"yue","ambiti":["cucina"],"via":"","testo":"Borrowed from Cantonese 豆豉 (dau⁶ si⁶). See also Tagalog tawsi."},{"parola":"tipakay","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"","termine_origine":"琵琶雞","catena":[{"codice":"yue","nome":"Cantonese","termine":"琵琶雞","categoria":"prestito"}],"lontana":"yue","ambiti":["cucina"],"via":"","testo":"Borrowed from Cantonese 琵琶雞 /琵琶鸡 (pei⁴ paa⁴ gai¹). Compare Vietnamese 琵琶 (tỳ bà)."},{"parola":"tusán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Chinese Peruvian","termine_origine":"","catena":[{"codice":"yue","nome":"Cantonese","termine":"","categoria":"prestito"}],"lontana":"yue","ambiti":[],"via":"","testo":"Borrowed from Cantonese 土生 (tou² sang¹)."},{"parola":"wantán","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"wonton","termine_origine":"雲吞","catena":[{"codice":"yue","nome":"Cantonese","termine":"雲吞","categoria":"prestito"}],"lontana":"yue","ambiti":[],"via":"","testo":"Borrowed from Cantonese 雲吞 /云吞 (wan⁴ tan¹)."}]}