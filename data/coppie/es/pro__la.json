{"arrivo":"es","origine":"pro","origine_nome":"Old Occitan","livello2":"la","livello2_nome":"Latin","n":9,"parole":[{"parola":"antorcha","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"torch","termine_origine":"entorcha","catena":[{"codice":"pro","nome":"Old Occitan","termine":"entorcha","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"intorta","categoria":"non_precisato"},{"codice":"fro","nome":"Old French","termine":"torche","categoria":"non_precisato"}],"lontana":"fro","ambiti":[],"via":"","testo":"Probably borrowed from Old Occitan entorcha, itself a crossing of entorta (from Latin intorta) and Old French torche."},{"parola":"atorar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to clog, clog up","termine_origine":"","catena":[{"codice":"pro","nome":"Old Occitan","termine":"","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"obtūrō","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Old Occitan, from Latin obtūrāre. Compare Portuguese aturar. See also the borrowed doublet obturar."},{"parola":"avestruz","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"ostrich","termine_origine":"estrutz","catena":[{"codice":"pro","nome":"Old Occitan","termine":"estrutz","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"strūthiō","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"στρουθίων","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"From ave (< Latin avis) + Old Occitan estrutz, from Latin strūthiō, from Ancient Greek στρουθίων (strouthíōn)."},{"parola":"bello","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"nodo incerto nell'albero","significato":"beautiful, fair","termine_origine":"bel","catena":[{"codice":"pro","nome":"Old Occitan","termine":"bel","categori