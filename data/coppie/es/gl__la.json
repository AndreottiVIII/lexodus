{"arrivo":"es","origine":"gl","origine_nome":"Galician","livello2":"la","livello2_nome":"Latin","n":6,"parole":[{"parola":"meigo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"A person who is believed to have made a pact with the devil.","termine_origine":"meigo","catena":[{"codice":"gl","nome":"Galician","termine":"meigo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"magicus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"μαγικός","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Galician meigo, from Old Galician-Portuguese meigo, from Latin magicus (“magical”), from Ancient Greek μαγικός (magikós). Compare also mego. Doublet of mágico."},{"parola":"morriña","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"murrain","termine_origine":"morriña","catena":[{"codice":"gl","nome":"Galician","termine":"morriña","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"mori","categoria":"non_precisato"}],"lontana":"la","ambiti":["scienza"],"via":"","testo":"Borrowed from Galician morriña, ultimately from a form of Latin mori (“to die”)."},{"parola":"nébeda","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"catnip","termine_origine":"nébeda","catena":[{"codice":"gl","nome":"Galician","termine":"nébeda","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"nepeta","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Galician nébeda, from Latin nepeta. Spanish previously had forms such as nieta, nebda, neuda, neota."},{"parola":"pazo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Galician manor","termine_origine":"pazo","catena":[{"codice":"gl","nome":"Galician","termine":"pazo","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"palātium","categoria":"non_precisato"}],"lontana":"la