{"arrivo":"es","origine":"ast","origine_nome":"Asturian","n":39,"parole":[{"parola":"amestáu","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"mixed Spanish-Asturian dialect spoken by most of the urban Asturian population","termine_origine":"amestáu","catena":[{"codice":"ast","nome":"Asturian","termine":"amestáu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian amestáu (“mixed”)."},{"parola":"argayar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"or from","significato":"to produce a landslide","termine_origine":"argayar","catena":[{"codice":"ast","nome":"Asturian","termine":"argayar","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian argayar or from argayo + -ar."},{"parola":"argayo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"landslide","termine_origine":"argayu","catena":[{"codice":"ast","nome":"Asturian","termine":"argayu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian argayu."},{"parola":"bandrullo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of tripe filled with meat","termine_origine":"banduyu","catena":[{"codice":"ast","nome":"Asturian","termine":"banduyu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"ventriculus","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Asturian banduyu (“stomach, belly”), from Latin ventriculus (“belly”). Doublet of ventrículo."},{"parola":"belfo","pos":"adj|noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"Having thick lips","termine_origine":"belfu","catena":[{"codice":"ast","nome":"Asturian","termine":"belfu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"bifidus","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Maybe borrowed from Asturian belfu, from Latin bifidus. Doublet of inherited befo."},{"parola":"botillo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a cured meat dish, made from bits of pig meat stuffed inside a pig's cecum","termine_origine":"botiellu","catena":[{"codice":"ast","nome":"Asturian","termine":"botiellu","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"botellus","categoria":"non_precisato"}],"lontana":"la","ambiti":["cucina"],"via":"","testo":"Borrowed from Asturian botiellu, from Latin botellus. For the unexpected retention of Latin /-t-/, Coromines & Pascual propose influence from botija (“vessel”) and other such words. Cognate with Asturian botiellu, Galician botelo and Portuguese butelo."},{"parola":"braña","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"meadow; meadowland","termine_origine":"braña","catena":[{"codice":"ast","nome":"Asturian","termine":"braña","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"From Asturian braña, from branu, Western variant of veranu (“summer”)."},{"parola":"cachopo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"cachopo (dish)","termine_origine":"cachopu","catena":[{"codice":"ast","nome":"Asturian","termine":"cachopu","categoria":"prestito"}],"lontana":"ast","ambiti":["cucina"],"via":"","testo":"Borrowed from Asturian cachopu (literally “stump”)."},{"parola":"chido","pos":"adj","n_etimologia":1,"categoria":"non_precisato","incerta":"sì","motivo_incerta":"Possibly","significato":"cool, awesome","termine_origine":"xidu","catena":[{"codice":"ast","nome":"Asturian","termine":"xidu","categoria":"non_precisato"}],"lontana":"ast","ambiti":[],"via":"","testo":"Possibly from Asturian xidu (“nice, beautiful”), brought to Mexico by a wave of Asturian immigrants in the 19th century. Or, possibly from the slang chiro (“excellent”). Not to be confused with chivo."},{"parola":"coloño","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"large basket","termine_origine":"coloñu","catena":[{"codice":"ast","nome":"Asturian","termine":"coloñu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian coloñu."},{"parola":"cuélebre","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a kind of dragon of Asturian mythology","termine_origine":"cuélebre","catena":[{"codice":"ast","nome":"Asturian","termine":"cuélebre","categoria":"prestito"}],"lontana":"ast","ambiti":["scienza"],"via":"","testo":"Borrowed from Asturian cuélebre."},{"parola":"cócora","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"annoying person","termine_origine":"cócora","catena":[{"codice":"ast","nome":"Asturian","termine":"cócora","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian cócora."},{"parola":"ería","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"large parcel of subdivided farmland","termine_origine":"ería","catena":[{"codice":"ast","nome":"Asturian","termine":"ería","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian ería, from era (“small seedbed”) + -ía."},{"parola":"esguilar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to climb","termine_origine":"esguilar","catena":[{"codice":"ast","nome":"Asturian","termine":"esguilar","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian esguilar."},{"parola":"esmirriado","pos":"adj","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"skinny, scrawny","termine_origine":"esmirriáu","catena":[{"codice":"ast","nome":"Asturian","termine":"esmirriáu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"According to Corominas, borrowed from Asturian esmirriáu. Compare Portuguese mirrado."},{"parola":"esquilo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"squirrel","termine_origine":"esquilu","catena":[{"codice":"ast","nome":"Asturian","termine":"esquilu","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"scuriolus","categoria":"non_precisato"},{"codice":"grc","nome":"Ancient Greek","termine":"σκίουρος","categoria":"non_precisato"}],"lontana":"grc","ambiti":[],"via":"","testo":"Borrowed from Asturian esquilu, from Vulgar Latin scuriolus, diminutive of scurius, variant of Latin sciurus, from Ancient Greek σκίουρος (skíouros)."},{"parola":"fabada","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fabada; bean potage","termine_origine":"fabada","catena":[{"codice":"ast","nome":"Asturian","termine":"fabada","categoria":"prestito"}],"lontana":"ast","ambiti":["cucina"],"via":"","testo":"Borrowed from Asturian fabada."},{"parola":"fabes con amasueles","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"fabes con amasueles","termine_origine":"fabes con amasueles","catena":[{"codice":"ast","nome":"Asturian","termine":"fabes con amasueles","categoria":"prestito"}],"lontana":"ast","ambiti":["cucina"],"via":"","testo":"From Asturian fabes con amasueles (“beans with clams”)."},{"parola":"fame","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"hunger","termine_origine":"fame","catena":[{"codice":"ast","nome":"Asturian","termine":"fame","categoria":"prestito"},{"codice":"ine-pro","nome":"Proto-Indo-European","termine":"*dʰH-","categoria":"non_precisato"}],"lontana":"ine-pro","ambiti":[],"via":"","testo":"Borrowed from Asturian fame (“hunger”), from Proto-Indo-European *dʰH- (“to disappear”). Cognate with Portuguese fome, French faim, Italian fame and Romanian foame. Doublet of hambre."},{"parola":"feje","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"bundle, wad","termine_origine":"fexe","catena":[{"codice":"ast","nome":"Asturian","termine":"fexe","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"fascis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Borrowed from Asturian fexe, ultimately from Latin fascis. Cognate with English fagot (“bundle of sticks bound together”). Doublet of fajo and haz."},{"parola":"fisgar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to snoop (on)","termine_origine":"fisgar","catena":[{"codice":"ast","nome":"Asturian","termine":"fisgar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*fixicāre","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"According to Corominas borrowed from Asturian fisgar (given conservation of f-), from Vulgar Latin *fixicāre, from Latin fixus (“constant, unwavering”)."},{"parola":"frisuelo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a type of dessert found in Leon and Asturias, Spain made with flour, milk, and eggs","termine_origine":"frixuelu","catena":[{"codice":"ast","nome":"Asturian","termine":"frixuelu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian frixuelu."},{"parola":"garcilla","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"ladle","termine_origine":"garciella","catena":[{"codice":"ast","nome":"Asturian","termine":"garciella","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian garciella."},{"parola":"gorullo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"lump of wool","termine_origine":"gorollu","catena":[{"codice":"ast","nome":"Asturian","termine":"gorollu","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"volūclum","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Asturian gorollu, from Vulgar Latin volūclum. Doublet of borujo, an inherited term."},{"parola":"jou","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a small deep valley or gorge in the Picos de Europa","termine_origine":"ḥou","catena":[{"codice":"ast","nome":"Asturian","termine":"ḥou","categoria":"prestito"}],"lontana":"ast","ambiti":["sport"],"via":"","testo":"Borrowed from Asturian ḥou, eastern variant of fueyu (“pit”)."},{"parola":"llagar","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"building where cider is made, and which contains the vat","termine_origine":"llagar","catena":[{"codice":"ast","nome":"Asturian","termine":"llagar","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian llagar. Doublet of lagar."},{"parola":"llar","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"trammel","termine_origine":"llar","catena":[{"codice":"ast","nome":"Asturian","termine":"llar","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian llar."},{"parola":"llera","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"perhaps","significato":"pebbly or stony area","termine_origine":"llera","catena":[{"codice":"ast","nome":"Asturian","termine":"llera","categoria":"prestito"},{"codice":"la","nome":"Latin","termine":"glarea","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Perhaps borrowed from Asturian llera, from Latin glarea."},{"parola":"miagar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to meow","termine_origine":"miagar","catena":[{"codice":"ast","nome":"Asturian","termine":"miagar","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian miagar."},{"parola":"nalga","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"buttock","termine_origine":"nalga","catena":[{"codice":"ast","nome":"Asturian","termine":"nalga","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*natica","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":["scienza"],"via":"","testo":"Borrowed from Asturian nalga from Vulgar Latin *natica, an adjectival term based on Latin natis (“rump, buttock”) (compare Catalan natja, Galician nádega, Italian natica, Portuguese nádega, Old French nache, English nates). The /l/ resulted from an original */ˈnad(e)ɡa/ through Asturleonese (a nativ"},{"parola":"pegollo","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a pillar of a hórreo","termine_origine":"pegollu","catena":[{"codice":"ast","nome":"Asturian","termine":"pegollu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian pegollu."},{"parola":"peje","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"fish","termine_origine":"","catena":[{"codice":"ast","nome":"Asturian","termine":"","categoria":"non_precisato"},{"codice":"an","nome":"Aragonese","termine":"","categoria":"non_precisato"},{"codice":"la","nome":"Latin","termine":"piscis","categoria":"non_precisato"}],"lontana":"la","ambiti":[],"via":"","testo":"Inherited from Old Spanish pexe, borrowed from e.g. Asturian or Aragonese, from Latin piscem. Doublet of pez, the indigenous Castilian outcome. Compare also Portuguese peixe."},{"parola":"piara","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"sì","motivo_incerta":"Probably","significato":"herd (of pigs, sheep etc.)","termine_origine":"peara","catena":[{"codice":"ast","nome":"Asturian","termine":"peara","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"According to Corominas borrowed from Asturian peara, a variant of Western Asturian piada, peada, probably from pía, western variant of pie (“foot”)."},{"parola":"pingar","pos":"verb","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"to tilt; to incline","termine_origine":"pingar","catena":[{"codice":"ast","nome":"Asturian","termine":"pingar","categoria":"prestito"},{"codice":"la-vul","nome":"Vulgar Latin","termine":"*pendico","categoria":"non_precisato"}],"lontana":"la-vul","ambiti":[],"via":"","testo":"Borrowed from Asturian pingar, from Vulgar Latin *pendicāre. Doublet of pringar."},{"parola":"quejigo","pos":"noun","n_etimologia":1,"categoria":"non_precisato","incerta":"no","significato":"Portuguese oak (Quercus faginea)","termine_origine":"caxigu","catena":[{"codice":"ast","nome":"Asturian","termine":"caxigu","categoria":"non_precisato"},{"codice":"cel-pro","nome":"Proto-Celtic","termine":"*kassiku","categoria":"non_precisato"}],"lontana":"cel-pro","ambiti":[],"via":"","testo":"Alteration of earlier cajigo, from Asturian caxigu (“oak”), from Proto-Celtic *kassiku (compare Aragonese caixico), from *kass- (“twisted, gnarled”) (compare Irish cas (“to twist”)); akin to French chêne (“oak”)."},{"parola":"rodillo","pos":"noun","n_etimologia":2,"categoria":"prestito","incerta":"no","significato":"cleaning cloth","termine_origine":"rodiellu","catena":[{"codice":"ast","nome":"Asturian","termine":"rodiellu","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian rodiellu."},{"parola":"sextaferia","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"a day, usually every year, on which townsfolk were obliged gathered together to repair the roadways","termine_origine":"sestaferia","catena":[{"codice":"ast","nome":"Asturian","termine":"sestaferia","categoria":"prestito"}],"lontana":"ast","ambiti":[],"via":"","testo":"Borrowed from Asturian sestaferia. Compare Portuguese sexta-feira (“Friday”)."},{"parola":"teito","pos":"noun","n_etimologia":1,"categoria":"prestito","incerta":"no","significato":"dwelling with a thatched roof","termine_origine":"","catena":[{"codice":"ast","nome":"Asturian","ter