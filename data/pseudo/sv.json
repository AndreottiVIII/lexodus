{"lingua":"sv","nome_it":"svedese","nome_en":"Swedish","escluso_dalle_statistiche":false,"nota":"Words of this language that look borrowed from another language but do not exist there with that meaning, grouped by the language they imitate.","n_parole":32,"n_lingue_imitate":5,"per_lingua_imitata":[{"codice":"en","nome_it":"inglese","nome_en":"English","n":28,"parole":[{"parola":"afterski","n_etimologia":1,"significato":"après-ski","categoria":"prestito","lingua_diretta":{"codice":"en","nome_it":"inglese","nome_en":"English"},"lingue_imitate":["en"],"testo":"Pseudo-anglicism, derived from after + ski as a calque of French après-ski. Attested since the 1950s.","file_albero":"alberi/sv/a.json","chiave_albero":"afterski|1"},{"parola":"afterwork","n_etimologia":1,"significato":"the act of visiting a pub, bar, restaurant or other venues of entertainment with coworkers immediately after work","categoria":"prestito","lingua_diretta":{"codice":"en","nome_it":"inglese","nome_en":"English"},"lingue_imitate":["en"],"testo":"Pseudo-anglicism, derived from after + work, based on afterski (“après-ski”). Attested since 2000.","file_albero":"alberi/sv/a.json","chiave_albero":"afterwork|1"},{"parola":"babylift","n_etimologia":1,"significato":"carrycot","categoria":"prestito","lingua_diretta":{"codice":"en","nome_it":"inglese","nome_en":"English"},"lingue_imitate":["en"],"testo":"Pseudo-anglicism, derived from baby + lift.","file_albero":"alberi/sv/b.json","chiave_albero":"babylift|1"},{"parola":"babysitter","n_etimologia":1,"significato":"baby bouncer","categoria":"prestito","lingua_diretta":{"codice":"en","nome_it":"inglese","nome_en":"English"},"lingue_imitate":["en"],"testo":"Pseudo-anglicism, derived from babysitter.","file_albero":"alberi/sv/b.json","chiave_albero":"babysitter|1"},{"parola":"backslick","n_etimologia":1,"significato":"slicked-back hair","categoria":"prestito","lingua_diretta":{"codice":"en","nome_it":"inglese","nome_en":"English"},"lingue_imitate":["en"],"testo":